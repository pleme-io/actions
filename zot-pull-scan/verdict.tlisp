;; zot-pull-scan/verdict.tlisp — stage 3 of the zot faucet gate: translate
;; the nested `image-scan` step's outcome into this action's typed
;; admitted/result contract, and re-assert the pass/fail decision as this
;; action's OWN exit code.
;;
;; WHY a separate, explicit verdict stage (not just letting image-scan's own
;; exit code propagate through): the scan step in action.yml runs with
;; `continue-on-error: true` so that a REJECTED image still lets this action
;; emit its typed admitted=false / result=rejected / severity / vuln-count
;; outputs — a composite-action step that hard-fails WITHOUT
;; continue-on-error skips every later step by default, so there would be no
;; chance to emit anything. But continue-on-error also absorbs the scan
;; step's own failure from the composite's overall status — so something
;; later must explicitly re-derive the real verdict and re-assert it as a
;; real exit code. This file is that something, and it is the LAST step in
;; the action, so its exit code IS what a consumer workflow sees as this
;; action's own pass/fail. This is deliberately NOT implicit: a scan that
;; "ran but didn't gate" — the exact illegal state a forgotten/misused
;; continue-on-error produces — is closed by this file always re-deriving
;; its own exit code from the scan's real outcome, never trusting that the
;; outer composite-action machinery propagated it correctly on its own.
;;
;; image-scan is the ONE canonical implementation of severity classification
;; + fail-on-severity gating (jq-parsed against trivy's real JSON shape,
;; hard-fails on a broken/unreachable scan rather than defaulting to
;; "clean" — see image-scan/run.tlisp's own header). This file never
;; re-implements any of that (a prior version of this action did, with a
;; stale substring-match severity classifier that never actually matched
;; trivy's real JSON output — see the commit that introduced this file for
;; the full history). It only maps a GitHub Actions step "outcome"
;; (success|failure|cancelled|skipped) to the admit/reject vocabulary this
;; action's own contract promises its callers.
;;
;; Inputs (env): SCAN_OUTCOME, SCAN_SEVERITY, SCAN_VULN_COUNT, DEST
;; Outputs: admitted, severity, vuln-count, local-archive, result
;; Exit: 0 iff SCAN_OUTCOME == "success" (admitted). Every other outcome —
;; rejected/failure/cancelled/skipped/anything unrecognized — fails closed;
;; an outcome this code doesn't explicitly recognize as success is NEVER
;; treated as a pass.

;; ── pure helpers (unit-tested via verdict.test.tlisp) ────────────

(define (admitted-outcome? outcome) (equal? outcome "success"))

(define (verdict-of outcome) (if (admitted-outcome? outcome) "admitted" "rejected"))

;; ── main: every side effect lives here ───────────────────────────

(define
  (main)
  (let*
    ((outcome (env-get "SCAN_OUTCOME" ""))
      (severity (env-get "SCAN_SEVERITY" "none"))
      (vuln-count (env-get "SCAN_VULN_COUNT" "0"))
      (scanned-targets (env-get "SCAN_SCANNED_TARGETS" ""))
      (dest (env-get "DEST" "zot-pull.tar"))
      (verdict (verdict-of outcome)))
    (append-output (string-append "severity=" severity))
    (append-output (string-append "vuln-count=" vuln-count))
    (append-output (string-append "scanned-targets=" scanned-targets))
    (append-output (string-append "local-archive=" dest))
    (append-output (string-append "admitted=" (if (admitted-outcome? outcome) "true" "false")))
    (append-output (string-append "result=" verdict))
    (cond
      ((admitted-outcome? outcome)
        ;; STATE THE DENOMINATOR NEXT TO THE VERDICT. `severity none` over 40
        ;; targets and `severity none` over ZERO printed identically here, and
        ;; this is the trusted-zone boundary -- the worst place in the pipeline
        ;; for a verdict whose denominator is invisible. hardened-clickhouse and
        ;; -clickhouse-keeper are trivy-blind by declaration
        ;; (`trivyAnalysableTargets = [ ]`), so their honest coverage is vulnix
        ;; over the Nix closure and this line must not read as if trivy cleared
        ;; them. SEVEN images are in that state, measured 2026-08-01:
        ;;   rabbitmq · mysql · socat-relay · clickhouse · clickhouse-keeper ·
        ;;   classic-hardened-clickhouse-{server,keeper}
        ;; An earlier draft of this comment said ELEVEN. That was a raw
        ;; grep count of `trivyAnalysableTargets = [ ]` in hardened-images'
        ;; flake.nix, and FOUR of the 11 hits are the string appearing inside
        ;; COMMENTS explaining the convention. Prose about a thing counted as
        ;; an instance of it -- the same defect this whole gate exists to
        ;; catch, committed in the fix for it. Attribute to a service block,
        ;; never grep a bare count.
        (log-info
          (string-append "zot faucet ADMIT: severity " severity
                         " below the configured threshold (scanned-targets="
                         (if (equal? scanned-targets "") "UNREPORTED" scanned-targets)
                         ", vuln-count=" vuln-count ")"))
        (if (equal? (string-trim scanned-targets) "0")
          (log-info
            (string-append
              "  NOTE: scanned-targets=0 -- trivy measured NOTHING here. This "
              "ADMIT is not evidence of a clean image; it is the absence of "
              "evidence from this scanner. Coverage for such images comes from "
              "vulnix over the Nix closure in the release gate."
              ;; ── VERIFIED BY EXECUTION 2026-08-02, not by reading ─────────────────
              ;; stdlib prepended as action.yml does, three cases:
              ;;   scanned-targets=0, severity=none  -> "ADMIT ... (scanned-
              ;;     targets=0, vuln-count=0)" + this NOTE; admitted=true,
              ;;     result=admitted
              ;;   scanned-targets=40, severity=HIGH -> "REJECT"; admitted=false,
              ;;     result=rejected   (so the gate is not simply permissive)
              ;;   scanned-targets=40, severity=none -> admits with ZERO note
              ;;     lines (so the note is genuinely tied to the denominator)
              ;;
              ;; ★★ AND THAT LAST SENTENCE IS TRUE OF ONE LANE ONLY (2026-08-02).
              ;; It holds for the NIX-BUILT images: they have a Nix closure, so
              ;; vulnix is a real second denominator behind a zero-target trivy.
              ;; It does NOT hold for the classic-hardened-* VENDOR REWRAPS,
              ;; which reach this same branch and are admitted by this same
              ;; NOTE. Their payload is a pulled vendor blob with no store path;
              ;; hardened-images records `vulnixWhitelist = null` and that
              ;; vulnix "scans the base closure only". So for those three the
              ;; fallback named here covers the base and not the thing that
              ;; carries the risk.
              ;;
              ;; MEASURED, so this is not theoretical: the classic server and
              ;; keeper bundle OpenSSL 3.5.0 statically, and 3.5.0 matches 35
              ;; NVD records (40 raw, minus a 5-record floor proven with a
              ;; nonsense-version control), four of them HIGH. Every one is
              ;; invisible to both scanners named above.
              ;;
              ;; The shape worth naming: a caveat that CITES A COMPENSATING
              ;; CONTROL is stronger than one that just says "unmeasured" --
              ;; and it is therefore worse when the compensating control does
              ;; not apply to every image that reaches it. This note reassures
              ;; on the classic lane by pointing at coverage that lane lacks.
              ;; `pending-faucet-lane-aware-note: the zero-target NOTE should
              ;;  name the ACTUAL fallback for the image at hand, and say
              ;;  "no second scanner covers this payload" when that is the
              ;;  truth. Admission policy is a separate question -- rejecting
              ;;  vendor rewraps outright is an operator decision, not this
              ;;  gate's to make unilaterally.`
              ))
          #t)
        0)
      (else
        (log-error
          (string-append
            "zot faucet REJECT: scan outcome="
            outcome
            " severity="
            severity
            " — not admitted (image-scan's own gate is canonical; "
            "this stage never re-derives severity, only re-asserts its verdict)"))
        1))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — zot-pull-scan verdict.tlisp helpers loaded; main skipped"))
  (else (exit (main))))
