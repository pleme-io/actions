;; zot-pull-scan/pull.tlisp — stage 1 of the zot faucet gate: pull an image
;; from a private zot registry into a local docker-archive so stage 2 (a
;; nested `image-scan` step, see action.yml) scans exactly the bytes we
;; pulled, never a re-resolved tag.
;;
;; This is the ONLY stage in this action that owns registry I/O. Scan +
;; gate logic all live in image-scan, the fleet's ONE canonical
;; implementation of severity classification + fail-on-severity threshold
;; gating (see verdict.tlisp's header for why this action no longer
;; duplicates that logic — it used to, with a stale/buggy copy).
;;
;; TLS (added 2026-07-24): the in-cluster Zot serves real in-pod TLS with a
;; SELF-SIGNED cert (no cert-manager on camelot-eks). The prior version ran
;; a bare `skopeo copy` with NO source-TLS trust wiring, so a pull from
;; zot's self-signed endpoint failed server-identity verification before a
;; single byte moved — the faucet could never open. This mirrors the
;; sibling `zot-push` action's already-proven CA-trust pattern: fetch the
;; pinned CA/leaf cert once from a raw URL and hand it to skopeo. skopeo pins
;; a DIRECTORY of certs (`--src-cert-dir`, *.crt = CA) rather than a single
;; file (doca's `--dest-ca-cert`), so the fetched PEM is written into a
;; dedicated dir and that dir is passed. Verification is against a SPECIFIC
;; known cert, never a blanket "accept any cert". `SRC_INSECURE=true` is the
;; FALLBACK (plain `--src-tls-verify=false`), used only if the cert fetch
;; itself fails — logged loudly, never silent.
;;
;; OPT-IN by default -- `SRC_CA_CERT_URL` defaults to "" (skip CA trust,
;; original plain-copy behavior) because this action's SOURCE is not always
;; the self-signed zot: its shipped consumer `vendor-image-mirror.yml` uses
;; it to pull the SOURCE image from GHCR (publicly-trusted TLS, no zot CA
;; wanted), and defaulting to a required zot-CA fetch would REFUSE every one
;; of those pulls. A consumer that genuinely pulls FROM the self-signed zot
;; opts in: set `SRC_CA_CERT_URL` to the committed zot-ca.crt (plus a
;; `SRC_CA_CERT_TOKEN` for the private repo) for pinned verification, OR set
;; `SRC_INSECURE=true` for the loud plaintext fallback.
;;
;; Inputs (env):
;;   REF               zot image ref to pull + scan (required)
;;   DEST              local docker-archive path (default zot-pull.tar)
;;   SRC_CA_CERT_URL   raw URL of the pinned CA/leaf cert (PEM); fetched once.
;;                     Default "" = skip CA trust entirely (plain copy — the
;;                     original behavior, correct for a publicly-trusted
;;                     source registry like GHCR). Set it to the committed
;;                     zot-ca.crt URL to pin the self-signed zot when the
;;                     SOURCE is zot itself.
;;   SRC_CA_CERT_DIR   local dir the fetched cert is written into + handed to
;;                     skopeo's --src-cert-dir (default /tmp/zot-pull-certs).
;;   SRC_CA_CERT_TOKEN GitHub token with read access to SRC_CA_CERT_URL's
;;                     repo — REQUIRED when that repo is private (the default
;;                     URL points at the private pleme-io/akeyless-k8s; an
;;                     unauthenticated raw fetch 404s). Empty keeps the
;;                     unauthenticated path (public cert URL).
;;   SRC_INSECURE      fall back to --src-tls-verify=false if the cert fetch
;;                     fails (default "false").
;;
;; Outputs: pulled ("true"|"false")
;; Exit: 0 on a successful pull; 1 (hard fail) on a pull failure OR a
;; refused-unverified-connection — a faucet that can't even see the bytes it
;; is supposed to gate must never let anything through, so this action's
;; later steps are gated on this one succeeding first (action.yml's default
;; step ordering: a non-continue-on-error failure here skips scan + verdict
;; entirely).

;; ── pure helpers (mirrors zot-push's fetch-CA shape) ──────────────
;; Build the curl argv for fetching the pinned CA cert. A bare
;; `Authorization: token <PAT>` header IS honored by raw.githubusercontent.com
;; for private repos (same as zot-push) — an empty token keeps the original
;; unauthenticated path, a non-empty one adds the header.
(define
  (pull:ca-cert-curl-args url path token)
  (if
    (equal? token "")
    (list "curl" "-sL" "-f" "-o" path url)
    (list "curl" "-sL" "-f" "-H" (string-append "Authorization: token " token) "-o" path url)))

;; Fetch the pinned CA cert to a local path via curl (always present on
;; these runners — this action's own loader already relies on it). Returns
;; the path on success, "" on failure (an honest miss, not a silent lie).
(define
  (pull:fetch-ca-cert url path token)
  (let
    ((r (apply exec-capture (pull:ca-cert-curl-args url path token))))
    (if (= (status-of r) 0) path "")))

;; skopeo copy docker://<ref> -> docker-archive:<dest>. `--insecure-policy`
;; is a GLOBAL flag (before the subcommand); `--src-cert-dir` /
;; `--src-tls-verify` are `copy` flags (after it, scoping the SOURCE).
;; cert-dir non-empty => pin the fetched CA; else insecure => skip verify;
;; else plain (publicly-trusted source). Auth to the zot registry is a
;; pre-condition (the consumer workflow logs in before this action runs).
(define
  (pull-image ref dest cert-dir insecure user pass)
  (let*
    ;; doca (oci-push), NOT skopeo. `doca pull` IS registry ->
    ;; docker-archive, with the same three concerns this action already
    ;; had: a pinned CA for a self-signed source, a TLS-verify escape
    ;; hatch, and per-call credentials. The flag names differ; the
    ;; semantics are 1:1.
    ;;
    ;; This also removes a HERMETIC SUPPLY CHAIN violation, not just a
    ;; foreign tool: the action used to run
    ;;   command -v skopeo || nix profile install …#skopeo
    ;; i.e. it INSTALLED a third-party binary at job time. We bake, we do
    ;; not install -- and doca arrives the way its already-converted
    ;; sibling zot-push gets it, via `nix run …#oci-push`, which is
    ;; content-addressed rather than an imperative mutation of the runner.
    ;;
    ;; One real difference to know: doca takes a PEM FILE, skopeo took a
    ;; DIRECTORY of *.crt. The caller's `src-ca-cert-dir` is where the
    ;; fetched cert is written, so the file inside it is what we hand over.
    ((tls-args
       (cond
         ((not (equal? cert-dir ""))
           (list "--dest-ca-cert" (path-join cert-dir "src-ca.crt")))
         (insecure (list "--insecure"))
         (else (list))))
      ;; Credentials ONLY when a username is supplied, so a public source
      ;; (GHCR) keeps the anonymous path. Without this an authenticated
      ;; registry rejects the pull outright -- which is exactly how this
      ;; action failed for as long as it had no credential input at all.
      ;; ── CREDENTIALS GO VIA ENV, NEVER ARGV. ──────────────────────────────
      ;; This used to append `--user <u> --pass <p>`. A command line is
      ;; world-readable: /proc/<pid>/cmdline and `ps` expose it to every process
      ;; on the runner, and GitHub's log masking does not cover the process
      ;; table. The credential here is a GHCR token with read access to private
      ;; pleme-io packages, on a shared ARC pool.
      ;;
      ;; doca reads the same values from INPUT_USER / INPUT_PASS (its
      ;; INPUT_<FLAG_UPPER_UNDERSCORE> convention), exported as step env by
      ;; action.yml. Env is readable only by the same uid; cmdline is readable
      ;; by anyone on the box.
      ;;
      ;; Empty is safe: doca's `env_input` filters empty strings, so an unset or
      ;; blank INPUT_USER is None rather than Some(""), and the anonymous path
      ;; for a public source is unchanged.
      (cred-args (list))
      ;; Clear DEST first. `docker-archive:` opens an existing path read-write
      ;; to APPEND another image, so a pre-existing dest is not overwritten --
      ;; and when that dest is a `nix build` out-link, the open fails outright:
      ;;
      ;;   initializing destination docker-archive:.../result: opening file
      ;;   ".../result": permission denied
      ;;
      ;; which is exactly what the camelot faucet hit, because its dest is
      ;; deliberately the same path nix-build wrote (so everything downstream
      ;; attests the bytes Zot actually returned, not the local build). The
      ;; symlink points into the read-only store, so skopeo can never open it.
      ;;
      ;; Unlinking is also the honest semantic: the faucet's whole claim is
      ;; that what ships is what Zot holds, and appending to whatever was
      ;; already there would quietly break that.
      (_cleared (exec-capture "rm" "-f" dest))
      ;; ── BAKED FIRST, `nix run` ONLY AS FALLBACK (2026-07-31) ──────────────
      ;; ★★ HERMETIC SUPPLY CHAIN + the operator's "we bake, we don't install":
      ;; a baked `oci-push` on PATH is used directly, and `nix run` is reached
      ;; for only when there is none.
      ;;
      ;; THIS IS NOT A PREFERENCE, IT IS A LIVE OUTAGE FIX. hardened-images run
      ;; 30648147453, mirror-hardened-clickhouse-to-zot:
      ;;
      ;;   ERROR doca pull: Stack size hard limit is 10485760, which is less
      ;;     than the desired 62914560 ...
      ;;   error: cannot connect to socket at
      ;;     '/nix/var/nix/daemon-socket/socket': No such file or directory
      ;;
      ;; Both lines are NIX's, not doca's, and they came from the nix
      ;; installer's own self-test, which had already FAILED for both sh and
      ;; bash (`WARN SelfTest([ShellFailed ...])`) and let the job continue.
      ;; So `nix run` had no daemon, doca never started, and an image that had
      ;; passed its CVE gate and been pushed could not be mirrored -- a 2F
      ;; blocker with no security meaning whatsoever.
      ;;
      ;; It is also the honest closure of this action's earlier hermetic fix.
      ;; Replacing `nix profile install ...#skopeo` with
      ;; `nix run github:pleme-io/substrate#oci-push` removed the *word* install
      ;; while keeping a job-time resolution of an UNPINNED @main ref -- the
      ;; violation changed shape rather than closing. A baked binary closes it.
      ;; Resolution + the source-note diagnostic live in the STDLIB
      ;; (oci:doca-baked / oci:doca-argv / oci:doca-source-note). This block used
      ;; to re-type all three; tlisp-lint Layer 5 correctly failed the duplicated
      ;; "(NOT baked ...)" literal, because a copy of a diagnostic string drifts
      ;; from its original and only one copy ever gets fixed.
      (args
        (append
          (oci:doca-argv "pull")
          (list "--ref" ref "--out" dest)
          tls-args
          cred-args))
      (_which (log-info (oci:doca-source-note)))
      (r (apply exec-capture args)))
    ;; Surface skopeo's OWN stderr on failure. Returning a bare status threw
    ;; the reason away, so a 401, a DNS miss and a TLS refusal were one
    ;; indistinguishable "skopeo pull failed" line -- which is exactly how an
    ;; unauthenticated pull looked for as long as this action has existed.
    ;; ── REPORT EXIT CODE + BOTH STREAMS (2026-07-31) ──────────────────────
    ;; Logging stderr alone was not enough, and a real run proved it. On
    ;; hardened-images run 30658995498 every mirror failed after ~2 minutes
    ;; having printed ONLY nix's own noise:
    ;;
    ;;   ERROR doca pull: warning: unknown setting 'build-provenance-tags'
    ;;   Stack size hard limit is 10485760, which is less than the desired ...
    ;;
    ;; Both are NIX WARNINGS. `nix run` floods stderr with them, so doca's
    ;; actual failure -- whatever it was -- was drowned and the operator was
    ;; left with a two-minute silence and a warning. That is the same
    ;; failure-is-illegible shape this block was written to fix, one layer in:
    ;; the fix surfaced stderr, and stderr turned out not to be where the
    ;; answer lives.
    ;;
    ;; Now: the EXIT CODE (which nix cannot pollute), plus stdout as well as
    ;; stderr, each labelled. A doca error printed to stdout, an empty-output
    ;; timeout, and a 401 are three different pictures and must not render the
    ;; same.
    (when
      (not (= (status-of r) 0))
      (log-error
        (string-append "doca pull FAILED, exit=" (string-format "{}" (status-of r))))
      (log-error (string-append "  stderr: " (string-trim (stderr-of r))))
      (log-error (string-append "  stdout: " (string-trim (stdout-of r))))
      (log-error
        (string-append
          "  ref=" ref " out=" dest
          " -- if both streams are empty the pull produced no diagnostic at all; "
          "check whether doca was reachable and whether the source needed credentials.")))
    (status-of r)))

;; The full public output contract this action must emit itself on a
;; terminal pull-side failure (the scan + verdict steps never run).
(define
  (emit-pull-failed dest)
  (append-output "pulled=false")
  (append-output (string-append "local-archive=" dest))
  (append-output "admitted=false")
  (append-output "severity=none")
  (append-output "vuln-count=0")
  (append-output "result=pull-failed"))

(define
  (main)
  (let*
    ((ref (env-required "REF"))
      (dest (env-get "DEST" "zot-pull.tar"))
      ;; Default "" => opt-out (plain copy). Non-empty => fetch + pin, so
      ;; the self-signed-zot-source case is opt-in and the GHCR-source
      ;; consumers (vendor-image-mirror) are unaffected.
      (ca-cert-url (env-get "SRC_CA_CERT_URL" ""))
      (ca-cert-dir (env-get "SRC_CA_CERT_DIR" "/tmp/zot-pull-certs"))
      (ca-cert-token (env-get "SRC_CA_CERT_TOKEN" ""))
      (allow-insecure (oci:flag-true? (env-get "SRC_INSECURE" "false")))
      (src-user (env-get "SRC_USER" ""))
      (src-pass (env-get "SRC_PASS" ""))
      ;; skopeo pins a DIR of certs; the CA file must live inside it.
      (ca-cert-path (string-append ca-cert-dir "/zot-ca.crt"))
      ;; When SRC_CA_CERT_URL is empty the consumer opted out of CA trust
      ;; (public source registry) -> keep the original plain-copy path.
      (fetched
        (if
          (equal? ca-cert-url "")
          ""
          (begin
            (exec-capture "mkdir" "-p" ca-cert-dir)
            (pull:fetch-ca-cert ca-cert-url ca-cert-path ca-cert-token))))
      (effective-cert-dir (if (equal? fetched "") "" ca-cert-dir)))
    (cond
      ;; The CA was REQUESTED (non-empty URL) but couldn't be fetched, and no
      ;; insecure fallback is enabled -> refuse rather than pull over an
      ;; unverified/plaintext connection (matches zot-push).
      ((and (not (equal? ca-cert-url "")) (equal? fetched "") (not allow-insecure))
        (log-error
          "zot-pull-scan: could not fetch the pinned CA cert (SRC_CA_CERT_TOKEN may be required for the private default URL) and SRC_INSECURE fallback is not enabled -- refusing to pull over an unverified or plaintext connection")
        (emit-pull-failed dest)
        1)
      (else
        (when
          (and (not (equal? ca-cert-url "")) (equal? fetched ""))
          (log-info
            "::warning::zot-pull-scan: CA cert fetch failed, falling back to --src-tls-verify=false -- this is a real, tracked degradation, not silent"))
        (log-info (string-append "==> zot faucet: pull docker://" ref " -> " dest))
        (cond
          ((= (pull-image ref dest effective-cert-dir allow-insecure src-user src-pass) 0)
            (append-output "pulled=true")
            0)
          (else
            ;; "doca", not "skopeo": this line named the wrong tool for as long
            ;; as the puller has been doca, and it cost real diagnosis time --
            ;; the run-30658995498 failure read as "skopeo pull failed" directly
            ;; beneath doca's own "oci-push: pull failed", so the two lines
            ;; disagreed about which program had just run. A log that names a
            ;; component not in the closure sends the reader to the wrong layer;
            ;; here it pointed at skopeo credentials when the actual defect was
            ;; a caller that never requested credentials at all.
            (log-error (string-append "zot-pull-scan: doca pull failed for " ref))
            (emit-pull-failed dest)
            1))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — zot-pull-scan pull.tlisp helpers loaded; main skipped"))
  (else (exit (main))))
