;; cargo-publish-crate/run.test.tlisp — pins the classifier this action
;; dispatches over, run via tatara-script's --test mode by the tlisp-test
;; action (it prepends the stdlib + the sibling run.tlisp with TLISP_TEST=1).
;;
;; WHY THIS FILE EXISTS. cargo-publish-crate used to carry its OWN copy of
;; the publish-failure predicates. Because action.yml prepends the stdlib
;; BEFORE run.tlisp, those local copies were defined second and therefore
;; WON — and the local set had no conflict/403 predicate at all. So a
;; crates.io `403 … you don't seem to be an owner` fell through to the
;; catch-all and reported "publish failed with no recognizable retry
;; signature", hiding the actual remedy (the crate NAME is taken; rename).
;; pleme-io/tear sat red for a week on exactly that, hourly.
;;
;; The stdlib grew the 403 arm on 2026-07-17 citing `tear` BY NAME, so the
;; fix already existed and was merely shadowed. These tests exist so the
;; shadow can never grow back silently: they assert the real 403 log text
;; classifies as 'conflict, and that each other outcome keeps its own arm.

;; The verbatim crates.io refusal, as cargo prints it. This is the string
;; that must never again classify as 'failed.
(define
  tear-403-log
  (string-append
    "    Updating crates.io index\n"
    "   Packaging tear v0.1.8 (/home/runner/work/tear/tear/tear)\n"
    "   Uploading tear v0.1.8 (/home/runner/work/tear/tear/tear)\n"
    "error: failed to publish tear v0.1.8 to registry at https://crates.io\n"
    "\n"
    "Caused by:\n"
    "  the remote server responded with an error (status 403 Forbidden): "
    "this crate exists but you don't seem to be an owner. If you believe "
    "this is a mistake, perhaps you need to accept an invitation to be an "
    "owner before publishing.\n"))

(deftest
  "the tear 403 not-an-owner refusal classifies as 'conflict, never 'failed"
  (assert
    (equal? (classify-cargo-publish-outcome tear-403-log 101) 'conflict)
    "403 not-an-owner -> 'conflict (the rename trigger)")
  (assert
    (not (equal? (classify-cargo-publish-outcome tear-403-log 101) 'failed))
    "403 not-an-owner must NOT fall through to the catch-all")
  ;; The specific substring the stdlib keys on — pinned so a reword of the
  ;; predicate cannot silently stop matching the real cargo output.
  (assert
    (cargo-publish-conflict? tear-403-log)
    "the conflict predicate matches 'seem to be an owner'"))

(deftest
  "a zero status is 'published regardless of log noise"
  (assert (equal? (classify-cargo-publish-outcome "" 0) 'published) "status 0 -> 'published")
  (assert
    (equal? (classify-cargo-publish-outcome tear-403-log 0) 'published)
    "status dominates: a 0 exit is a publish even if the log looks scary"))

(deftest
  "every other outcome keeps its own arm (no arm swallows another)"
  (assert
    (equal?
      (classify-cargo-publish-outcome "error: crate version 0.1.8 is already uploaded" 101)
      'already-uploaded)
    "already-uploaded -> its own arm (idempotent success)")
  (assert
    (equal?
      (classify-cargo-publish-outcome
        "error: failed to get a 200 OK response, got 429 Too Many Requests"
        101)
      'rate-limited)
    "429 -> 'rate-limited (retryable)")
  (assert
    (equal?
      (classify-cargo-publish-outcome "error: no matching package named `meimei` found" 101)
      'dep-missing)
    "dep-missing -> 'dep-missing (deferred green)")
  (assert
    (equal?
      (classify-cargo-publish-outcome
        "error: could not compile `thing` due to 3 previous errors"
        101)
      'failed)
    "a genuine build failure still reaches 'failed"))

(deftest
  "'conflict is terminal — it must not be retried"
  ;; A 403 not-an-owner can never succeed on a later attempt, so the action
  ;; fails fast rather than burning the retry budget. Guarding the CLASS:
  ;; 'conflict is distinct from 'rate-limited, the one retryable outcome.
  (assert
    (not (equal? (classify-cargo-publish-outcome tear-403-log 101) 'rate-limited))
    "'conflict is not retryable"))

;; ────────────────────────────────────────────────────────────────
;; publish = false — the declared non-publisher
;; ────────────────────────────────────────────────────────────────
;; The remedy the 'conflict arm above RECOMMENDS (rename, or publish = false)
;; was itself unusable: cargo refuses a publish=false crate, no classifier arm
;; matches that refusal, and the run reds. These pin the preflight that makes
;; the recommended remedy actually safe to adopt.

(define
  bevy-fork-manifest
  (string-append
    "[package]\n"
    "name = \"bevy_scene\"\n"
    "version = \"0.19.0-dev\"\n"
    "publish = false\n"
    "edition = \"2024\"\n"
    "\n"
    "[dependencies]\n"
    "bevy_ecs = { path = \"../bevy_ecs\", version = \"0.19.0-dev\" }\n"))

(define
  ordinary-manifest
  (string-append
    "[package]\n"
    "name = \"shikumi\"\n"
    "version = \"0.1.437\"\n"
    "edition = \"2024\"\n"))

(deftest
  "publish = false is detected on the manifest, before cargo runs"
  (assert
    (manifest-declares-no-publish? bevy-fork-manifest)
    "a fork declaring publish = false is recognized as a declared non-publisher")
  (assert
    (not (manifest-declares-no-publish? ordinary-manifest))
    "a normal crate is NOT mistaken for a non-publisher"))

(deftest
  "the detector reads [package], not any section that mentions publish"
  ;; publish belongs to [package] alone. A key of the same name under another
  ;; table must not silently disable a real crate's release — that would be a
  ;; false GREEN, the exact class this action exists to remove.
  (assert
    (not
      (manifest-declares-no-publish?
        (string-append
          "[package]\n"
          "name = \"real\"\n"
          "version = \"1.0.0\"\n"
          "\n"
          "[package.metadata.release]\n"
          "publish = false\n")))
    "publish = false under [package.metadata.release] does not disable the crate")
  (assert
    (not
      (manifest-declares-no-publish?
        (string-append "[package]\n" "name = \"real\"\n" "# publish = false\n")))
    "a commented-out publish = false is not honoured"))

(deftest
  "publish = false outranks a structural blocker"
  ;; A fork carries versionless path deps and would trip the blocker preflight.
  ;; It never publishes, so those deps are irrelevant and the honest verdict is
  ;; the green skip — which is why run.tlisp checks this arm FIRST.
  (assert
    (manifest-declares-no-publish?
      (string-append
        "[package]\n"
        "name = \"bevy_render\"\n"
        "version = \"0.19.0-dev\"\n"
        "publish = false\n"
        "\n"
        "[dependencies]\n"
        "bevy_utils = { path = \"../bevy_utils\" }\n"))
    "a publish=false fork with a versionless path dep is still a clean skip"))

(deftest
  "an array field above `publish` does not end the [package] walk"
  ;; THE REGRESSION. Every fixture above put `publish` immediately after
  ;; `version`, so all four passed while the real thing was broken: run.tlisp
  ;; carried a local `line-is-section-header?` that called ANY line containing
  ;; `[` a section header, and it shadowed the stdlib's strict one. mado has
  ;; `categories = [...]` and `keywords = [...]` above `publish = false`, so
  ;; the walk ended at `categories` and the crate red-failed as structurally
  ;; unpublishable — having correctly declared it does not publish.
  ;;
  ;; This is mado's real manifest shape, field order included.
  (assert
    (manifest-declares-no-publish?
      (string-append
        "[package]\n"
        "name = \"mado\"\n"
        "version = \"0.1.102\"\n"
        "categories = [\"command-line-utilities\"]\n"
        "keywords = [\"terminal\", \"emulator\", \"gpu\"]\n"
        "publish = false\n"
        "\n"
        "[lib]\n"
        "name = \"mado\"\n"))
    "an array field above publish ended the [package] walk early")
  ;; The same shape must still find a real section boundary, or the fix would
  ;; have traded one silent misread for another.
  (assert
    (not
      (manifest-declares-no-publish?
        (string-append
          "[package]\n"
          "name = \"real\"\n"
          "keywords = [\"a\", \"b\"]\n"
          "\n"
          "[dependencies]\n"
          "publish = false\n")))
    "a publish=false OUTSIDE [package] was honoured — the walk no longer stops at all")
  ;; A comment mentioning a bracketed section is not a boundary either.
  (assert
    (manifest-declares-no-publish?
      (string-append
        "[package]\n"
        "name = \"x\"\n"
        "# see [lib] below for the library target\n"
        "publish = false\n"))
    "a comment naming [lib] ended the walk"))
