;; cargo-publish-crate/run.tlisp — publish a single Rust crate
;; to crates.io. Skips when (name, version) already exists.
;; Sleeps + retries on 429 rate-limit (max 20 retries).

;; `status-of` / `stdout-of` / `stderr-of` / `extract-quoted-value` are NOT
;; defined here either. They were, byte-identical to the stdlib's, which the
;; prepend then shadowed with an exact copy -- harmless until the day one side
;; is fixed and the other is not. That is precisely how
;; `line-is-section-header?` above became a live bug. Deleted rather than
;; allowlisted; see _tlisp-stdlib/shadow-gate.test.tlisp.

(define dry-run (env-get "DRY_RUN" "false"))

(define no-verify (env-get "NO_VERIFY" "true"))

(define max-retries 20)

(define gh-output (env-required "GITHUB_OUTPUT"))

(define (append-output line)
  (define prior (if (path-exists? gh-output) (read-file gh-output) ""))
  (write-file gh-output (string-append prior line "\n")))

;; -------------------------------------------------------------- ;;
;; Read package.name + version from Cargo.toml                     ;;
;; -------------------------------------------------------------- ;;

;; `line-is-section-header?` is DELIBERATELY NOT DEFINED HERE. It used to be,
;; as `(and (> (string-length line) 0) (string-contains? line "["))` — any line
;; containing a bracket. action.yml prepends the stdlib, so this local copy was
;; defined SECOND and WON, exactly the shadowing this file's header describes
;; for the publish-failure predicates. The stdlib's version is strict (the text
;; before the first `[` must be blank) precisely because the naive test was
;; already found to break `[package]` walks on manifests with array fields —
;; num-traits, and kazari on 2026-07-21.
;;
;; It silently broke the publish=false preflight: mado carries
;; `categories = [...]` and `keywords = [...]` above `publish = false`, so the
;; walker "left" [package] at the categories line and never saw the field. The
;; run then took the structurally-UNPUBLISHABLE arm and went red — for a crate
;; that had correctly declared it does not publish. Deleting the shadow is the
;; dedup the header called for; it also un-breaks `walk-for-field` below, which
;; would mis-read name/version on any manifest with an array above them.

(define (walk-for-field field lines in-section)
  (cond
    ((null? lines) "")
    ((string-contains? (car lines) "[package]") (walk-for-field field (cdr lines) #t))
    ((and in-section (line-is-section-header? (car lines))) "")
    ((and
       in-section
       (string-contains? (car lines) field)
       (string-contains? (car lines) "="))
      (extract-quoted-value (car lines)))
    (else (walk-for-field field (cdr lines) in-section))))

(define (read-field field)
  (if (path-exists? "Cargo.toml")
    (walk-for-field
      field
      (string-split (read-file "Cargo.toml") "\n")
      #f)
    ""))

;; -------------------------------------------------------------- ;;
;; Already-published check                                         ;;
;; -------------------------------------------------------------- ;;

(define (already-published? name version)
  (let*
    ((url (string-append "https://crates.io/api/v1/crates/" name "/" version))
      (r (exec-capture "curl" "-s" "-o" "/dev/null" "-w" "%{http_code}" url))
      (code-str (stdout-of r)))
    (equal? code-str "200")))

;; -------------------------------------------------------------- ;;
;; Build cargo publish argv                                        ;;
;; -------------------------------------------------------------- ;;

(define (publish-args)
  (let*
    ((base (list "publish"))
      (with-dry (if (equal? dry-run "true") (append base (list "--dry-run")) base)))
    (if (equal? no-verify "true")
      (append with-dry (list "--no-verify"))
      with-dry)))

(define (do-publish) (apply exec-capture (cons "cargo" (publish-args))))

;; -------------------------------------------------------------- ;;
;; Rate-limit + already-uploaded detection                         ;;
;; -------------------------------------------------------------- ;;

;; The local shadow classifier that used to live here is GONE — it is the
;; stdlib's `classify-cargo-publish-outcome` (stdlib.tlisp:271), which
;; action.yml already prepends (:33). The shadows were defined AFTER that
;; prepend, so they WON, and because the set had no conflict/403 predicate
;; at all, a crates.io `403 … you don't seem to be an owner` fell through
;; to the `else` arm and reported "publish failed with no recognizable
;; retry signature" — hiding the one thing the operator needed to know:
;; the crate NAME is taken by someone else and the remedy is a rename.
;;
;; The stdlib grew that exact arm on 2026-07-17 citing `tear` BY NAME
;; (stdlib.tlisp:228-231) — so the fix already existed and was merely
;; shadowed. This deletion is the dedup the removed comment called for,
;; and it closes the TODO it carried.

;; -------------------------------------------------------------- ;;
;; Outcome disposition — the GREEN/RED/RETRY policy, as a pure function ;;
;; -------------------------------------------------------------- ;;
;;
;; Split out of the try-loop's `cond` so it can be TESTED. While the policy
;; lived inline, the only thing a test could reach was the classifier — which
;; log text maps to which outcome symbol — and the classifier was never the
;; part that was wrong. `'dep-missing` was classified perfectly and then
;; dispatched to `exit 0`, so every test passed while the action reported
;; success without publishing anything.
;;
;; Three dispositions, total over the classifier's five outcomes:
;;   'green — the registry now holds this (name, version). Nothing to do.
;;   'retry — a transient the same run can outlast (rate limit).
;;   'red   — this run did not publish and re-running THIS action, unchanged,
;;            cannot change that.
;;
;; The rule that decides between 'green and 'red is not "was it our fault" but
;; "is the artifact on the registry". A deferral fails that test, and green is
;; a claim about the registry, not an apology for the build.
(define
  (publish-outcome-disposition outcome)
  (cond
    ((equal? outcome 'published) 'green)
    ((equal? outcome 'already-uploaded) 'green)
    ((equal? outcome 'rate-limited) 'retry)
    ((equal? outcome 'dep-missing) 'red)
    ((equal? outcome 'conflict) 'red)
    (else 'red)))

;; -------------------------------------------------------------- ;;
;; Try-loop                                                        ;;
;; -------------------------------------------------------------- ;;

(define (try-publish attempt)
  (cond
    ((>= attempt max-retries)
      (log-error "exceeded max retries")
      (append-output "shipped=false")
      (exit 1))
    (else
      (log-info (string-append "publish attempt " (string-format "{}" attempt)))
      (let*
        ((r (do-publish))
          (code (status-of r))
          (log (string-append (stdout-of r) "\n" (stderr-of r)))
          (outcome (classify-cargo-publish-outcome log code)))
        (cond
          ((equal? outcome 'published)
            (log-info "published successfully")
            (append-output "shipped=true")
            (exit 0))
          ((equal? outcome 'already-uploaded)
            (log-info "already published — treating as success")
            (append-output "shipped=true")
            (exit 0))
          ;; DEP MISSING — terminal RED here, deliberately, even though the
          ;; identical outcome is a green defer in rust-workspace-publish.
          ;;
          ;; The difference is that deferring is only honest when something
          ;; comes back. In rust-workspace-publish it does: that action runs a
          ;; multi-pass loop over the members, so a sibling missing on pass 1
          ;; is present on pass 3 once its own publish lands. THIS action
          ;; publishes ONE crate in ONE pass. There is no second pass, and
          ;; `cargo-auto-release.yml` is `on: workflow_call` with no schedule,
          ;; so nothing re-drives the repo when the dep finally lands. The
          ;; missing dep is by construction an EXTERNAL crate this run cannot
          ;; influence.
          ;;
          ;; So the old message — "this crate publishes once the dep lands" —
          ;; was a promise with no mechanism behind it, and `exit 0` made the
          ;; run green forever while the crate stayed absent from the registry.
          ;; Measured 2026-08-04: pleme-io/iac-forge run 30911832147 reported
          ;; SUCCESS with `iac-forge` 404 on crates.io, on exactly this arm —
          ;;
          ;;   [13:03:29] INFO publish attempt 1
          ;;   [13:03:31] INFO a dependency is not yet on crates.io — deferring (green)
          ;;
          ;; and that silence had in turn blocked pleme-io/caixa's release
          ;; ("no matching package named `iac-forge` found"), which blocked
          ;; engenho, which broke `nix run .#rebuild` fleet-wide. A green that
          ;; hides a missing artifact does not stay local.
          ;;
          ;; This is the same verdict the file already gives two lines below
          ;; for a structurally-unpublishable manifest, and for the same
          ;; reason: retrying cannot fix it, so say so out loud.
          ((equal? outcome 'dep-missing)
            (log-error
              "a dependency is not yet on crates.io, and nothing will re-drive this repo when it lands (this action is single-pass; the release workflow has no schedule). Fix: publish the dependency, then re-run this workflow.")
            (log-info log)
            (append-output "shipped=false")
            (append-output "deferred=true")
            (exit 1))
          ((equal? outcome 'rate-limited)
            (log-info "crates.io rate limit hit — sleeping 600s")
            (exec-capture "sleep" "600")
            (try-publish (+ attempt 1)))
          ;; NAME CONFLICT — the registry refused because this name is
          ;; taken (or owned by someone else): the crates.io 403
          ;; "you don't seem to be an owner". Retrying can NEVER succeed,
          ;; so fail fast with the remedy named instead of burning the
          ;; retry budget on an unrecoverable condition.
          ;;
          ;; Deliberately RED, not skipped-green: renaming a published
          ;; artifact's registry identity is an operator decision (the
          ;; fleet precedent is `pleme-dojo`, and `pleme-tear` was chosen
          ;; the same way), so this action states the remedy and stops
          ;; rather than auto-renaming behind the operator's back.
          ;; cargo-publish-each-member maps 'conflict to 'skip instead,
          ;; correctly — there, one member's taken name must not block its
          ;; siblings; here the conflicted crate IS the whole job.
          ((equal? outcome 'conflict)
            (log-error
              (string-append
                "crates.io refused the name '"
                name
                "' — it exists under a different owner. Retrying cannot fix this. "
                "Remedy: rename the [package] to `pleme-"
                name
                "` (keeping any [[bin]] name as-is so nothing operator-facing changes), "
                "then re-run. Fleet precedent: pleme-dojo, pleme-tear."))
            (log-info log)
            (append-output "shipped=false")
            (append-output "conflict=true")
            (exit 1))
          (else
            (log-error "publish failed with no recognizable retry signature")
            (log-info log)
            (append-output "shipped=false")
            (exit code)))))))

;; TLISP_TEST gate — same shape as `cargo-publish-each-member/run.tlisp:262-266`.
;; Under the test harness the definitions above are loaded but the main is
;; SKIPPED, so run.test.tlisp can drive the real functions without a
;; Cargo.toml, a registry, or a network. Without this gate the harness ran
;; the main and died on "package.name not found in Cargo.toml", which is
;; why this action had no tests at all.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(define name (if tlisp-test-mode "" (read-field "name")))

(define version (if tlisp-test-mode "" (read-field "version")))

;; Publishability preflight (the false-green seal): computed once, guarded so a
;; missing manifest degrades to "no blockers" (the name/version arms already
;; catch a missing Cargo.toml). See stdlib `manifest-publish-blockers`.
(define publish-blockers
  (if tlisp-test-mode
    (list)
    (manifest-publish-blockers (if (path-exists? "Cargo.toml") (read-file "Cargo.toml") ""))))

;; `publish = false` — a declared non-publisher. Green no-op, not a failure.
;; See stdlib `manifest-declares-no-publish?` for why cargo's own refusal
;; would otherwise land in the 'failed arm and red the run.
(define declares-no-publish
  (if tlisp-test-mode
    #f
    (manifest-declares-no-publish? (if (path-exists? "Cargo.toml") (read-file "Cargo.toml") ""))))

(cond
  (tlisp-test-mode
    (log-info "TLISP_TEST=1 — action loaded; main skipped (the test harness drives it)"))
  ;; Checked FIRST and deliberately: a crate that declares it does not publish
  ;; makes no registry claim, so no later arm is relevant to it — not a git dep
  ;; it will never ship, and not a name it will never upload. Stating the skip
  ;; out loud is the point; a silent no-op is the failure mode this whole action
  ;; exists to remove.
  (declares-no-publish
    (log-info
      (string-append
        "cargo-publish-crate: '"
        name
        "' declares publish = false — no registry claim to make; skipping (green)"))
    (append-output "shipped=true")
    (append-output "skipped-no-publish=true")
    (exit 0))
  ((equal? name "")
    (log-error "cargo-publish-crate: package.name not found in Cargo.toml")
    (append-output "shipped=false")
    (exit 1))
  ((equal? version "")
    (log-error "cargo-publish-crate: package.version not found in Cargo.toml")
    (append-output "shipped=false")
    (exit 1))
  ;; A git dep or a versionless path dep in a SHIPPED table makes this crate
  ;; permanently unpublishable to crates.io. Caught before the publish attempt,
  ;; it red-fails LOUDLY with the exact offending dep — instead of a cryptic late
  ;; failure (or, for a workspace sibling, a dep-missing defer that goes GREEN
  ;; forever).
  ((not (null? publish-blockers))
    (log-error
      (string-append
        "cargo-publish-crate: '"
        name
        "' is structurally UNPUBLISHABLE — crates.io "
        "refuses git deps and versionless path deps in shipped tables. Blockers: "
        (string-join " | " publish-blockers)
        ". Fix: publish the dependency to crates.io and reference it by version "
        "(rename to pleme-io-<name> if the bare name is squatted)."))
    (append-output "shipped=false")
    (exit 1))
  ((already-published? name version)
    (log-info (string-append "skipping '" name "@" version "' — already on registry"))
    (append-output "shipped=true")
    (exit 0))
  (else (try-publish 1)))
