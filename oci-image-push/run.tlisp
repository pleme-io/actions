;; oci-image-push/run.tlisp — push a Nix-produced OCI image tarball.
;;
;; Pushes the local docker-archive to `<registry>/<image>:<tag>` with **doca**
;; (pleme-io/substrate's `oci-push`), the fleet's one container tool. skopeo is
;; gone from this path.
;;
;; ── WHY THE RETRY MOVED BEFORE THE CONVERSION ────────────────────────────────
;; The skopeo call this replaces carried `--retry-times 5`, and it was not
;; decoration: it was added against a MEASURED failure (2026-07-21, against a
;; remote Harbor registry) -- "writing blob: ... read: connection reset by
;; peer" partway through a ~40-blob rabbitmq image, after most blobs had already
;; uploaded. doca had NO retry at all.
;;
;; Converting first and noticing later would have silently regressed resilience
;; on precisely the path that pushes large hardened images to a remote Harbor,
;; i.e. the same registry the original incident was measured against.
;; So the retry landed in doca FIRST (substrate 8f2a136, three tests each with a
;; recorded red run), and only then did this call site move. doca's retry is
;; also strictly better than what it replaces: skopeo retried EVERY failure five
;; times, so a 401 slept through the whole budget before reporting the same
;; reason it had on attempt 1; doca retries only the registry interaction and
;; returns deterministic errors immediately.
;;
;; ── CREDENTIALS ──────────────────────────────────────────────────────────────
;; Unchanged contract: a prior `docker login` still works. doca resolves
;; explicit --dest-user/--dest-pass first, then INPUT_*, then AMBIENT
;; ~/.docker/config.json (and ~/.config/containers/auth.json) -- the same file
;; skopeo read, which is what makes this swap behavior-preserving for the
;; generated `substrate/lib/release/patterns*.nix` consumers that never pass
;; credentials at all.
;;
;; If NOTHING supplies credentials, doca fails with a missing-dest-user error
;; rather than pushing anonymously. That is deliberate: a silent anonymous WRITE
;; is worse than a loud failure, and it is the one behavior here that is
;; intentionally stricter than skopeo's.
;;
;; Inputs (env):
;;   REGISTRY    — e.g. "ghcr.io"
;;   IMAGE       — e.g. "pleme-io/pangea-operator"
;;   TAG         — image tag
;;   TARBALL     — local path to the Docker tarball (default "./result")
;;   USERNAME    — optional explicit registry user (else ambient docker login)
;;   PASSWORD    — optional explicit registry password/token
;;   DOCA_REF    — flake ref `nix run` resolves when doca is not baked
;;   FLAKE_REF   — (ignored; kept for input-compat)

;; INPUT_* (Docker mode) preferred; bare names retained as composite fallback.
(define registry (env-get "INPUT_REGISTRY" (env-get "REGISTRY" "")))

(define image (env-get "INPUT_IMAGE" (env-get "IMAGE" "")))

(define tag (env-get "INPUT_TAG" (env-get "TAG" "")))

(define tarball (env-get "INPUT_TARBALL" (env-get "TARBALL" "./result")))

(define user (env-get "INPUT_USERNAME" (env-get "USERNAME" "")))

(define pass (env-get "INPUT_PASSWORD" (env-get "PASSWORD" "")))

;; ── A SYSTEM TRUST STORE DOES NOT REACH doca. THIS IS NOT OPTIONAL POLISH. ───
;; skopeo used the host trust store, so a caller pushing to a self-signed
;; registry only had to run `update-ca-certificates` and skopeo picked it up.
;; doca CANNOT: its oci-client is built with `rustls-tls`, whose trust anchors
;; are the COMPILED-IN webpki set (`rustls-native-certs` is not in the lock).
;; doca's own source says so at cmd_list. So for a self-signed registry the CA
;; must be handed to doca as a FILE via --dest-ca-cert; installing it into
;; /usr/local/share/ca-certificates does nothing here.
;;
;; Caught before shipping rather than after: converting this action while
;; leaving the caller's "trust the CA system-wide" step in place would have
;; produced a TLS failure at the Zot push, with a workflow step named "Trust
;; Zot's CA" sitting green directly above it -- a preparation step that
;; succeeds and does not prepare anything for the tool that follows.
(define ca-cert (env-get "INPUT_CA_CERT" (env-get "CA_CERT" "")))

;; Plain HTTP / skip-verify escape hatch. Distinct from ca-cert: pinning a
;; specific self-signed cert is real verification, this is none.
(define insecure (env-get "INPUT_INSECURE" (env-get "INSECURE" "")))

(when (or (equal? registry "") (equal? image "") (equal? tag ""))
  (log-error "oci-image-push: missing INPUT_REGISTRY, INPUT_IMAGE, or INPUT_TAG")
  (exit 1))

(define target (string-append registry "/" image ":" tag))

;; Prefer a BAKED doca over `nix run`. A job-time `nix run` of an unpinned @main
;; ref is a hermetic-supply-chain violation AND, measured on hardened-images run
;; 30658995498, floods stderr with nix's own warnings so the tool's real error is
;; drowned.
;;
;; Resolution lives in the STDLIB (oci:doca-baked / oci:doca-argv /
;; oci:doca-source-note), called here rather than re-typed. This file used to
;; carry its own copy of all three, including the "(NOT baked ...)" diagnostic
;; string -- which tlisp-lint's Layer 5 correctly failed as a re-typed stdlib
;; literal: a predicate over a tool's diagnostic text belongs in one place, or
;; the copies drift and only one of them gets fixed.
;;
;; No local `doca-baked` binding: both call sites below now go through
;; oci:doca-argv / oci:doca-source-note, which resolve it themselves. Keeping one
;; here would be dead AND would spend an extra `command -v` subprocess at load.

;; ── CREDENTIALS GO VIA ENV, NEVER ARGV. ─────────────────────────────────────
;; This previously appended `--dest-user <u> --dest-pass <p>` to the command
;; line. A command line is world-readable on the host: /proc/<pid>/cmdline and
;; plain `ps` show it to every process on the runner. GitHub masks secrets in
;; LOG OUTPUT, which is a different thing entirely and gives no protection here.
;; On a shared ARC pool that is a real exposure of ZOT_PASSWORD, and it is one I
;; introduced earlier today when converting the Zot push away from an ambient
;; authfile -- before that change this action passed no secret at all.
;;
;; doca reads the same credentials from INPUT_DEST_USER / INPUT_DEST_PASS (its
;; documented `INPUT_<FLAG_UPPER_UNDERSCORE>` convention), which the composite
;; sets as step env. Env is not perfect -- /proc/<pid>/environ exists -- but it
;; is readable only by the same uid, whereas cmdline is world-readable.
;;
;; SAFE WHEN EMPTY, verified in doca's source rather than assumed: `env_input`
;; is `env::var(name).ok().filter(|s| !s.is_empty())`, so an empty
;; INPUT_DEST_USER is None, not Some(""). The ambient-docker-config fallback that
;; every generated patterns*.nix consumer relies on is therefore untouched.
(define cred-args (list))

(define tls-args
  (append
    (if (equal? ca-cert "")
      (list)
      (list "--dest-ca-cert" ca-cert))
    (if (equal? insecure "true")
      (list "--insecure")
      (list))))

(define base-args (oci:doca-argv "push"))

(log-info (oci:doca-source-note))

(log-info
  (string-append
    "pushing "
    tarball
    " -> "
    target
    (if (equal? user "")
      " (ambient credentials)"
      " (explicit credentials)")))

(define r
  (apply
    exec-capture
    (append
      base-args
      (list
        "--backend"
        "native"
        "--registry"
        registry
        "--image"
        image
        "--tag"
        tag
        "--tarball"
        tarball)
      cred-args
      tls-args)))

;; Report the EXIT CODE plus BOTH streams, each labelled. Returning a bare
;; status threw the reason away, and logging stderr alone was measurably not
;; enough: under `nix run`, nix's own warnings fill stderr and drown the tool's
;; actual error. A 401, a DNS miss, a missing tarball and an empty-output
;; timeout are four different pictures and must not render the same.
(when (not (= (status-of r) 0))
  (log-error
    (string-append "oci-image-push: doca push FAILED, exit=" (string-format "{}" (status-of r))))
  (log-error (string-append "  stderr: " (string-trim (stderr-of r))))
  (log-error (string-append "  stdout: " (string-trim (stdout-of r))))
  (log-error
    (string-append
      "  target="
      target
      " tarball="
      tarball
      " -- a missing-dest-user error here means NOTHING supplied credentials: "
      "no --dest-user, no INPUT_USERNAME, and no ambient docker login. doca "
      "refuses to push anonymously rather than writing under an identity nobody "
      "chose."))
  (exit (status-of r)))

(log-info (string-append "pushed " target))
