;; substrate-bump/run.tlisp — polymorphic bump driver.
;;
;; Detects the repo type by file presence and routes to the matching
;; per-repo flake app. The action's contract is uniform — `bumped` +
;; `new-version` get emitted to GITHUB_OUTPUT regardless of repo
;; type — so callers (substrate reusable workflows) compose the same
;; way for every repo flavour.
;;
;;   Ansible collection: galaxy.yml present → `.#bump` (mutates galaxy.yml)
;;   Ruby gem:           *.gemspec at root  → `.#gem:bump` (mutates lib/<name>/version.rb)
;;
;; Inputs (env):
;;   BUMP_TYPE      — patch | minor | major (default "patch")
;;   GITHUB_OUTPUT  — provided by GitHub Actions
;;
;; Outputs (appended as KEY=VALUE lines to $GITHUB_OUTPUT):
;;   bumped       true | false
;;   new-version  resulting version, or empty when bumped=false

(define bump-type (env-get "BUMP_TYPE" "patch"))

(define gh-output (env-get "GITHUB_OUTPUT" ""))

(define (append-output line)
  (define prior (if (path-exists? gh-output) (read-file gh-output) ""))
  (write-file gh-output (string-append prior line "\n")))

;; ---------------------------------------------------------------- ;;
;; Ansible collection — galaxy.yml as version source                ;;
;; ---------------------------------------------------------------- ;;

(define (ansible?) (path-exists? "galaxy.yml"))

(define (ansible-version) (let ((g (yaml-read "galaxy.yml"))) (or (alist-get g "version") "")))

(define (ansible-bump) (exec-check "nix" "run" ".#bump" "--" bump-type))

;; ---------------------------------------------------------------- ;;
;; Ruby gem — lib/<name>/version.rb as version source               ;;
;; ---------------------------------------------------------------- ;;

(define (find-gemspec)
  ;; Return the gem name (stem of <name>.gemspec) or "" if none.
  (let ((matches (glob "*.gemspec")))
    (if (null? matches)
      ""
      (string-replace
        (car matches)
        ".gemspec"
        ""))))

(define (gem-version-file gem-name)
  ;; Convention: lib/<gem-name>/version.rb. Kebab-case repo dir name.
  (string-append
    "lib/"
    gem-name
    "/version.rb"))

;; `extract-quoted-value` comes from the STDLIB. A byte-identical local copy
;; lived here and shadowed it (the prepend makes the later define win), which
;; Layer 4 baselined and Layer 5 then flagged as a re-typed diagnostic literal.
;; Deleted rather than re-baselined: the baseline file's own instruction is that
;; removing a row by deleting the copy is the tracked path to zero.

;; Ruby gems from the substrate ruby-gem-flake write `VERSION = %(0.1.0).freeze`
;; (percent-literal). The shared `extract-quoted-value` only understands " or '
;; quoting, so a %(...) line reads as "" on both the before and the after read
;; and the bump reports "no version change detected" despite forge writing the
;; file — no commit, no tag, no release. Extend locally, gem-scoped, and fall
;; back to the stdlib helper for the " and ' conventions (pangea-grafana).
(define (extract-gem-version line)
  (let ((pct (string-split line "%(")))
    (if (>= (length pct) 2)
      (car (string-split (car (cdr pct)) ")"))
      (extract-quoted-value line))))

(define (first-version-line ls)
  (cond
    ((null? ls) "")
    ((and (string-contains? (car ls) "VERSION") (string-contains? (car ls) "="))
      (extract-gem-version (car ls)))
    (else (first-version-line (cdr ls)))))

(define (read-gem-version gem-name)
  (let ((path (gem-version-file gem-name)))
    (if (not (path-exists? path))
      ""
      (first-version-line (string-split (read-file path) "\n")))))

;; `exec-capture`, not `exec-check`: the status alone cannot tell "the bump ran
;; and failed" from "the app this action assumes does not exist here", and those
;; need different messages to different people. Measured 2026-08-17: 20 of the
;; last 7 days' failures are the SECOND case, reported only as nix's
;; `does not provide attribute 'apps.x86_64-linux.gem:bump'`.
(define (gem-bump) (exec-capture "nix" "run" ".#gem:bump" "--" bump-type))

;; Pure, so it is testable: does this stderr say the app is ABSENT rather than
;; that the bump failed?
;;
;; WHY THIS IS A PRECONDITION AND NOT A BUG IN THE REPO. `find-gemspec` decides
;; "this is a gem" from a root `*.gemspec` and nothing else, but `.#gem:bump` is
;; provided only by substrate's ruby-gem builder (`lib/build/ruby/build.nix`).
;; A repo that is genuinely a gem AND hand-rolls its own flake `outputs`
;; therefore satisfies the detector and cannot satisfy the call — it fails 100%
;; of the time, by construction, and no retry or version arithmetic can help.
;; pangea-architectures is exactly this: `pangea-architectures.gemspec` at root,
;; a hand-written `outputs`, no `gem:bump` anywhere.
;;
;; NOTE the near-miss that makes this worth naming precisely: substrate ALSO
;; carries a `gem-bump` (hyphen) app in `lib/workspace/managed-flake.nix`, with
;; a different arity (`<gem-name> <new-version>` positionally, not
;; `-- <bump-type>`). It is NOT this app and cannot serve this call. Confirming
;; that took reading both builders; do not "fix" a repo by wiring that one.
(define (gem-app-absent? stderr-text)
  (and (string-contains? stderr-text "does not provide attribute")
       (string-contains? stderr-text "gem:bump")))

;; ---------------------------------------------------------------- ;;
;; Release monotonicity                                             ;;
;; ---------------------------------------------------------------- ;;
;;
;; This action does not COMPUTE a version — it delegates the whole write
;; to the consumer repo's own flake app (`nix run .#bump` / `.#gem:bump`),
;; which seeds from the manifest and, like every other bumper before this
;; fix, knows nothing about the repo's tags. So a manifest that lags its
;; tags bumps into already-passed territory and the release walks BACKWARD
;; (937-repo census, 2026-07-27: 527 inverted tag pairs on linear history).
;;
;; TIER-HONEST, and weaker here than in the siblings. rust-workspace-bump
;; and cargo-bump SEED from max(manifest, released), so a backward version
;; is unnameable by the arithmetic. Here the arithmetic lives in another
;; repo's flake, so the honest ceiling is a POST-CONDITION: let the
;; delegated bump run, then refuse to report success if what it produced
;; is not above the highest release. That is only-mitigated — a loud
;; Result::Err — and it is genuinely late: the flake app may already have
;; committed and tagged locally. It is still real protection, because both
;; consuming workflows (gem-auto-bump, ansible-collection-auto-bump) push
;; in a LATER step, and a non-zero exit here fails the job before
;; git-push-with-token ever runs — the bad tag never leaves the runner.
;;
;; Seeding this properly means teaching the substrate flake apps the same
;; invariant; that is a substrate change, deliberately not made from here.
(define (release-monotone-or-die! label after)
  (let ((max-released (git:max-released-version "v")))
    (cond
      ((semver:release-monotone? after max-released) #t)
      (else
        (append-output "bumped=false")
        (append-output "new-version=")
        (log-error
          (string-append
            label
            " produced version "
            after
            ", which is not above the highest already-released"
            " version v"
            max-released
            " — refusing (release-monotonicity guard). The flake"
            " app seeds from the manifest, so this means the"
            " manifest lags the tags: reconcile it to at least "
            max-released
            " and re-run."))
        (exit 1)))))

;; ---------------------------------------------------------------- ;;
;; Dispatch                                                         ;;
;; ---------------------------------------------------------------- ;;

;; TLISP_TEST gate — same shape as pull-request-gate. Under the harness the
;; definitions load but the dispatch is SKIPPED and the required env var is not
;; demanded, so run.test.tlisp can drive the pure extract surface with no flake
;; app, no nix and no network.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(cond
  (tlisp-test-mode (log-info "TLISP_TEST=1 — dispatch skipped (the harness drives the tests)"))

  (else
    (define gem-name (find-gemspec))
    (cond
      ;; Ansible collection path
      ((ansible?)
        (define before (ansible-version))
        (define status (ansible-bump))
        (cond
          ((= status 0)
            (let ((after (ansible-version)))
              (cond
                ((and (not (equal? after "")) (not (equal? after before)))
                  (release-monotone-or-die! "nix run .#bump" after)
                  (append-output "bumped=true")
                  (append-output (string-append "new-version=" after))
                  (log-info (string-append "ansible bump: " before " -> " after)))
                (else
                  (append-output "bumped=false")
                  (append-output "new-version=")
                  (log-info "no version change detected (ansible)")))))
          (else
            (append-output "bumped=false")
            (append-output "new-version=")
            (log-error
              (string-append "nix run .#bump failed with status " (string-format "{}" status)))
            (exit status))))

      ;; Ruby gem path
      ((not (equal? gem-name ""))
        (define before (read-gem-version gem-name))
        (define result (gem-bump))
        (define status (status-of result))
        (cond
          ((= status 0)
            (let ((after (read-gem-version gem-name)))
              (cond
                ((and (not (equal? after "")) (not (equal? after before)))
                  (release-monotone-or-die!
                    (string-append
                      "nix run .#gem:bump ("
                      gem-name
                      ")")
                    after)
                  (append-output "bumped=true")
                  (append-output (string-append "new-version=" after))
                  (log-info (string-append "gem bump (" gem-name "): " before " -> " after)))
                (else
                  (append-output "bumped=false")
                  (append-output "new-version=")
                  (log-info (string-append "no version change detected (gem " gem-name ")"))))))
          ;; The app is ABSENT — name the precondition, not nix's attribute
          ;; error, and say who has to change what. Left as a failure
          ;; deliberately: it IS misconfigured, and reporting bumped=false with
          ;; exit 0 would let a release proceed having bumped nothing.
          ((gem-app-absent? (stderr-of result))
            (append-output "bumped=false")
            (append-output "new-version=")
            (log-error
              (string-append
                "substrate-bump: this repo has " gem-name ".gemspec, so it was "
                "detected as a Ruby gem, but its flake exposes no `.#gem:bump` "
                "app — so there is nothing here for this action to delegate to."))
            (log-error
              (string-append
                "  `.#gem:bump` comes from substrate's ruby-gem builder "
                "(lib/build/ruby/build.nix). A gem that hand-rolls its own "
                "flake `outputs` satisfies the gemspec detector and can never "
                "satisfy this call: it fails 100% of the time, by construction."))
            (log-error
              (string-append
                "  Fix at the REPO: build the flake with substrate's ruby-gem "
                "builder so `.#gem:bump` exists. Do NOT wire "
                "lib/workspace/managed-flake.nix's `gem-bump` (hyphen) — a "
                "different app with a different arity, and it is unwired."))
            (exit status))
          (else
            (append-output "bumped=false")
            (append-output "new-version=")
            (log-error
              (string-append "nix run .#gem:bump failed with status " (string-format "{}" status)))
            ;; Relay the child's own output. Without this the message above is
            ;; the ONLY thing a reader gets, which is the same swallowing that
            ;; left `ERROR cargo set-version failed` undiagnosable across 74
            ;; repos until cargo-bump started relaying stderr.
            (cond
              ((not (equal? (stderr-of result) ""))
                (log-error (string-append "nix run .#gem:bump stderr: " (stderr-of result)))))
            (cond
              ((not (equal? (stdout-of result) ""))
                (log-info (string-append "nix run .#gem:bump stdout: " (stdout-of result)))))
            (exit status))))

      ;; Unknown repo type — fail loudly so misconfiguration surfaces
      (else
        (append-output "bumped=false")
        (append-output "new-version=")
        (log-error "substrate-bump: repo type not detected (no galaxy.yml, no *.gemspec)")
        (exit 1)))))
