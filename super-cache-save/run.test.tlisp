;; super-cache-save/run.test.tlisp — (deftest …) smoke for the pure
;; helpers + the write-if-absent local object tier, run via
;; tatara-script --test by the tlisp-test action (TLISP_TEST=1 gates main).

(deftest "save-key prefers an explicit key over the spec-path"
  (assert (equal? (save-key "explicit" "/nonexistent.json") "explicit") "explicit key wins")
  (assert (equal? (save-key "" "/nonexistent.json") "") "no key + absent spec => empty")
  (assert (equal? (save-key "" "") "") "no key + no spec => empty"))

(deftest "save-to-local is write-if-absent: persists once, then idempotently skips"
  (define dir "/tmp/scache-save-test")
  (exec-capture "rm" "-rf" dir)
  (exec-capture "mkdir" "-p" dir)
  (assert
    (equal? (save-to-local dir "k1" "/nix/store/aaa /nix/store/bbb") "written")
    "first write => written")
  (assert (path-exists? (supercache:local-entry-path dir "k1")) "entry landed on disk")
  (assert
    (equal? (save-to-local dir "k1" "/nix/store/aaa /nix/store/bbb") "already-present")
    "second save => idempotent skip")
  (assert
    (equal? (save-to-local dir "k1" "DIFFERENT") "already-present")
    "content-addressed skip does not overwrite"))

(deftest "token->store-path extracts the /nix/store path, dropping any arch: prefix"
  (assert
    (equal? (token->store-path "amd64:/nix/store/xyz-img.tar.gz") "/nix/store/xyz-img.tar.gz")
    "arch:path => path")
  (assert
    (equal? (token->store-path "/nix/store/abc-hello") "/nix/store/abc-hello")
    "bare store path unchanged")
  (assert (equal? (token->store-path "not-a-store-path") "") "non-store token => empty")
  (assert (equal? (token->store-path "") "") "empty token => empty"))

(deftest "the persisted entry round-trips the exact output list"
  (define dir "/tmp/scache-save-roundtrip")
  (exec-capture "rm" "-rf" dir)
  (exec-capture "mkdir" "-p" dir)
  (save-to-local
    dir
    "k2"
    "/nix/store/ccc")
  (assert
    (equal? (string-trim (read-file (supercache:local-entry-path dir "k2"))) "/nix/store/ccc")
    "restore reads back what save wrote"))

(deftest
  "flake-inputs->list parses a space/comma node-name list, dropping empties (the WARM lever push half)"
  (assert (equal? (flake-inputs->list "akeyless-main-repo") (list "akeyless-main-repo")) "single")
  (assert
    (equal? (flake-inputs->list "akeyless-main-repo nixpkgs") (list "akeyless-main-repo" "nixpkgs"))
    "space list")
  (assert
    (equal? (flake-inputs->list "akeyless-main-repo,nixpkgs") (list "akeyless-main-repo" "nixpkgs"))
    "comma list")
  (assert
    (equal?
      (flake-inputs->list "akeyless-main-repo, nixpkgs")
      (list "akeyless-main-repo" "nixpkgs"))
    "comma+space")
  (assert (null? (flake-inputs->list "  ")) "whitespace-only => empty")
  (assert (null? (flake-inputs->list "")) "empty => empty"))

;; ── the build-closure push (the leverage change) ─────────────────

(deftest "supercache:store-hash pulls the hash out of a store path"
  (assert
    (equal? (supercache:store-hash "/nix/store/08p3rzfazaxq3wif2iym1x5imxv4byfg-hardened-rabbitmq.tar.gz")
            "08p3rzfazaxq3wif2iym1x5imxv4byfg")
    "hash is the basename's first '-' segment")
  (assert (equal? (supercache:store-hash "") "") "empty path => empty hash"))

(deftest "supercache:presence-of rejects an unknown value instead of defaulting it"
  (assert (equal? (supercache:presence-of "required") "required") "required")
  (assert (equal? (supercache:presence-of "best-effort") "best-effort") "best-effort")
  (assert (equal? (supercache:presence-of "off") "off") "off")
  (assert (equal? (supercache:presence-of "") "best-effort") "unset => best-effort")
  ;; The point of the whole field: a TYPO must never quietly mean best-effort,
  ;; because "sui is required here" silently becoming "use it if you feel like
  ;; it" is exactly the failure this is meant to make impossible.
  (assert (equal? (supercache:presence-of "requried") "invalid") "typo => invalid, NOT a default"))

(deftest "supercache:nix-conf-for emits trusted-keys, never a global require-sigs=false"
  (define conf (supercache:nix-conf-for "http://sui.camelot-build.svc" "camelot-sui-1:AAAA"))
  (assert (string-contains? conf "extra-substituters = http://sui.camelot-build.svc") "substituter line")
  (assert (string-contains? conf "extra-trusted-public-keys = camelot-sui-1:AAAA") "trusted key line")
  ;; require-sigs=false disables signature checking GLOBALLY, including for
  ;; cache.nixos.org. sui-cache signs at ingest, so the narrow statement is
  ;; strictly stronger and this must never regress to the blunt one.
  (assert (not (string-contains? conf "require-sigs")) "never disables signature checking globally")
  (assert (string-contains? conf "fallback = true") "fallback travels WITH the substituter")
  (assert (equal? (supercache:nix-conf-for "" "camelot-sui-1:AAAA") "") "no endpoint => no config at all")
  (define nokey (supercache:nix-conf-for "http://sui" ""))
  (assert (not (string-contains? nokey "extra-trusted-public-keys")) "no key => no empty key line"))

(deftest "paths-for-scope falls back to the single output path for an unknown scope"
  (assert
    (equal? (paths-for-scope "output-only" "/nix/store/aaa-x") (list "/nix/store/aaa-x"))
    "unknown scope degrades to the legacy single-path behaviour, never to empty"))

(deftest "resolve-result-link returns empty for an empty link rather than guessing"
  (assert (equal? (resolve-result-link "") "") "empty in => empty out"))

(deftest "an unresolvable build closure degrades to the output path, never to nothing"
  ;; The upgrade must be strictly-never-worse: a caller that pushes one path
  ;; today must not silently push zero after this lands.
  (assert
    (equal? (with-output-fallback (list) "/nix/store/aaa-x") (list "/nix/store/aaa-x"))
    "empty closure => the single output path")
  (assert
    (equal? (with-output-fallback (list "/nix/store/bbb-y") "/nix/store/aaa-x")
            (list "/nix/store/bbb-y"))
    "a resolved closure is never overridden by the fallback"))
