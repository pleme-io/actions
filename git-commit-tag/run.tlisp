;; git-commit-tag/run.tlisp — configure bot identity, stage paths,
;; commit with template, create annotated tag. Does NOT push.

(define version (env-required "VERSION"))

(define tag-prefix (env-get "TAG_PREFIX" "v"))

(define template (env-get "COMMIT_MESSAGE_TEMPLATE" "release: workspace v{version}"))

(define add-paths-str (env-get "ADD_PATHS" "Cargo.toml Cargo.lock Cargo.nix Cargo.gen.lock"))

(define identity-name (env-get "IDENTITY_NAME" "github-actions[bot]"))

(define identity-email
  (env-get "IDENTITY_EMAIL" "41898282+github-actions[bot]@users.noreply.github.com"))

(define gh-output (env-required "GITHUB_OUTPUT"))

(define (append-output line)
  (define prior (if (path-exists? gh-output) (read-file gh-output) ""))
  (write-file gh-output (string-append prior line "\n")))

(define tag (string-append tag-prefix version))

(define commit-message (string-replace template "{version}" version))

;; ── ★ THE D2 CO-OUTPUTS ARE AN INVARIANT, NOT CALLER POLICY ─────────────
;; A bump that rewrote Cargo.lock ALSO regenerated Cargo.gen.lock and
;; Cargo.build-spec.json — `ensure-gen-lock-fresh` runs `gen build .` after
;; the version write, verifies the tie, and treats a tie it cannot restore
;; as fatal. Correct, and verified against the code.
;;
;; But the regen only exists ON DISK. Staging is whatever the caller named,
;; so a consumer that overrides ADD_PATHS and omits Cargo.gen.lock commits a
;; STALE tie with ZERO signal: the version write and Cargo.lock stage fine,
;; the commit succeeds, the tag lands, the push lands, the run is green —
;; and every Nix consumer of that workspace then hard-fails EVAL on
;; `lockfile-delta (D2)`, because the delta is keyed `<name>-<version>` and
;; a key miss silently falls back to `crateDefaults` (edition 2021, no
;; binaries). The tie is the only thing turning that misbuild into an error.
;;
;; MEASURED on engenho: Cargo.gen.lock is byte-identical across d2058c5 →
;; 41280e7 ("release: workspace v0.53.7"). It was never staged. Four laps of
;; break-then-hand-repin followed (v0.53.6, two re-pins, v0.53.7), and the
;; same shim shape is armed in tatara-rust-ast and wadachi.
;;
;; So union them in here rather than at each call site: this is the one
;; chokepoint every release reusable routes through, and fixing the
;; consumers is the whack-a-mole that has already been played four times.
;; Safe for the npm/python/helm/caixa reusables that also come through here
;; — staging is per-path under `exec-check`, which RETURNS the status rather
;; than raising, so a pathspec that is ignored (exit 1) or absent (exit 128)
;; fails alone and the commit proceeds.
;; Appended unconditionally rather than union'd: a repeated pathspec is a
;; harmless no-op for `git add`, and de-duplicating would mean reaching for
;; a list primitive this program does not define — the lint cannot see the
;; injected stdlib, so "probably bound" is not a basis for a change that
;; every release in the fleet routes through.
(define add-paths
  (append (string-split add-paths-str " ")
          (list "Cargo.gen.lock" "Cargo.build-spec.json")))

;; Configure bot identity for this repo (must succeed — a missing
;; identity makes the commit below fail in a more confusing way).
(exec-or-die (list "git" "config" "user.name" identity-name))

(exec-or-die (list "git" "config" "user.email" identity-email))

;; Tag-collision guard — checked BEFORE any mutation (fail fast).
;; `git tag -a <existing>` fails, but exec-check returns that non-zero
;; code rather than raising, so the old bare call swallowed it and the
;; stale, pre-existing tag got pushed (the 2026-06-03 version-skew
;; bug). Refuse to release onto an existing tag; the operator must
;; reconcile the workspace version against it first.
(when (git-tag-exists? tag)
  (log-error
    (string-append
      "tag "
      tag
      " already exists — refusing to "
      "release onto an existing tag (version-skew "
      "guard). Reconcile the workspace version "
      "against the existing tag before releasing."))
  (exit 1))

;; MONOTONICITY guard — checked BEFORE any mutation, alongside the
;; collision guard above, because the two answer DIFFERENT questions and
;; only one of them was ever asked here.
;;
;; The guard above asks "is this exact tag TAKEN?". That is a same-line
;; collision check: it refuses v0.2.6 when v0.2.6 exists, and waves
;; through v0.2.6 when the repo's highest release is v0.3.1 — because
;; v0.2.6 is, indeed, free. So a release could walk BACKWARD along
;; strictly linear history and every gate in the pipeline stayed green.
;; Measured 2026-07-27 over a 937-repo census: 527 inverted tag pairs
;; confirmed by exact `git merge-base --is-ancestor`, 4 of them produced
;; by pleme-io's own shared bumpers, worst `engenho` v0.53.0 -> v0.1.5
;; across 307 commits with zero merges.
;;
;; This guard asks the question that was missing: "is this version ABOVE
;; everything already released?" It is the LAST line before a tag object
;; exists, and it is the one line every routing path crosses — verified
;; 2026-07-27: all 7 substrate reusables that cut a version tag
;; (cargo-, rust-, rust-binary-, npm-, python-, helm-, caixa-auto-release)
;; reach the tag through THIS action, and zero repos in the org call any
;; bumper directly. Fixing the seed upstream (the bumpers) is the real
;; correction; this is the backstop that turns a silent regression into a
;; red CI run no matter which bumper, or which future bumper, fed it.
;;
;; TIER-HONEST: a runtime `exit 1` is ONLY-MITIGATED — a loud
;; Result::Err at release time, not an unrepresentable state. The
;; parse-time-rejected tier lives upstream in the bumpers, where
;; `semver:bump-seed` makes a below-max version unreachable by the
;; arithmetic rather than caught after the fact. Both ship; neither is
;; rounded up to the other.
;;
;; Fail-closed on an unrankable VERSION is deliberate and measured: every
;; bumper feeding this action emits a bare X.Y.Z, and zero repos on this
;; routing path release pre-release or 4-segment versions (the org's one
;; such tag, typemill's v0.8.18-pleme.1, is a vendor fork that does not
;; route here). An unrankable version arriving from a pleme-io bumper is
;; itself the defect, so surfacing it is the point.
(define max-released (git:max-released-version tag-prefix))

(when (not (semver:release-monotone? version max-released))
  (log-error
    (string-append
      "refusing to release "
      tag
      " — version "
      version
      " is not ABOVE the highest already-released version "
      tag-prefix
      max-released
      " (release-monotonicity guard). Releasing it would walk the"
      " published version BACKWARD. This almost always means the"
      " manifest version lags the tags: reconcile the manifest to"
      " at least "
      max-released
      " and re-run."))
  (exit 1))

(when (equal? max-released "")
  (log-info
    (string-append
      "no rankable "
      tag-prefix
      "X.Y.Z tag yet — "
      "first release, monotonicity vacuously holds")))

;; Stage each path SEPARATELY. `git add a b c` fails ATOMICALLY if ANY
;; pathspec doesn't match an existing file — e.g. `Cargo.nix` in a repo
;; that doesn't use crate2nix, or `Cargo.lock` in some layouts: git
;; prints `fatal: pathspec '…' did not match any files`, exits 128, and
;; stages NOTHING. That left rust-workspace-bump's version write
;; unstaged → an empty commit (`git commit` → "nothing to commit") →
;; the annotated tag landed on the UN-BUMPED HEAD and the published
;; version never advanced (the 2026-06-03 never-advancing-version bug;
;; root-caused via a faithful local repro). Per path, a missing optional
;; file fails on its own — exec-check returns the status without raising
;; — and the existing paths (Cargo.toml, Cargo.lock when present) still
;; stage.
(for-each (lambda (p) (exec-check "git" "add" p)) add-paths)

;; Commit. exec-check RETURNS the exit code (it does NOT raise on a
;; non-zero child), so a bare call would silently proceed to tagging
;; even when the commit failed — e.g. an empty commit because nothing
;; staged — landing the tag on an un-bumped HEAD (the 2026-06-03
;; version-skew bug). exec-or-die aborts loudly instead.
(exec-or-die (list "git" "commit" "-m" commit-message))

;; Annotated tag — must succeed, else the release ships without its tag.
(exec-or-die (list "git" "tag" "-a" tag "-m" commit-message))

(append-output (string-append "tag=" tag))

(log-info (string-append "committed + tagged " tag))
