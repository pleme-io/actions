;; registry-login/run.tlisp — resolve an OCI-registry credential from the
;; typed fallback (BOT_PAT > GHCR_TOKEN > GITHUB_TOKEN) and log the chosen
;; client (helm | docker) into the registry.
;;
;; This factors the token-resolution that every publish reusable used to
;; hand-repeat as a `${{ secrets.BOT_PAT || secrets.GHCR_TOKEN || ... }}`
;; expression into ONE tlisp overlay — the priority order lives here, once,
;; instead of drifting across helm-monorepo-auto-release.yml /
;; image-push.yml / nix-image-auto-release.yml. (Org directive: "instead of
;; || do overlays of yaml"; PRIME DIRECTIVE — duplication is a bug.)
;;
;; BOT_PAT is preferred because it carries write:packages on the org-shared
;; ghcr.io/pleme-io/* namespace; a repo-scoped GITHUB_TOKEN 403s on
;; cross-namespace OCI push. On the Free plan BOT_PAT only reaches PUBLIC
;; repos, so a private caller passes it empty and the fallback lands on
;; GITHUB_TOKEN — the two approved tracks, expressed once.
;;
;; Password is passed as an arg (GitHub masks registered secret values),
;; matching the proven skopeo-login shape.
;;
;; Inputs (env): REGISTRY, CLIENT (helm|docker), USERNAME,
;;               BOT_PAT, GHCR_TOKEN, GITHUB_TOKEN
;; Outputs: result=true|false (forwarded by tatara-script; surfaced as the
;;          action's `logged-in` output). The real product is the login
;;          SIDE-EFFECT on the runner's credential store, which the caller's
;;          publish step consumes.

(define (rl:nth lst i) (cond ((= i 0) (car lst)) (else (rl:nth (cdr lst) (- i 1)))))

;; oci://ghcr.io/pleme-io/charts -> ghcr.io ; ghcr.io -> ghcr.io
;; A scheme (contains "://") splits to (scheme: "" host ...); the host is
;; the 3rd dot-split part. A bare host splits to (host) — take the first.
(define (rl:host r)
  (let ((parts (string-split r "/"))) (if (string-contains? r "://") (rl:nth parts 2) (car parts))))

;; ── ★ THE LADDER — ordered candidates, tried until one LOGS IN ─────────
;; Superseded `rl:pick`, which returned the first NON-EMPTY credential and
;; then treated that one credential's login failure as terminal. Two defects
;; in one line, and the fleet has now paid for this exact shape three times:
;;
;;   1. SELECTION BY PRESENCE, NOT CAPABILITY. A dead-but-present BOT_PAT beat
;;      a working GITHUB_TOKEN. Measured 2026-08-22: `github/classic` sat dead
;;      for weeks while every consumer asked "is a credential configured?"
;;      instead of "does it work?".
;;   2. NO FALL-THROUGH. `rl:fail` exits 1, so rung 2 was unreachable whenever
;;      rung 1 existed at all. A ladder whose lower rungs cannot be reached is
;;      not a fallback, it is a single point of failure with extra inputs.
;;
;; A rung is now skipped when ABSENT (quietly — a private-repo caller
;; legitimately passes BOT_PAT empty) and when it FAILS TO LOG IN (loudly).
;;
;; ★ AND THE RUNG THAT WON IS ANNOUNCED, ALWAYS — not only on fallback. A
;; silent fallback that always succeeds is precisely how a top rung dies
;; unnoticed.
(define (rl:label-of pair) (car pair))
(define (rl:token-of pair) (car (cdr pair)))

;; Candidates in priority order, absent ones dropped.
(define (rl:candidates)
  (filter
    (lambda (p) (not (equal? (rl:token-of p) "")))
    (list
      ;; ★ Rung 1 — a GitHub App installation token (`ghs_`), minted per job
      ;; from a key that never expires. PROVEN 2026-08-22 to authenticate to
      ;; ghcr.io, contradicting GitHub's own docs which name only classic PATs:
      ;; anonymous /v2/ 401, garbage bearer 403, App token 200. It is preferred
      ;; because its authority is bounded by INSTALLATION rather than by the
      ;; scopes of some human's account.
      (list "app-token" (env-get "APP_TOKEN" ""))
      (list "bot-pat" (env-get "BOT_PAT" ""))
      (list "ghcr-token" (env-get "GHCR_TOKEN" ""))
      (list "github-token" (env-get "GITHUB_TOKEN" "")))))

(define (rl:fail reason)
  (log-error (string-append "registry-login: " reason))
  (append-output "result=false")
  (exit 1))

;; helm keeps its OWN registry config (~/.config/helm/registry/config.json);
;; docker/skopeo read ~/.docker/config.json. Pick the client whose store the
;; caller's publish step will consult. helm is fetched via `nix shell` (the
;; reusable installs Nix before this step).
(define (rl:login client host user token)
  (cond
    ((equal? client "helm")
      (exec-check
        "nix"
        "shell"
        "nixpkgs#kubernetes-helm"
        "--command"
        "helm"
        "registry"
        "login"
        host
        "--username"
        user
        "--password"
        token))
    (else (exec-check "docker" "login" host "--username" user "--password" token))))

;; Walk the ladder. Returns the winning label, or "" when every rung failed.
;; `first?` distinguishes "the preferred rung won" from "we degraded", because
;; those want different operator attention even though both publish fine.
(define (rl:try-rungs client host user rungs first?)
  (cond
    ((null? rungs) "")
    (else
      (let*
        ((label (rl:label-of (car rungs)))
          (r (rl:login client host user (rl:token-of (car rungs)))))
        (cond
          ((= r 0)
            (if first?
              (log-info (string-append "registry-login: rung `" label "` (preferred)"))
              (log-error
                (string-append
                  "registry-login: rung `"
                  label
                  "` IN USE — a higher-priority credential was present and FAILED to log in. Publishing continues, but fix the primary.")))
            label)
          (else
            (log-error
              (string-append
                "registry-login: rung `"
                label
                "` failed to log in (exit "
                (string-format "{}" r)
                ") — falling through"))
            (rl:try-rungs client host user (cdr rungs) #f)))))))

(define (main)
  (let*
    ((registry (env-required "REGISTRY"))
      (client (env-get "CLIENT" "docker"))
      (user (env-required "USERNAME"))
      (rungs (rl:candidates))
      (host (rl:host registry)))
    (cond
      ((null? rungs)
        (rl:fail "no credential — APP_TOKEN, BOT_PAT, GHCR_TOKEN and GITHUB_TOKEN are all empty"))
      ((equal? host "")
        (rl:fail (string-append "could not extract a host from registry '" registry "'")))
      (else
        (log-info (string-append "==> " client " registry login " host))
        (let ((won (rl:try-rungs client host user rungs #t)))
          (cond
            ((equal? won "")
              ;; Every rung that was PRESENT failed. Name them, because "no
              ;; credential supplied" and "every credential rejected" need
              ;; different responses and must never render the same.
              (rl:fail
                (string-append
                  client
                  " login failed on every supplied credential ("
                  (string-join ", " (map rl:label-of rungs))
                  ")")))
            (else (append-output "result=true") (exit 0))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — registry-login helpers loaded; main skipped"))
  (else (main)))
