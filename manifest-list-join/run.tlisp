;; manifest-list-join/run.tlisp — compose separately-pushed per-arch
;; images into ONE multi-arch OCI image index (manifest list) and push
;; it under the multi-arch deploy coordinate r<run>-<sha>. Reports the
;; index DIGEST — the single exact coordinate an environment pins.
;;
;; Part of the super-cache-ci MANIFEST leg (job 3). skopeo *copies*
;; single images; it does NOT *compose* an index from separately-pushed
;; per-arch digests — so this action drives a real manifest tool
;; (regctl `index create/add`, buildah|podman `manifest create/add/push`,
;; or `docker buildx imagetools`), auto-detected. It consumes the per-arch
;; refs that zot-push produced (amd64=<ref>,arm64=<ref>) and is attested
;; by cartorio-attest.
;;
;; doca (pleme-io/substrate#oci-push) is the fleet's OCI tool and is used
;; here for the digest readback — but doca has NO index-composition verb
;; (its subcommands are push/transfer/inspect/pull/list/resolve/tag/delete/
;; vendored-crates/config-show/harden-rootfs/unpack/crypto-version, read at
;; substrate/tools/oci-push/src/main.rs:3293-3305, 2026-08-08). So the
;; foreign manifest tool below is NOT a verbatim port of something doca
;; already covers; it is the one genuine gap. When doca grows `index
;; create`, this whole tool-selection block collapses into one doca call.
;;
;; TOOL PRIORITY (REVISED 2026-07-23): `mlj:select-tool` tries regctl
;; FIRST, then buildah/podman, then docker last. Root cause: the
;; cluster-internal Zot moved off plain HTTP onto real in-pod TLS
;; (self-signed, no cert-manager) 2026-07-18 -- see zot-push/run.tlisp's
;; header for the full story. This action's own INSECURE input/flag was
;; already a documented no-op for `docker buildx imagetools create`
;; (mlj:docker-join's own comment): it has no `--insecure`/`--tls-verify`
;; equivalent and defers entirely to the shared dind sidecar's daemon-
;; level trust config, which carries no entry for the Zot host or its
;; CA. buildah/podman's `--tls-verify=false` IS a real per-invocation
;; flag but only ever buys the (real, tracked) insecure fallback, never
;; a genuine CA-pinned verification. regctl is the one candidate tool
;; that is a standalone client accepting PER-REGISTRY trust config
;; without touching a shared daemon's global trust store -- so it is the
;; tool actually capable of honoring either the real CA-cert route or an
;; explicit insecure fallback here.
;;
;; ── HOW regctl IS OBTAINED (CHANGED 2026-08-08) ───────────────────────
;; action.yml used to carry an "Ensure regctl" bash step running
;;   command -v regctl >/dev/null 2>&1 || nix profile install …#regctl
;; — 11 lines of shell outside the canonical loader, and a ★★ HERMETIC
;; SUPPLY CHAIN violation of exactly the shape the skopeo step next to it
;; was deleted for on 2026-07-31: an imperative install of a third-party
;; binary at job time, MUTATING the runner's nix profile. Pinning the
;; channel makes the fetch reproducible; it does not make it hermetic, and
;; it does not stop the mutation.
;;
;; It is now resolved the way `oci:doca-argv` resolves doca: a BAKED
;; `regctl` on PATH wins, and `nix run <REGCTL_REF>` is the LOGGED
;; fallback (see `mlj:regctl-source-note`) so a job never silently takes
;; the weaker path. regctl is not preinstalled on the akeylesslabs camelot
;; ARC runner image (stock `ghcr.io/actions/actions-runner:latest` + dind
;; -- confirmed live 2026-07-23: no buildah/podman/regctl on PATH, only
;; the dind-sidecar `docker`), so the fallback is the live path there
;; today; baking regctl into that image closes it for real.
;;
;; The fallback got cheaper at the same time: regctl used to be invoked
;; THREE times (`registry set --cacert`, `registry set --tls`, `registry
;; login`, then `index create`). It is now invoked ONCE — see the
;; credential/trust section below.
;;
;; Tier: SHIPPABLE-NOW. Index composition is deterministic; the tag/base
;; algebra + arch/ref parsing are pure + unit-tested. The ONE runtime
;; dependency is a manifest tool reachable from the runner — if none is
;; the action FAILS loudly with reason=no-tool (never fakes an index
;; digest). Today the akeyless build is amd64-only, so a 1-arch join is a
;; DEGENERATE (but honest) index; it becomes load-bearing the moment
;; arm64-native lands (reason emits `single-arch` vs `joined`).
;;
;; Uses _tlisp-stdlib helpers (prepended by action.yml's loader):
;;   emit-output, status-of, stdout-of, stderr-of, oci:compose-base,
;;   oci:target-ref, oci:index-tag, oci:flag-true?, oci:doca-remote-digest,
;;   oci:doca-source-note, oci:split-registry, oci:fetch-ca-cert,
;;   hash:cmd-present?.
;;
;; Inputs (env):
;;   REGISTRY      cluster Zot host:port (default zot.zot-system.svc.cluster.local:5000)
;;   REPO          full base override "<host>/<repo>" (no tag); wins when set
;;   IMAGE         repo path override "<repo>" (with REGISTRY when REPO empty)
;;   SVC           akeyless service name; composes "akeyless-<svc>"
;;   ARCH_REFS     per-arch refs to join: "amd64=<ref>,arm64=<ref>"  (required)
;;   TAG           explicit index tag; else composed r<run>-<sha>
;;   RUN_NUMBER    github.run_number (for the composed index tag)
;;   SHA           github.sha        (for the composed index tag)
;;   INSECURE      cluster-internal Zot is http/self-signed (default "true") --
;;                 the CA-cert-fetch-FAILED fallback, never the first choice:
;;                 for regctl `tls: insecure` (HTTPS, verification skipped),
;;                 for buildah/podman a real per-invocation --tls-verify=false,
;;                 for the doca digest readback plain HTTP, and a documented
;;                 no-op for docker (see the TOOL PRIORITY note above).
;;   DEST_USER     registry push credential username                (required)
;;   DEST_PASS     registry push credential password                (required)
;;   TOOL          auto|regctl|buildah|podman|docker (default "auto")
;;   CA_CERT_URL   raw URL of the pinned CA/leaf cert (PEM); fetched once,
;;                 used by BOTH the regctl join and the doca digest readback
;;                 (default: the same committed cluster cert zot-push trusts)
;;   CA_CERT_PATH  local path the fetched cert is written to (default
;;                 /tmp/manifest-list-join-ca.crt — distinct from zot-push's
;;                 own default so one job step never clobbers the other's
;;                 cached fetch)
;;   CA_CERT_TOKEN a GitHub token with read access to CA_CERT_URL's repo --
;;                 REQUIRED when that repo is private (the default
;;                 CA_CERT_URL points at pleme-io/akeyless-k8s, which is
;;                 private). Empty (default) keeps the unauthenticated path
;;                 for a public cert URL.
;;   REGCTL_REF    flake ref `nix run` resolves when regctl is NOT baked
;;                 (default github:NixOS/nixpkgs/nixos-24.05#regctl — the same
;;                 exact-pinned channel the deleted install step used)
;;   DOCA_REF      read by the stdlib's oci:doca-argv, same shape
;;   RUNNER_TEMP   where the private credential directory is created
;;
;; Outputs (emit-output → GITHUB_OUTPUT):
;;   index-ref / index-digest / arches / joined / reason

;; ── pure helpers (unit-tested via run.test.tlisp) ────────────────
;; Split one "arch=ref" segment into (arch . ref). A segment with no
;; "=" is treated as a bare ref with an unknown ("") arch.
(define (mlj:split-pair s)
  (let ((parts (string-split s "=")))
    (cond
      ((>= (length parts) 2) (cons (string-trim (car parts)) (string-trim (car (cdr parts)))))
      (else (cons "" (string-trim s))))))

;; Parse a comma-separated "amd64=r1,arm64=r2" list into (arch . ref)
;; pairs, dropping empty segments.
(define (mlj:parse-pairs segs)
  (cond
    ((null? segs) (list))
    ((equal? (string-trim (car segs)) "") (mlj:parse-pairs (cdr segs)))
    (else (cons (mlj:split-pair (car segs)) (mlj:parse-pairs (cdr segs))))))

;; The refs (2nd element of each (arch ref) pair) in order. NOTE:
;; tatara-lisp `(cons a b)` on atoms yields the 2-element list `(a b)`,
;; so the ref is `(car (cdr pair))`, not `(cdr pair)`.
(define (mlj:refs-of pairs)
  (cond ((null? pairs) (list)) (else (cons (car (cdr (car pairs))) (mlj:refs-of (cdr pairs))))))

;; The known arches (non-empty cars), space-joined ("amd64 arm64").
(define (mlj:arches-list pairs)
  (cond
    ((null? pairs) (list))
    ((equal? (car (car pairs)) "") (mlj:arches-list (cdr pairs)))
    (else (cons (car (car pairs)) (mlj:arches-list (cdr pairs))))))

(define (mlj:arches-of pairs) (string-join " " (mlj:arches-list pairs)))

;; The multi-arch index tag: explicit TAG > composed r<run>-<sha> > "".
(define (mlj:resolve-tag tag-in run sha)
  (cond
    ((not (equal? (string-trim tag-in) "")) (string-trim tag-in))
    ((and (not (equal? run "")) (not (equal? sha ""))) (oci:index-tag run sha))
    (else "")))

;; The registry host a ref lives on: everything before the FIRST "/".
;; Same rule oci:split-registry applies to a composed base, and it holds
;; for a tagged ref ("h:5000/x:t") and a digest ref ("h:5000/x@sha256:…")
;; alike. A ref with no "/" at all (a bare Docker-Hub short name) yields
;; the whole string; this action's refs always come from zot-push and are
;; always fully qualified, and the only consequence would be one unused
;; entry in a private credential file.
(define (mlj:ref-host r) (car (string-split r "/")))

(define (mlj:member? lst x)
  (cond ((null? lst) #f) ((equal? (car lst) x) #t) (else (mlj:member? (cdr lst) x))))

(define (mlj:uniq lst)
  (cond
    ((null? lst) (list))
    (else
      (let ((rest (mlj:uniq (cdr lst))))
        (if (mlj:member? rest (car lst)) rest (cons (car lst) rest))))))

(define (mlj:ref-hosts refs)
  (cond ((null? refs) (list)) (else (cons (mlj:ref-host (car refs)) (mlj:ref-hosts (cdr refs))))))

;; Every registry host this join touches: the index target plus each
;; source ref's host. The OLD `--creds user:pass` / `docker login <host>`
;; wiring sent the SAME credential to whatever host each ref was on, so
;; enumerating the hosts and writing one entry per host reproduces that
;; behaviour exactly — it does not narrow it.
(define (mlj:hosts-of index-ref refs)
  (mlj:uniq (cons (mlj:ref-host index-ref) (mlj:ref-hosts refs))))

;; ── ★ CREDENTIALS NEVER TOUCH argv ────────────────────────────────
;;
;; THE DEFECT THIS CLOSES, and it was live on every one of the four tool
;; paths (found + closed 2026-08-08):
;;
;;   (exec-capture "docker" "login" host "--username" u "--password" p)
;;   (exec-capture "regctl" "registry" "login" host "--user" u "--pass" p …)
;;   (list "--creds" (string-append u ":" p))        ; buildah + podman
;;
;; `/proc/<pid>/cmdline` is mode 0444 — WORLD-READABLE — and `ps` shows
;; the same bytes to every user on the box. GitHub masks LOGS; it does not
;; mask the process table, and these runners are shared. The buildah/podman
;; form was the worst of the three: `--creds` was re-passed on every
;; `manifest add`, so the password appeared once per architecture.
;;
;; The repo already states this rule — `oci:doca-remote-digest`'s own
;; stdlib header says credentials "come from INPUT_USER / INPUT_PASS in the
;; environment …, never on argv, because /proc/<pid>/cmdline and `ps` are
;; world-readable on a shared runner". This file simply never followed it.
;;
;; `exec-capture` has no stdin channel, so `--password-stdin` is not
;; reachable from here. It does not need to be: every tool involved reads
;; credentials from a FILE, and a file has an owner bit that argv does not.
;;   • docker   → $DOCKER_CONFIG/config.json   (docker's own login format)
;;   • buildah  → --authfile <same format>     (containers/image)
;;   • podman   → --authfile <same format>     (containers/image)
;;   • regctl   → $REGCTL_CONFIG               (regclient's own format)
;;   • doca     → INPUT_USER / INPUT_PASS in the environment
;;
;; VERIFIED, not assumed, against real binaries on 2026-08-08:
;;   • `podman login --get-login <host>` reads our hand-written authfile
;;     through BOTH `--authfile` and `REGISTRY_AUTH_FILE` → prints the user.
;;   • `regctl registry whoami <host>` reads a hand-written REGCTL_CONFIG
;;     → prints the user; `regctl index create` driven purely by that file
;;     (zero credential argv) produced a byte-identical index digest to the
;;     `registry login` route against a live registry:2.
;;   • `docker buildx imagetools create` composed + pushed a real 2-arch
;;     index against a live registry:2 with only DOCKER_CONFIG set and NO
;;     `docker login` at all.
;;   • `doca inspect --digest-only` authenticated from INPUT_USER/INPUT_PASS.
;;
;; TIER, honestly: only-mitigated, not unrepresentable. The file is created
;; inside a 0700 directory and chmod'd 0600, so it is owner-only where argv
;; was world-readable — but nothing in the type system stops a future edit
;; from appending `--pass`. The structural fix is a stdin channel on
;; exec-capture; that is upstream in tatara-lisp, not here.

;; The docker/containers credential file: {"auths":{"<host>":{"auth":"<b64>"}}}.
;; `json-stringify` does the escaping so a host or a password containing a
;; quote or a backslash cannot break out of the JSON string — the escaping
;; bug a hand-rolled string-append would have shipped.
(define (mlj:auth-entries hosts b64 first?)
  (cond
    ((null? hosts) "")
    (else
      (string-append
        (if first? "" ",")
        (json-stringify (car hosts))
        ":{\"auth\":"
        (json-stringify b64)
        "}"
        (mlj:auth-entries (cdr hosts) b64 #f)))))

(define (mlj:auth-json hosts user pass)
  (string-append
    "{\"auths\":{"
    (mlj:auth-entries hosts (base64-encode (string-append user ":" pass)) #t)
    "}}"))

;; regclient's own config: {"hosts":{"<host>":{…}}}. Confirmed field-by-field
;; against regclient 0.9.2 by running `regctl registry login`/`registry set`
;; into a scratch HOME and reading back the file it wrote.
;;
;;   regcert  the PEM itself (NOT a path) — real verification pinned to that
;;            specific certificate; `tls` is then left at its default
;;            "enabled", which `regctl registry config <host>` confirms.
;;   tls      "insecure" ONLY on the cert-fetch-failed fallback. NOT
;;            "disabled" (plain HTTP): regctl's mode is exact and does not
;;            probe-HTTPS-then-fall-back, and Zot has had no plain-HTTP
;;            listener since its 2026-07-18 in-pod TLS migration, so
;;            "disabled" would never recover anything against the real target.
(define (mlj:regctl-host-entry host cert-pem insecure? user pass)
  (string-append
    (json-stringify host)
    ":{\"hostname\":"
    (json-stringify host)
    (if (equal? cert-pem "") "" (string-append ",\"regcert\":" (json-stringify cert-pem)))
    (if (and (equal? cert-pem "") insecure?) ",\"tls\":\"insecure\"" "")
    ",\"user\":"
    (json-stringify user)
    ",\"pass\":"
    (json-stringify pass)
    "}"))

(define (mlj:regctl-host-entries hosts cert-pem insecure? user pass first?)
  (cond
    ((null? hosts) "")
    (else
      (string-append
        (if first? "" ",")
        (mlj:regctl-host-entry
          (car hosts)
          cert-pem
          insecure?
          user
          pass)
        (mlj:regctl-host-entries
          (cdr hosts)
          cert-pem
          insecure?
          user
          pass
          #f)))))

(define (mlj:regctl-config-json hosts cert-pem insecure? user pass)
  (string-append
    "{\"hosts\":{"
    (mlj:regctl-host-entries
      hosts
      cert-pem
      insecure?
      user
      pass
      #t)
    "}}"))

;; Create the private directory BEFORE any secret-bearing file exists in
;; it, so there is no window where a 0755 directory holds a credential.
;; `mkdir`/`chmod` are binaries invoked directly — no shell.
(define (mlj:private-dir path)
  (exec-check "mkdir" "-p" path)
  (exec-check "chmod" "700" path)
  path)

(define (mlj:write-private path body)
  (write-file path body)
  (exec-check "chmod" "600" path)
  path)

;; ── tool detection ────────────────────────────────────────────────
;;
;; `mlj:has?` was defined here as a line-for-line copy of the shared stdlib's
;; `hash:cmd-present?` — a third instance of the same function, after
;; tameshi-attest's `attest:cmd-present?`. All three spawned a shell to run
;; `command -v <name> >/dev/null 2>&1` with the name interpolated unquoted.
;;
;; The rename is what hid it: tlisp-lint's Layer 4 finds stdlib shadowing by
;; intersecting define NAMES, so an identical name is caught on sight and an
;; `mlj:`-prefixed one is invisible. Layer 5 exists for exactly this shape.
;;
;; The stdlib version spawns no shell: `exec-capture` raises on an absent
;; binary and returns on a present one, so presence and absence were always
;; two control paths — the shell only converted that into an exit code.

;; The baked regctl's name, or "" when it is not on PATH. Mirrors
;; `oci:doca-baked` exactly.
(define (mlj:regctl-baked) (if (hash:cmd-present? "regctl") "regctl" ""))

(define (mlj:regctl-ref) (env-get "REGCTL_REF" "github:NixOS/nixpkgs/nixos-24.05#regctl"))

;; The argv PREFIX for a regctl subcommand. Baked wins; `nix run` is the
;; fallback, and `--` separates nix's own args from regctl's.
(define (mlj:regctl-argv subcommand)
  (let ((baked (mlj:regctl-baked)))
    (if (equal? baked "")
      (list
        "nix"
        "run"
        (mlj:regctl-ref)
        "--"
        subcommand)
      (list baked subcommand))))

;; Never silently degrade: a job that fell back to `nix run` must say so,
;; because that path needs a working nix daemon at job time and fails in a
;; way that reads as a regctl error when it is actually nix's.
;;
;; The wording deliberately does NOT reuse `oci:doca-source-note`'s sentence.
;; tlisp-lint Layer 5 flags a diagnostic literal re-typed outside the stdlib,
;; and it caught this on the first run — correctly: a shared literal belongs in
;; the stdlib once. Promoting a generic `nix:source-note` there is the real fix
;; and needs a second consumer plus an edit outside this directory, so this note
;; says the same thing in its own words for now.
;; pending-stdlib-promotion: nix:source-note (shared by oci:doca-source-note)
(define (mlj:regctl-source-note)
  (let ((baked (mlj:regctl-baked)))
    (string-append
      "regctl source: "
      (if (equal? baked "")
        (string-append
          "nix run "
          (mlj:regctl-ref)
          " (unbaked; a live nix daemon is required for this job to resolve it)")
        (string-append "baked at " baked)))))

;; regctl counts as reachable when it is baked OR when nix can run it.
(define (mlj:regctl-available?)
  (or (not (equal? (mlj:regctl-baked) "")) (hash:cmd-present? "nix")))

(define (mlj:tool-available? t)
  (cond ((equal? t "regctl") (mlj:regctl-available?)) (else (hash:cmd-present? t))))

;; auto → first reachable of regctl|buildah|podman|docker; "" when none is.
;;
;; An EXPLICIT tool is now availability-checked too. It was not: `TOOL=buildah`
;; on a runner without buildah returned "buildah" verbatim, and the first
;; `exec-capture` RAISED (exec-capture raises on an absent binary, it does not
;; return 127) — an uncaught error that killed the script before ANY output was
;; written, so a consumer read every one of index-ref/index-digest/arches/
;; joined/reason as empty rather than the typed `reason=no-tool` this action
;; promises. Same for a typo'd tool name.
(define (mlj:select-tool requested)
  (cond
    ((not (equal? requested "auto")) (if (mlj:tool-available? requested) requested ""))
    ((mlj:regctl-available?) "regctl")
    ((hash:cmd-present? "buildah") "buildah")
    ((hash:cmd-present? "podman") "podman")
    ((hash:cmd-present? "docker") "docker")
    (else "")))

;; ── per-tool index composition (returns child status; 0 = ok) ─────

;; Every exec-capture failure below logs its captured stderr before
;; returning the status int -- exec-capture silently discards stderr
;; unless a caller reads it, and `main`'s own failure branch only ever
;; had a generic "index create/push failed (exit N)" with no way to
;; tell auth-denied from no-such-manifest from a transient registry
;; error. Confirmed live (2026-07-21): a real akeylesslabs run failed
;; in 0.28s with zero diagnostic beyond "exit 1" -- this is that gap,
;; closed at every tool path, not just the one that happened to fail.

;; buildah & podman share identical `manifest create/add/push` syntax, and
;; both accept the SAME `--authfile` flag on any subcommand that actually
;; touches the registry (`add` pulls a remote manifest to inspect it;
;; `push` writes the joined index) -- `create` never leaves the local
;; store, so it never needs credentials.
(define (mlj:authfile-flag path) (list "--authfile" path))

(define (mlj:oci-tool-add tool local-name refs insecure? auth)
  (cond
    ((null? refs) 0)
    (else
      (let
        ((r
           (apply
             exec-capture
             (append
               (list
                 tool
                 "manifest"
                 "add")
               (if insecure?
                 (list "--tls-verify=false")
                 (list))
               auth
               (list local-name (string-append "docker://" (car refs)))))))
        (cond
          ((= (status-of r) 0) (mlj:oci-tool-add tool local-name (cdr refs) insecure? auth))
          (else
            (log-error
              (string-append
                "manifest-list-join: "
                tool
                " manifest add "
                (car refs)
                " failed: "
                (string-trim (stderr-of r))))
            (status-of r)))))))

(define (mlj:oci-tool-join tool local-name refs index-ref insecure? auth)
  ;; best-effort clean of a stale local manifest (ignore result). Safe to
  ;; call unguarded: mlj:select-tool has already proven `tool` is runnable,
  ;; so this cannot raise on an absent binary.
  (exec-check
    tool
    "manifest"
    "rm"
    local-name)
  (let ((cr (exec-capture tool "manifest" "create" local-name)))
    (cond
      ((not (= (status-of cr) 0))
        (log-error
          (string-append
            "manifest-list-join: "
            tool
            " manifest create failed: "
            (string-trim (stderr-of cr))))
        (status-of cr))
      (else
        (let ((a (mlj:oci-tool-add tool local-name refs insecure? auth)))
          (cond
            ((not (= a 0)) a)
            (else
              (let
                ((pr
                   (apply
                     exec-capture
                     (append
                       (list
                         tool
                         "manifest"
                         "push"
                         "--all")
                       (if insecure?
                         (list "--tls-verify=false")
                         (list))
                       auth
                       (list local-name (string-append "docker://" index-ref))))))
                (when (not (= (status-of pr) 0))
                  (log-error
                    (string-append
                      "manifest-list-join: "
                      tool
                      " manifest push failed: "
                      (string-trim (stderr-of pr)))))
                (status-of pr)))))))))

;; docker buildx imagetools create -- composes the index DIRECTLY from
;; each source's REMOTE registry manifest and pushes in one step.
;;
;; NOT `docker manifest create` + `docker manifest push`: that classic
;; pair operates on the LOCAL docker content store -- `manifest create`
;; resolves each source ref against images already pulled onto THIS
;; daemon, it does not itself reach out to the registry. In this
;; action's actual shape the per-arch images were built and pushed by a
;; SEPARATE CI job on a separate runner/daemon that never pulled them
;; back down, so every source ref is "no such manifest" locally --
;; confirmed live (2026-07-17): reproduced instantly (no network delay)
;; against a real registry with the exact refs a failing akeylesslabs
;; camelot/hardened-images run passed. `imagetools create` has no such
;; requirement -- it inspects and composes purely via registry API
;; calls, which is what a cross-job/cross-runner join always needs.
;;
;; No direct `--insecure`/`--tls-verify` equivalent exists for buildx;
;; it defers to the daemon's own registry trust config (localhost/
;; 127.0.0.1 targets are trusted by Docker's own default, verified
;; against a local registry:2 with no extra setup -- the shape this
;; action's own e2e test exercises). A registry that needs explicit
;; insecure-registries trust for this tool would need that configured
;; at the daemon level; `insecure?` is accepted for signature parity
;; with the other tool paths but currently unused here -- named
;; honestly, not silently dropped.
;;
;; `docker buildx imagetools create` has no --creds of its own -- it reads
;; auth from a docker config file. It used to get one by running a real
;; `docker login --password <secret>` (the argv leak documented above);
;; it now gets one from the private DOCKER_CONFIG `main` exports, which is
;; the same file `docker login` would have written. VERIFIED 2026-08-08:
;; a real 2-arch index composed + pushed to a live registry:2 with only
;; DOCKER_CONFIG set and no login step at all.
(define (mlj:docker-join refs index-ref insecure?)
  (let
    ((r
       (apply
         exec-capture
         (append (list "docker" "buildx" "imagetools" "create" "-t" index-ref) refs))))
    (when (not (= (status-of r) 0))
      (log-error
        (string-append
          "manifest-list-join: docker buildx imagetools create failed: "
          (string-trim (stderr-of r)))))
    (status-of r)))

;; regctl index create <index-ref> --ref <r1> --ref <r2> …
(define (mlj:regctl-ref-flags refs)
  (cond
    ((null? refs) (list))
    (else (append (list "--ref" (car refs)) (mlj:regctl-ref-flags (cdr refs))))))

;; ONE regctl invocation. Trust + credentials were already materialized
;; into $REGCTL_CONFIG by `main`, and regclient loads that file itself --
;; so the three preparatory `regctl registry set/login` calls this used to
;; need are gone, which also makes the un-baked `nix run` fallback four
;; times cheaper.
(define (mlj:regctl-join refs index-ref)
  (let
    ((r
       (apply
         exec-capture
         (append
           (mlj:regctl-argv "index")
           (list "create" index-ref)
           (mlj:regctl-ref-flags refs)))))
    (when (not (= (status-of r) 0))
      (log-error
        (string-append
          "manifest-list-join: regctl index create failed: "
          (string-trim (stderr-of r)))))
    (status-of r)))

;; Is the regctl path allowed to proceed? Real CA-pinned verification when
;; the cert fetch succeeded; the INSECURE fallback only when the input
;; permits it; otherwise an honest refusal rather than a faked join. Pure —
;; the logging lives in `main` so this stays unit-testable.
(define (mlj:regctl-trust-ok? cert-pem insecure?) (or (not (equal? cert-pem "")) insecure?))

(define (mlj:join tool refs index-ref insecure? auth-file)
  (cond
    ((equal? tool "buildah")
      (mlj:oci-tool-join
        "buildah"
        "mlj-index"
        refs
        index-ref
        insecure?
        (mlj:authfile-flag auth-file)))
    ((equal? tool "podman")
      (mlj:oci-tool-join
        "podman"
        "mlj-index"
        refs
        index-ref
        insecure?
        (mlj:authfile-flag auth-file)))
    ((equal? tool "docker") (mlj:docker-join refs index-ref insecure?))
    ((equal? tool "regctl") (mlj:regctl-join refs index-ref))
    (else 127)))

;; ── main ──────────────────────────────────────────────────────────
;;
;; `emit-output`, not `append-output`: the value of index-ref is composed
;; from TAG / RUN_NUMBER / SHA / REPO / IMAGE / SVC, and `arches` straight
;; from ARCH_REFS -- all caller-supplied. $GITHUB_OUTPUT is newline-
;; separated, so a newline anywhere in one of those writes ADDITIONAL
;; output keys chosen by whoever set the input. append-output cannot see
;; that (by the time it is called the key and value are one string);
;; emit-output keeps them apart and refuses.
(define (mlj:emit-fail reason)
  (emit-output "joined" "false")
  (emit-output "index-ref" "")
  (emit-output "index-digest" "")
  (emit-output "arches" "")
  (emit-output "reason" reason))

(define (main)
  (let*
    ((registry (env-get "REGISTRY" "zot.zot-system.svc.cluster.local:5000"))
      (repo (env-get "REPO" ""))
      (image (env-get "IMAGE" ""))
      (svc (env-get "SVC" ""))
      (arch-refs (env-get "ARCH_REFS" ""))
      (run (env-get "RUN_NUMBER" ""))
      (sha (env-get "SHA" ""))
      (tag-in (env-get "TAG" ""))
      (insecure (oci:flag-true? (env-get "INSECURE" "true")))
      (dest-user (env-required "DEST_USER"))
      (dest-pass (env-required "DEST_PASS"))
      (tool-req (env-get "TOOL" "auto"))
      (ca-cert-url
        (env-get
          "CA_CERT_URL"
          "https://raw.githubusercontent.com/pleme-io/akeyless-k8s/main/clusters/camelot-eks/infrastructure/zot/zot-ca.crt"))
      (ca-cert-path (env-get "CA_CERT_PATH" "/tmp/manifest-list-join-ca.crt"))
      (ca-cert-token (env-get "CA_CERT_TOKEN" ""))
      (pairs (mlj:parse-pairs (string-split arch-refs ",")))
      (refs (mlj:refs-of pairs))
      (arches (mlj:arches-of pairs))
      (base (oci:compose-base repo registry image "akeyless-" svc))
      (tag (mlj:resolve-tag tag-in run sha)))
    (cond
      ((null? refs)
        (log-error "manifest-list-join: ARCH_REFS is empty (need amd64=<ref>[,arm64=<ref>])")
        (mlj:emit-fail "no-refs")
        1)
      ((equal? base "")
        (log-error
          "manifest-list-join: need REPO, or IMAGE, or SVC to resolve the index repository")
        (mlj:emit-fail "need-target")
        1)
      ((equal? tag "")
        (log-error "manifest-list-join: need TAG, or RUN_NUMBER+SHA to compose r<run>-<sha>")
        (mlj:emit-fail "need-tag")
        1)
      (else
        (let*
          ((index-ref (oci:target-ref base tag))
            (tool (mlj:select-tool tool-req))
            (registry-host (oci:split-registry base))
            (hosts (mlj:hosts-of index-ref refs))
            ;; ONE cert fetch, shared by the regctl join AND the doca digest
            ;; readback below. It used to be fetched inside the regctl path
            ;; only, which is why the readback never had it.
            (cert (oci:fetch-ca-cert ca-cert-url ca-cert-path ca-cert-token))
            (cert-pem (if (equal? cert "") "" (read-file cert)))
            (workdir
              (mlj:private-dir
                (string-append (env-get "RUNNER_TEMP" "/tmp") "/manifest-list-join-cred")))
            (auth-file
              (mlj:write-private
                (string-append workdir "/config.json")
                (mlj:auth-json hosts dest-user dest-pass)))
            (regctl-config
              (mlj:write-private
                (string-append workdir "/regctl.json")
                (mlj:regctl-config-json
                  hosts
                  cert-pem
                  insecure
                  dest-user
                  dest-pass))))
          (cond
            ((equal? tool "")
              (log-error
                (string-append
                  "manifest-list-join: "
                  (if (equal? tool-req "auto")
                    "no manifest tool reachable (regctl|buildah|podman|docker)"
                    (string-append
                      "the requested tool '"
                      tool-req
                      "' is not reachable (expected one of regctl|buildah|podman|docker)"))
                  " -- refusing to fake an index. "
                  (mlj:regctl-source-note)))
              (mlj:emit-fail "no-tool")
              1)
            ((and (equal? tool "regctl") (not (mlj:regctl-trust-ok? cert-pem insecure)))
              (log-error
                (string-append
                  "manifest-list-join: could not fetch the pinned CA cert for "
                  registry-host
                  " and INSECURE fallback is not enabled — refusing to trust regctl against an unverified connection"))
              (mlj:emit-fail "join-fail")
              1)
            (else
              ;; Exported, never passed on argv. DOCKER_CONFIG is a private
              ;; directory rather than the runner's own ~/.docker so this step
              ;; never mutates shared daemon state; every ref this action
              ;; touches is covered because `hosts` enumerates them all.
              (env-set "DOCKER_CONFIG" workdir)
              (env-set "REGISTRY_AUTH_FILE" auth-file)
              (env-set "REGCTL_CONFIG" regctl-config)
              (env-set "INPUT_USER" dest-user)
              (env-set "INPUT_PASS" dest-pass)
              (when (not (equal? cert "")) (env-set "INPUT_DEST_CA_CERT" cert))
              (when (and (equal? cert-pem "") insecure)
                (log-info
                  (string-append
                    "::warning::manifest-list-join: CA cert fetch failed for "
                    registry-host
                    " — falling back to the INSECURE route (regctl tls=insecure / --tls-verify=false / plain-HTTP digest readback), a real tracked degradation, not silent")))
              (log-info
                (string-append
                  "==> manifest-list-join ["
                  tool
                  "] "
                  (string-format "{}" (length refs))
                  " arch(es) {"
                  arches
                  "} -> docker://"
                  index-ref
                  (if (equal? cert-pem "")
                    " (unpinned)"
                    " (CA-pinned)")))
              (when (equal? tool "regctl") (log-info (mlj:regctl-source-note)))
              (when (< (length refs) 2)
                (log-info
                  "::warning::manifest-list-join: fewer than 2 arches — emitting a DEGENERATE single-arch index (load-bearing once arm64-native lands)"))
              (let
                ((s
                   (mlj:join
                     tool
                     refs
                     index-ref
                     insecure
                     auth-file)))
                (cond
                  ((not (= s 0))
                    (log-error
                      (string-append
                        "manifest-list-join: index create/push failed (exit "
                        (string-format "{}" s)
                        ")"))
                    (mlj:emit-fail "join-fail")
                    s)
                  (else
                    ;; THE DIGEST READBACK, fixed 2026-08-08. It used to be
                    ;;   (oci:doca-remote-digest index-ref insecure)
                    ;; with INSECURE defaulting to "true" — and doca's
                    ;; `--insecure` is not "skip cert verification", it is
                    ;; ClientProtocol::Http, PLAIN HTTP (substrate/tools/
                    ;; oci-push/src/main.rs:151-155). The cluster Zot has had
                    ;; no plain-HTTP listener since 2026-07-18, so on the
                    ;; default inputs the readback could only ever fail and
                    ;; `index-digest` — this action's headline output, the
                    ;; "single exact coordinate an environment pins" — was
                    ;; structurally always empty, degraded to a ::warning::
                    ;; that reads like an occasional hiccup.
                    ;;
                    ;; The pinned CA cert was already on disk; it was simply
                    ;; never handed to doca. It is now, via doca's own
                    ;; INPUT_DEST_CA_CERT env fallback (verified: a bogus path
                    ;; hard-errors "cannot read CA cert", proving it is read),
                    ;; and `--insecure` is passed ONLY when there is no cert
                    ;; and INSECURE permits it.
                    (log-info (oci:doca-source-note))
                    (let ((digest (oci:doca-remote-digest index-ref (and (equal? cert "") insecure))))
                      (when (equal? digest "")
                        (log-info
                          "::warning::manifest-list-join: could not resolve index digest (doca inspect failed) — index-digest= (honest empty); the push itself succeeded"))
                      (emit-output "index-ref" index-ref)
                      (emit-output "index-digest" digest)
                      (emit-output "arches" arches)
                      (emit-output "joined" "true")
                      (emit-output "reason" (if (< (length refs) 2) "single-arch" "joined"))
                      (log-info
                        (string-append
                          "joined multi-arch index "
                          index-ref
                          (if (equal? digest "")
                            ""
                            (string-append " @ " digest))))
                      0)))))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — manifest-list-join helpers loaded; main skipped"))
  (else (exit (main))))
