;; manifest-list-join/run.tlisp — compose separately-pushed per-arch
;; images into ONE multi-arch OCI image index (manifest list) and push
;; it under the multi-arch deploy coordinate r<run>-<sha>. Reports the
;; index DIGEST — the single exact coordinate an environment pins.
;;
;; Part of the super-cache-ci MANIFEST leg (job 3). skopeo *copies*
;; single images; it does NOT *compose* an index from separately-pushed
;; per-arch digests — so this action drives a real manifest tool
;; (regctl `index create/add`, buildah|podman `manifest create/add/push`,
;; or `docker manifest`), auto-detected. It consumes the per-arch refs
;; that zot-push produced (amd64=<ref>,arm64=<ref>) and is attested by
;; cartorio-attest.
;;
;; TOOL PRIORITY (REVISED 2026-07-23): `mlj:select-tool` now tries
;; regctl FIRST, then buildah/podman, then docker last. Root cause: the
;; cluster-internal Zot moved off plain HTTP onto real in-pod TLS
;; (self-signed, no cert-manager) 2026-07-18 -- see zot-push/run.tlisp's
;; header for the full story. This action's own INSECURE input/flag was
;; already a documented no-op for `docker buildx imagetools create`
;; (mlj:docker-join's own comment): it has no `--insecure`/`--tls-verify`
;; equivalent and defers entirely to the shared dind sidecar's daemon-
;; level trust config, which carries no entry for the Zot host or its
;; CA. buildah/podman's `--tls-verify=false` IS a real per-invocation
;; flag but only ever buys the (real, tracked) insecure fallback, never
;; a genuine CA-pinned verification. regctl is the one candidate tool
;; that is a standalone client accepting PER-REGISTRY trust config
;; (`regctl registry set --cacert "<pem>"`, confirmed real against a
;; live regclient 0.6.1 AND 0.9.2 binary: the config is written to
;; regctl's own `$HOME/.regctl/config.json` and a LATER, separate
;; `regctl index create/add` call loads it automatically, source=host in
;; -v debug output) without touching any shared daemon's global trust
;; store -- so it is the tool actually capable of honoring either the
;; real CA-cert route or an explicit insecure fallback here. It is not
;; preinstalled on the akeylesslabs camelot ARC runner image (stock
;; `ghcr.io/actions/actions-runner:latest` + dind -- confirmed live,
;; 2026-07-23: no buildah/podman/regctl on PATH, only the dind-sidecar
;; `docker`), so action.yml's "Ensure regctl" step nix-installs it the
;; same way "Ensure skopeo" already does.
;;
;; Tier: SHIPPABLE-NOW. Index composition is deterministic; the tag/base
;; algebra + arch/ref parsing are pure + unit-tested. The ONE runtime
;; dependency is a manifest tool on PATH — if none is present the action
;; FAILS loudly (never fakes an index digest). Today the akeyless build
;; is amd64-only, so a 1-arch join is a DEGENERATE (but honest) index;
;; it becomes load-bearing the moment arm64-native lands (reason emits
;; `single-arch` vs `joined`).
;;
;; Uses _tlisp-stdlib helpers (prepended by action.yml's loader):
;;   append-output, status-of, stdout-of, oci:compose-base,
;;   oci:target-ref, oci:index-tag, oci:flag-true?, oci:skopeo-remote-digest,
;;   oci:split-registry, oci:fetch-ca-cert.
;;
;; Inputs (env):
;;   REGISTRY      cluster Zot host:port (default zot.zot-system.svc.cluster.local:5000)
;;   REPO          full base override "<host>/<repo>" (no tag); wins when set
;;   IMAGE         repo path override "<repo>" (with REGISTRY when REPO empty)
;;   SVC           akeyless service name; composes "akeyless-<svc>"
;;   ARCH_REFS     per-arch refs to join: "amd64=<ref>,arm64=<ref>"  (required)
;;   TAG           explicit index tag; else composed r<run>-<sha>
;;   RUN_NUMBER    github.run_number (for the composed index tag)
;;   SHA           github.sha        (for the composed index tag)
;;   INSECURE      cluster-internal Zot is http/self-signed (default "true") --
;;                 for regctl this is the CA-cert-fetch-failed fallback (real,
;;                 logged degradation, never silent); for buildah/podman a
;;                 real per-invocation --tls-verify=false; a documented no-op
;;                 for docker (see the TOOL PRIORITY note above).
;;   DEST_USER     registry push credential username                (required)
;;   DEST_PASS     registry push credential password                (required)
;;   TOOL          auto|regctl|buildah|podman|docker (default "auto")
;;   CA_CERT_URL   raw URL of the pinned CA/leaf cert (PEM); fetched once,
;;                 used only by the regctl path (default: the same committed
;;                 cluster cert zot-push already trusts)
;;   CA_CERT_PATH  local path the fetched cert is written to (default
;;                 /tmp/manifest-list-join-ca.crt — distinct from zot-push's
;;                 own default so one job step never clobbers the other's
;;                 cached fetch)
;;   CA_CERT_TOKEN a GitHub token with read access to CA_CERT_URL's repo --
;;                 REQUIRED when that repo is private (the default
;;                 CA_CERT_URL points at pleme-io/akeyless-k8s, which is
;;                 private). Empty (default) keeps the unauthenticated path
;;                 for a public cert URL.
;;
;; Outputs (append-output → GITHUB_OUTPUT):
;;   index-ref / index-digest / arches / joined / reason

;; ── pure helpers (unit-tested via run.test.tlisp) ────────────────
;; Split one "arch=ref" segment into (arch . ref). A segment with no
;; "=" is treated as a bare ref with an unknown ("") arch.
(define (mlj:split-pair s)
  (let ((parts (string-split s "=")))
    (cond
      ((>= (length parts) 2)
       (cons (string-trim (car parts)) (string-trim (car (cdr parts)))))
      (else (cons "" (string-trim s))))))

;; Parse a comma-separated "amd64=r1,arm64=r2" list into (arch . ref)
;; pairs, dropping empty segments.
(define (mlj:parse-pairs segs)
  (cond
    ((null? segs) (list))
    ((equal? (string-trim (car segs)) "") (mlj:parse-pairs (cdr segs)))
    (else (cons (mlj:split-pair (car segs)) (mlj:parse-pairs (cdr segs))))))

;; The refs (2nd element of each (arch ref) pair) in order. NOTE:
;; tatara-lisp `(cons a b)` on atoms yields the 2-element list `(a b)`,
;; so the ref is `(car (cdr pair))`, not `(cdr pair)`.
(define (mlj:refs-of pairs)
  (cond
    ((null? pairs) (list))
    (else (cons (car (cdr (car pairs))) (mlj:refs-of (cdr pairs))))))

;; The known arches (non-empty cars), space-joined ("amd64 arm64").
(define (mlj:arches-list pairs)
  (cond
    ((null? pairs) (list))
    ((equal? (car (car pairs)) "") (mlj:arches-list (cdr pairs)))
    (else (cons (car (car pairs)) (mlj:arches-list (cdr pairs))))))

(define (mlj:arches-of pairs)
  (string-join " " (mlj:arches-list pairs)))

;; The multi-arch index tag: explicit TAG > composed r<run>-<sha> > "".
(define (mlj:resolve-tag tag-in run sha)
  (cond
    ((not (equal? (string-trim tag-in) "")) (string-trim tag-in))
    ((and (not (equal? run "")) (not (equal? sha ""))) (oci:index-tag run sha))
    (else "")))

;; ── tool detection ────────────────────────────────────────────────
(define (mlj:has? name)
  (= 0 (status-of (exec-capture "sh" "-c"
                    (string-append "command -v " name " >/dev/null 2>&1")))))

;; auto → first present of regctl|buildah|podman|docker; else the
;; requested tool verbatim; "" when auto finds nothing. regctl FIRST
;; (see the TOOL PRIORITY header note): it is the one candidate that
;; accepts per-registry TLS/CA trust without touching a shared daemon's
;; global config, so `auto` prefers it over docker (this action's
;; `Ensure regctl` action.yml step guarantees it is on PATH).
(define (mlj:select-tool requested)
  (cond
    ((not (equal? requested "auto")) requested)
    ((mlj:has? "regctl")  "regctl")
    ((mlj:has? "buildah") "buildah")
    ((mlj:has? "podman")  "podman")
    ((mlj:has? "docker")  "docker")
    (else "")))

;; ── per-tool index composition (returns child status; 0 = ok) ─────

;; Every exec-capture failure below logs its captured stderr before
;; returning the status int -- exec-capture silently discards stderr
;; unless a caller reads it, and `main`'s own failure branch only ever
;; had a generic "index create/push failed (exit N)" with no way to
;; tell auth-denied from no-such-manifest from a transient registry
;; error. Confirmed live (2026-07-21): a real akeylesslabs run failed
;; in 0.28s with zero diagnostic beyond "exit 1" -- this is that gap,
;; closed at every tool path, not just the one that happened to fail.

;; buildah & podman share identical `manifest create/add/push` syntax, and
;; both accept the SAME `--creds user:pass` flag on any subcommand that
;; actually touches the registry (`add` pulls a remote manifest to inspect
;; it; `push` writes the joined index) -- `create` never leaves the local
;; store, so it never needs creds. See `mlj:creds-flag`'s header note for
;; why this is required, not optional, against this cluster's Zot.
(define (mlj:oci-tool-add tool local-name refs insecure? creds)
  (cond
    ((null? refs) 0)
    (else
     (let ((r (apply exec-capture
                (append (list tool "manifest" "add")
                        (if insecure? (list "--tls-verify=false") (list))
                        creds
                        (list local-name (string-append "docker://" (car refs)))))))
       (cond
         ((= (status-of r) 0) (mlj:oci-tool-add tool local-name (cdr refs) insecure? creds))
         (else
          (log-error (string-append "manifest-list-join: " tool " manifest add "
                                     (car refs) " failed: " (string-trim (stderr-of r))))
          (status-of r)))))))

(define (mlj:oci-tool-join tool local-name refs index-ref insecure? creds)
  ;; best-effort clean of a stale local manifest (ignore result)
  (exec-check tool "manifest" "rm" local-name)
  (let ((cr (exec-capture tool "manifest" "create" local-name)))
    (cond
      ((not (= (status-of cr) 0))
       (log-error (string-append "manifest-list-join: " tool " manifest create failed: "
                                  (string-trim (stderr-of cr))))
       (status-of cr))
      (else
       (let ((a (mlj:oci-tool-add tool local-name refs insecure? creds)))
         (cond
           ((not (= a 0)) a)
           (else
            (let ((pr (apply exec-capture
                        (append (list tool "manifest" "push" "--all")
                                (if insecure? (list "--tls-verify=false") (list))
                                creds
                                (list local-name (string-append "docker://" index-ref))))))
              (when (not (= (status-of pr) 0))
                (log-error (string-append "manifest-list-join: " tool " manifest push failed: "
                                           (string-trim (stderr-of pr)))))
              (status-of pr)))))))))

;; docker buildx imagetools create -- composes the index DIRECTLY from
;; each source's REMOTE registry manifest and pushes in one step.
;;
;; NOT `docker manifest create` + `docker manifest push`: that classic
;; pair operates on the LOCAL docker content store -- `manifest create`
;; resolves each source ref against images already pulled onto THIS
;; daemon, it does not itself reach out to the registry. In this
;; action's actual shape the per-arch images were built and pushed by a
;; SEPARATE CI job on a separate runner/daemon that never pulled them
;; back down, so every source ref is "no such manifest" locally --
;; confirmed live (2026-07-17): reproduced instantly (no network delay)
;; against a real registry with the exact refs a failing akeylesslabs
;; camelot/hardened-images run passed. `imagetools create` has no such
;; requirement -- it inspects and composes purely via registry API
;; calls, which is what a cross-job/cross-runner join always needs.
;;
;; No direct `--insecure`/`--tls-verify` equivalent exists for buildx;
;; it defers to the daemon's own registry trust config (localhost/
;; 127.0.0.1 targets are trusted by Docker's own default, verified
;; against a local registry:2 with no extra setup -- the shape this
;; action's own e2e test exercises). A registry that needs explicit
;; insecure-registries trust for this tool would need that configured
;; at the daemon level; `insecure?` is accepted for signature parity
;; with the other tool paths but currently unused here -- named
;; honestly, not silently dropped.
;;
;; `docker buildx imagetools create` has no --creds of its own either --
;; unlike regctl/buildah/podman it reads auth from the shared daemon's
;; OWN credential store (~/.docker/config.json), so authenticating this
;; path means a real `docker login` against the target registry BEFORE
;; the imagetools call, the same shared-daemon-config trust model this
;; file's own header note already describes for TLS.
(define (mlj:docker-login registry-host user pass)
  (status-of (exec-capture "docker" "login" registry-host "--username" user "--password" pass)))

(define (mlj:docker-join refs index-ref insecure? registry-host user pass)
  (cond
    ((not (= (mlj:docker-login registry-host user pass) 0))
     (log-error (string-append "manifest-list-join: docker login " registry-host " failed"))
     1)
    (else
     (let ((r (apply exec-capture
                (append (list "docker" "buildx" "imagetools" "create" "-t" index-ref) refs))))
       (when (not (= (status-of r) 0))
         (log-error (string-append "manifest-list-join: docker buildx imagetools create failed: "
                                    (string-trim (stderr-of r)))))
       (status-of r)))))

;; regctl index create <index-ref> --ref <r1> --ref <r2> …
(define (mlj:regctl-ref-flags refs)
  (cond
    ((null? refs) (list))
    (else (append (list "--ref" (car refs)) (mlj:regctl-ref-flags (cdr refs))))))

(define (mlj:regctl-join refs index-ref)
  (let ((r (apply exec-capture
             (append (list "regctl" "index" "create" index-ref)
                     (mlj:regctl-ref-flags refs)))))
    (when (not (= (status-of r) 0))
      (log-error (string-append "manifest-list-join: regctl index create failed: "
                                 (string-trim (stderr-of r)))))
    (status-of r)))

;; ── regctl TLS/CA trust config ────────────────────────────────────
;;
;; `regctl index create/add` has no per-invocation --insecure/--cacert
;; flag of its own; trust is PERSISTENT, PER-REGISTRY config in
;; regctl's own `$HOME/.regctl/config.json`, written by `regctl
;; registry set` BEFORE the join call. Confirmed real + real syntax
;; against a live regclient binary (both 0.6.1, the nixos-24.05 pin
;; action.yml's "Ensure regctl" step installs, and 0.9.2): the written
;; `regcert`/`tls` fields are loaded automatically by a LATER, separate
;; `regctl index create` invocation (source=host in -v debug output) --
;; no env var, no flag needed on the join call itself. `--skip-check`:
;; `registry set` PINGS the registry by default and exits nonzero on a
;; failed ping even though the config was written successfully; skip
;; that ping so an unreachable-at-config-time (but reachable-at-join-
;; time) registry never fails this step for the wrong reason.
(define (mlj:regctl-set-cacert host cert-path)
  (status-of (exec-capture "regctl" "registry" "set" host
               "--cacert" (read-file cert-path) "--skip-check")))

;; `--tls insecure` (HTTPS, certificate verification skipped) -- NOT
;; `--tls disabled` (plain HTTP). Confirmed live against a real
;; self-signed-cert `registry:2` (regclient 0.9.2): `--tls disabled`
;; against a TLS-only listener fails hard ("Client sent an HTTP request
;; to an HTTPS server" / 400) -- regctl, unlike docker/skopeo/buildah's
;; `--tls-verify=false`, does NOT probe HTTPS-then-fall-back-to-HTTP; the
;; mode is exact. Zot itself has had no plain-HTTP listener since its
;; 2026-07-18 in-pod TLS migration (see the header note), so `disabled`
;; would never actually recover anything here -- `insecure` is the only
;; value that is a real fallback against the real target.
(define (mlj:regctl-set-insecure host)
  (status-of (exec-capture "regctl" "registry" "set" host
               "--tls" "insecure" "--skip-check")))

;; Establish trust for `host` before any `regctl index …` call. Same
;; precedence as zot-push's own TLS handling: real CA-pinned
;; verification (against a SPECIFIC known cert) when the fetch
;; succeeds; INSECURE (HTTPS, skip cert verification) only as the
;; named, logged fallback when `insecure?` allows it -- never a silent
;; downgrade. #t on success, #f when neither route is available (an
;; honest refusal, not a faked join).
(define (mlj:regctl-configure-trust host ca-cert-url ca-cert-path ca-cert-token insecure?)
  (let ((fetched (oci:fetch-ca-cert ca-cert-url ca-cert-path ca-cert-token)))
    (cond
      ((not (equal? fetched ""))
       (= 0 (mlj:regctl-set-cacert host fetched)))
      (insecure?
       (log-info (string-append "::warning::manifest-list-join: CA cert fetch failed for "
                  host " — falling back to regctl --tls insecure (HTTPS, cert verification skipped), a real tracked degradation, not silent"))
       (= 0 (mlj:regctl-set-insecure host)))
      (else
       (log-error (string-append "manifest-list-join: could not fetch the pinned CA cert for "
                  host " and INSECURE fallback is not enabled — refusing to trust regctl against an unverified connection"))
       #f))))

;; ── registry write credentials ────────────────────────────────────
;;
;; Zot rejects anonymous writes the same way for a manifest INDEX as it
;; does for a blob (authz.defaultPolicy: [read]; only a named `writers`
;; principal may create/update/delete -- see zot-push's own header +
;; the cluster's release.yaml). This action shipped with ZERO credential
;; wiring since inception: `mlj:regctl-configure-trust` (below) only
;; ever established TLS/CA trust, never authentication, so `regctl index
;; create` always failed "no credentials available: unauthorized" the
;; moment it ran against an authz-enabled Zot -- confirmed live
;; 2026-07-24 (the SAME session that fixed zot-push's own stale-password
;; 401: fixing that credential alone was not sufficient, because this
;; action never offered a credential in the first place). Every tool
;; path below now authenticates the same `dest-user`/`dest-pass` zot-push
;; already requires, so the class (not just the regctl instance that
;; happened to be live-tested) is closed.

;; buildah/podman: `--creds user:pass` on any subcommand that touches
;; the registry (see `mlj:oci-tool-add`/`mlj:oci-tool-join` above).
(define (mlj:creds-flag user pass)
  (list "--creds" (string-append user ":" pass)))

;; regctl persists creds the SAME way it persists cacert/tls trust:
;; `regctl registry login <host> --user <user> --pass <pass>` writes
;; into the SAME per-host entry in $HOME/.regctl/config.json that
;; `mlj:regctl-set-cacert`/`mlj:regctl-set-insecure` already write --
;; confirmed live against a real regclient 0.9.2 binary (`registry set`
;; for tls, `registry login` for user/pass, one shared config file; a
;; LATER, separate `regctl index create` call loads both automatically).
;; `--skip-check` matches the trust-config calls above: skip the
;; connectivity ping so an unreachable-at-login-time (but reachable-at-
;; join-time) registry never fails this step for the wrong reason.
(define (mlj:regctl-login host user pass)
  (status-of (exec-capture "regctl" "registry" "login" host
               "--user" user "--pass" pass "--skip-check")))

(define (mlj:join tool refs index-ref insecure? registry-host ca-cert-url ca-cert-path ca-cert-token user pass)
  (cond
    ((equal? tool "buildah") (mlj:oci-tool-join "buildah" "mlj-index" refs index-ref insecure? (mlj:creds-flag user pass)))
    ((equal? tool "podman")  (mlj:oci-tool-join "podman"  "mlj-index" refs index-ref insecure? (mlj:creds-flag user pass)))
    ((equal? tool "docker")  (mlj:docker-join refs index-ref insecure? registry-host user pass))
    ((equal? tool "regctl")
     (cond
       ((not (mlj:regctl-configure-trust registry-host ca-cert-url ca-cert-path ca-cert-token insecure?)) 1)
       ((not (= (mlj:regctl-login registry-host user pass) 0))
        (log-error (string-append "manifest-list-join: regctl registry login " registry-host " failed"))
        1)
       (else (mlj:regctl-join refs index-ref))))
    (else 127)))

;; ── main ──────────────────────────────────────────────────────────
(define (mlj:emit-fail reason)
  (append-output "joined=false")
  (append-output "index-ref=")
  (append-output "index-digest=")
  (append-output "arches=")
  (append-output (string-append "reason=" reason)))

(define (main)
  (let* ((registry (env-get "REGISTRY" "zot.zot-system.svc.cluster.local:5000"))
         (repo (env-get "REPO" ""))
         (image (env-get "IMAGE" ""))
         (svc (env-get "SVC" ""))
         (arch-refs (env-get "ARCH_REFS" ""))
         (run (env-get "RUN_NUMBER" ""))
         (sha (env-get "SHA" ""))
         (tag-in (env-get "TAG" ""))
         (insecure (oci:flag-true? (env-get "INSECURE" "true")))
         (dest-user (env-required "DEST_USER"))
         (dest-pass (env-required "DEST_PASS"))
         (tool-req (env-get "TOOL" "auto"))
         (ca-cert-url (env-get "CA_CERT_URL"
           "https://raw.githubusercontent.com/pleme-io/akeyless-k8s/main/clusters/camelot-eks/infrastructure/zot/zot-ca.crt"))
         (ca-cert-path (env-get "CA_CERT_PATH" "/tmp/manifest-list-join-ca.crt"))
         (ca-cert-token (env-get "CA_CERT_TOKEN" ""))
         (pairs (mlj:parse-pairs (string-split arch-refs ",")))
         (refs (mlj:refs-of pairs))
         (arches (mlj:arches-of pairs))
         (base (oci:compose-base repo registry image "akeyless-" svc))
         (tag (mlj:resolve-tag tag-in run sha)))
    (cond
      ((null? refs) (log-error "manifest-list-join: ARCH_REFS is empty (need amd64=<ref>[,arm64=<ref>])") (mlj:emit-fail "no-refs") 1)
      ((equal? base "") (log-error "manifest-list-join: need REPO, or IMAGE, or SVC to resolve the index repository") (mlj:emit-fail "need-target") 1)
      ((equal? tag "") (log-error "manifest-list-join: need TAG, or RUN_NUMBER+SHA to compose r<run>-<sha>") (mlj:emit-fail "need-tag") 1)
      (else
       (let* ((index-ref (oci:target-ref base tag))
              (tool (mlj:select-tool tool-req))
              (registry-host (oci:split-registry base)))
         (cond
           ((equal? tool "")
            (log-error "manifest-list-join: no manifest tool on PATH (regctl|buildah|podman|docker) — refusing to fake an index")
            (mlj:emit-fail "no-tool") 1)
           (else
            (log-info (string-append "==> manifest-list-join [" tool "] "
                       (string-format "{}" (length refs)) " arch(es) {" arches
                       "} -> docker://" index-ref (if insecure " (insecure)" "")))
            (when (< (length refs) 2)
              (log-info "::warning::manifest-list-join: fewer than 2 arches — emitting a DEGENERATE single-arch index (load-bearing once arm64-native lands)"))
            (let ((s (mlj:join tool refs index-ref insecure registry-host ca-cert-url ca-cert-path ca-cert-token dest-user dest-pass)))
              (cond
                ((not (= s 0))
                 (log-error (string-append "manifest-list-join: index create/push failed (exit "
                             (string-format "{}" s) ")"))
                 (mlj:emit-fail "join-fail") s)
                (else
                 (let ((digest (oci:skopeo-remote-digest index-ref insecure)))
                   (when (equal? digest "")
                     (log-info "::warning::manifest-list-join: could not resolve index digest (skopeo inspect failed) — index-digest= (honest empty); the push itself succeeded"))
                   (append-output (string-append "index-ref=" index-ref))
                   (append-output (string-append "index-digest=" digest))
                   (append-output (string-append "arches=" arches))
                   (append-output "joined=true")
                   (append-output (string-append "reason=" (if (< (length refs) 2) "single-arch" "joined")))
                   (log-info (string-append "joined multi-arch index " index-ref
                              (if (equal? digest "") "" (string-append " @ " digest))))
                   0)))))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
   (log-info "TLISP_TEST=1 — manifest-list-join helpers loaded; main skipped"))
  (else
   (exit (main))))
