;; helm-bump/run.tlisp — bump a Chart.yaml's version field.
;; Helm chart version + appVersion are both bumped to stay in sync.

(define bump-type (env-get "BUMP_TYPE" "patch"))

(define skip-flag (env-get "SKIP_WHEN_NO_SOURCE_CHANGES" "true"))

(define source-paths (env-get "SOURCE_PATHS" "templates values.yaml Chart.yaml"))

;; Read Chart.yaml's .version, or "" — where "" means ONLY "absent".
;;
;; ── THIS SHIPPED A VERSION LITERALLY NAMED `null..1` ─────────────────────
;;
;; yq prints the string `null` at EXIT 0 for a missing key. The old form
;; returned that verbatim, and the caller's `(equal? old-version "")` guard
;; passed it straight through. `bump-semver` then split `"null"` on "." —
;; giving one field, so awk's $2 and $3 are empty — and emitted:
;;
;;     $ printf 'apiVersion: v2\nname: demo\n' > Chart.yaml
;;     $ yq '.version' Chart.yaml   ->  null   (exit 0)
;;     $ echo null | awk -F. '{print $1"."$2"."$3+1}'   ->  null..1
;;
;; That value was then written to BOTH .version and .appVersion by real yq,
;; `bumped=true` was emitted, and the action exited 0. helm-publish packages
;; and pushes whatever Chart.yaml says.
;;
;; Measured 2026-08-06, no stub and no fault injection required: a Chart.yaml
;; that simply omits `version:` reproduces it with the real yq.
;;
;; So the fix is at the READ, not at the arithmetic: a value that is not a
;; semver is not a version, and `""` must mean absent and nothing else. The
;; `2>/dev/null` goes too — it was hiding the one signal that distinguishes a
;; missing key from a broken yq.
(define (chart-version-ok? v)
  (re-match? "^[0-9]+\\.[0-9]+\\.[0-9]+" v))

(define (read-chart-version)
  (let ((r (exec-capture "yq" ".version" "Chart.yaml")))
    (cond
      ((not (= (status-of r) 0))
        (log-error
          (string-append "yq failed reading Chart.yaml .version: "
                         (string-trim (stderr-of r))))
        "")
      (else
        (let ((v (string-trim (stdout-of r))))
          (cond
            ((equal? v "null") "")
            ((equal? v "") "")
            ((not (chart-version-ok? v))
              (log-error
                (string-append "Chart.yaml .version is '" v
                               "', which is not a semver. Refusing to bump it."))
              "")
            (else v)))))))

;; Compute next semver per bump-type. Helm has no built-in
;; equivalent of `cargo set-version --bump` so we do it ourselves.
(define (bump-semver version type)
  (let*
    ((parts (string-split version "."))
      (major-s (if (>= (length parts) 1) (car parts) "0"))
      (minor-s (if (>= (length parts) 2) (car (cdr parts)) "0"))
      (patch-s (if (>= (length parts) 3) (car (cdr (cdr parts))) "0"))
      (r
        (exec-capture "sh"
          "-c"
          (string-append
            "echo \""
            major-s
            "-"
            minor-s
            "-"
            patch-s
            "-"
            type
            "\" | awk -F- '"
            "{ if ($4==\"patch\") print $1\".\"$2\".\"$3+1;"
            "  else if ($4==\"minor\") print $1\".\"$2+1\".0\";"
            "  else if ($4==\"major\") print $1+1\".0.0\"; }'"))))
    (string-trim (stdout-of r))))

(define (write-chart-version new-v)
  ;; yq -i edits Chart.yaml in place, bumping both version + appVersion.
  (let*
    ((r1 (exec-capture "sh" "-c" (string-append "yq -i '.version = \"" new-v "\"' Chart.yaml")))
      (r2
        (exec-capture "sh" "-c" (string-append "yq -i '.appVersion = \"" new-v "\"' Chart.yaml"))))
    (and (= (status-of r1) 0) (= (status-of r2) 0))))

(define (should-bump?)
  (cond ((not (equal? skip-flag "true")) #t) (else (has-changes-since? (last-tag) source-paths))))

;; ── THE SKIP-DETECTOR CARRIES ITS OWN DENOMINATOR ───────────────────────
;;
;; `should-bump?` asks `git diff --quiet <tag> HEAD -- <source-paths>`. Git
;; resolves those pathspecs from the process CWD, and exits 0 — "no changes" —
;; for a pathspec that matches NOTHING just as readily as for one that matches
;; an unchanged file. The two are indistinguishable downstream: both emit
;; `bumped=false`, the ship job is skipped by `if: bumped == 'true'`, and the
;; run is GREEN while the chart ships nowhere.
;;
;; That is not hypothetical — it is the exact failure mode this whole release
;; path exists to end, and adding `chart-path` created a fresh way to reach it:
;; a caller that sets `chart-path: charts/ensaio` AND leaves the old
;; repo-root-relative `source-paths: charts/ensaio/templates ...` produces
;; `charts/ensaio/charts/ensaio/templates`, which matches nothing, forever.
;;
;; So the set being inspected must state its own size. If NOT ONE declared
;; source path exists relative to the CWD, discovery is broken and the action
;; fails loudly rather than reporting a verdict over an empty set. The
;; threshold is "none of them" rather than "all of them" deliberately: a chart
;; legitimately without a `values.yaml` still has `templates` and `Chart.yaml`,
;; so this cannot produce a false red.
(define (existing-path-count paths)
  (cond
    ((null? paths) 0)
    ((path-exists? (car paths)) (+ 1 (existing-path-count (cdr paths))))
    (else (existing-path-count (cdr paths)))))

(define (source-paths-discoverable?)
  (> (existing-path-count (string-split source-paths " ")) 0))

(define (emit-skip msg old-v)
  (log-info msg)
  (append-output (string-append "old-version=" old-v))
  (append-output "bumped=false")
  (append-output "new-version="))

(define (emit-success old-v new-v)
  (log-info (string-append "bumped: " old-v " -> " new-v))
  (append-output (string-append "old-version=" old-v))
  (append-output "bumped=true")
  (append-output (string-append "new-version=" new-v)))

(define (emit-failure msg old-v)
  (log-error msg)
  (append-output (string-append "old-version=" old-v))
  (append-output "bumped=false")
  (append-output "new-version="))

;; TLISP_TEST gate — under the harness the definitions load but no bump runs,
;; so run.test.tlisp can exercise the pure helpers. 46 of this repo's actions
;; already do this; helm-bump did not, which is why it had no test file at all
;; and why the null..1 defect went unwitnessed for as long as it did.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(define old-version (if tlisp-test-mode "" (read-chart-version)))

(cond
  (tlisp-test-mode
    (log-info "TLISP_TEST=1 — helm-bump loaded; main skipped (the harness drives it)"))
  ((not (path-exists? "Chart.yaml"))
    (emit-failure "helm-bump: no Chart.yaml at repo root" "")
    (exit 1))
  ((equal? old-version "") (emit-failure "helm-bump: .version not found in Chart.yaml" "") (exit 1))
  ((not (source-paths-discoverable?))
    (emit-failure
      (string-append
        "helm-bump: NONE of SOURCE_PATHS ('"
        source-paths
        "') exists in the working directory. The skip-detector would run "
        "`git diff` over an EMPTY set, exit 0, and report 'no changes' — a "
        "green run that ships nothing. SOURCE_PATHS is relative to the "
        "chart directory (`chart-path`), so do not repeat that prefix: with "
        "`chart-path: charts/foo` the correct value is "
        "'templates values.yaml Chart.yaml', not 'charts/foo/templates ...'.")
      old-version)
    (exit 1))
  ((not (should-bump?))
    (emit-skip
      (string-append
        "no changes since last tag — skipping (at "
        old-version
        ")")
      old-version)
    (exit 0))
  (else
    (let ((new-v (bump-semver old-version bump-type)))
      (cond
        ((equal? new-v "")
          (emit-failure "helm-bump: failed to compute new version" old-version)
          (exit 1))
        ((write-chart-version new-v) (emit-success old-version new-v) (exit 0))
        (else (emit-failure "helm-bump: failed to write Chart.yaml" old-version) (exit 1))))))
