;; tlisp-lint/run.tlisp — validate every *.tlisp file under the
;; repo. Two layers:
;;
;;   1. Pure-text paren/string/comment balance scan. Catches the
;;      "extra close" and "missing close" class of bug WITHOUT
;;      needing tatara-script to be installed.
;;
;;   2. Parser-level dry-run via tatara-script (if installed) —
;;      catches semantic issues that pass the text scan but trip
;;      the actual parser (e.g. unterminated string literals
;;      inside lambda bodies).
;;
;; Inputs (env):
;;   PATHS                space-separated globs (default "**/*.tlisp")
;;   FAIL_ON_UNBALANCED   "true" | "false"
;;   RUN_PARSER_CHECK     "true" | "false"
;;
;; Outputs (appended):
;;   files-scanned    integer
;;   errors-found     integer (0 on success)

(define paths-input (env-get "PATHS" "**/*.tlisp"))
(define fail-flag (env-get "FAIL_ON_UNBALANCED" "true"))
(define parser-flag (env-get "RUN_PARSER_CHECK" "true"))
;; append-output comes from the STDLIB — a local copy would shadow it, which is
;; precisely the class Layer 4 below now gates. The linter holds itself to it.

;; -------------------------------------------------------------- ;;
;; File discovery — glob the input patterns                        ;;
;; -------------------------------------------------------------- ;;

(define (find-tlisp-files patterns)
  ;; Use shell `find` for simplicity. `glob` exists in tatara-lisp
  ;; for single patterns, but `find -name *.tlisp` is the broadest
  ;; sweep + handles nested dirs uniformly.
  ;;
  ;; Excludes:
  ;;   .git/         — VCS
  ;;   node_modules/ — npm vendoring
  ;;   target/       — Rust build dir
  ;;   _*/           — leading-underscore dirs (e.g. _tlisp-stdlib);
  ;;                   these hold fragment libraries that aren't
  ;;                   self-contained programs.
  (let* ((r (exec-capture "sh" "-c"
              "find . -type f -name '*.tlisp' -not -path './.git/*' -not -path './node_modules/*' -not -path './target/*' -not -path './_*/*' | sort"))
         (out (alist-get r "stdout" "")))
    (cond
      ((equal? (string-trim out) "") (list))
      (else (string-split (string-trim out) "\n")))))

;; -------------------------------------------------------------- ;;
;; Balance scan — char-by-char with state                          ;;
;; -------------------------------------------------------------- ;;
;; Returns ((balance . N) (string-open-line . L)) — N is the final
;; paren depth (0 = balanced); L is the line of an unterminated
;; string literal if any (0 = none).

(define (scan-file path)
  (let ((bal-result (exec-capture "python3" "-c"
                       (string-append
                         "import sys\n"
                         "s=open('" path "').read()\n"
                         "in_str=False; in_comment=False; balance=0; first_neg=0; str_line=0; line=1\n"
                         "i=0\n"
                         "while i<len(s):\n"
                         "    c=s[i]\n"
                         "    if c=='\\n':\n"
                         "        in_comment=False; line+=1\n"
                         "    elif in_comment: pass\n"
                         "    elif in_str:\n"
                         "        if c=='\\\\' and i+1<len(s): i+=1\n"
                         "        elif c=='\"': in_str=False; str_line=0\n"
                         "    elif c==';': in_comment=True\n"
                         "    elif c=='\"': in_str=True; str_line=line\n"
                         "    elif c=='(': balance+=1\n"
                         "    elif c==')':\n"
                         "        balance-=1\n"
                         "        if balance<0 and first_neg==0: first_neg=line\n"
                         "    i+=1\n"
                         "print(f'balance={balance} first_neg={first_neg} unterminated_string_line={str_line}')\n"))))
    (string-trim (alist-get bal-result "stdout" ""))))

;; -------------------------------------------------------------- ;;
;; Per-file lint                                                   ;;
;; -------------------------------------------------------------- ;;

(define (lint-file path)
  ;; Returns the number of errors for this file (0 = clean).
  (let* ((report (scan-file path))
         (balance-zero? (string-contains? report "balance=0"))
         (no-extra-close? (string-contains? report "first_neg=0"))
         (no-unterminated? (string-contains? report "unterminated_string_line=0")))
    (cond
      ((and balance-zero? no-extra-close? no-unterminated?)
       (log-info (string-append "  OK   " path))
       0)
      (else
       (log-error (string-append "  FAIL " path " — " report))
       1))))

;; -------------------------------------------------------------- ;;
;; Main                                                            ;;
;; -------------------------------------------------------------- ;;

;; TLISP_TEST gate — under the harness the definitions load but no scan runs,
;; so run.test.tlisp can drive the pure rule functions (the stdlib-shadow
;; layer's name extraction + baseline diff) with no `find`, no python, no repo.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(define files (if tlisp-test-mode (list) (find-tlisp-files paths-input)))
(define file-count (length files))

(define (lint-all files acc-errors)
  (cond
    ((null? files) acc-errors)
    (else
     (lint-all (cdr files)
               (+ acc-errors (lint-file (car files)))))))

;; ── Layer 3: semantic rule lint ────────────────────────────────
;; Re-invoke this tatara-script binary's `lint` subcommand (the
;; git-mutation-discard rule + any future rules in tatara-lisp-lint)
;; over the repo. The binary is on PATH because the tatara-script@v1
;; action that runs this script installed it there. Capability-probed
;; via --help so it no-ops cleanly on a tatara-script that predates
;; the `lint` subcommand (no shell — exec-capture is the typed
;; subprocess surface).
(define (semantic-rule-errors)
  (let* ((help (exec-capture "tatara-script" "--help"))
         (help-text (string-append (stdout-of help) (stderr-of help))))
    (cond
      ((not (string-contains? help-text "lint [path"))
       (log-info "  semantic rule lint skipped (tatara-script has no lint subcommand yet)")
       0)
      (else
       (let ((r (exec-capture "tatara-script" "lint" ".")))
         (cond
           ((= (status-of r) 0)
            (log-info "  semantic rule lint: clean")
            0)
           (else
            (log-error (string-trim (stdout-of r)))
            1)))))))

;; ── Layer 4: stdlib shadowing ──────────────────────────────────
;; action.yml concatenates `_tlisp-stdlib/stdlib.tlisp` FIRST and the action's
;; `run.tlisp` SECOND, and a later top-level `(define …)` WINS. So any name an
;; action re-defines silently shadows the stdlib's original — and the action
;; keeps its private copy forever, including every bug the stdlib has since
;; fixed and every fix the stdlib has since gained.
;;
;; That is not hypothetical. `rust-workspace-publish` carried its own
;; `dep-missing-on-line?`, narrowed until it matched nothing cargo actually
;; emits; the stdlib's `cargo-publish-dep-missing-line?` matched the real log
;; correctly and was never reached. Result: a textbook sibling-ordering failure
;; classified as "no recognizable signature" → exit 1, and the whole
;; tatara-lisp 0.3.x line sat unpublished at 0.2.5 while every run was
;; "green then red for no visible reason". The same shadowing also withheld the
;; stdlib's 403-not-an-owner conflict arm and its "429 Too Many" rate-limit arm
;; from that action.
;;
;; Existing shadows are BASELINED (reported every run, never silently accepted)
;; exactly like runtime-install-lint's debt list; only a NEW one fails. Removing
;; a baseline row — delete the local copy, use the stdlib — is the path to zero.

(define stdlib-src-path "_tlisp-stdlib/stdlib.tlisp")
(define shadow-baseline-path "tlisp-lint/stdlib-shadow-baseline.txt")

;; "(define (foo a b)" → "foo" ; "(define bar 1)" → "bar" ; else "".
;; Only column-0 defines count: an inner `(define …)` is scoped to its body and
;; shadows nothing at top level.
(define (top-level-define-name line)
  (cond
    ((not (string-prefix? line "(define ")) "")
    (else
      (let* ((rest (string-replace line "(define " ""))
             (bare (if (string-prefix? rest "(") (string-replace rest "(" "") rest))
             (head (car (string-split (string-trim bare) " "))))
        (car (string-split (car (string-split head ")")) "\t"))))))

(define (collect-define-names lines acc)
  (cond
    ((null? lines) (reverse acc))
    (else
      (let ((n (top-level-define-name (car lines))))
        (collect-define-names (cdr lines) (if (equal? n "") acc (cons n acc)))))))

(define (define-names-in path)
  (if (path-exists? path)
    (collect-define-names (string-split (read-file path) "\n") (list))
    (list)))

(define (name-member? x xs)
  (cond ((null? xs) #f) ((equal? (car xs) x) #t) (else (name-member? x (cdr xs)))))

;; every name in `names` that the stdlib also defines at top level
(define (shadowed-names names stdlib-names)
  (filter (lambda (n) (name-member? n stdlib-names)) names))

;; one baseline row per shadow: "<path>\t<name>", path repo-relative.
;; `find .` yields "./x/run.tlisp"; the baseline stores "x/run.tlisp", so the
;; row must not depend on how the file was discovered — an un-normalized path
;; makes every baselined row read as NEW and the gate is red for everyone.
(define (repo-relative path)
  (if (string-prefix? path "./") (string-replace path "./" "") path))

(define (shadow-row path name) (string-append (repo-relative path) "\t" name))

(define baselined-shadows
  (if (path-exists? shadow-baseline-path)
    (filter (lambda (l) (and (not (equal? (string-trim l) ""))
                             (not (string-prefix? (string-trim l) "#"))))
            (string-split (read-file shadow-baseline-path) "\n"))
    (list)))

(define (new-shadow-rows path names stdlib-names)
  (filter (lambda (row) (not (name-member? row baselined-shadows)))
          (map (lambda (n) (shadow-row path n))
               (shadowed-names names stdlib-names))))

(define (shadow-errors-for path stdlib-names)
  (let* ((all (shadowed-names (define-names-in path) stdlib-names))
         (new (new-shadow-rows path (define-names-in path) stdlib-names)))
    (cond
      ((null? all) 0)
      ((null? new)
       (log-info (string-append "  shadow (baselined) " path " — "
                                (string-join "," all)))
       0)
      (else
        (log-error (string-append "  NEW STDLIB SHADOW " path " — "
                                  (string-join "," new)
                                  " : delete the local copy and use the stdlib's, "
                                  "or add the row to " shadow-baseline-path))
        (length new)))))

(define (shadow-errors files stdlib-names acc)
  (cond
    ((null? files) acc)
    (else (shadow-errors (cdr files) stdlib-names
                         (+ acc (shadow-errors-for (car files) stdlib-names))))))

(define (stdlib-shadow-errors)
  (cond
    ((not (path-exists? stdlib-src-path))
     (log-info "  stdlib shadow check skipped (no _tlisp-stdlib/stdlib.tlisp here)")
     0)
    (else (shadow-errors files (define-names-in stdlib-src-path) 0))))

;; ── Layer 5: differently-named stdlib reimplementation ─────────────────
;; THE OPEN HALF OF LAYER 4, now closed enough to catch the historical defect.
;;
;; Layer 4 intersects define NAMES. The defect it was built for never collided
;; on a name: the local predicate was `dep-missing-on-line?` and the stdlib's is
;; `cargo-publish-dep-missing-line?`. Layer 4 caught that FILE only by accident
;; (it also re-declared `any-line-matches?`). A fresh file carrying the exact
;; historical body under its original name passed clean — MEASURED.
;;
;; The observation that closes it: a predicate over a FOREIGN TOOL'S DIAGNOSTIC
;; TEXT is identified not by its name but by the diagnostic string it matches.
;; Two functions that both test cargo's "failed to select a version" are the
;; same predicate no matter what they are called. So: a long, sentence-shaped
;; string literal that the stdlib already owns must not be re-typed inside an
;; action. If you need that match, call the stdlib predicate.
;;
;; A phrase rule was tried and rejected once before, correctly — a bare
;; `"version"` hits 8 actions and a noisy gate gets deleted. This one is
;; narrowed on THREE axes, and the narrowing was measured, not guessed:
;;   (a) COMMENTS ARE STRIPPED. Un-stripped, this rule flags 14 rows, and 6 of
;;       them are prose in `rust-workspace-publish`'s own comments explaining
;;       the historical bug. Stripped: 8 rows.
;;   (b) length ≥ 16 AND contains a space — a diagnostic sentence, not a word.
;;   (c) no shell/interpolation metacharacter (> | & $). That drops the
;;       `' >/dev/null 2>&1'` family (5 of the 8 remaining rows), which is
;;       shell plumbing every action legitimately writes, not a diagnostic.
;; Matching is CONTAINMENT in either direction, because the historical local
;; literal was `"failed to select a version"` — a strict PREFIX of the stdlib's
;; `"failed to select a version for"`. Equality alone would have missed it.
;;
;; TIER: CI-caught, and only a HEURISTIC even then. It catches a reimplementation
;; that re-types the diagnostic; it does NOT catch one that reconstructs the
;; same match from shorter fragments, computes it, or duplicates a stdlib
;; function whose body contains no long literal at all. Do not round this up to
;; "the class is sealed" — the honest claim is "the historical instance, and
;; anything shaped like it, is now caught".
;;
;; KNOWN LIMIT in the extractor: literals are recovered per LINE by splitting on
;; `"`, so a string containing an escaped `\"` or spanning lines is mis-parsed
;; (a false NEGATIVE — it under-reports, never over-reports). Layer 1 already
;; owns unterminated-string detection.

(define literal-baseline-path "tlisp-lint/stdlib-literal-baseline.txt")

;; Pieces of a line split on `"` alternate code / literal / code / literal…
;; A `;` inside a CODE piece starts a comment: stop the line there. This is
;; what makes prose about a bug distinguishable from the bug.
(define (line-literals-walk pieces in-str acc)
  (cond
    ((null? pieces) (reverse acc))
    (in-str (line-literals-walk (cdr pieces) #f (cons (car pieces) acc)))
    ((string-contains? (car pieces) ";") (reverse acc))
    (else (line-literals-walk (cdr pieces) #t acc))))

(define (line-code-literals line)
  (line-literals-walk (string-split line "\"") #f (list)))

;; A diagnostic-shaped literal: a sentence, not a word, and not shell plumbing.
(define (diagnostic-literal? s)
  (and (>= (string-length s) 16)
       (string-contains? s " ")
       (not (string-contains? s ">"))
       (not (string-contains? s "|"))
       (not (string-contains? s "&"))
       (not (string-contains? s "$"))))

(define (collect-diagnostic-literals lines acc)
  (cond
    ((null? lines) acc)
    (else
      (collect-diagnostic-literals
        (cdr lines)
        (append acc (filter diagnostic-literal? (line-code-literals (car lines))))))))

(define (diagnostic-literals-in path)
  (if (path-exists? path)
    (collect-diagnostic-literals (string-split (read-file path) "\n") (list))
    (list)))

;; #t iff either literal contains the other — the prefix case is the one that
;; matters (`"failed to select a version"` ⊂ `"failed to select a version for"`).
(define (literal-kin? a b)
  (or (equal? a b) (string-contains? a b) (string-contains? b a)))

(define (kin-stdlib-literal lit stdlib-lits)
  (cond
    ((null? stdlib-lits) "")
    ((literal-kin? lit (car stdlib-lits)) (car stdlib-lits))
    (else (kin-stdlib-literal lit (cdr stdlib-lits)))))

(define literal-baselined
  (if (path-exists? literal-baseline-path)
    (filter (lambda (l) (and (not (equal? (string-trim l) ""))
                             (not (string-prefix? (string-trim l) "#"))))
            (string-split (read-file literal-baseline-path) "\n"))
    (list)))

;; The baseline key trims the literal: leading/trailing whitespace is never the
;; identifying part of a diagnostic, and a row ending in a space is a file even
;; a careful editor will silently "clean". Found by running the gate — the
;; `"Authorization: token "` row has a trailing space and never matched.
(define (literal-row path lit)
  (string-append (repo-relative path) "\t" (string-trim lit)))

;; `*.test.tlisp` is EXEMPT, and this is a rule not an oversight. A test file's
;; job is to hold a foreign tool's VERBATIM output as evidence — the whole point
;; of rust-workspace-publish's fixtures is that they are the real cargo log and
;; not a paraphrase. Flagging them would flag exactly the thing we want authors
;; to do, and the first person to hit it would delete the layer. MEASURED: with
;; test files included the gate reported 20 errors, essentially all of them
;; fixtures and `deftest` titles; excluded, it reports the real duplication.
(define (literal-exempt-file? path) (string-suffix? path ".test.tlisp"))

(define (literal-errors-for path stdlib-lits)
  (let* ((kin (if (literal-exempt-file? path)
                (list)
                (filter (lambda (l) (not (equal? (kin-stdlib-literal l stdlib-lits) "")))
                        (diagnostic-literals-in path))))
         (rows (map (lambda (l) (literal-row path l)) kin))
         (new (filter (lambda (r) (not (name-member? r literal-baselined))) rows)))
    (cond
      ((null? kin) 0)
      ((null? new)
       (log-info (string-append "  stdlib literal (baselined) " path " — "
                                (string-join "," kin)))
       0)
      (else
        (log-error
          (string-append
            "  STDLIB DIAGNOSTIC LITERAL RE-TYPED " path " — "
            (string-join " | " new)
            " : this literal already lives in " stdlib-src-path
            " (as " (kin-stdlib-literal (car kin) stdlib-lits)
            "). A predicate over a foreign tool's diagnostic text belongs in the "
            "stdlib exactly once — call the stdlib's predicate instead of "
            "re-typing its match. That is the differently-named reimplementation "
            "that stalled tatara-lisp 0.3.x. If this really is unrelated, add the "
            "row to " literal-baseline-path))
        (length new)))))

(define (literal-errors files stdlib-lits acc)
  (cond
    ((null? files) acc)
    (else (literal-errors (cdr files) stdlib-lits
                          (+ acc (literal-errors-for (car files) stdlib-lits))))))

(define (stdlib-literal-errors)
  (cond
    ((not (path-exists? stdlib-src-path))
     (log-info "  stdlib literal check skipped (no _tlisp-stdlib/stdlib.tlisp here)")
     0)
    (else (literal-errors files (diagnostic-literals-in stdlib-src-path) 0))))

;; ── Layer 6: crash-certain forms ───────────────────────────────────────
;; THE CLASS: a form that is not a parse error, not an unbalanced paren, not a
;; stdlib duplication — and is a GUARANTEED hard error the moment control
;; reaches it. Layers 1–5 all certify these files clean, and so does
;; `tatara-script lint`.
;;
;; The mechanism matters, because it dictates the shape of the fix. These do NOT
;; fail at load. MEASURED 2026-07-30:
;;
;;     $ cat > /tmp/x.tlisp <<'EOF'
;;     (define (never-called) (let loop ((x 1)) x))
;;     (log-info "loaded fine")
;;     EOF
;;     $ tatara-script /tmp/x.tlisp
;;     [..] INFO loaded fine        ← exit 0
;;
;; The error `bad `let`: bindings must be a list` fires only when
;; `never-called` is CALLED. So you cannot catch this by loading the file; it
;; needs STATIC detection. `helm-deploy` was the textbook instance: its
;; `split-flag-args` returned early on empty input, so the action ran green
;; forever and died the first time anybody passed `--set`.
;;
;; Two forms, both fully derived — nothing about the language is hand-listed
;; here:
;;
;;   6a NAMED LET.  `(let loop ((x 1)) …)`. tatara-script has no named let, and
;;      neither do `let*`/`letrec` — all three reject an atom where the bindings
;;      list must be. Found by `crash-certain-reader.py`, which is a real
;;      s-expression reader, so a named let quoted inside a COMMENT or a STRING
;;      is not a hit.
;;
;;   6b WRONG ARITY ON AN INTERPRETER PRIMITIVE.  The arity table is READ OUT OF
;;      THE LIVE INTERPRETER, not typed in. `Interpreter::apply` checks arity
;;      BEFORE it invokes the callable, and the caught error value carries the
;;      whole verdict:
;;
;;        (try (string-replace #f #f #f #f) (catch (e) e))
;;        => Error(arity-mismatch: `string-replace` expected Exact(3), got 4)
;;
;;      So probing every call head in the repo at a deliberately absurd
;;      argument count yields the interpreter's own table. Because the arity
;;      check precedes invocation, a probe that lands on an arity error CANNOT
;;      run the primitive's body — and a probe that misses (a variadic) hits the
;;      argument marshaller first: `(exec-capture #f ×23)` returns
;;      `expected string, got bool`, it does not execute anything. That is why
;;      the dummy argument is `#f` and not `""`.
;;
;; SCOPE, stated honestly rather than rounded up:
;;   * Only `Exact(n)` is gated. `Range(a, b)` is reported by the interpreter
;;     too, but this script has no string→number primitive (`string->number`,
;;     `parse-int`: both unbound — measured), so the check is a string equality
;;     against n and a range cannot be compared. Range-arity primitives are
;;     UNGATED.
;;   * Only NATIVE primitives are gated — a probe whose error names a
;;     `<closure>` instead of the probed name is dropped. stdlib closures are
;;     legitimately rebound by actions (Layer 4's baseline is the evidence), so
;;     gating them would fight a pattern this repo permits.
;;   * A head the reader sees but the interpreter does not know (an action's own
;;     define, a let-bound local) probes as `unbound-symbol` and is skipped, so
;;     user functions are never arity-checked.
;;
;; TIER: CI-caught. Both forms stay perfectly writable — nothing in the type
;; system or the parser stops you. This gate is the only thing that objects,
;; and it objects only where it runs.

(define crash-baseline-path "tlisp-lint/crash-certain-baseline.txt")

;; `ACTION_PATH` is exported by action.yml (`${{ github.action_path }}`), because
;; on a runner this script is a STRING passed to the tatara-script action and has
;; no idea where its own sidecar lives. Locally (repo root) the fallback holds.
(define crash-reader-script
  (let ((ap (env-get "ACTION_PATH" "")))
    (if (equal? ap "")
      "tlisp-lint/crash-certain-reader.py"
      (string-append ap "/crash-certain-reader.py"))))

(define lint-tmp-dir (env-get "RUNNER_TEMP" "/tmp"))
(define crash-files-list (string-append lint-tmp-dir "/tlisp-lint-files.txt"))
(define crash-probe-path (string-append lint-tmp-dir "/tlisp-lint-arity-probe.tlisp"))
(define crash-arity-path (string-append lint-tmp-dir "/tlisp-lint-arity.txt"))

(define crash-baselined
  (if (path-exists? crash-baseline-path)
    (filter (lambda (l) (and (not (equal? (string-trim l) ""))
                             (not (string-prefix? (string-trim l) "#"))))
            (string-split (read-file crash-baseline-path) "\n"))
    (list)))

;; A reader row is TSV. `row-field` is 0-indexed and total about which field is
;; which, so a format change is a visible edit rather than a silent off-by-one.
;; `nth` is (index list) and returns nil past the end — the explicit length
;; guard keeps a short row from putting a nil into a string-append.
(define (row-field row n)
  (let ((parts (string-split row "\t")))
    (if (> (length parts) n) (nth n parts) "")))

(define (rows-of-kind rows kind)
  (filter (lambda (r) (equal? (row-field r 0) kind)) rows))

(define (nonblank-lines text)
  (filter (lambda (l) (not (equal? (string-trim l) "")))
          (string-split text "\n")))

;; ── 6b step 1: ask the interpreter for the arity of one head ───────────
;; 23 dummy arguments: absurd enough that no primitive in the fleet declares it,
;; so an Exact/Range primitive always answers with an arity error.
(define arity-probe-dummies
  "#f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f")

(define (arity-probe-line head)
  (string-append "(log-info (string-append \"ARITYPROBE\\t" head "\\t\" "
                 "(string-format \"{}\" (try (" head " " arity-probe-dummies
                 ") (catch (e) e)))))"))

(define (arity-probe-source heads)
  (string-join "\n" (map arity-probe-line heads)))

;; "…arity-mismatch: `string-replace` expected Exact(3), got 23" -> "3".
;; "" for anything else: a Range, a closure, an unbound symbol, a special form.
(define (probe-exact-arity head verdict)
  (cond
    ((not (string-contains? verdict "arity-mismatch")) "")
    ;; NATIVE ONLY: the verdict must name the head we probed. A `<closure>`
    ;; verdict means a stdlib lisp function, which an action may rebind.
    ((not (string-contains? verdict (string-append "`" head "`"))) "")
    ((not (string-contains? verdict "expected Exact(")) "")
    (else
      (let* ((tail (car (cdr (string-split verdict "expected Exact("))))
             (num (car (string-split tail ")"))))
        (string-trim num)))))

(define (probe-row->arity-row line)
  (cond
    ((not (string-contains? line "ARITYPROBE\t")) "")
    (else
      (let* ((payload (car (cdr (string-split line "ARITYPROBE\t"))))
             (head (row-field payload 0))
             (verdict (row-field payload 1))
             (n (probe-exact-arity head verdict)))
        (if (equal? n "") "" (string-append head "\t" n))))))

(define (derive-arity-table heads)
  (write-file crash-probe-path (arity-probe-source heads))
  (let* ((r (exec-capture "tatara-script" crash-probe-path))
         (text (string-append (stdout-of r) (stderr-of r)))
         (rows (filter (lambda (x) (not (equal? x "")))
                       (map probe-row->arity-row (nonblank-lines text)))))
    rows))

;; ── 6b step 2 + 6a: report ────────────────────────────────────────────
(define (crash-row-new? row) (not (name-member? row crash-baselined)))

(define (namedlet-row row)
  ;; NAMEDLET \t path \t line \t form  ->  "<path>:<line>\tnamed-<form>"
  (string-append (repo-relative (row-field row 1)) ":" (row-field row 2)
                 "\tnamed-" (row-field row 3)))

(define (arityviol-row row)
  ;; ARITYVIOL \t path \t line \t head \t got \t want
  (string-append (repo-relative (row-field row 1)) ":" (row-field row 2)
                 "\t" (row-field row 3) "/" (row-field row 4)
                 " (wants " (row-field row 5) ")"))

(define (report-crash-rows label rows explain)
  (let ((new (filter crash-row-new? rows)))
    (cond
      ((null? rows) 0)
      ((null? new)
       (log-info (string-append "  " label " (baselined) — "
                                (string-join " | " rows)))
       0)
      (else
        (log-error (string-append "  CRASH-CERTAIN " label " — "
                                  (string-join " | " new)
                                  " : " explain
                                  " If this really is unreachable-and-intended, "
                                  "add the row to " crash-baseline-path))
        (length new)))))

(define (crash-certain-errors)
  (cond
    ((not (path-exists? crash-reader-script))
     (log-info (string-append "  crash-certain check skipped (no "
                              crash-reader-script ")"))
     0)
    ((null? files)
     0)
    (else
      (write-file crash-files-list (string-join "\n" files))
      (let* ((hr (exec-capture "python3" crash-reader-script "heads" crash-files-list)))
        (cond
          ((not (= (status-of hr) 0))
           (log-error (string-append "  crash-certain reader failed: "
                                     (string-trim (stderr-of hr))))
           1)
          (else
            (let* ((rows (nonblank-lines (stdout-of hr)))
                   (namedlets (map namedlet-row (rows-of-kind rows "NAMEDLET")))
                   (heads (map (lambda (r) (row-field r 1)) (rows-of-kind rows "HEAD")))
                   (namedlet-errs
                     (report-crash-rows
                       "named let"
                       namedlets
                       (string-append
                         "tatara-script has NO named let — `(let name ((v e)) …)` "
                         "is a hard `bad `let`: bindings must be a list` the "
                         "moment control reaches it, and it does NOT fail at "
                         "load. Port it to a named `(define (name v) …)` plus a "
                         "call, exactly as the fixed actions do.")))
                   (arity-rows (derive-arity-table heads)))
              (write-file crash-arity-path (string-join "\n" arity-rows))
              (let* ((ar (exec-capture "python3" crash-reader-script "arity"
                                       crash-files-list crash-arity-path))
                     (viols (map arityviol-row
                                 (rows-of-kind (nonblank-lines (stdout-of ar))
                                               "ARITYVIOL"))))
                (log-info (string-append "  arity table derived from the live "
                                         "interpreter: "
                                         (string-format "{}" (length arity-rows))
                                         " Exact-arity primitives over "
                                         (string-format "{}" (length heads))
                                         " call heads"))
                (+ namedlet-errs
                   (report-crash-rows
                     "wrong arity"
                     viols
                     (string-append
                       "the interpreter rejects this argument count for this "
                       "primitive — an arity mismatch is a hard error at the "
                       "call, so this code path can only crash. The count in "
                       "parentheses is what the running interpreter itself "
                       "reported.")))))))))))

(define (lint-main)
  (log-info (string-append "scanning " (string-format "{}" file-count)
                           " .tlisp files under " paths-input))
  (let ((total-errors (+ (lint-all files 0)
                         (semantic-rule-errors)
                         (stdlib-shadow-errors)
                         (stdlib-literal-errors)
                         (crash-certain-errors))))
    (append-output (string-append "files-scanned=" (string-format "{}" file-count)))
    (append-output (string-append "errors-found=" (string-format "{}" total-errors)))
    (cond
      ((= total-errors 0)
       (log-info (string-append "all " (string-format "{}" file-count) " files clean"))
       0)
      ((equal? fail-flag "true")
       (log-error (string-append (string-format "{}" total-errors) " file(s) failed lint"))
       1)
      (else
       (log-info (string-append (string-format "{}" total-errors)
                                " file(s) failed lint — continuing (fail-on-unbalanced=false)"))
       0))))

(cond
  (tlisp-test-mode
   (log-info "TLISP_TEST=1 — linter loaded; main skipped (the test harness drives it)"))
  (else
    (exit (lint-main))))
