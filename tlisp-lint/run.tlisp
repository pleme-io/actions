;; tlisp-lint/run.tlisp — validate every *.tlisp file under the
;; repo. Two layers:
;;
;;   1. Pure-text paren/string/comment balance scan. Catches the
;;      "extra close" and "missing close" class of bug WITHOUT
;;      needing tatara-script to be installed.
;;
;;   2. Parser-level dry-run via tatara-script (if installed) —
;;      catches semantic issues that pass the text scan but trip
;;      the actual parser (e.g. unterminated string literals
;;      inside lambda bodies).
;;
;; Inputs (env):
;;   PATHS                space-separated globs (default "**/*.tlisp")
;;   FAIL_ON_UNBALANCED   "true" | "false"
;;   RUN_PARSER_CHECK     "true" | "false"
;;
;; Outputs (appended):
;;   files-scanned    integer
;;   errors-found     integer (0 on success)

(define paths-input (env-get "PATHS" "**/*.tlisp"))
(define fail-flag (env-get "FAIL_ON_UNBALANCED" "true"))
(define parser-flag (env-get "RUN_PARSER_CHECK" "true"))
;; append-output comes from the STDLIB — a local copy would shadow it, which is
;; precisely the class Layer 4 below now gates. The linter holds itself to it.

;; -------------------------------------------------------------- ;;
;; File discovery — glob the input patterns                        ;;
;; -------------------------------------------------------------- ;;

(define (find-tlisp-files patterns)
  ;; Use shell `find` for simplicity. `glob` exists in tatara-lisp
  ;; for single patterns, but `find -name *.tlisp` is the broadest
  ;; sweep + handles nested dirs uniformly.
  ;;
  ;; Excludes:
  ;;   .git/         — VCS
  ;;   node_modules/ — npm vendoring
  ;;   target/       — Rust build dir
  ;;   _*/           — leading-underscore dirs (e.g. _tlisp-stdlib);
  ;;                   these hold fragment libraries that aren't
  ;;                   self-contained programs.
  (let* ((r (exec-capture "sh" "-c"
              "find . -type f -name '*.tlisp' -not -path './.git/*' -not -path './node_modules/*' -not -path './target/*' -not -path './_*/*' | sort"))
         (out (alist-get r "stdout" "")))
    (cond
      ((equal? (string-trim out) "") (list))
      (else (string-split (string-trim out) "\n")))))

;; -------------------------------------------------------------- ;;
;; Balance scan — char-by-char with state                          ;;
;; -------------------------------------------------------------- ;;
;; Returns ((balance . N) (string-open-line . L)) — N is the final
;; paren depth (0 = balanced); L is the line of an unterminated
;; string literal if any (0 = none).

(define (scan-file path)
  (let ((bal-result (exec-capture "python3" "-c"
                       (string-append
                         "import sys\n"
                         "s=open('" path "').read()\n"
                         "in_str=False; in_comment=False; balance=0; first_neg=0; str_line=0; line=1\n"
                         "i=0\n"
                         "while i<len(s):\n"
                         "    c=s[i]\n"
                         "    if c=='\\n':\n"
                         "        in_comment=False; line+=1\n"
                         "    elif in_comment: pass\n"
                         "    elif in_str:\n"
                         "        if c=='\\\\' and i+1<len(s): i+=1\n"
                         "        elif c=='\"': in_str=False; str_line=0\n"
                         "    elif c==';': in_comment=True\n"
                         "    elif c=='\"': in_str=True; str_line=line\n"
                         "    elif c=='(': balance+=1\n"
                         "    elif c==')':\n"
                         "        balance-=1\n"
                         "        if balance<0 and first_neg==0: first_neg=line\n"
                         "    i+=1\n"
                         "print(f'balance={balance} first_neg={first_neg} unterminated_string_line={str_line}')\n"))))
    (string-trim (alist-get bal-result "stdout" ""))))

;; -------------------------------------------------------------- ;;
;; Per-file lint                                                   ;;
;; -------------------------------------------------------------- ;;

(define (lint-file path)
  ;; Returns the number of errors for this file (0 = clean).
  (let* ((report (scan-file path))
         (balance-zero? (string-contains? report "balance=0"))
         (no-extra-close? (string-contains? report "first_neg=0"))
         (no-unterminated? (string-contains? report "unterminated_string_line=0")))
    (cond
      ((and balance-zero? no-extra-close? no-unterminated?)
       (log-info (string-append "  OK   " path))
       0)
      (else
       (log-error (string-append "  FAIL " path " — " report))
       1))))

;; -------------------------------------------------------------- ;;
;; Main                                                            ;;
;; -------------------------------------------------------------- ;;

;; TLISP_TEST gate — under the harness the definitions load but no scan runs,
;; so run.test.tlisp can drive the pure rule functions (the stdlib-shadow
;; layer's name extraction + baseline diff) with no `find`, no python, no repo.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(define files (if tlisp-test-mode (list) (find-tlisp-files paths-input)))
(define file-count (length files))

(define (lint-all files acc-errors)
  (cond
    ((null? files) acc-errors)
    (else
     (lint-all (cdr files)
               (+ acc-errors (lint-file (car files)))))))

;; ── Layer 3: semantic rule lint ────────────────────────────────
;; Re-invoke this tatara-script binary's `lint` subcommand (the
;; git-mutation-discard rule + any future rules in tatara-lisp-lint)
;; over the repo. The binary is on PATH because the tatara-script@v1
;; action that runs this script installed it there. Capability-probed
;; via --help so it no-ops cleanly on a tatara-script that predates
;; the `lint` subcommand (no shell — exec-capture is the typed
;; subprocess surface).
(define (semantic-rule-errors)
  (let* ((help (exec-capture "tatara-script" "--help"))
         (help-text (string-append (stdout-of help) (stderr-of help))))
    (cond
      ((not (string-contains? help-text "lint [path"))
       (log-info "  semantic rule lint skipped (tatara-script has no lint subcommand yet)")
       0)
      (else
       (let ((r (exec-capture "tatara-script" "lint" ".")))
         (cond
           ((= (status-of r) 0)
            (log-info "  semantic rule lint: clean")
            0)
           (else
            (log-error (string-trim (stdout-of r)))
            1)))))))

;; ── Layer 4: stdlib shadowing ──────────────────────────────────
;; action.yml concatenates `_tlisp-stdlib/stdlib.tlisp` FIRST and the action's
;; `run.tlisp` SECOND, and a later top-level `(define …)` WINS. So any name an
;; action re-defines silently shadows the stdlib's original — and the action
;; keeps its private copy forever, including every bug the stdlib has since
;; fixed and every fix the stdlib has since gained.
;;
;; That is not hypothetical. `rust-workspace-publish` carried its own
;; `dep-missing-on-line?`, narrowed until it matched nothing cargo actually
;; emits; the stdlib's `cargo-publish-dep-missing-line?` matched the real log
;; correctly and was never reached. Result: a textbook sibling-ordering failure
;; classified as "no recognizable signature" → exit 1, and the whole
;; tatara-lisp 0.3.x line sat unpublished at 0.2.5 while every run was
;; "green then red for no visible reason". The same shadowing also withheld the
;; stdlib's 403-not-an-owner conflict arm and its "429 Too Many" rate-limit arm
;; from that action.
;;
;; Existing shadows are BASELINED (reported every run, never silently accepted)
;; exactly like runtime-install-lint's debt list; only a NEW one fails. Removing
;; a baseline row — delete the local copy, use the stdlib — is the path to zero.

(define stdlib-src-path "_tlisp-stdlib/stdlib.tlisp")
(define shadow-baseline-path "tlisp-lint/stdlib-shadow-baseline.txt")

;; "(define (foo a b)" → "foo" ; "(define bar 1)" → "bar" ; else "".
;; Only column-0 defines count: an inner `(define …)` is scoped to its body and
;; shadows nothing at top level.
(define (top-level-define-name line)
  (cond
    ((not (string-prefix? line "(define ")) "")
    (else
      (let* ((rest (string-replace line "(define " ""))
             (bare (if (string-prefix? rest "(") (string-replace rest "(" "") rest))
             (head (car (string-split (string-trim bare) " "))))
        (car (string-split (car (string-split head ")")) "\t"))))))

(define (collect-define-names lines acc)
  (cond
    ((null? lines) (reverse acc))
    (else
      (let ((n (top-level-define-name (car lines))))
        (collect-define-names (cdr lines) (if (equal? n "") acc (cons n acc)))))))

(define (define-names-in path)
  (if (path-exists? path)
    (collect-define-names (string-split (read-file path) "\n") (list))
    (list)))

(define (name-member? x xs)
  (cond ((null? xs) #f) ((equal? (car xs) x) #t) (else (name-member? x (cdr xs)))))

;; every name in `names` that the stdlib also defines at top level
(define (shadowed-names names stdlib-names)
  (filter (lambda (n) (name-member? n stdlib-names)) names))

;; one baseline row per shadow: "<path>\t<name>", path repo-relative.
;; `find .` yields "./x/run.tlisp"; the baseline stores "x/run.tlisp", so the
;; row must not depend on how the file was discovered — an un-normalized path
;; makes every baselined row read as NEW and the gate is red for everyone.
(define (repo-relative path)
  (if (string-prefix? path "./") (string-replace path "./" "") path))

(define (shadow-row path name) (string-append (repo-relative path) "\t" name))

(define baselined-shadows
  (if (path-exists? shadow-baseline-path)
    (filter (lambda (l) (and (not (equal? (string-trim l) ""))
                             (not (string-prefix? (string-trim l) "#"))))
            (string-split (read-file shadow-baseline-path) "\n"))
    (list)))

(define (new-shadow-rows path names stdlib-names)
  (filter (lambda (row) (not (name-member? row baselined-shadows)))
          (map (lambda (n) (shadow-row path n))
               (shadowed-names names stdlib-names))))

(define (shadow-errors-for path stdlib-names)
  (let* ((all (shadowed-names (define-names-in path) stdlib-names))
         (new (new-shadow-rows path (define-names-in path) stdlib-names)))
    (cond
      ((null? all) 0)
      ((null? new)
       (log-info (string-append "  shadow (baselined) " path " — "
                                (string-join "," all)))
       0)
      (else
        (log-error (string-append "  NEW STDLIB SHADOW " path " — "
                                  (string-join "," new)
                                  " : delete the local copy and use the stdlib's, "
                                  "or add the row to " shadow-baseline-path))
        (length new)))))

(define (shadow-errors files stdlib-names acc)
  (cond
    ((null? files) acc)
    (else (shadow-errors (cdr files) stdlib-names
                         (+ acc (shadow-errors-for (car files) stdlib-names))))))

(define (stdlib-shadow-errors)
  (cond
    ((not (path-exists? stdlib-src-path))
     (log-info "  stdlib shadow check skipped (no _tlisp-stdlib/stdlib.tlisp here)")
     0)
    (else (shadow-errors files (define-names-in stdlib-src-path) 0))))

(define (lint-main)
  (log-info (string-append "scanning " (string-format "{}" file-count)
                           " .tlisp files under " paths-input))
  (let ((total-errors (+ (lint-all files 0)
                         (semantic-rule-errors)
                         (stdlib-shadow-errors))))
    (append-output (string-append "files-scanned=" (string-format "{}" file-count)))
    (append-output (string-append "errors-found=" (string-format "{}" total-errors)))
    (cond
      ((= total-errors 0)
       (log-info (string-append "all " (string-format "{}" file-count) " files clean"))
       0)
      ((equal? fail-flag "true")
       (log-error (string-append (string-format "{}" total-errors) " file(s) failed lint"))
       1)
      (else
       (log-info (string-append (string-format "{}" total-errors)
                                " file(s) failed lint — continuing (fail-on-unbalanced=false)"))
       0))))

(cond
  (tlisp-test-mode
   (log-info "TLISP_TEST=1 — linter loaded; main skipped (the test harness drives it)"))
  (else
    (exit (lint-main))))
