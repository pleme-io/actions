;; helm-oci-publish/run.tlisp — lint + package + push a Helm chart.
;;
;; Tries `nix run .#forge -- helm release ...` first; falls back to
;; `nix shell nixpkgs#kubernetes-helm` for lint/package/push if forge
;; isn't exposed in the consumer's flake.
;;
;; Inputs (env):
;;   CHART_PATH      — path to the chart directory (must contain Chart.yaml),
;;                     or the PARENT directory when CHARTS names the charts
;;   CHARTS          — newline-separated chart names under CHART_PATH; empty
;;                     (default) publishes the single chart at CHART_PATH.
;;                     Non-empty republishes exactly the named charts — the
;;                     changed-only list from actions/changed-charts. GitHub
;;                     startup_fails a job that combines `uses:` with
;;                     `strategy.matrix` (measured 2026-11-21, helmworks runs
;;                     44862261383/44862322663), so the changed-only loop
;;                     lives HERE, in an action, not a workflow matrix.
;;   REGISTRY        — oci:// URL
;;   VERSION         — optional override; empty means "use Chart.yaml's version"
;;   LIB_CHART_DIR   — optional sibling library chart dir (for file:// deps)
;;   LIB_CHART_NAME  — library chart name (default "pleme-lib")
;;
;; Pre-condition: helm registry login already done by the caller
;; workflow (the docker/login-equivalent for OCI Helm). Nix already
;; installed.

;; INPUT_* (Docker mode) preferred; bare names retained as composite fallback.
(define chart-path (env-get "INPUT_CHART_PATH" (env-get "CHART_PATH" "")))

(define registry (env-get "INPUT_REGISTRY" (env-get "REGISTRY" "")))

(define version (env-get "INPUT_VERSION" (env-get "VERSION" "")))

(define lib-chart-dir (env-get "INPUT_LIB_CHART_DIR" (env-get "LIB_CHART_DIR" "")))

(define lib-chart-name (env-get "INPUT_LIB_CHART_NAME" (env-get "LIB_CHART_NAME" "pleme-lib")))

(define charts-list
  (filter (lambda (n) (not (equal? n "")))
          (map string-trim (string-split (env-get "CHARTS" "") "\n"))))

(when (or (equal? chart-path "") (equal? registry ""))
  (log-error "helm-oci-publish: missing INPUT_CHART_PATH or INPUT_REGISTRY")
  (exit 1))

(define (forge-available?) (exec-ok? "nix" "run" ".#forge" "--" "--help"))

(define (file-exists? p) (erro:ok? (proc:run (list "test" "-f" p))))

(define (helm-sh arg-string)
  (exec-check "nix" "shell" "nixpkgs#kubernetes-helm" "--command" "sh" "-c" arg-string))

(define (publish-one path)
  ;; lint, package into a per-chart dist dir (a shared dist/ would let one
  ;; chart's tgz be pushed twice while another's is skipped — the glob
  ;; picks head -n1), then push exactly that tgz.
  (define (basename-of p)
    (define segs (filter (lambda (s) (not (equal? s ""))) (string-split p "/")))
    (cond
      ((null? segs) p)
      ((null? (cdr segs)) (car segs))
      (else (basename-of (string-join "/" (cdr segs))))))
  (define dist-dir (string-append "dist/" (basename-of path)))
  (log-info (string-append "publishing " path " -> " registry))
  (cond
    ((forge-available?)
      (begin
        (log-info "using forge helm release")
        (apply exec-check
               (append
                 (list "nix" "run" ".#forge" "--" "helm" "release"
                       "--chart-dir" path "--registry" registry)
                 (if (equal? version "") (list) (list "--version" version))
                 (if (equal? lib-chart-dir "")
                   (list)
                   (list "--lib-chart-dir" lib-chart-dir
                         "--lib-chart-name" lib-chart-name))))))
    (else
      (begin
        (log-info "forge not in flake; using helm CLI")
        ;; Chart deps must be materialized under charts/ before lint: a
        ;; committed Chart.lock plus vendored tgz is NOT enough — helm lint
        ;; answers "missing these dependencies" until dependency build
        ;; unpacks them (measured 2026-11-21, run 44863548977).
        (define dep-rc
          (if (file-exists? (string-append path "/Chart.lock"))
            (helm-sh (string-append "helm dependency build " path))
            0))
        (if (not (= dep-rc 0))
          (begin (log-error (string-append "helm dependency build failed for " path)) dep-rc)
          (begin
            (define lint-rc
              (exec-check "nix" "shell" "nixpkgs#kubernetes-helm"
                          "--command" "helm" "lint" path))
            (if (not (= lint-rc 0))
              (begin (log-error (string-append "helm lint failed for " path)) lint-rc)
              (begin
                (define pkg-rc
                  (helm-sh
                    (string-append
                      "mkdir -p " dist-dir " && helm package " path
                      " --destination " dist-dir
                      (if (equal? version "") "" (string-append " --version " version)))))
                (if (not (= pkg-rc 0))
                  (begin (log-error (string-append "helm package failed for " path)) pkg-rc)
                  (helm-sh
                    (string-append
                      "tgz=$(ls -1 " dist-dir "/*.tgz | head -n1) && "
                      "helm push \"$tgz\" " registry)))))))))))

(define (publish-all remaining rc)
  ;; first non-zero exit wins the report; every chart still gets its turn,
  ;; so one broken chart does not silently skip the rest.
  (cond
    ((null? remaining) rc)
    (else
      (define one-rc (publish-one (car remaining)))
      (publish-all (cdr remaining) (if (= rc 0) one-rc rc)))))

(define status
  (cond
    ((> (length charts-list) 0)
      (publish-all (map (lambda (n) (string-append chart-path "/" n)) charts-list) 0))
    (else (publish-one chart-path))))

(when (not (= status 0))
  (log-error (string-append "helm publish failed (status " (string-format "{}" status) ")"))
  (exit status))
