;; codacy-coverage-upload/run.tlisp — upload a coverage report to Codacy.
;;
;; ── WHAT THIS REPLACES ───────────────────────────────────────────────────
;; The file that shipped here was a STUB that reported success:
;;
;;     (log-info "::warning::codacy-coverage-upload not yet implemented")
;;     (append-output "uploaded=stub")
;;     (exit 0)
;;
;; It consumed neither of its two required inputs. `API_TOKEN` and
;; `COVERAGE_FILE` were forwarded by action.yml into an environment nothing
;; read. Every consumer saw a green step, an `uploaded` output, and no upload
;; — the failure mode and the success mode were byte-identical. A `::warning::`
;; is not a gate; it is a line in a log nobody reads on a green run.
;;
;; `uploaded=stub` is worse than either `true` or `false`, because it is
;; neither: a consumer branching `if: steps.x.outputs.uploaded == 'true'`
;; silently skips its follow-up, and one branching `!= 'false'` silently
;; proceeds. Both are wrong and neither says so. This file emits only `true`
;; or `false`, and `false` always accompanies a non-zero exit.
;;
;; ── ★ THE TOKEN NEVER ENTERS ARGV ────────────────────────────────────────
;; codacy-coverage-reporter accepts `--project-token <tok>` on the command
;; line. It is NOT used here and must not be. A command line is world-readable
;; through `ps` and /proc/<pid>/cmdline by any other process on the runner,
;; and GitHub's masking redacts LOGS, not the process table. The reporter also
;; reads `CODACY_PROJECT_TOKEN` from its environment, so action.yml forwards
;; the token there and this script never names its value — only its presence.
;; `proc:run` inherits the interpreter's environment (verified), which is what
;; makes the env channel sufficient and argv unnecessary.
;;
;; ── WHY `proc:run` AND NOT `exec-capture` ────────────────────────────────
;; Two failures have to stay distinguishable: the reporter is not installed on
;; this runner, and the reporter ran and rejected the upload. `exec-capture`
;; RAISES on the first and returns a status on the second, so a naive port
;; reports "upload failed" for a missing binary and sends the operator to
;; debug Codacy credentials. `proc:run` returns (err …) for could-not-start
;; and (ok …) at any exit status, so each gets its own diagnostic.

(define coverage-file (env-get "COVERAGE_FILE" ""))

(define reporter-bin (env-get "REPORTER_BIN" "codacy-coverage-reporter"))

;; Presence only. The value is never logged, never interpolated, never passed
;; as an argument — it reaches the reporter solely through the inherited
;; environment variable action.yml sets.
(define token-present? (not (equal? (env-get "CODACY_PROJECT_TOKEN" "") "")))

;; `required: true` on a composite action's input is DOCUMENTATION — the
;; runner does not enforce it, so an omitted input arrives as the empty
;; string rather than failing the job. Both required inputs are therefore
;; checked here, where the check is real.
(define (check-inputs)
  (cond
    ((equal? (string-trim coverage-file) "")
      (log-error
        (string-append
          "coverage-file is empty. This input is marked `required: true`, but "
          "the runner does not enforce `required` for composite action inputs "
          "— an omitted input arrives as \"\". Pass the path of the coverage "
          "report to upload (e.g. cobertura.xml, coverage.xml, lcov.info)."))
      #f)
    ((not token-present?)
      (log-error
        (string-append
          "api-token is empty. Codacy rejects an unauthenticated upload, so "
          "proceeding would report a failure whose cause is already known. "
          "Pass a Codacy PROJECT token — this action forwards it as "
          "CODACY_PROJECT_TOKEN."))
      #f)
    ((not (path-exists? coverage-file))
      (log-error
        (string-append
          "coverage report not found: "
          coverage-file
          ". Nothing is uploaded. Note that this action deliberately does NOT "
          "run actions/checkout — see action.yml — so the report generated by "
          "an earlier step in the calling job is still in the workspace; a "
          "miss here is a wrong path, not a wiped one."))
      #f)
    (else #t)))

;; The upload. argv is a LIST, so there is no command string to quote and
;; nothing to inject into; the token is absent from it by construction.
(define (upload)
  (log-info (string-append "==> " reporter-bin " report -r " coverage-file))
  (let ((r (proc:run (list reporter-bin "report" "-r" coverage-file))))
    (cond
      ;; Could not be STARTED — a missing binary, not a rejected upload.
      ((erro:err? r)
        (log-error
          (string-append
            "could not run '"
            reporter-bin
            "': "
            (erro:message (erro:value r))
            ". This is the reporter being absent from the runner, NOT Codacy "
            "refusing the coverage. Provide it on PATH (nix, or a pinned "
            "release asset) and/or set the `reporter-bin` input to its path. "
            "This action will not fetch and execute an installer at job time."))
        #f)
      (else
        (let ((res (erro:value r)))
          (cond
            ((equal? (status-of res) 0) #t)
            (else
              ;; The status IS read. A `$(…)` whose exit code is never checked
              ;; is how an upload failure becomes an empty output and a green
              ;; step; there is no such path here.
              (log-error
                (string-append
                  reporter-bin
                  " exited "
                  (string-format "{}" (status-of res))
                  " — Codacy did not accept the coverage report."))
              (log-info (string-trim (stderr-of res)))
              #f)))))))

(define (main)
  (cond
    ((not (check-inputs))
      ;; emit-output, not append-output: key and value stay separate, so a
      ;; newline in a value is refused as the injection it is rather than
      ;; silently writing an extra output key.
      (emit-output "uploaded" "false")
      (exit 1))
    ((upload)
      (log-info (string-append "coverage uploaded to Codacy from " coverage-file))
      (emit-output "uploaded" "true")
      (exit 0))
    (else
      ;; A failed upload exits non-zero. The stub's `exit 0` made a silent
      ;; no-upload indistinguishable from a delivered one; that is closed here.
      (emit-output "uploaded" "false")
      (exit 1))))

(if (equal? (env-get "TLISP_TEST" "") "") (main) (log-info "codacy-coverage-upload: main skipped under TLISP_TEST"))
