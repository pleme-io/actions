;; datadog-event/run.tlisp — post an event to the Datadog Events API.
;;
;; Was jq-through-sh then curl-through-sh. The API_KEY sat in argv inside
;; `-H 'DD-API-KEY: <key>'`, readable from `ps` or /proc/<pid>/cmdline; curl
;; had no `--fail`, so the verdict came from a scraped `%{http_code}`; and
;; TITLE/TEXT/TAGS/ALERT_TYPE were interpolated into single quotes, so any
;; value containing `'` closed the quote and injected.
;;
;; The jq filter here also carried the four-fragment string bug (jq's inner
;; `","` ending the tlisp string early, making the next line's comma an
;; UNQUOTE). That was repaired in place earlier today; converting to a lisp
;; payload removes the whole category rather than that one instance.

(define key (env-required "API_KEY"))

(define title (env-required "TITLE"))

(define text (env-required "TEXT"))

(define tags (env-get "TAGS" "source:github_actions"))

(define alert (env-get "ALERT_TYPE" "info"))

(define site (env-get "SITE" "datadoghq.com"))

(define url (string-append "https://api." site "/api/v1/events"))

;; `tags` is a comma-separated list by contract — this is jq's
;; `($tags | split(","))`, done in-process.
(define tag-list
  (filter (lambda (t) (not (equal? (string-trim t) "")))
          (string-split tags ",")))

(define payload
  (list
    (list "title" title)
    (list "text" text)
    (list "alert_type" alert)
    (list "tags" tag-list)
    (list "source_type_name" "github")))

;; The key is a HEADER VALUE, never argv.
(define r (webhook:post url (list (list "DD-API-KEY" key)) payload))

(cond
  ((erro:err? r)
    (log-error
      (string-append "datadog-event: post failed — " (erro:message (erro:value r))))
    (append-output "posted=false")
    (exit 1))
  (else
    (log-info "datadog-event: posted")
    (append-output "posted=true")
    (exit 0)))
