;; git-push-with-token/run.tlisp — re-arm origin with a token, push.
;;
;; The default GITHUB_TOKEN cannot trigger another workflow on its own
;; pushes (GH security restriction). When the caller has a PAT
;; (e.g. BOT_PAT) and wants the resulting tag push to fire the
;; release workflow, this action rewrites the origin URL to use that
;; token as the basic-auth password, then pushes the branch + tags.
;;
;; Inputs (env):
;;   GIT_PUSH_TOKEN  — the token (BOT_PAT or GITHUB_TOKEN)
;;   BRANCH          — branch to push (default "main")
;;   PUSH_TAGS       — "true" to also push --tags
;;
;; The URL rewrite handles both freshly-cloned remotes (no token in
;; URL) and previously-rearmed remotes (some x-access-token already
;; embedded) by first stripping any existing https://<x>@ prefix.

;; INPUT_* (Docker mode) preferred; bare names retained as composite fallback.
(define token (env-get "INPUT_TOKEN" (env-get "GIT_PUSH_TOKEN" "")))

(define branch (env-get "INPUT_BRANCH" (env-get "BRANCH" "main")))

(define ptags? (equal? (env-get "INPUT_PUSH_TAGS" (env-get "PUSH_TAGS" "true")) "true"))

;; ---------- get + clean origin URL ---------- ;;

(define (strip-userinfo url)
  ;; Turns "https://<anything>@github.com/..." into "https://github.com/...".
  ;; Plain "https://github.com/..." passes through unchanged.
  (cond
    ((string-starts-with? url "https://")
      ;; Split on "@" — if there's a userinfo segment, the part before
      ;; the FIRST @ contains "://", so re-stitch using everything
      ;; after the first @.
      (let ((parts (string-split url "@")))
        (if (= (length parts) 1)
          url
          (string-append "https://" (string-join "@" (cdr parts))))))
    (else url)))

;; ---------- rewrite + push ---------- ;;

(define (rearm url)
  (string-replace
    url
    "https://"
    (string-append
      "https://x-access-token:"
      token
      "@")))

;; Push the branch and (optionally) every tag in ONE transaction.
;; `--atomic` makes the remote accept all refs or none, so the branch +
;; its release tag are indivisible (no land-tag-without-commit skew).
;; This is a Docker action (no stdlib), so helpers stay inline.
(define (capture-out cap) (string-trim (alist-get cap :stdout)))

(define (output-lines cap)
  (let ((out (capture-out cap))) (if (equal? out "") (list) (string-split out "\n"))))

(define (rev-parse ref) (capture-out (exec-capture "git" "rev-parse" ref)))

(define (tags-at commit) (output-lines (exec-capture "git" "tag" "--points-at" commit)))

(define release-tag (string-trim (env-get "PUSH_TAG" "")))

(define (push-argv tag br tags?)
  (cond
    ((not (equal? tag "")) (list "git" "push" "origin" (string-append "refs/tags/" tag)))
    (tags? (list "git" "push" "--atomic" "origin" br "--tags"))
    (else (list "git" "push" "origin" br))))

(define (do-push) (apply exec-check (push-argv release-tag branch ptags?)))

(define (push-tag-with-retry attempts)
  (let ((s (do-push)))
    (cond
      ((= s 0) 0)
      ((<= attempts 0)
        (log-error
          (string-append
            "git push origin refs/tags/"
            release-tag
            " still refused; the remote may already carry a different "
            release-tag))
        s)
      (else
        (log-info (string-append "push of tag " release-tag " failed — retrying the same push"))
        (push-tag-with-retry (- attempts 1))))))

;; ---------- derived-file conflict resolution ---------- ;;
;;
;; A conflict in a GENERATED file is not a semantic conflict, and treating
;; it as one is what stranded egaku-term at crates.io 0.3.1 while its repo
;; sat at 0.3.4 — three releases that bumped, tagged, and never shipped.
;;
;; The mechanism, measured 2026-08-03: `auto-release` and `gen-spec` fire on
;; the SAME push event. gen-spec finishes first (~2m) and pushes a
;; regenerated `Cargo.gen.lock`; auto-release finishes later (~4m), gets a
;; non-ff rejection, rebases — and its bump commit ALSO touches
;; `Cargo.gen.lock`. So the two collide every single time, on a file neither
;; human wrote. The retry logic below was built assuming the racer touches
;; only `flake.lock` ("disjoint, so the replay is conflict-free"); that
;; assumption held for the racer it was written against and is false for the
;; one that actually races.
;;
;; Resolution: take the REPLAYED side (our bump) for a declared-derived path,
;; so the version bump — the part that MUST land — survives. The replayed
;; side was generated on the OLD base, so it is stale on the new one, and
;; nothing re-runs the generator on a push made with a token whose pushes
;; trigger no workflow (blue 1c6f410). regenerate-command rebuilds it from
;; the rebased tree before the push; without it the file is pushed as replayed.
;;
;; A conflict touching anything OUTSIDE the declared list still aborts. This
;; never silently resolves an authored file.

;; `string-split` is strictly 2-arity (no whitespace-splitting overload), so
;; fold newlines and tabs to spaces first — a YAML block scalar delivers this
;; input newline-separated, a one-liner delivers it space-separated, and both
;; must work. `string-replace` is Rust's `str::replace`, i.e. global.
(define (split-ws s)
  (filter
    (lambda (p) (not (equal? p "")))
    (string-split (string-replace (string-replace s "\n" " ") "\t" " ") " ")))

(define regenerable
  (split-ws (string-trim (env-get "INPUT_REGENERABLE_PATHS" (env-get "REGENERABLE_PATHS" "")))))

(define regenerate-argv
  (split-ws (string-trim (env-get "INPUT_REGENERATE_COMMAND" (env-get "REGENERATE_COMMAND" "")))))

(define (conflicted-paths)
  (output-lines (exec-capture "git" "diff" "--name-only" "--diff-filter=U")))

(define (changed-tracked-paths) (output-lines (exec-capture "git" "diff" "--name-only")))

;; During a REBASE the sides are inverted relative to a merge: `--theirs` is
;; the commit being replayed (our bump) and `--ours` is the upstream we are
;; landing on. Naming it here because reaching for `--ours` is the intuitive
;; and wrong move, and it would silently drop the version bump.
(define (take-replayed-side path)
  (exec-check
    "git"
    "checkout"
    "--theirs"
    "--"
    path)
  (exec-check
    "git"
    "add"
    "--"
    path))

(define (resolve-derived-conflict)
  (let ((stuck (conflicted-paths)))
    (cond
      ((null? stuck) #f)
      ((not (every? (lambda (p) (member? p regenerable)) stuck))
        (log-error
          (string-append
            "rebase conflicted on a path that is not declared regenerable: "
            (string-join ", " stuck)))
        #f)
      (else
        (log-info
          (string-append
            "rebase conflicted only in derived file(s): "
            (string-join ", " stuck)
            (if (null? regenerate-argv)
              " — taking the replayed side; no regenerate-command is set, so it is pushed as replayed"
              " — taking the replayed side, then running regenerate-command")))
        (for-each take-replayed-side stuck)
        ;; `git rebase --continue` re-opens the commit-message editor, and it
        ;; has NO `--no-edit` (that is a `git rebase` error, not an option).
        ;; So the editor must be neutralised through the environment — and it
        ;; must be `GIT_EDITOR`, because `GIT_EDITOR` OUTRANKS `-c
        ;; core.editor`. Measured 2026-08-03: with `-c core.editor=true` alone
        ;; and a developer's `GIT_EDITOR=blnvim` exported, `--continue`
        ;; launched nvim and hung until killed. A runner usually has neither
        ;; set, so this would have looked fine in CI and hung the first time
        ;; anyone ran the action anywhere else — a silent wedge with no output.
        (env-set "GIT_EDITOR" "true")
        (= 0 (exec-check "git" "rebase" "--continue"))))))

;; Re-point each tag to new-head (force). Lightweight is fine: the
;; release workflow fires on the tag REF regardless of annotation, and
;; `git describe --tags` (the bump's last-tag) honours lightweight tags.
(define (move-tags tags new-head)
  (for-each (lambda (t) (exec-check "git" "tag" "-f" t new-head)) tags))

(define bot-identity
  (list
    "-c"
    "user.email=github-actions[bot]@users.noreply.github.com"
    "-c"
    "user.name=github-actions[bot]"))

(define (git-as-bot args) (apply exec-check (append (list "git") bot-identity args)))

(define (regenerate-command-text) (string-join " " regenerate-argv))

(define (run-regenerate-command)
  (try
    (apply exec-check regenerate-argv)
    (catch
      (e)
      (log-warn (string-append "regenerate-command could not start: " (error-message e)))
      -1)))

(define (amend-regenerated onto)
  (let ((changed (filter (lambda (p) (member? p regenerable)) (changed-tracked-paths))))
    (cond
      ((null? changed) (log-info "regenerate-command changed no tracked regenerable path"))
      ((equal? (rev-parse "HEAD") (rev-parse onto))
        (log-warn
          "regenerate-command changed derived files but the rebase replayed no commit to amend"))
      ((not (= 0 (apply exec-check (append (list "git" "add" "-u" "--") changed))))
        (log-warn (string-append "git add of regenerated " (string-join ", " changed) " failed")))
      ((not (= 0 (git-as-bot (list "commit" "--amend" "--no-edit"))))
        (log-warn "git commit --amend of the regenerated files failed"))
      (else
        (log-info
          (string-append
            "amended the replayed commit with regenerated "
            (string-join ", " changed)))))))

(define (regenerate-after-rebase onto)
  (let ((here (cwd)))
    (chdir (rev-parse "--show-toplevel"))
    (log-info (string-append "regenerate-command: " (regenerate-command-text)))
    (if (= 0 (run-regenerate-command))
      (amend-regenerated onto)
      (log-warn
        (string-append
          "regenerate-command failed: "
          (regenerate-command-text)
          " — pushing the rebased commit as it is")))
    (when (not (= 0 (exec-check "git" "reset" "-q" "--hard" "HEAD")))
      (log-warn
        "git reset --hard HEAD after regenerate-command failed; a later rebase retry may refuse the dirty tree"))
    (chdir here)))

;; Resilient push: a non-fast-forward rejection means ANOTHER writer
;; (an operator flake.lock push, a concurrent workflow) advanced <branch>
;; between this job's checkout and this push — stranding the bump commit
;; + its release tag so the whole release fails (a green bump that never
;; ships; observed 2026-06-03 on tatara-lisp v0.2.4). Recover by fetching
;; the new tip, REBASING our local commits onto it (the bump touches
;; Cargo.* while the common racer touches flake.lock — disjoint, so the
;; replay is conflict-free), re-pointing any tags that rode the rebased
;; commits, and retrying. Bounded; a genuine content conflict aborts the
;; rebase + surfaces (no worse than the pre-fix single-shot push). The
;; `-c user.*` keeps the rebase replay's committer identity self-contained
;; (the container may not inherit the job's git config).
(define (push-with-retry attempts)
  (let ((s (do-push)))
    (cond
      ((= s 0) 0)
      ((<= attempts 0) (log-error "git push still rejected after rebase retries") s)
      (else
        (log-info "push rejected (non-ff?) — fetch + rebase onto latest, then retry")
        (let ((old-head (rev-parse "HEAD"))
           (fetch-s (exec-check "git" "fetch" "origin" branch)))
          (cond
            ((not (= fetch-s 0)) (log-error "git fetch failed during push retry") fetch-s)
            (else
              (let*
                ((onto (string-append "origin/" branch))
                  (saved-tags (tags-at old-head))
                  (rebase-s (git-as-bot (list "rebase" onto))))
                (cond
                  ((and (not (= rebase-s 0)) (not (resolve-derived-conflict)))
                    ;; lint:allow git-mutation-discard — abort-cleanup; we return rebase-s
                    (exec-check
                      "git"
                      "rebase"
                      "--abort")
                    (log-error
                      "rebase onto latest conflicted — manual resolution needed (push not retried)")
                    rebase-s)
                  (else
                    (when (not (null? regenerate-argv)) (regenerate-after-rebase onto))
                    (move-tags saved-tags (rev-parse "HEAD"))
                    (push-with-retry (- attempts 1))))))))))))

(define (main)
  (when (equal? token "")
    (log-error "git-push-with-token: missing INPUT_TOKEN")
    (exit 1))
  ;; Docker-action mode: the container's runtime UID rarely matches
  ;; the runner UID owning /github/workspace. Git refuses to operate
  ;; on a repo it considers owned by an untrusted user; mark every
  ;; directory safe before any git command runs.
  (exec-capture "git"
    "config"
    "--global"
    "--add" "safe.directory"
    "*")
  (let*
    ((current-url (capture-out (exec-capture "git" "remote" "get-url" "origin")))
      (set-url-status
        (exec-check
          "git"
          "remote"
          "set-url"
          "origin"
          (rearm (strip-userinfo current-url)))))
    (when (not (= set-url-status 0))
      (log-error "git remote set-url failed")
      (exit set-url-status)))
  (let ((push-status (if (equal? release-tag "") (push-with-retry 3) (push-tag-with-retry 3))))
    (when (not (= push-status 0))
      (log-error (string-append (string-join " " (push-argv release-tag branch ptags?)) " failed"))
      (exit push-status)))
  (log-info
    (if (equal? release-tag "")
      (string-append "pushed " branch (if ptags? " + tags (atomic)" ""))
      (string-append "pushed refs/tags/" release-tag " only; no branch moved"))))

(if (equal? (env-get "TLISP_TEST" "") "1")
  #t
  (main))
