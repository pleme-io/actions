;; runner-resolve/run.test.tlisp — (deftest …) units for the pure
;; precedence logic AND the real config-file read path, run by the
;; tlisp-test action via `tatara-script --test`. The harness prepends
;; the stdlib + the sibling run.tlisp (TLISP_TEST=1 gates main), then
;; this file, so rr:* is driven directly — no runner env, no exit.

(deftest "rr:resolve-runner — override wins over everything"
  (assert
    (equal? (rr:resolve-runner "gpu-runner" "file-runner" "ubuntu-latest") "gpu-runner")
    "override beats file + default")
  (assert
    (equal? (rr:resolve-runner "  gpu-runner  " "file-runner" "ubuntu-latest") "gpu-runner")
    "override is trimmed"))

(deftest "rr:resolve-runner — file wins when override is empty"
  (assert
    (equal?
      (rr:resolve-runner
        ""
        "pleme-private"
        "ubuntu-latest")
      "pleme-private")
    "file beats default when override is empty")
  (assert
    (equal?
      (rr:resolve-runner
        "   "
        "  pleme-private  "
        "ubuntu-latest")
      "pleme-private")
    "whitespace-only override treated as empty; file value trimmed"))

(deftest "rr:resolve-runner — effective-default wins when nothing else is set"
  (assert
    (equal? (rr:resolve-runner "" "" "ubuntu-latest") "ubuntu-latest")
    "both empty -> effective-default")
  (assert
    (equal? (rr:resolve-runner "" "  " "ubuntu-latest") "ubuntu-latest")
    "whitespace-only file value -> effective-default"))

(deftest "rr:resolve-provenance — matches the same precedence as rr:resolve-runner"
  (assert
    (equal? (rr:resolve-provenance "gpu-runner" "file-runner" "default") "override")
    "override tier")
  (assert (equal? (rr:resolve-provenance "" "file-runner" "default") "file") "file tier")
  (assert (equal? (rr:resolve-provenance "" "" "default") "default") "default tier passed through")
  (assert
    (equal? (rr:resolve-provenance "" "" "visibility-default") "visibility-default")
    "visibility-default tier passed through")
  (assert
    (equal? (rr:resolve-provenance "  " "  " "default") "default")
    "whitespace-only counts as empty"))

;; ── The new tier-4 pure helpers: rr:effective-default,
;; rr:effective-default-provenance, rr:is-private? ──────────────────

(deftest "rr:is-private? — only the literal string \"true\" counts as private"
  (assert (rr:is-private? "true") "exact match is private")
  (assert (not (rr:is-private? "false")) "false is public")
  (assert (not (rr:is-private? "")) "empty (unset context) fails toward public, never private")
  (assert
    (not (rr:is-private? "True"))
    "wrong case is NOT treated as private -- no guessed truthiness")
  (assert (not (rr:is-private? "1")) "not a recognized private-truthy form"))

(deftest "rr:effective-default — explicit default always wins over visibility"
  (assert
    (equal?
      (rr:effective-default
        "gpu-runner"
        "true"
        "pleme-private"
        "ubuntu-24.04")
      "gpu-runner")
    "explicit default beats private visibility default")
  (assert
    (equal?
      (rr:effective-default
        "gpu-runner"
        "false"
        "pleme-private"
        "ubuntu-24.04")
      "gpu-runner")
    "explicit default beats public visibility default too"))

(deftest
  "rr:effective-default — private repo, no explicit default, resolves to private-runner-default"
  (assert
    (equal?
      (rr:effective-default
        ""
        "true"
        "pleme-private"
        "ubuntu-24.04")
      "pleme-private")
    "the actual billing-safe fix: a private repo with no explicit default lands on one cluster, never a metered runner"))

(deftest
  "rr:effective-default — public repo, no explicit default, resolves to public-runner-default"
  (assert
    (equal?
      (rr:effective-default
        ""
        "false"
        "pleme-private"
        "ubuntu-24.04")
      "ubuntu-24.04")
    "public repos keep their free GitHub-hosted minutes, untouched"))

(deftest
  "rr:effective-default — unset/unrecognized visibility fails toward public (never private)"
  (assert
    (equal? (rr:effective-default "" "" "pleme-private" "ubuntu-24.04") "ubuntu-24.04")
    "an empty IS_PRIVATE context (e.g. a non-repository-scoped event) never silently routes onto the self-hosted pool"))

(deftest
  "rr:effective-default-provenance — distinguishes an explicit default from the visibility fallback"
  (assert
    (equal? (rr:effective-default-provenance "gpu-runner") "default")
    "caller explicitly passed a default")
  (assert
    (equal? (rr:effective-default-provenance "") "visibility-default")
    "caller passed nothing -- visibility tier fired"))

;; The scenario that MOTIVATED this action: a repo on GitHub's Free plan
;; has no access to Organization-level `vars.*`, so a caller's ternary
;; reading e.g. `vars.PRIVATE_BUILDER_RUNNER` resolves to an empty string for
;; `override`. A repo-committed .github/runner.yml still resolves the
;; intended runner — with NO vars.* dependency anywhere in this path.
(deftest "the motivating scenario — missing org vars resolves via config-path alone"
  (let ((override "")
     ;; unset vars.* forwards as ""
     (file-runner "pleme-private")
     ;; read from .github/runner.yml
     (default "ubuntu-latest"))
    (assert
      (equal? (rr:resolve-runner override file-runner default) "pleme-private")
      "resolves the committed runner with zero vars.* involved")
    (assert
      (equal? (rr:resolve-provenance override file-runner "default") "file")
      "provenance correctly attributes the win to the config file, not a var")))

;; ── Real file-IO path — rr:read-file-runner against actual fixture
;; files, exercising the genuine path-exists? + yaml-read-field (real
;; yq subprocess) call, not a mock. Distinct fixture filenames avoid
;; any ordering dependency between test forms.

(deftest "rr:read-file-runner — reads a real committed config file"
  (write-file "/tmp/runner-resolve-fixture.yml" "runner: pleme-private\n")
  (assert
    (equal? (rr:read-file-runner "/tmp/runner-resolve-fixture.yml") "pleme-private")
    "reads the runner: field from a real YAML file via real yq"))

(deftest "rr:read-file-runner — honestly empty when the file is absent"
  (assert
    (equal? (rr:read-file-runner "/tmp/runner-resolve-fixture-absent.yml") "")
    "absent file -> empty, never a guessed value"))

(deftest "rr:read-file-runner — honestly empty when config-path itself is empty"
  (assert (equal? (rr:read-file-runner "") "") "empty config-path -> empty, no yq invocation"))

(deftest "rr:read-file-runner — honestly empty when the file has no runner: field"
  (write-file "/tmp/runner-resolve-fixture-no-field.yml" "other-field: something\n")
  (assert
    (equal? (rr:read-file-runner "/tmp/runner-resolve-fixture-no-field.yml") "")
    "file present but no runner: field -> empty, never a stale/guessed value"))

(deftest "a fork pull request on a public repo never resolves to a self-hosted default"
  (assert (rr:untrusted-head? "false" "true") "public + fork is untrusted")
  (assert (not (rr:untrusted-head? "true" "true")) "a private repo is not guarded here")
  (assert (not (rr:untrusted-head? "false" "false")) "a push or same-repo PR is trusted")
  (assert
    (equal? (rr:guarded "pleme-public-build" "visibility-default" #t "" "ubuntu-24.04") (list "ubuntu-24.04" "untrusted-head"))
    "visibility tier is replaced by the hosted default")
  (assert
    (equal? (rr:guarded "pleme-public-build" "file" #t "" "ubuntu-24.04") (list "ubuntu-24.04" "untrusted-head"))
    "the committed file is replaced too, a fork can edit it")
  (assert
    (equal? (rr:guarded "x" "override" #t "x" "ubuntu-24.04") (list "x" "override"))
    "an explicit override still wins")
  (assert
    (equal? (rr:guarded "pleme-public-build" "visibility-default" #f "" "ubuntu-24.04") (list "pleme-public-build" "visibility-default"))
    "a trusted head is unchanged"))

(define rr-test:pressure
  (rr:pressure
    "{\"from\":100,\"until\":200,\"queued\":12,\"idle\":{\"pleme-io/blue\":{\"pleme-public-build\":1,\"pleme-busy\":0}}}"))

(define (rr-test:verdict eligibility run-id repo label threshold)
  (rr:overflow-verdict eligibility rr-test:pressure run-id repo label threshold))

(deftest "overflow — every condition met routes the hosted default to the overflow runner"
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "pleme-public-build" 10) "overflow")
    "trusted, live lease, backlog over threshold, an idle runner for this repo")
  (assert
    (equal?
      (rr:apply-overflow (list "ubuntu-latest" "visibility-default") "overflow" " pleme-public-build ")
      (list "pleme-public-build" "overflow"))
    "the overflow runner replaces the hosted label and names its tier"))

(deftest "overflow — any other verdict leaves the resolved runner unchanged"
  (assert
    (equal?
      (rr:apply-overflow (list "ubuntu-latest" "visibility-default") "below-threshold" "pleme-public-build")
      (list "ubuntu-latest" "visibility-default"))
    "below threshold stays hosted")
  (assert
    (equal?
      (rr:apply-overflow (list "ubuntu-24.04" "untrusted-head") "fork-head" "pleme-public-build")
      (list "ubuntu-24.04" "untrusted-head"))
    "a fork head keeps the untrusted default"))

(deftest "overflow — only push, workflow_dispatch and schedule are trusted events"
  (assert (rr:trusted-event? "push") "push")
  (assert (rr:trusted-event? "workflow_dispatch") "workflow_dispatch")
  (assert (rr:trusted-event? " schedule ") "schedule, trimmed")
  (assert (not (rr:trusted-event? "pull_request")) "pull_request, even from the same repo")
  (assert (not (rr:trusted-event? "pull_request_target")) "pull_request_target")
  (assert (not (rr:trusted-event? "issue_comment")) "issue_comment")
  (assert (not (rr:trusted-event? "workflow_run")) "workflow_run can carry a fork's artifacts")
  (assert (not (rr:trusted-event? "merge_group")) "a merge queue can hold fork code")
  (assert (not (rr:trusted-event? "")) "an unset event"))

(deftest "overflow — a fork pull request never overflows, whatever the snapshot says"
  (assert
    (equal?
      (rr:overflow-eligibility "ubuntu-24.04" "untrusted-head" "pull_request" "false" #t)
      "fork-head")
    "the real fork shape")
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "visibility-default" "push" "false" #t) "fork-head")
    "the fork guard wins even over a trusted event name")
  (assert
    (equal?
      (rr:apply-overflow
        (rr:guarded "ubuntu-latest" "visibility-default" #t "" "ubuntu-24.04")
        (rr-test:verdict
          (rr:overflow-eligibility "ubuntu-24.04" "untrusted-head" "pull_request" "false" #t)
          150
          "pleme-io/blue"
          "pleme-public-build"
          0)
        "pleme-public-build")
      (list "ubuntu-24.04" "untrusted-head"))
    "end to end: a fork head with a ready snapshot and threshold 0 stays on the hosted untrusted default"))

(deftest "overflow — eligibility refuses a private repo, an untrusted event, an explicit runner and a self-hosted label"
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "visibility-default" "push" "true" #f) "private-repo")
    "a private repo already resolves to its own pool")
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "visibility-default" "pull_request" "false" #f) "untrusted-event")
    "a same-repo pull request is not an overflow event")
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "override" "push" "false" #f) "explicit-runner")
    "an override is the caller's choice")
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "file" "push" "false" #f) "explicit-runner")
    "a committed runner file is the repo's choice")
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "default" "push" "false" #f) "explicit-runner")
    "an explicit default is the caller's choice")
  (assert
    (equal? (rr:overflow-eligibility "pleme-private" "visibility-default" "push" "false" #f) "not-hosted")
    "only a GitHub-hosted label overflows")
  (assert
    (equal? (rr:overflow-eligibility "ubuntu-latest" "visibility-default" "push" "false" #f) "eligible")
    "the eligible shape")
  (assert
    (equal? (rr-test:verdict "private-repo" 150 "pleme-io/blue" "pleme-public-build" 0) "private-repo")
    "an ineligible verdict passes through"))

(deftest "overflow — the lease is live only strictly inside (from, until)"
  (assert
    (equal? (rr-test:verdict "eligible" 100 "pleme-io/blue" "pleme-public-build" 10) "no-live-lease")
    "a run created before the lease (an old re-run)")
  (assert
    (equal? (rr-test:verdict "eligible" 200 "pleme-io/blue" "pleme-public-build" 10) "no-live-lease")
    "a run after the lease expired: the publisher is down")
  (assert
    (equal? (rr-test:verdict "eligible" #f "pleme-io/blue" "pleme-public-build" 10) "no-live-lease")
    "an unreadable run id")
  (assert
    (equal?
      (rr:overflow-verdict "eligible" (rr:pressure "") 150 "pleme-io/blue" "pleme-public-build" 0)
      "no-live-lease")
    "no snapshot at all"))

(deftest "overflow — the backlog must reach the threshold"
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "pleme-public-build" 13) "below-threshold")
    "12 queued under 13")
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "pleme-public-build" 12) "overflow")
    "12 queued at 12")
  (assert
    (equal?
      (rr:overflow-verdict
        "eligible"
        (rr:pressure "{\"from\":100,\"until\":200,\"idle\":{\"pleme-io/blue\":{\"pleme-public-build\":1}}}")
        150
        "pleme-io/blue"
        "pleme-public-build"
        0)
      "below-threshold")
    "an unmeasured backlog never overflows, even at threshold 0")
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "pleme-public-build" #f) "no-threshold")
    "an unreadable threshold"))

(deftest "overflow — an idle runner with the overflow label must serve this repository"
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "pleme-busy" 0) "no-idle-runner")
    "the label's runners are all busy")
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/other" "pleme-public-build" 0) "no-idle-runner")
    "a repo-scoped runner of another repository cannot take this job")
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "pleme-absent" 0) "no-idle-runner")
    "a label the snapshot does not name")
  (assert
    (equal? (rr-test:verdict "eligible" 150 "pleme-io/blue" "  " 0) "no-overflow-runner")
    "an empty overflow runner turns the tier off"))

(deftest "overflow — a malformed snapshot or count reads as absent, never as a value"
  (assert (equal? (rr:pressure "") (list)) "empty")
  (assert (equal? (rr:pressure "{not json") (list)) "malformed")
  (assert (equal? (rr:pressure "[1,2]") (list)) "not an object")
  (assert (equal? (rr:idle (rr:pressure "{\"idle\":{\"pleme-io/blue\":3}}") "pleme-io/blue" "x") 0) "a count where a map belongs")
  (assert (equal? (rr:count "42709554585") 42709554585) "a run id")
  (assert (equal? (rr:count " 10 ") 10) "a trimmed threshold")
  (assert (not (rr:count "-1")) "negative")
  (assert (not (rr:count "ten")) "words")
  (assert (not (rr:count "")) "empty"))
