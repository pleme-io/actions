;; ddl-gate — refuse destructive DDL in a committed model tree.
;;
;; Inlined ahead of this file: _tlisp-stdlib/stdlib.tlisp (append-output,
;; path-exists?) and _tlisp-ddl/stdlib.tlisp (the classifier). Composition is
;; by inlining, not `require` — see caixa-tlisp-ddl's README for why.
;;
;; Same baseline-debt discipline as action-shell-lint / no-cve-suppression /
;; breathe-band-lint: pre-existing debt is NAMED in the baseline and reported
;; on every run, never silently accepted; only a NEW, non-baselined finding
;; fails the build. The goal is an EMPTY baseline, not a growing one.
;;
;; A finding key is "RULE <relpath>#<sha8>" where sha8 fingerprints the
;; NORMALISED statement. Keyed by content, not by line or index, so
;; reformatting the file or moving a statement does not silently un-baseline
;; it, and rewording this script's messages cannot either.

(define root (env-get "ROOT" "."))

(define fail-on-violation (not (eq? (env-get "FAIL_ON_VIOLATION" "true") "false")))

(define sunset-step (env-get "DDL_SUNSET_STEP" ""))

(define baseline-path (string-append root "/.ddl-gate-baseline.txt"))

(define (gate:sql-files dir) (filter (fn (p) (string-ends-with? p ".sql")) (walk-dir dir)))

(define (gate:strip-root p)
  (let ((parts (string-split p (string-append root "/"))))
    (if (> (length parts) 1)
      (car (cdr parts))
      p)))

;; sha256 returns the full hex digest. There is no `substring` builtin, so the
;; short prefix comes from a regex match rather than a slice.
(define (gate:sha8 stmt)
  (let ((m (re-find "^[0-9a-f]{8}" (sha256 stmt)))) (if (eq? m "") "00000000" m)))

(define (gate:key verdict-rule relpath stmt)
  (string-append
    (string-uppercase verdict-rule)
    (string-append " " (string-append relpath (string-append "#" (gate:sha8 stmt))))))

(define (gate:findings-for path)
  (let ((relpath (gate:strip-root path)))
    (filter
      (fn (f) (not (eq? f "")))
      (map
        (fn (v)
          (if (ddl:permitted? (ddl:verdict-of v) sunset-step)
            ""
            (list
              (list "key" (gate:key (ddl:rule-of v) relpath (ddl:statement-of v)))
              (list "verdict" (ddl:verdict-label (ddl:verdict-of v)))
              (list "reason" (ddl:reason-of v))
              (list "path" relpath))))
        (ddl:classify-document (read-file path))))))

(define (gate:key-of f) (alist-get f "key" ""))

(define (gate:read-baseline)
  (if (path-exists? baseline-path)
    (filter
      (fn (l) (and (not (eq? (string-trim l) "")) (not (string-starts-with? (string-trim l) "#"))))
      (string-split (read-file baseline-path) "\n"))
    (list)))

;; Takes the baseline explicitly rather than closing over a top-level define.
;; Everything below `main` used to run at LOAD time, which walked the tree
;; before the caller had a chance to do anything and made the unit impossible
;; to drive from a test -- the same reason none of the four baseline-debt gates
;; had tests until suspend-blocker-lint grew the TLISP_TEST guard.
(define (gate:baselined? baseline-lines f)
  (> (length (filter (fn (l) (eq? (string-trim l) (gate:key-of f))) baseline-lines)) 0))

(define (gate:say-finding tag f)
  (print-line
    (string-append
      tag
      (string-append
        " "
        (string-append (gate:key-of f) (string-append " :: " (alist-get f "reason" "")))))))

(define (main)
  ;; Walked ONCE. The previous shape called (gate:sql-files root) four separate
  ;; times -- four full tree walks per run, and four chances for the count in
  ;; the log to disagree with the count that was actually scanned.
  (let ((files (gate:sql-files root)))
    ;; A gate that scanned NOTHING is a broken run, not a clean one, and from the
    ;; exit code alone the two are identical. This one exits 2 rather than joining
    ;; the long list of checks in this fleet whose failure mode looks like success.
    ;; Added after the sibling suspend-blocker-lint shipped with exactly this hole:
    ;; a reversed string-suffix? argument matched no files, so it scanned 0 and
    ;; exited 0. Same defense here, same reason.
    (if (eq? 0 (length files))
      (begin
        (print-line (string-append "ddl-gate: FAILED — scanned 0 .sql files under " root))
        (print-line "  a zero-file scan means a wrong ROOT or a broken walk, never a pass")
        (exit 2))
      #t)
    (let
      ((all-findings (reduce (fn (acc p) (append acc (gate:findings-for p))) (list) files))
        (baseline-lines (gate:read-baseline)))
      (let
        ((baselined (filter (fn (f) (gate:baselined? baseline-lines f)) all-findings))
          (violations (filter (fn (f) (not (gate:baselined? baseline-lines f))) all-findings)))
        (print-line (string-format "ddl-gate: {} .sql files under {}" (length files) root))
        (map (fn (f) (gate:say-finding "  debt   " f)) baselined)
        (map (fn (f) (gate:say-finding "  REFUSE " f)) violations)
        (print-line
          (string-format
            "ddl-gate: {} new, {} tracked debt"
            (length violations)
            (length baselined)))
        (append-output (string-append "violations=" (string-format "{}" (length violations))))
        (append-output (string-append "baselined=" (string-format "{}" (length baselined))))
        (append-output (string-append "files-scanned=" (string-format "{}" (length files))))
        (if (and fail-on-violation (> (length violations) 0))
          (exit 1)
          (exit 0))))))

(if (equal? (env-get "TLISP_TEST" "") "")
  (main)
  (log-info "TLISP_TEST=1 — loaded; main skipped (the test harness drives it)"))
