;; discord-notify/run.tlisp — POST a Discord-embed message.
;;
;; Was jq-through-sh then curl-through-sh: the webhook URL (the credential) in
;; argv, no `--fail` so a 401 exited 0, and the payload rebuilt as shell text.
;;
;; And the documented COLOR input NEVER WORKED. action.yml says "decimal int
;; or hex like 0x00ff00"; the old code passed it to jq's `tonumber`, which
;; rejects `0x00ff00` outright, so every run using the documented hex form
;; died at payload assembly. `num:parse-int` accepts both.
;;
;; The jq call also read `"$COLOR"`/`"$BODY"` from the ENVIRONMENT rather than
;; the bound values, so the tlisp defaults were unreachable — an unset COLOR
;; made jq evaluate `("" | tonumber)` and the action failed instead of posting.

(define webhook (env-required "WEBHOOK_URL"))

(define title (env-required "TITLE"))

(define body (env-get "BODY" ""))

(define color-raw (env-get "COLOR" "3066993"))

(define color
  (let ((r (num:parse-int color-raw)))
    (cond
      ((erro:err? r)
        (log-error
          (string-append "discord-notify: COLOR '" color-raw
                         "' is neither a decimal int nor 0x-prefixed hex"))
        (append-output "delivered=false")
        (exit 1))
      (else (erro:value r)))))

(define payload
  (list
    (list "embeds"
      (list
        (list
          (list "title" title)
          (list "description" body)
          (list "color" color))))))

(define r (webhook:post webhook (list) payload))

(cond
  ((erro:err? r)
    (log-error
      (string-append "discord-notify: delivery failed — " (erro:message (erro:value r))))
    (append-output "delivered=false")
    (exit 1))
  (else
    (log-info "delivered to Discord")
    (append-output "delivered=true")
    (exit 0)))
