;; container-boot-check/run.tlisp — start a container, poll a health
;; command until it succeeds or a bounded attempt count is exhausted.
;; Generic: any image, any health command, no secrets, no
;; camelot/akeyless-specific logic. Dumps container logs on timeout so
;; a boot failure is never silent (the whole point of this gate).
;;
;; Real-world motivation: a Nix-rebuilt image can pass every CVE scan
;; and still crash at process boot (an OTP-version mismatch crashed
;; rabbitmq-server at Erlang VM startup while scanning clean) -- a
;; CVE-clean image that never starts is worse than useless.
;;
;; HEALTH_CMD may be empty: a distroless/shell-less image (a static
;; Go binary, a pure-Python app on a distroless-glibc base) has no `sh`
;; for `docker exec` to invoke at all, so exec-based polling is
;; structurally impossible -- not just inapplicable. In that case this
;; falls back to a "still running after the wait window" check via
;; `docker inspect .State.Running`, no exec into the container at all.
;; A real crash (import error, syntax error, immediate exit) still
;; fails this the same way it would fail a health-cmd poll.

(define image (env-required "IMAGE"))

(define health-cmd (env-get "HEALTH_CMD" ""))

(define container-env (env-get "CONTAINER_ENV" ""))

(define container-name "boot-check-target")

;; tatara-lisp has no string->number; bridge a numeric env string to an
;; Int via json-parse (a bare integer is valid JSON) -- the proven
;; nix-image/run.tlisp pattern.
(define
  (parse-int s fallback)
  (let ((t (string-trim s))) (cond ((equal? t "") fallback) (else (json-parse t)))))

(define max-attempts (parse-int (env-get "MAX_ATTEMPTS" "30") 30))

(define poll-interval (string-trim (env-get "POLL_INTERVAL_SECONDS" "3")))

(define
  (env-pairs)
  (filter (lambda (l) (not (equal? l ""))) (string-split (string-trim container-env) "\n")))

(define
  (env-flags pairs)
  (cond ((null? pairs) (list)) (else (append (list "-e" (car pairs)) (env-flags (cdr pairs))))))

;; Best-effort cleanup of a stale container from a previous attempt in
;; this same job -- ignored if none exists.
(exec-capture "docker" "rm" "-f" container-name)

(define
  run-args
  (append (list "run" "-d" "--name" container-name) (env-flags (env-pairs)) (list image)))

(log-info (string-append "==> starting " image))

(define start-result (apply exec-capture (cons "docker" run-args)))

(define (cleanup) (exec-capture "docker" "rm" "-f" container-name))

(cond
  ((not (= (status-of start-result) 0))
    (log-error (string-append "docker run failed: " (stderr-of start-result)))
    (append-output "healthy=false")
    (exit 1))
  (else 'started))

;; Poll loop (recursion is tatara-lisp's loop construct -- no native
;; while). Each miss sleeps poll-interval seconds via a single tiny
;; `sh -c "sleep N"` exec, the same sanctioned side-effect idiom
;; cargo-publish-each-member's real-sleep already uses. Runs on the
;; RUNNER's own shell (always present), never inside the target
;; container -- the exec-into-target only happens for the health-cmd
;; branch below.
(define
  (poll attempt)
  (cond
    ((> attempt max-attempts) 'timeout)
    (else
      (let
        ((r (exec-capture "docker" "exec" container-name "sh" "-c" health-cmd)))
        (cond
          ((= (status-of r) 0) 'healthy)
          (else
            (exec-capture "sh" "-c" (string-append "sleep " poll-interval))
            (poll (+ attempt 1))))))))

;; Shell-less fallback: wait the full window, then ask the DAEMON (not
;; the container) whether it's still running. No exec into the target.
(define wait-seconds (* max-attempts (parse-int poll-interval 3)))

(define
  (still-running-after-wait)
  (exec-capture "sh" "-c" (string-append "sleep " (string-format "{}" wait-seconds)))
  (let
    ((r (exec-capture "docker" "inspect" "--format" "{{.State.Running}}" container-name)))
    (if (and (= (status-of r) 0) (equal? (string-trim (stdout-of r)) "true")) 'healthy 'timeout)))

;; ── THIRD MODE: a binary that CANNOT fully start in isolation ──────────────
;; Measured 2026-08-01 on akeylesslabs' camelot-hardened-images run 30702469999:
;; `clickhouse-operator` fails boot-check with
;;   F():Unable to build kubeconf: ~/.kube/config not found  -> exitCode=255
;; It is a KUBERNETES OPERATOR. There is no cluster inside `docker run`, so it
;; cannot stay up and cannot answer an exec'd health-cmd. BOTH existing modes
;; therefore fail it by construction:
;;   * still-running-after-wait — it exits 255 immediately
;;   * health-cmd poll          — execs into a container that already exited
;;
;; That is a gate which can NEVER pass. Everything this campaign has hunted so
;; far was a gate that always passes; this is the inverse, and its blast radius
;; is worse: a vacuous GREEN lets one bad artifact through, a vacuous RED blocks
;; every GOOD one behind it. Four consecutive downstream runs died here, so the
;; images that DID pass never promoted either.
;;
;; It is also better camouflaged. Nobody audits a FAILING security gate for
;; correctness — red reads as the system working, the finding is assumed real,
;; and triage goes to the thing under test ("the operator image is broken")
;; rather than to the test. Discovering it requires concluding that a security
;; control is wrong, which is the socially expensive answer.
;;
;; WHAT THIS MODE PROVES, and it is deliberately WEAKER than 'healthy':
;; reaching a known startup string proves the binary LOADED — every shared
;; library resolved, no glibc collision, no missing interpreter, no SIGSEGV
;; before main — and executed into its own startup path. For a hardened-image
;; rewrap that IS the property at risk; it is exactly the class that caught
;; keeper's 139. It does NOT prove the process serves anything. Never report an
;; expect-log pass as "healthy".
;;
;; ANTI-LAUNDERING: the string is REQUIRED and must be non-empty. An empty
;; EXPECT_LOG does not select this mode, so it can never degrade into
;; "any output passes" — the failure shape it exists to remove. Callers must
;; name a string only a correctly-loading binary can emit; a string the runtime
;; prints before exec'ing the entrypoint would make this vacuous again.
;; ── MEASURED CONSUMERS (akeylesslabs camelot-hardened-images run 30706207197,
;; 2026-08-01). THREE images fail boot-check, and they are TWO distinct causes,
;; not one -- which matters, because "three boot-check failures" reads as one
;; bug and is not:
;;
;;   clickhouse-operator          exitCode=255  "Unable to build kubeconf"
;;   clickhouse-metrics-exporter  exitCode=255  "Unable to build kubeconf"  (same)
;;   clickhouse-backup            exitCode=0    prints its usage banner
;;
;; The first two are k8s operators with no cluster. The THIRD is the sharpest
;; case this action has produced: `clickhouse-backup` is a ONE-SHOT CLI. It ran
;; correctly, printed `clickhouse-backup - Tool for easy backup of ClickHouse`,
;; and exited ZERO -- and the gate reported "never became healthy". A container
;; that SUCCEEDED was flagged as a boot failure, because both original modes
;; assume a daemon. No amount of fixing the image could have made that pass.
;;
;; Suggested values (each string chosen because only a correctly-loading binary
;; emits it, per the anti-laundering rule above):
;;   clickhouse-operator          expect-log: "Unable to build kubeconf"
;;   clickhouse-metrics-exporter  expect-log: "Unable to build kubeconf"
;;   clickhouse-backup            expect-log: "Tool for easy backup of ClickHouse"
;;
;; BOTH OUTPUT SHAPES ARE VERIFIED against real containers, each with a negative
;; control: marker on STDERR with exit 255, and marker on STDOUT with exit 0.
;; That pair is why this reads `docker logs 2>&1` and ignores the exit code --
;; either alone would have covered one class and silently failed the other.
(define expect-log (env-get "EXPECT_LOG" ""))

(define
  (reached-expected-log)
  (exec-capture "sh" "-c" (string-append "sleep " (string-format "{}" wait-seconds)))
  ;; 2>&1 is load-bearing: glog and most Go startup diagnostics go to STDERR,
  ;; and `docker logs` keeps the streams separate. Reading only stdout would
  ;; report "string absent" for a container that printed it.
  (let
    ((r (exec-capture "sh" "-c"
          (string-append "docker logs " container-name " 2>&1"))))
    (if (and (= (status-of r) 0) (string-contains? (stdout-of r) expect-log))
      'expected-log-reached
      'timeout)))

(define result
  (cond
    ((not (equal? expect-log "")) (reached-expected-log))
    ((equal? health-cmd "") (still-running-after-wait))
    (else (poll 1))))

(cond
  ;; Distinct verdict, distinct wording, on purpose. This is a LOAD proof, not
  ;; a health proof, and the log line a human skims must not say otherwise --
  ;; rounding it up to "passed health check" would recreate the overclaim in
  ;; the one place anyone reads. `healthy=true` is still emitted because the
  ;; output means "this boot-check passed", and every consumer branches on it;
  ;; the qualifier lives in the message beside it.
  ((equal? result 'expected-log-reached)
    (log-info
      (string-append
        image
        " LOADED and reached its expected startup marker: \""
        expect-log
        "\" -- this proves the binary linked and executed into its own startup"
        " path (the class that catches a glibc collision or a missing"
        " interpreter). It does NOT prove the process serves traffic; this"
        " image cannot fully start in isolation by design."))
    (append-output "healthy=true")
    (cleanup)
    (exit 0))
  ((equal? result 'healthy)
    (log-info
      (string-append
        image
        " booted and passed health check ("
        (string-format "{}" max-attempts)
        " attempts allowed)"))
    (append-output "healthy=true")
    (cleanup)
    (exit 0))
  (else
    (log-error
      (string-append
        image
        " never became healthy after "
        (string-format "{}" max-attempts)
        " attempts -- container logs follow"))
    ;; ── DUMP THE STATE, NOT JUST THE LOGS ──────────────────────────────────
    ;; `docker logs` alone is not enough, and hardened-images run 30698283011
    ;; is the receipt: release-clickhouse-keeper failed here with
    ;; "never became healthy ... container logs follow" and the dump that
    ;; followed was EMPTY -- the very next line in the job log was the git
    ;; cleanup two seconds later. A distroless image that dies instantly writes
    ;; nothing to stdout/stderr, so the operator was handed a red verdict with
    ;; ZERO evidence, and "the container printed nothing" was indistinguishable
    ;; from "we failed to capture the logs".
    ;;
    ;; .State.ExitCode / .State.Error / .State.OOMKilled are what actually name
    ;; the cause in that case: 127 for a missing interpreter or entrypoint, 125
    ;; when the runtime itself refused, a non-empty .Error for "exec format
    ;; error", OOMKilled for a memory limit. They cost one docker call and are
    ;; available precisely when the log dump is empty.
    (let
      ((logs (exec-capture "docker" "logs" container-name)))
      (if (and (equal? (string-trim (stdout-of logs)) "")
               (equal? (string-trim (stderr-of logs)) ""))
        (log-error "container produced NO output on stdout or stderr")
        (begin (log-info (stdout-of logs)) (log-info (stderr-of logs)))))
    (let
      ((st (exec-capture "docker" "inspect" "--format"
             "exitCode={{.State.ExitCode}} oomKilled={{.State.OOMKilled}} error={{.State.Error}} status={{.State.Status}}"
             container-name)))
      (log-error (string-append "container state: " (string-trim (stdout-of st)))))
    (append-output "healthy=false")
    (cleanup)
    (exit 1)))
