;; rust-workspace-publish/run.tlisp — ship workspace to the Rust
;; registry; auto-rename conflicts, auto-skip already-published,
;; auto-back-off on 429 rate limits.

(define dry-run (env-get "DRY_RUN" "false"))

(define no-verify (env-get "NO_VERIFY" "true"))

(define rename-prefix (env-get "RENAME_PREFIX" "pleme-io-"))

(define max-retries 20)

;; publish-mode: "full" (default) = bump+ship on push, with a bounded
;; in-job ride of crates.io's new-crate rate limit; "drip" = a cron tick
;; that publishes only what current capacity allows and never sleeps
;; in-job — it hands the remainder to the next tick. The two compose:
;; "full" drains the first batch immediately on the push that triggered
;; the bootstrap; "drip" rides the refill across ticks until convergence.
(define publish-mode (env-get "PUBLISH_MODE" "full"))

;; In-job ride budget. A push (full mode) drains the burst immediately
;; and rides a few precise refill windows so the triggering push makes
;; real progress — but capped at 30 min so it never hogs a runner (or
;; approaches GitHub's 6h wall). Any refill landing beyond the cap
;; converts to a cron deferral instead of an in-job sleep, and the */15
;; drip finishes the long tail cheaply. (now) is unix seconds;
;; budget-deadline is the absolute epoch past which 429s defer to cron.
(define budget-secs 1800)

;; 30m
(define job-start (now))

(define budget-deadline (+ job-start budget-secs))

;; append-output / status-of / stdout-of / stderr-of / configure-git-bot come
;; from the STDLIB. They used to be re-declared here, and because action.yml
;; concatenates stdlib.tlisp first, every local copy shadowed its stdlib
;; original. Harmless while the copies agreed — and the mechanism by which the
;; dep-missing predicate silently diverged and stalled the whole 0.3.x line.
;; This action now carries zero stdlib shadows; `tlisp-lint` fails a new one.

;; -------------------------------------------------------------- ;;
;; Workspace enumeration                                           ;;
;; -------------------------------------------------------------- ;;
;; cargo metadata exposes every workspace member's name. We list
;; them, then publish per-crate so we can skip / rename / retry
;; individually instead of all-or-nothing.

;; workspace.package.version is read via the stdlib's hardened
;; `cargo-workspace-version`. The previous local walker exited the
;; [workspace.package] section on ANY line containing `[` (so an array
;; field like `keywords = ["a","b"]` above `version` ended the section →
;; empty version → publish failed) and matched `version` as a substring
;; (so `rust-version` could win). The stdlib's `line-is-section-header?`
;; (bracket AND no `=`) + `line-assigns-field?` (exact field) fix both —
;; solve once, in one place.

(define (workspace-members)
  ;; `cargo metadata --no-deps --format-version 1` returns JSON with
  ;; workspace_members listed. We use jq via exec-capture for a
  ;; line-per-name shape that's easy to parse in tlisp.
  ;;
  ;; `select(.publish != [])` EXCLUDES members marked `publish = false`.
  ;; cargo metadata encodes the field three ways and only one of them means
  ;; "never publish":
  ;;   publish absent / true  -> "publish": null   (any registry — SHIP)
  ;;   publish = ["some-reg"] -> ["some-reg"]      (restricted — SHIP)
  ;;   publish = false        -> []                (NEVER — skip)
  ;; so the empty-array test is exact, and `!= []` keeps null (the common
  ;; case) rather than accidentally filtering it.
  ;;
  ;; Without this the publisher ATTEMPTS an unpublishable member, cargo
  ;; refuses with "`package.publish` must be set to `true` or a non-empty
  ;; list in Cargo.toml to publish", that text matches no known signature,
  ;; and the run is classified a PERMANENT FAILURE — exit 1 on a workspace
  ;; where every publishable crate shipped fine. Measured on
  ;; pleme-hotswap-derive run 31076862995 (2026-08-06): pleme-hotswap and
  ;; pleme-hotswap-derive both "already published — treating as success",
  ;; then `pleme-hotswap-gen` (a generator, deliberately publish = false)
  ;; turned the whole release red. That repo has never had a green release
  ;; run, for this reason alone.
  ;;
  ;; This is a SKIP, not a new success signature: an unpublishable member is
  ;; not a publish that succeeded, it is a publish that was never owed. It
  ;; must not be reachable by the retry/already-published paths at all.
  (let*
    ((r
       (exec-capture "sh"
         "-c"
         (string-append
           "cargo metadata --no-deps --format-version 1 | jq -r "
           "'.packages[] | select(.publish != []) | .name'")))
      (out (stdout-of r)))
    (string-split (string-trim out) "\n")))

;; Each member's SHIPPED dependencies, as
;;   "<name>\t<dep>,<dep>,…\t<exact-pinned-dep>,…"
;; [dev-dependencies] are excluded (`kind == "dev"`): cargo strips them on
;; publish, so a dev-dep is not a publish-ordering edge — and a dev-dep cycle
;; between two members is perfectly legal, so including them would report a
;; false cycle. Normal deps carry `kind: null`, build deps `"build"`; both ship.
;;
;; Field 3 is the EXACT-pinned subset (`req` starting with "="). That is the
;; lib<->derive seal, e.g. tatara-lisp's `tatara-lisp-derive = { version =
;; "=0.3.3" }`, which exists so a published lib can never fail to compile
;; itself against a floated derive. An exact pin has ZERO slack against index
;; lag — no other version can satisfy it — so its target is published first
;; within its ready batch, buying the most settle time before its dependent.
(define (workspace-dep-lines)
  (let*
    ((r
       (exec-capture "sh"
         "-c"
         (string-append
           "cargo metadata --no-deps --format-version 1 | jq -r "
           "'.packages[] | .name + \"\\t\" + "
           "([.dependencies[] | select(.kind != \"dev\") | .name] | join(\",\"))"
           " + \"\\t\" + "
           "([.dependencies[] | select(.kind != \"dev\")"
           " | select(.req | startswith(\"=\")) | .name] | join(\",\"))'")))
      (out (string-trim (stdout-of r))))
    (if (equal? out "")
      (list)
      (string-split out "\n"))))

(define (csv-field parts n)
  (let ((raw (if (< (length parts) (+ n 1)) "" (string-trim (nth n parts)))))
    (if (equal? raw "")
      (list)
      (string-split raw ","))))

;; "<name>\t<a>,<b>\t<a>" → ("<name>" "<a>" "<b>")
(define (parse-dep-line line)
  (let ((parts (string-split line "\t"))) (cons (string-trim (car parts)) (csv-field parts 1))))

;; every member name that some member EXACT-pins
(define (parse-exact-line line) (csv-field (string-split line "\t") 2))

(define (workspace-dep-graph) (map parse-dep-line (workspace-dep-lines)))

(define (flatten-lists xs)
  (cond ((null? xs) (list)) (else (append (car xs) (flatten-lists (cdr xs))))))

(define (workspace-exact-pinned) (flatten-lists (map parse-exact-line (workspace-dep-lines))))

;; -------------------------------------------------------------- ;;
;; crates.io existence check                                       ;;
;; -------------------------------------------------------------- ;;
;; curl --fail returns 22 on 4xx. We just check the http status
;; code. If the (name, version) pair already exists, we skip the
;; publish to keep the run idempotent.

(define (already-published? name version)
  (let*
    ((url (string-append "https://crates.io/api/v1/crates/" name "/" version))
      (r (exec-capture "curl" "-s" "-o" "/dev/null" "-w" "%{http_code}" url))
      (code-str (stdout-of r)))
    (equal? code-str "200")))

;; -------------------------------------------------------------- ;;
;; Per-crate publish                                               ;;
;; -------------------------------------------------------------- ;;

(define (publish-args name)
  (let*
    ((base (list "publish" "-p" name))
      (with-dry (if (equal? dry-run "true") (append base (list "--dry-run")) base)))
    (if (equal? no-verify "true")
      (append with-dry (list "--no-verify"))
      with-dry)))

(define (do-publish name) (apply exec-capture (cons "cargo" (publish-args name))))

;; -------------------------------------------------------------- ;;
;; Failure-mode detection                                          ;;
;; -------------------------------------------------------------- ;;
;; The textual predicates (`cargo-publish-already-uploaded?`,
;; `cargo-publish-conflict?`, `cargo-publish-rate-limited?`,
;; `cargo-publish-dep-missing-line?`) live in the STDLIB and are used from
;; there. They used to be re-declared here, and because action.yml
;; concatenates stdlib.tlisp FIRST and this file SECOND, the local copies
;; SHADOWED the stdlib ones (a later top-level `define` wins). That shadowing
;; is what stalled the whole tatara-lisp 0.3.x line at 0.2.5:
;;
;;   local  dep-missing? on the real v0.3.3 log => #f
;;   stdlib cargo-publish-dep-missing? on it    => #t
;;   verdict actually reached                   => 'failed  → exit 1
;;
;; The local `dep-missing-on-line?` required "failed to select a version" AND
;; "which is not on the registry" on the SAME line. Cargo never emits that
;; pair on one line — it puts the requirement on one line and
;; "candidate versions found which didn't match" / "location searched" /
;; "required by package" on the following ones. So a textbook sibling-ordering
;; failure hit the else arm ("no recognizable signature") and aborted the run.
;;
;; The shadowing also silently withheld two stdlib fixes from this action: the
;; 403 "seem to be an owner" / Unauthorized / denied / Invalid-token conflict
;; arm (the `tear` crate, 2026-07-17) and the "429 Too Many" rate-limit arm.
;; Predicates now have exactly one home. See run.test.tlisp for the RED proof.

;; Return the FIRST line matching `pred`, or "" — so a classifier can SHOW
;; the cargo line it classified on instead of only its own verdict. A verdict
;; without its evidence is how a misclassification survives: the log said
;; "dep not on registry yet" for escriba while all 23 of its dependencies were
;; published and semver-satisfiable, and nothing in the output revealed what
;; cargo had actually complained about.
(define (first-matching-line lines pred)
  (cond
    ((null? lines) "")
    ((pred (car lines)) (car lines))
    (else (first-matching-line (cdr lines) pred))))

;; -------------------------------------------------------------- ;;
;; dep-missing, decided STRUCTURALLY instead of textually           ;;
;; -------------------------------------------------------------- ;;
;; The escriba lesson was real: matching "failed to select a version" on text
;; alone laundered genuine resolution failures into "dep not on registry yet",
;; which deferred forever and then aborted naming a provably false cause. But
;; the narrowing that fixed it overshot into never matching at all.
;;
;; The honest discriminator is not a longer string — it is the NAME cargo
;; already tells us. Every unsatisfiable-requirement message names the crate:
;;
;;   failed to select a version for the requirement `tatara-cilium = "^0.3.3"`
;;   no matching package named `tatara-cilium` found
;;
;; If that name is a workspace sibling, the crate genuinely is not on the
;; registry yet (we are mid-ship) → DEFER, bounded by the pass budget. If it
;; is not a sibling, no amount of deferring can ever make it resolve → it is a
;; real failure and is reported with its verbatim evidence line. escriba's
;; blocker named an external crate, so under this rule it fails loudly; the
;; tatara case names a sibling, so it defers. One rule, both cases right.

;; Extract the backticked crate name cargo names on a line, or "".
;; `foo = "^1.2"` → "foo";  `foo` → "foo";  no backticks → "".
(define (requirement-name-on-line line)
  (let ((parts (string-split line "`")))
    (cond
      ((< (length parts) 2) "")
      (else (string-trim (car (string-split (car (cdr parts)) " ")))))))

(define (workspace-sibling? name members)
  ;; A sibling under its own name, or under the conflict-rename identity the
  ;; rename path republishes it as (pleme-io-<member>) — a dependent resolves
  ;; against the NEW name, which is absent from the pre-rename member list.
  (cond
    ((equal? name "") #f)
    ((null? members) #f)
    ((equal? name (car members)) #t)
    ((equal? name (string-append rename-prefix (car members))) #t)
    (else (workspace-sibling? name (cdr members)))))

(define (sibling-dep-blocker-line? line members)
  (and
    (cargo-publish-dep-missing-line? line)
    (workspace-sibling? (requirement-name-on-line line) members)))

(define (sibling-dep-missing? log members)
  (any-line-matches?
    (string-split log "\n")
    (lambda (line) (sibling-dep-blocker-line? line members))))

;; The evidence line for whichever verdict we reached — a resolution complaint
;; if cargo made one, else "".
(define (resolution-evidence log)
  (first-matching-line (string-split log "\n") cargo-publish-dep-missing-line?))

;; -------------------------------------------------------------- ;;
;; Rate-limit riding                                               ;;
;; -------------------------------------------------------------- ;;
;; crates.io throttles NEW-crate publishes; its 429 body carries
;; "Please try again after <HTTP-date>". We ride that refill precisely.
;; All date math + the sleep live inside ONE `sh -c` blob (the runtime
;; has no string->number, so numbers never cross back into tlisp), and
;; the cargo log is handed off via a temp FILE so its multiline stderr
;; is never interpolated into the command string. LC_ALL=C forces
;; English date parsing regardless of the runner locale (crates.io
;; always emits English month/day names). Returns one of:
;;   "rode" — slept the precise window in-job; retry the crate
;;   "wait" — drip tick, OR refill beyond the job budget, OR no parseable
;;            timestamp: re-queue for the next cron tick (exit green)
(define rl-log-path "/tmp/rust-workspace-publish-429.log")

(define (rate-limit-decision log)
  (write-file rl-log-path log)
  (let
    ((r
       (exec-capture "sh"
         "-c"
         (string-append
           "LOG='"
           rl-log-path
           "'; MODE='"
           publish-mode
           "'; DEADLINE="
           (string-format "{}" budget-deadline)
           "; "
           "d=$(grep -oiE 'try again after [A-Za-z]{3}, [0-9]{2} [A-Za-z]{3} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT' \"$LOG\" 2>/dev/null | head -1 | sed -E 's/^[Tt]ry again after //'); "
           "now=$(LC_ALL=C date -u +%s); resume=''; "
           "if [ -n \"$d\" ]; then resume=$(LC_ALL=C date -u -d \"$d\" +%s 2>/dev/null); fi; "
           "[ -z \"$resume\" ] && resume=$((now + 600)); "
           "if [ \"$MODE\" = drip ]; then echo wait; exit 0; fi; "
           "if [ \"$resume\" -gt \"$DEADLINE\" ]; then echo wait; exit 0; fi; "
           "w=$((resume - now + 10)); [ \"$w\" -lt 1 ] && w=1; "
           "echo \"riding rate limit ${w}s\" >&2; sleep \"$w\"; echo rode"))))
    (string-trim (stdout-of r))))

;; -------------------------------------------------------------- ;;
;; Rename on conflict                                              ;;
;; -------------------------------------------------------------- ;;

;; `replace-once-in-file` used to live HERE, as:
;;
;;     (define (replace-once-in-file path needle replacement)
;;       (let ((contents (read-file path)))
;;         (write-file path (string-replace contents needle replacement))))
;;
;; It COULD NOT FAIL. MEASURED: `string-replace` with an absent needle returns
;; the contents unchanged, so `write-file` rewrote the file BYTE-IDENTICALLY,
;; returned normally, and `rename-crate` went on to log "renamed 'X' -> 'Y'"
;; having changed nothing. It is now the stdlib's
;; `replace-once-in-file-or-die` / `replace-once-in-file-verified` pair, which
;; returns a typed outcome and refuses on 'needle-absent / 'needle-ambiguous.
;; Deliberately NOT re-declared locally — a local copy would shadow the
;; stdlib's, which is the exact class tlisp-lint Layer 4 gates.
;;
;; ── Why the old needle was WRONG, not merely unguarded ──────────────────
;;
;; The old code SYNTHESIZED the dependency line it meant to patch:
;;     X = { path = "X", version = "<cargo-workspace-version>" }
;; guessing the version REQUIREMENT from the workspace VERSION. Those are
;; different strings. tatara-lisp/Cargo.toml carries, verbatim:
;;     tatara-lisp-derive       = { path = "…", version = "=0.3.3" }  ← EXACT
;;     tatara-closed-set-derive = { path = "…", version = "=0.3.3" }  ← EXACT
;;     tatara-lisp              = { path = "…", version = "0.3.3"  }
;; so the synthesized needle missed BOTH exact-pinned rows, and had it
;; "matched" by being rewritten into a caret it would have ERASED the
;; lib↔derive seal that stops a published lib failing to compile against a
;; floated derive.
;;
;; The fix is to stop synthesizing: LOCATE the line, edit it in place. The
;; requirement is then preserved byte-for-byte because it is never re-typed —
;; `=0.3.3`, `^0.3.3`, `0.3.3`, or a shape nobody has met yet.
;;
;; ── Shape coverage, stated honestly ────────────────────────────────────
;;
;; SUPPORTED (all four route through the ONE [workspace.dependencies] row):
;;   exact        `X = { path = "X", version = "=1.2.3" }`
;;   caret        `X = { path = "X", version = "^1.2.3" }`
;;   plain        `X = { path = "X", version = "1.2.3"  }`
;;   inheritance  member has `X.workspace = true`; the real pin is the
;;                [workspace.dependencies] row. Cargo inherits the WHOLE spec
;;                including `package`, so patching that one row renames the
;;                dep for every inheriting member and NO member file changes.
;;
;; REFUSED LOUDLY (never silently skipped):
;;   - no [workspace.dependencies] row for X (members declare X inline). A
;;     correct fix needs the member set and would have to rewrite N manifests;
;;     a PARTIAL rewrite across N members is strictly worse than a refusal, so
;;     this returns #f and the caller red-fails the crate.
;;   - a multi-line inline table, or a bare `X = "1.2"` string dep — shapes
;;     `toml-inline-table-add-key` will not mangle.
;; Tier: only-mitigated. The refusal is a runtime `#f` → ("fail" name), not a
;; type error. Do not round up.

;; ── The PURE decision, split out so it is provable ─────────────────────
;; Given the VERBATIM [workspace.dependencies] row for the crate (or "" when
;; there is none) and the target name, return either the NEW row (a string) or
;; a typed refusal symbol. Every real judgement lives here, so the whole
;; exact-pin-preservation contract is unit-testable with no cargo, no git and
;; no filesystem — which is the only reason the old version's wrongness could
;; sit undetected: its decision was welded to its I/O.
;;
;;   'no-workspace-dep-row  — nothing to patch; caller must refuse
;;   'already-renamed       — a `package =` key is already present (idempotent)
;;   'unsupported-dep-shape — not a single-line inline table
(define (rename-dep-row-plan dep-line new-name)
  (cond
    ((equal? (string-trim dep-line) "") 'no-workspace-dep-row)
    ((string-contains? dep-line "package =") 'already-renamed)
    (else
      (let ((new-row (toml-inline-table-add-key dep-line "package" new-name)))
        (if (equal? new-row "")
          'unsupported-dep-shape
          new-row)))))

(define (rename-crate original)
  (let*
    ((new-name (string-append rename-prefix original))
      (crate-toml (string-append original "/Cargo.toml"))
      (dep-line (toml-line-in-section "Cargo.toml" "[workspace.dependencies]" original))
      (plan (rename-dep-row-plan dep-line new-name)))
    (cond
      ((not (path-exists? crate-toml))
        (log-error (string-append "no crate dir for '" original "'"))
        #f)

      ;; No workspace-level pin to patch → refuse, do not half-rename.
      ((equal? plan 'no-workspace-dep-row)
        (log-error
          (string-append
            "rename of '"
            original
            "' REFUSED: no `"
            original
            " = { … }` row under [workspace.dependencies] in the root Cargo.toml. "
            "The old code would have rewritten nothing here and reported success. "
            "Supported shapes are an inline table with an exact/caret/plain "
            "version (members may inherit it via `"
            original
            ".workspace = true`); an inline per-member declaration is not "
            "auto-renamed because a partial rewrite across members is worse "
            "than this refusal."))
        #f)

      ;; Idempotent: a previous pass already renamed it.
      ((equal? plan 'already-renamed)
        (log-info
          (string-append
            "'"
            original
            "' already carries a `package =` "
            "rename in [workspace.dependencies]; nothing to do"))
        #t)

      ((equal? plan 'unsupported-dep-shape)
        (log-error
          (string-append
            "rename of '"
            original
            "' REFUSED: its [workspace.dependencies] "
            "row is not a single-line inline table this action can edit "
            "without mangling it. Verbatim row: "
            dep-line))
        #f)

      (else
        ;; (a) the member's own [package] name. LOCATED, not synthesized, so a
        ;; `[[bin]] name = "X"` line cannot be caught in the blast radius — and
        ;; if the located line somehow occurs twice, the primitive refuses
        ;; rather than rewriting both.
        (let ((name-line (toml-line-in-section crate-toml "[package]" "name")))
          (cond
            ((equal? name-line "")
              (log-error
                (string-append
                  "rename of '"
                  original
                  "' REFUSED: no `name = …` under "
                  "[package] in "
                  crate-toml))
              #f)
            (else
              (replace-once-in-file-or-die
                crate-toml
                name-line
                (string-append
                  "name = \""
                  new-name
                  "\""))
              ;; (b) the workspace pin — requirement preserved verbatim.
              (replace-once-in-file-or-die
                "Cargo.toml"
                dep-line
                plan)
              (log-info
                (string-append
                  "renamed '"
                  original
                  "' -> '"
                  new-name
                  "' (workspace pin now: "
                  (string-trim plan)
                  ")"))
              #t)))))))

(define (commit-and-push original)
  (let ((new-name (string-append rename-prefix original)))
    ;; Per-path add (a missing pathspec must not abort the whole stage),
    ;; then commit + push via exec-or-die: a silently-ignored push here
    ;; left the rename UNPUSHED while the loop treated it as done → the
    ;; conflicting name was re-published every pass.
    (for-each
      (lambda (p) (exec-check "git" "add" p))
      (list (string-append original "/Cargo.toml") "Cargo.toml"))
    (exec-or-die
      (list
        "git"
        "commit"
        "-m"
        (string-append
          "rename: "
          original
          " -> "
          new-name
          " (registry name conflict)")))
    (exec-or-die (list "git" "push" "origin" "HEAD:main"))))

;; -------------------------------------------------------------- ;;
;; Per-crate publish loop with retry                               ;;
;; -------------------------------------------------------------- ;;

;; TLISP_TEST gate — same shape as `cargo-publish-each-member/run.tlisp:262`.
;; Under the harness the definitions load but the main is SKIPPED, so
;; run.test.tlisp can drive the real classifier + the real ordering against
;; verbatim cargo output with no Cargo.toml, no git, no registry.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(define version (if tlisp-test-mode "" (cargo-workspace-version)))

;; ── A DELIBERATE SIBLING OF THE STDLIB'S CLASSIFIER — read this first ──
;;
;; This is a NAMED VARIANT of `classify-cargo-publish-outcome`
;; (_tlisp-stdlib/stdlib.tlisp). The name says so on purpose: the last time an
;; action carried a differently-named near-duplicate of a stdlib predicate, the
;; kinship was ACCIDENTAL and invisible — a local `dep-missing-on-line?` was
;; narrowed until it matched nothing cargo emits while the stdlib's
;; `cargo-publish-dep-missing-line?` sat one concatenation away, never called,
;; and the whole tatara-lisp 0.3.x line stalled at 0.2.5. tlisp-lint's Layer 4
;; cannot see that class by name-intersection (no name collided), so the only
;; defense for a JUSTIFIED variant is to make the relationship explicit in the
;; code. That is what the `-with-siblings` suffix and this block are for.
;;
;; WHY IT CANNOT DELEGATE — two structural differences, both load-bearing:
;;
;;   (1) EXTRA INPUT. It needs `members`, the workspace sibling set, to split
;;       the stdlib's single 'dep-missing verdict in two: a sibling that simply
;;       is not on the registry YET (defer — we are mid-ship) versus an
;;       external requirement that can never resolve (fail loudly, the escriba
;;       shape). The stdlib's signature is (log status) and has no way to know.
;;
;;   (2) DIFFERENT ARM ORDER, on purpose. The stdlib tests conflict BEFORE
;;       dep-missing. Here conflict must be LAST, because the stdlib's conflict
;;       arm deliberately matches broad auth words ("denied", "Unauthorized")
;;       to catch crates.io's 403-on-foreign-name, and those words appear
;;       inside other error bodies — so it must never pre-empt the narrower
;;       sibling-dep test. Reordering the stdlib's arms to match would change
;;       every other consumer's verdicts; that is why this is a variant rather
;;       than an edit upstream.
;;
;; What it MUST NOT do, and does not: re-implement any of the stdlib's line
;; predicates. Every arm below calls a `cargo-publish-*?` from the stdlib, so a
;; stdlib fix reaches this action. The ONLY local logic is the sibling
;; discriminator (`sibling-dep-missing?`) and the arm order.
;;
;; Pure by construction, so the verdict is unit-testable against real cargo
;; output — a classifier that only exists inside an I/O-bound loop is a
;; classifier nobody can prove.
;;
;; Returns one of:
;;   'published   'already-uploaded   'dep-missing   'rate-limited
;;   'conflict    'failed
(define (classify-cargo-publish-outcome-with-siblings log members code)
  (cond
    ((= code 0) 'published)
    ((cargo-publish-already-uploaded? log) 'already-uploaded)
    ((sibling-dep-missing? log members) 'dep-missing)
    ((cargo-publish-rate-limited? log) 'rate-limited)
    ((cargo-publish-conflict? log) 'conflict)
    (else 'failed)))

;; -------------------------------------------------------------- ;;
;; Topological publish order                                       ;;
;; -------------------------------------------------------------- ;;
;; `cargo metadata` lists members alphabetically, which is exactly wrong: it
;; put `tatara` — the CLI with 11 intra-workspace deps — FIRST, so every
;; dependent was attempted before the leaf it needs existed on the registry.
;; Leaves must go first, and `tatara-lisp-derive` first of all, because
;; `tatara-lisp` EXACT-pins it (version = "=x.y.z", the deliberate lib<->derive
;; seal that stops a published lib from failing to compile itself against a
;; floated derive). Publishing the derive after the lib can never work.
;;
;; Kahn in original order: repeatedly emit every remaining member whose
;; intra-workspace deps are all already emitted. A pass that emits nothing
;; means a cycle — append the remainder in original order rather than dropping
;; a member or spinning, because a dropped member is a silent non-publish, the
;; same false-green class this whole fix exists to kill. (dev-dependencies are
;; filtered out upstream, so a real cycle is not expected.)

(define (name-in-list? x xs)
  (cond
    ((null? xs) #f)
    ((equal? (car xs) x) #t)
    (else (name-in-list? x (cdr xs)))))

(define (all-emitted? deps emitted members)
  (cond
    ((null? deps) #t)
    ((not (workspace-sibling? (car deps) members))
      ;; an external crate is not an ordering edge
      (all-emitted?
        (cdr deps)
        emitted
        members))
    ((name-in-list? (car deps) emitted) (all-emitted? (cdr deps) emitted members))
    (else #f)))

(define (deps-of name dep-alist)
  (cond
    ((null? dep-alist) (list))
    ((equal? (car (car dep-alist)) name) (cdr (car dep-alist)))
    (else (deps-of name (cdr dep-alist)))))

(define (topo-sweep remaining dep-alist emitted members ready blocked)
  ;; one sweep: partition `remaining` into newly-ready and still-blocked
  (cond
    ((null? remaining) (list (reverse ready) (reverse blocked)))
    ((all-emitted?
       (deps-of (car remaining) dep-alist)
       emitted
       members)
      (topo-sweep
        (cdr remaining)
        dep-alist
        (append emitted (list (car remaining)))
        members
        (cons (car remaining) ready)
        blocked))
    (else
      (topo-sweep
        (cdr remaining)
        dep-alist
        emitted
        members
        ready
        (cons (car remaining) blocked)))))

;; Within one ready batch the members are mutually independent, so any order
;; publishes correctly — but an EXACT-pinned target goes first, because `=x.y.z`
;; is the one requirement shape that no other published version can satisfy, so
;; it is the least forgiving of index lag.
(define (seal-first ready exact)
  (append
    (filter (lambda (n) (name-in-list? n exact)) ready)
    (filter (lambda (n) (not (name-in-list? n exact))) ready)))

(define (topo-drive remaining dep-alist emitted members exact)
  (cond
    ((null? remaining) emitted)
    (else
      (let*
        ((swept (topo-sweep remaining dep-alist emitted members (list) (list)))
          (ready (seal-first (car swept) exact))
          (blocked (car (cdr swept))))
        (cond
          ((null? ready)
            ;; cycle — nothing became ready. Keep every member; order degrades.
            (log-error
              (string-append
                "cycle among workspace members: "
                (string-join "," blocked)
                " — publishing them in manifest order"))
            (append emitted blocked))
          (else (topo-drive blocked dep-alist (append emitted ready) members exact)))))))

;; `exact` is optional-by-arity in spirit but explicit here: pass the
;; exact-pinned member names, or (list) when there are none.
(define (topo-order-with members dep-alist exact)
  (topo-drive
    members
    dep-alist
    (list)
    members
    exact))

(define (topo-order members dep-alist) (topo-order-with members dep-alist (list)))

;; Returns one of:
;;   ("done" . <final-name>) — successfully published (or skipped)
;;   ("defer" . <name>)      — dep not yet on registry, retry next pass
;;   ("fail" . <name>)       — permanent failure
;; `members` is the workspace member set — the classifier needs it to tell a
;; sibling that simply isn't published yet from an external dep that never
;; will be. `siblings` is threaded rather than read from a global so the
;; classifier stays pure and testable.
(define (publish-one-in siblings name attempt)
  (cond
    ((>= attempt max-retries)
      (log-error (string-append "exceeded retries for '" name "'"))
      (list "fail" name))
    ((already-published? name version)
      (log-info (string-append "skipping '" name "@" version "' — already on registry"))
      (list "done" name))
    (else
      (log-info
        (string-append
          "publishing '"
          name
          "@"
          version
          "' (attempt "
          (string-format "{}" attempt)
          ")"))
      (let*
        ((r (do-publish name))
          (code (status-of r))
          (log (string-append (stdout-of r) "\n" (stderr-of r)))
          (outcome (classify-cargo-publish-outcome-with-siblings log siblings code)))
        (cond
          ((equal? outcome 'published)
            (log-info (string-append "published '" name "'"))
            (list "done" name))
          ((equal? outcome 'already-uploaded)
            (log-info (string-append "already published '" name "' — treating as success"))
            (list "done" name))
          ((equal? outcome 'dep-missing)
            (log-info
              (string-append
                "deferring '"
                name
                "' — workspace sibling not on the "
                "registry yet: "
                (resolution-evidence log)))
            (list "defer" name))
          ((equal? outcome 'rate-limited)
            (let ((decision (rate-limit-decision log)))
              (cond
                ((string-contains? decision "rode")
                  ;; Rode the precise refill in-job. Retry the SAME crate
                  ;; WITHOUT advancing attempt — the job budget (not
                  ;; max-retries) bounds rate-limit riding, so a heavily
                  ;; throttled bootstrap can never exhaust retries → fail.
                  (log-info (string-append "rode rate-limit refill — retrying '" name "'"))
                  (publish-one-in
                    siblings
                    name
                    attempt))
                (else
                  ;; Capacity exhausted: park this crate and keep the pass
                  ;; going. A rate-limited bootstrap is NOT a failed run.
                  ;;
                  ;; ★ The message deliberately does NOT promise a "next
                  ;; tick". It used to, and that was the misleading half of a
                  ;; real incident (magma, 2026-08-07): ten crates parked
                  ;; behind magma-attest, the log said "re-queueing for next
                  ;; tick", and no tick ever came — the calling shim declares
                  ;; no `on: schedule`, and only 3 of 434 shims in the org do.
                  ;; A parked crate resumes on the NEXT RUN, whatever causes
                  ;; it; if the caller has no cron, that means a push or a
                  ;; manual dispatch. Say what is true and let the operator
                  ;; decide, rather than implying an automation that may not
                  ;; exist.
                  (log-info
                    (string-append
                      "capacity exhausted — parking '"
                      name
                      "'; it resumes on the next run of this workflow "
                      "(cron if the caller declares `on: schedule`, "
                      "otherwise a push or `workflow_dispatch`)"))
                  (list "wait" name)))))
          ((equal? outcome 'conflict)
            (log-info (string-append "name conflict on '" name "', renaming"))
            (cond
              ((rename-crate name)
                (commit-and-push name)
                (publish-one-in
                  siblings
                  (string-append rename-prefix name)
                  (+ attempt 1)))
              (else (log-error (string-append "rename failed for '" name "'")) (list "fail" name))))
          (else
            ;; Unrecognized. If cargo DID make a resolution complaint, name it:
            ;; that means the blocker is not a workspace sibling, so no amount
            ;; of deferring can make it resolve — the escriba shape.
            (let ((evidence (resolution-evidence log)))
              (cond
                ((equal? evidence "")
                  (log-error
                    (string-append
                      "publish of '"
                      name
                      "' failed with no recognizable signature")))
                (else
                  (log-error
                    (string-append
                      "publish of '"
                      name
                      "' blocked by a NON-sibling requirement (deferring "
                      "cannot fix this): "
                      evidence)))))
            (log-info log)
            (list "fail" name)))))))

;; -------------------------------------------------------------- ;;
;; Main                                                            ;;
;; -------------------------------------------------------------- ;;

;; Single terminal-output point (drive-passes returns exactly once, so
;; every terminal cond arm calls this). `pending` is the comma-joined
;; remainder left for the next cron tick; `complete?` is true iff nothing
;; remains. GitHub takes the last write for a duplicated key, so even an
;; accidental double-emit is benign — but routing all four lines through
;; here keeps them in lockstep.
(define (emit-outputs shipped renamed pending failed complete?)
  (append-output (string-append "shipped-count=" (string-format "{}" (length shipped))))
  (append-output
    (string-append "renamed-crates=" (if (null? renamed) "" (string-join "," renamed))))
  (append-output
    (string-append "pending-crates=" (if (null? pending) "" (string-join "," pending))))
  (append-output (string-append "failed-crates=" (if (null? failed) "" (string-join "," failed))))
  (append-output (string-append "bootstrap-complete=" (if complete? "true" "false"))))

;; Injected-side-effect accessor — the same `(alist-get ops k #f)` shape
;; cargo-publish-each-member uses, so both publishers read their ops the one way.
(define (ops-fn ops key) (alist-get ops key #f))

;; One pass over `names` → (shipped renamed deferred waited failed).
;;   shipped  — published (or skipped as already-on-registry)
;;   renamed  — published under a conflict-renamed name
;;   deferred — dep not yet on registry; retry next PASS (this tick)
;;   waited   — rate-limit capacity exhausted; retry next TICK (cron)
;;   failed   — permanent (unrecognized error / rename failure)
;;
;; A failure is COLLECTED, not thrown. The old code called (exit 1) the instant
;; one member failed, so the single misclassified `tatara` crate cancelled the
;; other 16 members of the tatara-lisp workspace — every one of which was
;; independently publishable. One bad member must cost exactly one member. The
;; driver decides the exit code once, at the end, naming every failure.
;;
;; `publish-one` is injected via `ops` so the bucketing is unit-testable
;; without cargo, git or a registry.
(define (publish-pass-with ops names shipped renamed deferred waited failed)
  (cond
    ((null? names) (list shipped renamed deferred waited failed))
    (else
      (let*
        ((name (car names))
          (result ((ops-fn ops "publish-one") name 1))
          (kind (car result))
          (final (car (cdr result))))
        (cond
          ((equal? kind "fail")
            (log-error
              (string-append
                "permanent failure on '"
                final
                "' — continuing with the remaining members"))
            (publish-pass-with
              ops
              (cdr names)
              shipped
              renamed
              deferred
              waited
              (append failed (list final))))
          ((equal? kind "wait")
            (publish-pass-with
              ops
              (cdr names)
              shipped
              renamed
              deferred
              (append waited (list final))
              failed))
          ((equal? kind "defer")
            (publish-pass-with
              ops
              (cdr names)
              shipped
              renamed
              (append deferred (list final))
              waited
              failed))
          ((equal? final name)
            (publish-pass-with
              ops
              (cdr names)
              (append shipped (list final))
              renamed
              deferred
              waited
              failed))
          (else
            (publish-pass-with
              ops
              (cdr names)
              (append shipped (list final))
              (append renamed (list name))
              deferred
              waited
              failed)))))))

(define (real-ops siblings)
  (list (cons "publish-one" (lambda (name attempt) (publish-one-in siblings name attempt)))))

;; A permanent failure anywhere in the workspace is a RED run — but only after
;; every other member has had its turn.
(define (pass-exit-code failed) (if (null? failed) 0 1))

;; -------------------------------------------------------------- ;;
;; Sparse-index propagation                                        ;;
;; -------------------------------------------------------------- ;;
;; A crate is visible to `cargo publish`'s resolver only once crates.io's
;; SPARSE INDEX serves it, which is not the same instant the publish returns
;; 200 — the index is fronted by a CDN, so a sibling published seconds earlier
;; can still be unresolvable. crates.io publishes NO propagation SLA, so there
;; is no honest fixed number to wait: what follows is a bounded backoff, not a
;; guarantee. Convergence is guaranteed by the pass budget plus the */15 drip
;; tick; the sleep only stops us from burning all 8 passes inside one second.
;; (Note `already-published?` polls the crates.io *API*, which can answer 200
;; while the index a resolver reads is still stale — the API is not the index.)
(define (index-settle-secs pass-n)
  (cond
    ((<= pass-n 1) 15)
    ((= pass-n 2) 30)
    ((= pass-n 3) 60)
    (else 120)))

;; Multi-pass driver. Each pass publishes what it can; dep-deferred crates
;; retry in the next pass (this tick, after an index-settle wait), rate-limited
;; crates are parked in `waited` for the next cron tick. A permanent failure
;; never stops a pass — it lands in `failed` and only decides the exit code.
;; Terminal cases:
;;   (a) pending empty           → done; RED iff anything failed
;;   (b) pass budget reached     → remainder deferred to next tick
;;   (c) no shipped, no waited,
;;       deferred == pending     → RED: real circular dep / stuck index
;;   (d) no shipped but parked   → capacity-blocked, cron resumes
;;   (e) otherwise               → progress; next pass over `deferred`
(define max-passes 8)

;; Public entry — 7 args, unchanged. `prev-shipped-n` starts at 0, which is the
;; honest initial state: before pass 1 nothing has shipped in this run, so a
;; pass-1 stall really is a cycle or a genuinely stuck index and SHOULD abort.
(define (drive-passes-with ops pending shipped renamed waited failed pass-n)
  (drive-passes-from ops pending shipped renamed waited failed pass-n 0))

;; `prev-shipped-n` — how many members the IMMEDIATELY PRECEDING pass shipped.
;;
;; It exists to separate two states the abort branch used to conflate, and the
;; conflation was measured, not theoretical: on 2026-08-07 tatara-lisp's pass 1
;; shipped 6 members (tatara-closed-set@0.3.38 among them), waited the 15s
;; window, and pass 2 shipped nothing because the sparse index had not served
;; them yet. That tripped
;;
;;     "no progress this pass; aborting (likely circular dep or stuck registry
;;      index)"
;;
;; naming a cause that was provably false — a cycle cannot ship 6 members one
;; pass earlier — and threw away the 30s/60s/120s backoff written directly
;; above for exactly this situation. 14 members stayed unpublished while the
;; index served the sibling seconds later.
;;
;; The rule: a zero-progress pass that FOLLOWS a productive one is propagation
;; lag; the run has already proven it can publish. Consume a pass with the
;; longer settle instead of aborting. A real cycle still aborts — it simply
;; costs two consecutive stalled passes to prove, since a cycle can never
;; produce the productive pass that buys the retry.
(define (drive-passes-from ops pending shipped renamed waited failed pass-n prev-shipped-n)
  (cond
    ((null? pending)
      (emit-outputs
        shipped
        renamed
        waited
        failed
        (and (null? waited) (null? failed)))
      (if (null? waited)
        (log-info (string-append "all " (string-format "{}" (length shipped)) " members shipped"))
        (log-info
          (string-append
            "shipped "
            (string-format "{}" (length shipped))
            "; "
            (string-format "{}" (length waited))
            " deferred to next capacity window")))
      (if (null? failed)
        0
        (begin (log-error (string-append "permanent failures: " (string-join "," failed))) 1)))
    ((>= pass-n max-passes)
      (emit-outputs
        shipped
        renamed
        (append pending waited)
        failed
        #f)
      (log-info
        (string-append
          "pass budget reached; "
          (string-format "{}" (+ (length pending) (length waited)))
          " members deferred to next tick"))
      (pass-exit-code failed))
    (else
      (log-info
        (string-append
          "==> pass "
          (string-format "{}" pass-n)
          " — "
          (string-format "{}" (length pending))
          " members to attempt"))
      (let*
        ((out (publish-pass-with ops pending (list) (list) (list) (list) (list)))
          (newly-shipped (car out))
          (newly-renamed (car (cdr out)))
          (deferred (car (cdr (cdr out))))
          (newly-waited (car (cdr (cdr (cdr out)))))
          (newly-failed (car (cdr (cdr (cdr (cdr out))))))
          (all-waited (append waited newly-waited))
          (all-failed (append failed newly-failed)))
        (cond
          ((and
             (null? newly-shipped)
             (null? newly-waited)
             (= (length deferred) (length pending)))
            ;; Zero progress. Whether that is fatal depends entirely on whether
            ;; the PREVIOUS pass shipped anything — see drive-passes-from.
            (if (> prev-shipped-n 0)
              (begin
                (log-info
                  (string-append
                    "no progress this pass, but the previous one shipped "
                    (string-format "{}" prev-shipped-n)
                    " member(s) — treating as sparse-index lag, not a cycle; "
                    "waiting "
                    (string-format "{}" (index-settle-secs pass-n))
                    "s before re-attempting: "
                    (string-join "," deferred)))
                ((ops-fn ops "settle") (index-settle-secs pass-n))
                (drive-passes-from
                  ops
                  deferred
                  shipped
                  renamed
                  all-waited
                  all-failed
                  (+ pass-n 1)
                  0))
              (begin
                (emit-outputs
                  shipped
                  renamed
                  (append deferred all-waited)
                  all-failed
                  #f)
                (log-error
                  (string-append
                    "no progress across two consecutive passes; aborting "
                    "(circular dep or stuck registry index). still blocked: "
                    (string-join "," deferred)))
                1)))
          ((null? newly-shipped)
            (emit-outputs
              shipped
              renamed
              (append deferred all-waited)
              all-failed
              #f)
            (log-info
              (string-append
                "capacity-blocked; "
                (string-format "{}" (+ (length deferred) (length all-waited)))
                " members deferred to next tick"))
            (pass-exit-code all-failed))
          (else
            ;; Something shipped and something is still blocked on a sibling:
            ;; give the sparse index a bounded moment before re-attempting,
            ;; rather than burning the pass budget in one second.
            (cond
              ((not (null? deferred))
                (log-info
                  (string-append
                    "waiting "
                    (string-format "{}" (index-settle-secs pass-n))
                    "s for the sparse index to serve "
                    (string-format "{}" (length newly-shipped))
                    " newly-published sibling(s)"))
                ((ops-fn ops "settle") (index-settle-secs pass-n)))
              (else #t))
            (drive-passes-from
              ops
              deferred
              (append shipped newly-shipped)
              (append renamed newly-renamed)
              all-waited
              all-failed
              (+ pass-n 1)
              (length newly-shipped))))))))

(define (run-main)
  (configure-git-bot)
  (let*
    ((members (workspace-members))
      (ordered (topo-order-with members (workspace-dep-graph) (workspace-exact-pinned)))
      (ops (append (real-ops members) (list (cons "settle" (lambda (secs) (sleep secs)))))))
    (log-info
      (string-append
        "workspace v"
        version
        " — "
        (string-format "{}" (length members))
        " members"))
    (log-info (string-append "publish order (leaves first): " (string-join " -> " ordered)))
    (drive-passes-with
      ops
      ordered
      (list)
      (list)
      (list)
      (list)
      1)))

(cond
  (tlisp-test-mode
    (log-info "TLISP_TEST=1 — publisher loaded; main skipped (the test harness drives it)"))
  (else (exit (run-main))))
