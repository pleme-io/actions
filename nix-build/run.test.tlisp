(define (never-run argv) (error "runner must not be called"))

(define (failing-run argv) (push-result 1 "error: cannot open /var/cache/sui\nhint: check perms\n"))

(define (ok-run argv) (push-result 0 ""))

(deftest "build argv is unchanged by the cache inputs"
  (assert
    (equal? (build-argv ".#default" "") (list "build" "--print-out-paths" "--no-link" ".#default"))
    "no system")
  (assert
    (equal?
      (build-argv ".#x" "x86_64-linux")
      (list "build" "--print-out-paths" "--no-link" "--system" "x86_64-linux" ".#x"))
    "with system"))

(deftest "push disabled never runs sui and reports disabled"
  (assert (not (cache-push-enabled? "false")) "false is off")
  (assert (not (cache-push-enabled? "")) "unset is off")
  (assert (not (cache-push-enabled? "yes")) "only the literal true is on")
  (assert (cache-push-enabled? "true") "true is on")
  (assert
    (equal? (cache-push-step #f #t (list "/nix/store/aaa-x") (list) never-run) (list "false" "disabled"))
    "disabled short-circuits before the runner"))

(deftest "push enabled builds the sui cache push argv"
  (assert
    (equal?
      (cache-push-argv
        (list "/nix/store/aaa-x" "/nix/store/bbb-y")
        "/var/cache/sui"
        "/tmp/k.key")
      (list
        "cache"
        "push"
        "--recursive"
        "--store-path"
        "/var/cache/sui"
        "--signing-key"
        "/tmp/k.key"
        "/nix/store/aaa-x"
        "/nix/store/bbb-y"))
    "full argv")
  (assert
    (equal? (cache-push-argv (list "/nix/store/aaa-x") "" "") (list "cache" "push" "--recursive" "/nix/store/aaa-x"))
    "empty optional inputs are omitted, not passed empty")
  (assert
    (equal? (out-paths "/nix/store/aaa-x\n/nix/store/bbb-y\n") (list "/nix/store/aaa-x" "/nix/store/bbb-y"))
    "every printed output path is pushed")
  (assert
    (equal? (cache-push-step #t #t (list "/nix/store/aaa-x") (list) ok-run) (list "true" ""))
    "success reports pushed"))

(deftest "a push failure is a warning verdict, never a step failure"
  (define v (cache-push-step #t #t (list "/nix/store/aaa-x") (list) failing-run))
  (assert (equal? (car v) "false") "cache-pushed=false")
  (assert
    (equal? (car (cdr v)) "sui cache push exited 1: error: cannot open /var/cache/sui hint: check perms")
    "reason carries the exit status and stderr separately, on one output line")
  (assert
    (equal? (cache-push-step #t #f (list "/nix/store/aaa-x") (list) never-run) (list "false" "sui not on PATH"))
    "a missing sui binary is a verdict, not a crash")
  (assert
    (equal? (cache-push-step #t #t (list) (list) never-run) (list "false" "no output paths"))
    "nothing built means nothing pushed"))

(deftest "eval-first evaluates the drvPath and builds the derivation's outputs"
  (assert (not (eval-first-enabled? "")) "unset is off")
  (assert (eval-first-enabled? "true") "true is on")
  (assert
    (equal? (eval-argv ".#nixosConfigurations.plo.config.system.build.toplevel" "")
      (list "eval" "--raw" ".#nixosConfigurations.plo.config.system.build.toplevel.drvPath"))
    "eval argv")
  (assert (equal? (drv-installable "/nix/store/aaa-x.drv\n") "/nix/store/aaa-x.drv^*") "drv installable"))

(deftest "eval-stack-kib runs the evaluation under that soft stack limit, and only when set"
  (assert
    (equal? (eval-command (list "eval" "--raw" ".#x.drvPath") "") (list "nix" "eval" "--raw" ".#x.drvPath"))
    "unset leaves the evaluation command unchanged")
  (assert
    (equal? (eval-command (list "eval" "--raw" ".#x.drvPath") " 8192 ")
      (list "bash" "-c" "ulimit -S -s \"$0\" && exec \"$@\"" "8192" "nix" "eval" "--raw" ".#x.drvPath"))
    "set lowers only the soft limit, the hard limit stays what the host gives"))

(deftest "eval-only evaluates without eval-first and never builds"
  (assert (not (eval-wanted? "false" "false")) "neither is set")
  (assert (eval-wanted? "true" "false") "eval-first alone")
  (assert (eval-wanted? "false" "true") "eval-only alone still evaluates")
  (assert (not (eval-only-enabled? "")) "unset is off")
  (assert (eval-only-enabled? "true") "true is on"))

(deftest "max-silent-time is passed to nix build only when set"
  (assert (equal? (build-argv-with ".#x" "" "") (build-argv ".#x" "")) "unset leaves argv unchanged")
  (assert
    (equal? (build-argv-with ".#x" "" "10800")
      (list "build" "--max-silent-time" "10800" "--print-out-paths" "--no-link" ".#x"))
    "set adds the flag"))

(define sample-plan
  (string-append
    "these 3 derivations will be built:\n"
    "  /nix/store/1ab0j1ndzv9w3yhvc1nin6cr1avi5frw-rust_serde-1.0.0.drv\n"
    "  /nix/store/2ab0j1ndzv9w3yhvc1nin6cr1avi5frw-rust_tokio-1.4.0.drv\n"
    "  /nix/store/3ab0j1ndzv9w3yhvc1nin6cr1avi5frw-pangea-operator.tar.gz.drv\n"
    "these 2 paths will be fetched (1.00 MiB download, 4.00 MiB unpacked):\n"
    "  /nix/store/4ab0j1ndzv9w3yhvc1nin6cr1avi5frw-glibc-2.40\n"
    "  /nix/store/5ab0j1ndzv9w3yhvc1nin6cr1avi5frw-bash-5.3\n"))

(deftest "the dry-run plan counts what will be built and what will be substituted"
  (define plan (plan-parse sample-plan))
  (assert (= (length (car plan)) 3) "three derivations to build")
  (assert (= (car (cdr plan)) 2) "two paths to fetch")
  (assert
    (equal? (car (car plan)) "/nix/store/1ab0j1ndzv9w3yhvc1nin6cr1avi5frw-rust_serde-1.0.0.drv")
    "drv paths keep their order")
  (assert (equal? (plan-name (car (car plan))) "rust_serde-1.0.0") "name drops the store hash")
  (assert
    (equal? (plan-parse "this derivation will be built:\n  /nix/store/aaa-x.drv\n") (list (list "/nix/store/aaa-x.drv") 0))
    "the singular header is a header too")
  (assert (equal? (plan-parse "") (list (list) 0)) "nothing to do is an empty plan, not a failure"))

(deftest "plan is on unless the literal false"
  (assert (plan-enabled? "true") "true")
  (assert (plan-enabled? "") "unset")
  (assert (not (plan-enabled? "false")) "false")
  (assert
    (equal? (plan-argv ".#x" "") (list "build" "--dry-run" "--no-link" ".#x"))
    "the plan asks the same installable"))

(deftest "auto push is a quiet no-op without the runner's fleet cache"
  (assert (cache-push-auto? "auto") "auto")
  (assert (not (cache-push-auto? "true")) "true keeps the local-store push")
  (assert
    (equal? (fleet-push-step (list "/nix/store/aaa-x") "" "" #t never-run) (list "false" "no fleet cache on this runner"))
    "a hosted runner has no SUI_CACHE_URL, so nothing runs")
  (assert
    (equal? (fleet-push-step (list) "http://rio:5000" "/k" #t never-run) (list "false" "nothing built"))
    "a fully substituted build pushes nothing")
  (assert
    (equal?
      (fleet-push-argv (list "/nix/store/aaa-x") "http://rio:5000" "/run/secrets/k")
      (list "cache" "push" "--cache-url" "http://rio:5000" "--signing-key" "/run/secrets/k" "/nix/store/aaa-x"))
    "the push names the origin and the key file, never the key")
  (assert
    (equal? (fleet-push-step (list "/nix/store/aaa-x") "http://rio:5000" "/k" #t ok-run) (list "true" ""))
    "a fleet runner pushes what it built"))
