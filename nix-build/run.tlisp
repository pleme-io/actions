;; nix-build/run.tlisp — auto-migrated from shell to tlisp+stdlib

(define (build-argv ref sys)
  (let ((base (list "build" "--print-out-paths" "--no-link")))
    (append (if (equal? sys "") base (append base (list "--system" sys))) (list ref))))

(define (silence-flag raw)
  (let ((v (string-trim raw)))
    (if (equal? v "") (list) (list "--max-silent-time" v))))

(define (build-argv-with ref sys silence)
  (let ((argv (build-argv ref sys)))
    (append (list (car argv)) (silence-flag silence) (cdr argv))))

(define (eval-first-enabled? raw) (equal? (string-trim raw) "true"))

(define (eval-argv ref sys)
  (let ((base (list "eval" "--raw")))
    (append (if (equal? sys "") base (append base (list "--system" sys))) (list (string-append ref ".drvPath")))))

(define (drv-installable drv) (string-append (string-trim drv) "^*"))

(define (eval-only-enabled? raw) (equal? (string-trim raw) "true"))

(define (eval-command argv stack-kib)
  (let ((kib (string-trim stack-kib)))
    (if (equal? kib "")
      (cons "nix" argv)
      (append (list "bash" "-c" "ulimit -S -s \"$0\" && exec \"$@\"" kib "nix") argv))))

(define (eval-wanted? first only) (or (eval-first-enabled? first) (eval-only-enabled? only)))

(define (resolve-installable ref sys)
  (cond
    ((not (eval-wanted? (env-get "EVAL_FIRST" "false") (env-get "EVAL_ONLY" "false"))) (list 0 ref ""))
    (else
      (let ((cmd (eval-command (eval-argv ref sys) (env-get "EVAL_STACK_KIB" ""))))
        (log-info (string-append "==> " (string-join " " cmd)))
        (let ((r (apply exec-capture cmd)))
          (if (= (status-of r) 0)
            (list 0 (drv-installable (stdout-of r)) "")
            (list 1 "" (stderr-of r))))))))

(define (out-paths stdout)
  (filter (lambda (p) (not (equal? p ""))) (map string-trim (string-split (string-trim stdout) "\n"))))

(define (cache-push-enabled? raw) (equal? (string-trim raw) "true"))

(define (cache-push-argv paths store-path key-file)
  (append
    (list "cache" "push" "--recursive")
    (sui-cache:opt-flag "--store-path" store-path)
    (sui-cache:opt-flag "--signing-key" key-file)
    paths))

(define (push-result status stderr) (sui-cache:result status stderr))

(define (push-verdict r) (sui-cache:verdict r))

(define (cache-push-step enabled? sui-present? paths argv runner)
  (cond
    ((not enabled?) (list "false" "disabled"))
    ((null? paths) (list "false" "no output paths"))
    ((not sui-present?) (list "false" "sui not on PATH"))
    (else (push-verdict (runner argv)))))

(define (emit-push verdict)
  (append-output (string-append "cache-pushed=" (car verdict)))
  (append-output (string-append "cache-push-reason=" (car (cdr verdict))))
  (cond
    ((equal? (car verdict) "true") (log-info "sui cache push: pushed"))
    ((equal? (car (cdr verdict)) "disabled") #f)
    (else (log-info (string-append "::warning::sui cache push failed: " (car (cdr verdict)))))))

(define (push-built paths)
  (let* ((enabled? (cache-push-enabled? (env-get "CACHE_PUSH" "false")))
         (key-file
           (if enabled? (sui-cache:materialize-key (env-get "CACHE_SIGNING_KEY" "") "nix-build-sui-signing") ""))
         (argv
           (cache-push-argv
             paths
             (env-get "CACHE_STORE_PATH" "")
             key-file))
         (verdict (cache-push-step enabled? (sui-cache:on-path? "sui") paths argv sui-cache:run)))
    (if (not (equal? key-file "")) (exec-capture "rm" "-f" key-file) #f)
    (emit-push verdict)))

(define (fail-build stderr)
  (log-error "nix build failed")
  (log-info stderr)
  (append-output "out-path=")
  (append-output "cache-pushed=false")
  (append-output "cache-push-reason=build failed")
  1)

(define (main)
  (let* ((sys (env-get "SYSTEM" ""))
         (resolved (resolve-installable (env-get "FLAKE_REF" ".#default") sys)))
    (cond
      ((not (= (car resolved) 0)) (fail-build (car (cdr (cdr resolved)))))
      ((eval-only-enabled? (env-get "EVAL_ONLY" "false"))
        (log-info (string-append "evaluated: " (car (cdr resolved))))
        (append-output (string-append "drv=" (car (cdr resolved))))
        (append-output "out-path=")
        (append-output "cache-pushed=false")
        (append-output "cache-push-reason=disabled")
        0)
      (else
        (let* ((args (build-argv-with (car (cdr resolved)) sys (env-get "MAX_SILENT_TIME" "")))
               (_ (log-info (string-append "==> nix " (string-join " " args))))
               (r (apply exec-capture (cons "nix" args))))
          (cond
            ((= (status-of r) 0)
              (let ((path (string-trim (stdout-of r))))
                (log-info (string-append "built: " path))
                (append-output (string-append "out-path=" path))
                (push-built (out-paths path))
                0))
            (else (fail-build (stderr-of r)))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1") (log-info "TLISP_TEST=1 — nix-build helpers loaded; main skipped"))
  (else (exit (main))))
