;; bigorna/run.tlisp — the CI ENTRY verb for pleme-io's typed
;; buildx-native-multi-arch primitive (sui-bigorna, the anvil).
;;
;; ONE step gives a consumer a `docker buildx` builder whose nodes are
;; REAL, native per-architecture build nodes (no QEMU) PLUS a cache front
;; that points at the shipped sui tiered content-addressed store — so an
;; UNCHANGED `docker buildx build --platform linux/amd64,linux/arm64`
;; afterwards dispatches each platform to native metal and answers seen
;; layers warm. Native-multi-arch AND cache land through ONE integration
;; point: this action.
;;
;; It owns NO build algebra. It is a thin keyway front over the shipped
;; `bigorna setup` binary (sui-bigorna): it RENDERS a typed BigornaConfig
;; (YAML) from the action inputs, hands it to `bigorna setup --config`,
;; and forwards the binary's typed JSON receipt to GITHUB_OUTPUT. The
;; emulated-node refusal, the native-vs-QEMU guarantee, and the cache
;; endpoint bridge all live IN the binary (proven by its 31 unit tests) —
;; this verb never re-implements them.
;;
;; ── the native model (tier-honest) ──────────────────────────────────
;; A bigorna node is native by construction: it can only be registered
;; when its host arch equals its target arch (an emulated node has no
;; constructor — sui-bigorna/src/node.rs). So on ONE runner:
;;   * the runner's OWN arch is the create-time native node (no endpoint);
;;   * a FOREIGN target arch is a native node ONLY if the consumer supplies
;;     a native endpoint for it (a docker context / tcp:// remote reached
;;     via ARCH_ENDPOINTS, e.g. the camelot runs-on:[camelot,<arch>] fan);
;;   * a foreign arch with NO endpoint would be EMULATED — which bigorna
;;     refuses. FALLTHROUGH decides what happens then:
;;       error         → the honest hard fail (default; exit 1)
;;       native-subset → set up the native-covered platforms, warn about
;;                       the rest, exit 0 (a loud, honest partial)
;; Single-runner native-multi-arch therefore covers the runner's own arch
;; for free; true cross-arch native needs an endpoint per foreign arch.
;; This is stated, not hidden.
;;
;; Uses _tlisp-stdlib helpers (prepended by action.yml's loader step):
;;   emit-output, log-info, log-error, path-exists?, write-file,
;;   read-file, exec-capture / exec-ok?, status-of, stdout-of,
;;   string-format, string-split, string-trim, re-match?.
;;
;; Inputs (env):
;;   PLATFORMS       comma/space OCI platform list (default "linux/amd64")
;;   CACHE           registry cache ref fronting the sui store, e.g.
;;                   ghcr.io/pleme-io/<svc>:buildcache. "" = no cache front.
;;   CACHE_MODE      "max" (default) | "min"
;;   ARCH_ENDPOINTS  space/comma list of arch=endpoint for FOREIGN native
;;                   nodes (e.g. "arm64=arm64-ctx"). "" = own-arch only.
;;   FALLTHROUGH     "error" (default) | "native-subset"
;;   BUILDER_NAME    buildx builder name (default "bigorna")
;;   DRIVER          "docker-container" (default) | "kubernetes" | "remote"
;;   BIGORNA_VERSION sui ref for `nix run github:pleme-io/sui/<ref>#bigorna`
;;                   (default "main"). Ignored when a `bigorna` is on PATH.
;;
;; Outputs (emit-output → GITHUB_OUTPUT; one `emit-receipt` renders all
;; seven on every exit path, so they can never disagree):
;;   builder            the buildx builder name that was set up
;;   native-platforms   comma-joined platforms with a native node (the
;;                      builder's covered set)
;;   emulation          "native-for-all" | "needs-native-node"
;;   cache-from         a `--cache-from` token the consumer's build reuses
;;                      ("" when no cache front)
;;   cache-to           a `--cache-to` token ("" when no cache front)
;;   ok                 "true" iff every requested platform got a native node
;;                      AND every create step succeeded
;;   result             generic catch-all == builder name (or "" on failure)
;;
;; Exit (keyway): 0 setup succeeded (or a native-subset partial); non-zero
;; when a requested platform is emulated and FALLTHROUGH does not permit a
;; partial, when a buildx create step failed (the binary's own status is
;; forwarded — 1 create failure, 2 config error), when the binary could not
;; be resolved, or when an input fails the shape gate. NEVER a faked green
;; — an emulated request without permission, or a failed create, is loud.

;; ── pure helpers (unit-tested via run.test.tlisp; no side effects) ───

;; Split a comma/space list into clean, non-empty tokens.
(define (tokens raw) (nonempty-tokens (flatten-split (string-split raw ",") " ")))

;; Split each element of `parts` on `sep` and concatenate — a two-level
;; split so "a, b  c" yields ("a" "b" "c").
(define (flatten-split parts sep)
  (cond
    ((null? parts) (list))
    (else (append (string-split (car parts) sep) (flatten-split (cdr parts) sep)))))

(define (nonempty-tokens toks)
  (cond
    ((null? toks) (list))
    ((equal? (string-trim (car toks)) "") (nonempty-tokens (cdr toks)))
    (else (cons (string-trim (car toks)) (nonempty-tokens (cdr toks))))))

;; The OCI arch half of a platform token ("linux/arm64/v8" -> "arm64").
;; A bare "arm64" maps to itself so ARCH_ENDPOINTS keys and PLATFORMS
;; entries meet on the same arch token.
(define (platform-arch p)
  (let ((parts (string-split (string-trim p) "/")))
    (cond
      ((null? parts) "")
      ((null? (cdr parts)) (string-trim (car parts)))
      ; bare arch
      (else (string-trim (car (cdr parts)))))))

; os/ARCH[/variant]

;; The canonical host-arch token bigorna's Arch::host() derives from
;; std::env::consts::ARCH. `uname -m` gives x86_64 / aarch64; normalize to
;; the OCI token so host_arch == platform.arch can hold.
(define (normalize-arch a)
  (let ((t (string-trim a)))
    (cond
      ((equal? t "x86_64") "amd64")
      ((equal? t "amd64") "amd64")
      ((equal? t "aarch64") "arm64")
      ((equal? t "arm64") "arm64")
      (else t))))

;; Parse ARCH_ENDPOINTS ("arm64=arm64-ctx s390x=tcp://…") into an alist of
;; (arch endpoint) 2-element lists — tatara-lisp's `cons` is not a dotted
;; pair (`(cdr (cons k v))` is a LIST, not v), so each entry is a proper
;; 2-list read with (car (cdr entry)). A token with no "=" is skipped.
(define (parse-arch-endpoints raw) (ae-fold (tokens raw) (list)))

(define (ae-fold toks acc)
  (cond
    ((null? toks) acc)
    (else
      (let ((kv (string-split (car toks) "=")))
        (cond
          ((null? (cdr kv)) (ae-fold (cdr toks) acc))
          ; no "=" → skip
          (else
            (ae-fold
              (cdr toks)
              (cons
                (list (normalize-arch (string-trim (car kv))) (string-trim (car (cdr kv))))
                acc))))))))

(define (alist-lookup key alist)
  (cond
    ((null? alist) "")
    ((equal? (car (car alist)) key) (car (cdr (car alist))))
    (else (alist-lookup key (cdr alist)))))

;; A platform gets a NATIVE node iff it targets the runner's own arch
;; (the create node) OR the consumer supplied a native endpoint for its
;; arch. Anything else would be emulated.
(define (platform-native? p host-arch endpoints)
  (let ((a (normalize-arch (platform-arch p))))
    (or (equal? a host-arch) (not (equal? (alist-lookup a endpoints) "")))))

;; Partition the requested platforms into (native . emulated) by policy.
(define (native-platforms plats host-arch endpoints)
  (filter-platforms
    plats
    host-arch
    endpoints
    #t))

(define (emulated-platforms plats host-arch endpoints)
  (filter-platforms
    plats
    host-arch
    endpoints
    #f))

(define (filter-platforms plats host-arch endpoints want-native)
  (cond
    ((null? plats) (list))
    (else
      (let ((keep (equal? (platform-native? (car plats) host-arch endpoints) want-native)))
        (cond
          (keep (cons (car plats) (filter-platforms (cdr plats) host-arch endpoints want-native)))
          (else (filter-platforms (cdr plats) host-arch endpoints want-native)))))))

;; Comma-join a token list for the receipt output (a plain view — the
;; typed builder emits the real --platform flag).
(define (join-comma toks)
  (cond
    ((null? toks) "")
    ((null? (cdr toks)) (car toks))
    (else (string-append (car toks) "," (join-comma (cdr toks))))))

;; The registry cache endpoint token for a ref + mode (mirrors
;; sui-bigorna CacheEndpoint::Registry Display: type=registry,ref=…,mode=…).
;; Registry is symmetric — the same token is a valid --cache-from and
;; --cache-to; only mode changes the export usefulness.
(define (cache-token ref mode)
  (cond
    ((equal? (string-trim ref) "") "")
    (else
      (string-append
        "type=registry,ref="
        (string-trim ref)
        ",mode="
        (normalize-cache-mode mode)))))

(define (normalize-cache-mode m)
  (let ((t (string-trim m))) (cond ((equal? t "min") "min") (else "max"))))

;; ── ★ input shape gate — the boundary that closes TWO live injections ─
;;
;; MEASURED 2026-08-08 against this file, both reproduced before the fix.
;; Every value below is interpolated into wire formats by plain string
;; concatenation, and NEITHER concatenation escapes anything, so a newline
;; is not a formatting slip — it rewrites the document:
;;
;;   (1) the rendered BigornaConfig YAML.
;;       DRIVER=$'docker-container\nuse_as_default: false\nbootstrap: false'
;;       put `use_as_default: false` into the config as a real top-level
;;       key — the CALLER deciding a field this action exists to fix.
;;       (The section header below used to claim this was "NOT freeform
;;       string composition of a foreign syntax". The field NAMES are
;;       fixed; the VALUES were not, and that is the half that bites.)
;;
;;   (2) $GITHUB_OUTPUT, which is newline-separated `key=value`.
;;       BUILDER_NAME=$'bigorna\nok=true\nnative-platforms=linux/amd64,linux/arm64'
;;       parsed as ok=true / native-platforms=linux/amd64,linux/arm64 on a
;;       run whose REAL verdict was ok=false / native-platforms=linux/arm64.
;;       `result=` is emitted LAST and carries the same payload, so the
;;       forgery wins under last-assignment-wins. That is a faked green on
;;       the one guarantee this action exists to make — native, not QEMU —
;;       and the consumer's next step would hand amd64 to a node that
;;       cannot build it natively.
;;
;;   (3) the consumer's own shell. README's usage example interpolates
;;       `${{ steps.bigorna.outputs.cache-from }}` UNQUOTED into a `run:`
;;       block, so the CACHE ref reaches a command line.
;;
;; So every value is checked against a shape that cannot carry a newline
;; (or a YAML/shell metacharacter) BEFORE it reaches any renderer, and a
;; violation is a loud refusal — never a sanitized-and-continued value,
;; which would hide the caller's mistake instead of naming it. stdlib's
;; `emit-output` is the second, independent guard at the write itself.

(define bigorna:name-shape "^[A-Za-z0-9][A-Za-z0-9._-]*$")

; builder / arch token

(define bigorna:platform-shape "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,2}$")

; os/arch[/variant]

(define bigorna:endpoint-shape "^[A-Za-z0-9][A-Za-z0-9._:/-]*$")

; ctx name | tcp:// | ssh://

(define bigorna:ref-shape "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$")

; an OCI registry ref

(define (require-shape label value pattern hint)
  (cond
    ((re-match? pattern value) value)
    (else
      (log-error
        (string-append
          "bigorna: refusing "
          label
          " `"
          value
          "` — "
          hint
          " The value is interpolated by concatenation into a wire format "
          "— the rendered BigornaConfig YAML, $GITHUB_OUTPUT, or the cache "
          "token a consumer pastes into their own build — where a newline "
          "or a metacharacter forges document structure rather than "
          "malforming a line, so an out-of-shape value is refused here "
          "instead of sanitized."))
      (exit 1))))

;; DRIVER is an ENUM in this action's own published contract
;; (docker-container | kubernetes | remote), so the honest check is
;; membership, not a charset. It closes the YAML injection AND catches a
;; typo that would otherwise be handed to the binary as a driver it has
;; never heard of.
(define (require-driver d)
  (cond
    ((equal? d "docker-container") d)
    ((equal? d "kubernetes") d)
    ((equal? d "remote") d)
    (else
      (log-error
        (string-append
          "bigorna: refusing driver `"
          d
          "` — the documented values are docker-container | kubernetes | remote."))
      (exit 1))))

(define (require-platforms plats)
  (cond
    ((null? plats) #t)
    (else
      (require-shape
        "platform"
        (car plats)
        bigorna:platform-shape
        "an OCI platform is 1-3 `/`-separated alphanumeric segments (linux/amd64, linux/arm64/v8).")
      (require-platforms (cdr plats)))))

;; Both halves of every ARCH_ENDPOINTS entry reach the config: the arch
;; key lands in `host_arch:` and in the node name, the endpoint in
;; `endpoint:`.
(define (require-endpoints eps)
  (cond
    ((null? eps) #t)
    (else
      (require-shape
        "arch-endpoint arch"
        (car (car eps))
        bigorna:name-shape
        "an arch token is alphanumeric (arm64, amd64, s390x).")
      (require-shape
        "arch-endpoint endpoint"
        (car (cdr (car eps)))
        bigorna:endpoint-shape
        "an endpoint is a docker context name or a tcp:// / ssh:// / unix:// remote.")
      (require-endpoints (cdr eps)))))

;; ── config rendering — one BigornaConfig node block per native platform.
;; Emitted as YAML the shipped `bigorna setup --config` deserializes into
;; BigornaConfig (serde). Every field NAME is fixed by the Rust struct's
;; serde contract (builder_name / driver / nodes[].{name,platform,
;; host_arch,endpoint}); every field VALUE has passed the shape gate
;; above, which is what makes this a mechanical projection of typed inputs
;; rather than freeform composition of a foreign syntax.

;; The node name for a platform ("bigorna-arm64").
(define (node-name builder p) (string-append builder "-" (normalize-arch (platform-arch p))))

;; Render one node's YAML block. The runner's own-arch node is the
;; create node (no endpoint); a foreign native node carries its endpoint.
(define (render-node builder p host-arch endpoints)
  (let*
    ((arch (normalize-arch (platform-arch p)))
      (ep (cond ((equal? arch host-arch) "") (else (alist-lookup arch endpoints)))))
    (string-append
      "  - name: "
      (node-name builder p)
      "\n"
      "    platform: "
      (string-trim p)
      "\n"
      "    host_arch: "
      arch
      "\n"
      (cond ((equal? ep "") "") (else (string-append "    endpoint: " ep "\n"))))))

(define (render-nodes builder plats host-arch endpoints)
  (cond
    ((null? plats) "")
    (else
      (string-append
        (render-node
          builder
          (car plats)
          host-arch
          endpoints)
        (render-nodes
          builder
          (cdr plats)
          host-arch
          endpoints)))))

;; The full BigornaConfig document. bootstrap + use_as_default default to
;; true in the Rust struct (serde default) so the builder is usable and
;; picked up by an unchanged `docker buildx build` the moment setup returns.
(define (render-config builder driver plats host-arch endpoints)
  (string-append
    "builder_name: "
    builder
    "\n"
    "driver: "
    driver
    "\n"
    "bootstrap: true\n"
    "use_as_default: true\n"
    "nodes:\n"
    (render-nodes
      builder
      plats
      host-arch
      endpoints)))

;; ── the receipt — ONE renderer for all four exit paths ───────────────
;;
;; Before this, each of the four paths hand-listed the same seven keys as
;; `append-output (string-append "k=" v)`. Two problems, one fix: four
;; hand-lists are four places to forget a key or let them disagree, and
;; `append-output` structurally CANNOT see the injection above — by the
;; time it is called, `string-append` has fused key and value into one
;; string and the boundary is gone. `emit-output` keeps them separate and
;; refuses a newline in the value, so the forged-green reproduction is a
;; loud failure at the write even if a future edit slips a value past the
;; shape gate.
(define (emit-receipt builder natives emulation cache-from cache-to ok result)
  (emit-output "builder" builder)
  (emit-output "native-platforms" natives)
  (emit-output "emulation" emulation)
  (emit-output "cache-from" cache-from)
  (emit-output "cache-to" cache-to)
  (emit-output "ok" ok)
  (emit-output "result" result))

;; The coverage verdict, which is a statement about the REQUEST (the
;; documented contract: "native-for-all (every requested platform is
;; native) | needs-native-node") and NOT about whether the create step
;; then worked. The failure path used to report `needs-native-node`
;; unconditionally, so a fully-native request whose buildx create failed
;; sent the reader hunting for an endpoint that was never the problem.
;; `ok=false` plus a non-zero exit already carry the failure.
(define (coverage-verdict emulated)
  (cond ((null? emulated) "native-for-all") (else "needs-native-node")))

;; ── ★ FALLTHROUGH is fail-CLOSED ─────────────────────────────────────
;;
;; The test used to be `(equal? fallthrough "error")`, so ONLY the exact
;; string "error" hard-failed and EVERY other value — including a typo —
;; silently granted native-subset permission. Reproduced 2026-08-08:
;; FALLTHROUGH=Error on a request with an emulated platform exited 0 with
;; a partial builder, where the contract says exit 1. A typo in the knob
;; whose whole job is to fail closed must not fail open, so the predicate
;; now reads the other way round: `native-subset` is the ONLY value that
;; permits a partial, and anything unrecognized lands on the safe side.
(define (permits-partial? fallthrough) (equal? (string-trim fallthrough) "native-subset"))

(define (known-fallthrough? fallthrough)
  (let ((t (string-trim fallthrough)))
    (or (equal? t "error") (equal? t "native-subset"))))

;; ── side-effecting main (gated off under TLISP_TEST) ─────────────────

;; Resolve a runnable `bigorna` argv. Prefer a bigorna already on PATH
;; (baked into a pleme-io nix runner image — the native fast path, same
;; short-circuit tatara-script uses), else `nix run github:pleme-io/sui`.
(define (bigorna-argv version)
  (cond
    ((exec-ok? "sh" "-c" "command -v bigorna") (list "bigorna"))
    (else
      (list
        "nix"
        "run"
        (string-append
          "github:pleme-io/sui/"
          (string-trim version)
          "#bigorna")
        "--"))))

(define (run-setup argv config-path)
  ;; argv already ends at the subcommand boundary ("--" for nix run, or
  ;; nothing for a PATH bigorna); append the keyway subcommand + config.
  (apply exec-capture (append argv (list "setup" "--config" config-path))))

(define (main)
  (let*
    ((plats-raw (env-get "PLATFORMS" "linux/amd64"))
      (cache-ref (env-get "CACHE" ""))
      (cache-mode (env-get "CACHE_MODE" "max"))
      (ae-raw (env-get "ARCH_ENDPOINTS" ""))
      (fallthrough (env-get "FALLTHROUGH" "error"))
      ;; Each of the four values below reaches a renderer that does not
      ;; escape: `builder` and `driver` the config YAML, `cache-ref` the
      ;; cache token a consumer pastes UNQUOTED into their own `run:`.
      ;; The shape gate is applied at the binding, so nothing downstream
      ;; ever holds an unchecked value.
      (builder
        (let ((b (string-trim (env-get "BUILDER_NAME" "bigorna"))))
          (cond
            ((equal? b "") "bigorna")
            (else (require-shape "builder-name" b bigorna:name-shape "a builder name is alphanumeric with . _ -.")))))
      (driver
        (let ((d (string-trim (env-get "DRIVER" "docker-container"))))
          (cond ((equal? d "") "docker-container") (else (require-driver d)))))
      (cache-checked
        (cond
          ((equal? (string-trim cache-ref) "") "")
          (else
            (require-shape
              "cache"
              (string-trim cache-ref)
              bigorna:ref-shape
              "a cache ref is an OCI registry reference (ghcr.io/org/name:tag)."))))
      (version (env-get "BIGORNA_VERSION" "main"))
      (host-arch (normalize-arch (host-uname-arch)))
      (endpoints (parse-arch-endpoints ae-raw))
      (requested (tokens plats-raw))
      (native (native-platforms requested host-arch endpoints))
      (emulated (emulated-platforms requested host-arch endpoints)))

    ;; The list-valued halves of the gate. Both refuse loudly; neither
    ;; returns a value anything downstream reads, so they are statements.
    (require-platforms requested)
    (require-endpoints endpoints)

    (log-info (string-append "bigorna: host arch " host-arch ", requested " (join-comma requested)))
    (cond
      ((not (null? endpoints))
        (log-info
          (string-append
            "bigorna: foreign native endpoints supplied for "
            (join-comma (map (lambda (kv) (car kv)) endpoints)))))
      (else #t))

    ;; An unrecognized FALLTHROUGH is named rather than silently absorbed;
    ;; `permits-partial?` has already routed it to the safe side.
    (cond
      ((not (known-fallthrough? fallthrough))
        (log-info
          (string-append
            "::warning::bigorna: FALLTHROUGH=`"
            (string-trim fallthrough)
            "` is not one of error | native-subset — treating it as `error` "
            "(fail closed). A typo in this knob must not silently grant "
            "native-subset permission.")))
      (else #t))

    ;; An emulated request under FALLTHROUGH=error is the honest hard fail
    ;; BEFORE touching docker — never a faked green, never a QEMU node.
    (cond
      ((and (not (null? emulated)) (not (permits-partial? fallthrough)))
        (log-error
          (string-append
            "bigorna: no native node for "
            (join-comma emulated)
            " and FALLTHROUGH=error — supply ARCH_ENDPOINTS="
            "<arch>=<endpoint> for each (a native docker context / "
            "tcp:// remote), or set FALLTHROUGH=native-subset to set "
            "up only the native-covered platforms."))
        (emit-receipt
          builder
          ""
          "needs-native-node"
          ""
          ""
          "false"
          "")
        1)

      ((null? native)
        ;; native-subset but nothing is native — an empty builder is useless.
        (log-error "bigorna: no requested platform maps to a native node.")
        (emit-receipt
          builder
          ""
          "needs-native-node"
          ""
          ""
          "false"
          "")
        1)

      (else
        (cond
          ((not (null? emulated))
            (log-info
              (string-append
                "::warning::bigorna FALLTHROUGH=native-subset — "
                (join-comma emulated)
                " has no native node and is EXCLUDED. The builder "
                "covers "
                (join-comma native)
                " natively.")))
          (else #t))

        ;; Render the typed BigornaConfig for the native set + hand it to
        ;; the shipped binary. RUNNER_TEMP is the GHA scratch dir; fall back
        ;; to the cwd so a local run works too.
        (let*
          ((tmp (env-get "RUNNER_TEMP" "."))
            (cfg (string-append tmp "/bigorna.config.yaml"))
            (doc (render-config builder driver native host-arch endpoints)))
          (write-file cfg doc)
          (log-info
            (string-append
              "bigorna: rendered "
              cfg
              " ("
              (string-format "{}" (length native))
              " native node(s)); running setup"))
          (let*
            ((argv (bigorna-argv version))
              (r (run-setup argv cfg))
              (st (status-of r))
              (out (stdout-of r))
              ;; The binary emits a SetupReceipt JSON with `ok:true` iff
              ;; every create step succeeded. Trust the exit code (0 = ok,
              ;; 1 = a create step failed, 2 = config error) as the typed
              ;; contract; surface the receipt tail for the log.
              ;; `cache-checked` — never the raw CACHE — is what reaches
              ;; the token a consumer pastes into their own build.
              (from-t (cache-token cache-checked cache-mode))
              (to-t (cache-token cache-checked cache-mode)))
            (log-info out)
            (cond
              ((= st 0)
                (emit-receipt
                  builder
                  (join-comma native)
                  (coverage-verdict emulated)
                  from-t
                  to-t
                  ;; ok=true only when the full requested set is native.
                  (cond ((null? emulated) "true") (else "false"))
                  builder)
                (log-info
                  (string-append
                    "bigorna: builder `"
                    builder
                    "` ready — native for "
                    (join-comma native)
                    (cond ((equal? from-t "") "") (else (string-append "; cache front " from-t)))))
                0)
              (else
                (log-error
                  (string-append "bigorna: `bigorna setup` exited " (string-format "{}" st)))
                ;; `native-platforms` is emptied because setup failed and
                ;; there is no builder to cover anything — but `emulation`
                ;; keeps telling the truth about the REQUEST rather than
                ;; blaming a missing endpoint for a create failure.
                (emit-receipt
                  builder
                  ""
                  (coverage-verdict emulated)
                  ""
                  ""
                  "false"
                  "")
                st))))))))

;; ── host-arch probe (isolated so main's helpers stay pure) ───────────
(define (host-uname-arch)
  (let ((r (exec-capture "uname" "-m")))
    (cond ((= (status-of r) 0) (string-trim (stdout-of r))) (else "x86_64"))))

; sane default; normalize-arch maps it

;; ── entrypoint / test gate ───────────────────────────────────────────
(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — bigorna helpers loaded; main skipped"))
  (else (exit (main))))
