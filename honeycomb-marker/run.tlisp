;; honeycomb-marker/run.tlisp — create a Honeycomb marker.
;;
;; Was jq-through-sh then curl-through-sh, with three defects beyond the
;; shared ones:
;;
;;   * `date +%s` was shelled out. `now` is a primitive, and the shelled
;;     status was never read — a failure yielded ts="" and emitted
;;     `--argjson ts ` with no operand, surfacing only as the generic
;;     "payload assembly failed".
;;   * `url-frag` spliced the LITERAL TEXT ` url-in ` because the variable sat
;;     inside a string literal, so any non-empty URL_ARG broke the payload
;;     unconditionally. Repaired in place earlier today; now the value is
;;     simply a field, so the category is gone.
;;   * the API_KEY sat in argv inside `-H 'X-Honeycomb-Team: <key>'`.
;;
;; DATASET is interpolated into the URL PATH, which is correct — it addresses
;; the resource — but it is a path segment, so a value containing `/` would
;; retarget the request. Honeycomb dataset names do not contain slashes; if
;; that ever changes this needs encoding.

(define key (env-required "API_KEY"))

(define ds (env-required "DATASET"))

(define msg (env-required "MESSAGE"))

(define ty (env-get "TYPE_ARG" "release"))

(define url-in (env-get "URL_ARG" ""))

(define url (string-append "https://api.honeycomb.io/1/markers/" ds))

;; Seconds since the epoch, in-process. `now` is a primitive.
(define ts (now))

(define base
  (list
    (list "message" msg)
    (list "type" ty)
    (list "start_time" ts)))

;; The optional url is a FIELD now, not a spliced fragment of a jq filter.
(define payload
  (if (equal? url-in "") base (append base (list (list "url" url-in)))))

(define r (webhook:post url (list (list "X-Honeycomb-Team" key)) payload))

(cond
  ((erro:err? r)
    (log-error
      (string-append "honeycomb-marker: create failed — " (erro:message (erro:value r))))
    (emit-output "created" "false")
    (exit 1))
  (else
    (log-info "honeycomb-marker: created")
    (emit-output "created" "true")
    (exit 0)))
