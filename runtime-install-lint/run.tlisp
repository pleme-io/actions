;; runtime-install-lint/run.tlisp — flag runtime tool installation
;; (curl|tar, curl|sh, apt-get/apt/pip/npm/go/cargo install) in any
;; action.yml or run.tlisp in this repo, AND per-job Nix installation
;; (DeterminateSystems/nix-installer-action, `nix shell nixpkgs#…`) in any
;; .github/workflows/*.yml — a SEPARATE, narrow scan so the broad install
;; patterns are never applied to workflow YAML (legit CI curls would false-
;; positive). See NIX-HARDENING.md §VI.1: the CI build env belongs BAKED in the
;; runner image; the per-job installer is the debt this flags.
;;
;; The hard rule this enforces (theory/NIX-HARDENING.md, "no runtime tool
;; installation, anywhere"): every external binary a pleme-io/actions entry
;; needs is a Nix-hardened, distroless image via pleme-io/hardened-images,
;; consumed as a `docker://` container action or a pinned release asset --
;; never fetched/installed imperatively at job time. Two real, distinct
;; failure classes this closes (both hit live, secrets-scan, 2026-07-22):
;; a shell-escaping bug in an embedded multi-line install string, and a
;; stale version pin silently downloading a 404 page in place of a
;; tarball. Neither is possible if the binary ships pre-baked in an image.
;;
;; Same shape as action-shell-lint's own baseline discipline: existing
;; violations are named, tracked debt (reported every run, never silently
;; accepted) rather than an instant hard-fail across the whole catalog --
;; only a NEW, non-baselined violation fails the build. Graduating an
;; entry out of the baseline (converting the action to consume a hardened
;; image) is the intended, tracked path to zero.

;; ── THE DESHELLIFY BLIND SPOT, closed 2026-08-08 ──────────────────────────
;; This glob was `*/action.yml */run.tlisp`. Converting an action to tlisp
;; then MOVED ITS DEBT OUT OF THE SUBJECT SET: `image-scan`'s trivy fetch
;; went to `image-scan/install.tlisp`, which the old glob does not reach, and
;; the entry vanished from this report entirely — no new violation, but no
;; tracked one either. The debt went INVISIBLE, not away, and the baseline
;; line guarding it became a guard that can never fire again.
;;
;; That is a general property of the deshellify campaign, not a one-off: every
;; conversion that adds a NEW `.tlisp` beside `run.tlisp` silently shrinks what
;; this lint can see. `*/*.tlisp` covers the whole family.
;;
;; KNOWN REMAINING GAP, stated rather than implied: widening the glob does not
;; make the PATTERNS tlisp-shaped. They are written for shell, where a command
;; and its URL share a line; in tlisp the argv is split across expressions —
;; `(exec-capture "curl" "-sfL" "-o" staged url)` with `url` bound elsewhere —
;; so `curl[^\n]*install\.sh` still cannot match it. This change restores the
;; FILES to the subject set; matching a split argv needs argv-aware rules.
;; pending-runtime-install-lint: argv-shaped patterns for tlisp call sites
(define paths (env-get "PATHS" "*/action.yml */*.tlisp"))

(define fail-on (env-get "FAIL_ON_VIOLATION" "true"))

(define baseline-path (env-get "BASELINE_PATH" "runtime-install-lint/baseline.txt"))

(log-info (string-append "==> scanning " paths " for runtime tool installation"))

;; Skip pure-comment lines (YAML `#` / tlisp `;;` at line start, after
;; leading whitespace).
;;
;; ── AN UNPIPED DOWNLOAD COUNTS, and that is the 2026-08-01 correction ──────
;; Every clause required a PIPE (`curl … |`), so the dominant real shape --
;; `curl -sSL <url>/releases/latest/download/<tool> -o /tmp/x && chmod +x` --
;; matched NOTHING. This file's baseline said "Empty as of 2026-07-22, all 23
;; violations purged … the forcing function that keeps the count at zero"
;; while TWELVE actions installed tools at job time, unseen. A lint reporting 0
;; over a subject set it cannot match is the failure-indistinguishable-from-
;; success class one layer up: the number was true of what the regex saw and
;; false of the repo.
;;
;; What the added clauses target is a DOWNLOAD OF SOMETHING TO RUN, not any
;; curl -- an install script, a release asset, an archive, a raw source file,
;; or a write onto /usr/. Measured against the alternative: a bare `/curl /`
;; flagged 26 files, of which the notifiers (slack/teams/discord/matrix,
;; datadog-event) are `curl -sS -o /dev/null -w '%{http_code}'` -- an HTTP
;; status probe, which is the action's PURPOSE and not an install. Those are
;; excluded by construction rather than by a skip-list.
;;
;; Every one of the 12 pulls from `releases/latest` or a `main` install.sh --
;; UNPINNED -- with -sSL and no --fail, so an HTTP error writes an error page
;; to the destination and `chmod +x` makes it "executable". That is exactly the
;; "stale version pin silently downloading a 404 page" class named at the top
;; of this file as a thing this lint closes. It did not.
;;
;; The `/stdlib\.tlisp/ { next; }` exemption is also gone. It carved out "the
;; sanctioned stdlib loader fetch", and as of a296c0b there is no such fetch --
;; all 310 actions read the stdlib in-checkout via github.action_path. Keeping
;; a carve-out for a practice that no longer exists only licenses its return.
;; (Note it was never load-bearing: the old loader line was `curl -sL <url>`
;; with NO pipe, so the pattern missed it with or without the exemption.)
;;
;; One hit is enough per file (`exit` from the pattern block once matched)
;; -- this reports OFFENDING FILES, the same granularity as
;; action-shell-lint's own output, not every offending line.
(define awk-prog
  "BEGIN { }\n   /^[ \\t]*#/ { next; }\n   /^[ \\t]*;;/ { next; }\n   /curl[^\\n]*install\\.sh/ || /curl[^\\n]*releases\\/(latest|download)/ || /curl[^\\n]*\\.(zip|tar\\.gz|tgz)/ || /curl[^\\n]*raw\\.githubusercontent/ || /curl[^\\n]*-o [^\\n]*\\/usr\\// || /curl[^\\n]*\\|/ || /wget /|| /apt-get install/ || /apt install/ || /pip install/ || /npm install -g/ || /go install / || /cargo install / {\n     print FILENAME; nextfile;\n   }")

(define find-cmd
  (string-append
    "find . -path './_*' -prune -o -path './runtime-install-lint' -prune -o "
    "\\( -name 'action.yml' -o -name 'run.tlisp' \\) -print "
    "| xargs -I{} awk '"
    awk-prog
    "' {}"))

(define r (exec-capture "sh" "-c" find-cmd))

(define out (string-trim (stdout-of r)))

;; Second scan — WORKFLOW YAML (.github/workflows/*.yml|*.yaml). A SEPARATE,
;; NARROW rule (NIX-HARDENING.md §VI.1): the broad install-pattern awk above must
;; NOT be repointed at workflow YAML — legit CI curls / pip / npm-installs are
;; everywhere and would false-positive. This flags ONLY per-job NIX installation:
;; the DeterminateSystems/nix-installer-action, or a per-job `nix shell nixpkgs#…`
;; fetching a toolchain the runner IMAGE should bake in (the exact debt the
;; canteiro live runs hit). Offending files flow through the same baseline/report
;; machinery below. This scan finds work only when the action runs in a repo that
;; HAS `.github/workflows/` (i.e. invoked in a consuming repo's CI, e.g. sui —
;; set BASELINE_PATH to that repo's own baseline listing any known debt).
(define wf-awk-prog
  "/^[ \\t]*#/ { next; }\n   /DeterminateSystems\\/nix-installer-action/ { print FILENAME; nextfile; }\n   /nix shell nixpkgs#/ { print FILENAME; nextfile; }")

(define wf-find-cmd
  (string-append
    "find . -path './_*' -prune -o -path '*/.github/workflows/*' "
    "\\( -name '*.yml' -o -name '*.yaml' \\) -print "
    "| xargs -I{} awk '"
    wf-awk-prog
    "' {}"))

(define wf-r (exec-capture "sh" "-c" wf-find-cmd))

(define wf-out (string-trim (stdout-of wf-r)))

;; Both scans' offending-file lists, merged for one report pass.
(define combined
  (cond
    ((equal? out "") wf-out)
    ((equal? wf-out "") out)
    (else (string-append out "\n" wf-out))))

(define files-r
  (exec-capture "sh"
    "-c"
    ;; BOTH scans, because there are two and this counter reports "how much
    ;; did I look at". It previously counted only the ACTION files
    ;; (action.yml / run.tlisp), which is the right find for a sibling lint
    ;; that scans this repo — and always ZERO in a consuming repo, which is
    ;; where this action mostly runs. sui showed it plainly: 9 workflow files,
    ;; 4 correctly reported as baselined debt, `files-scanned=0`.
    ;;
    ;; That mattered beyond cosmetics. A zero denominator is exactly what a
    ;; caller checks to prove a scan HAPPENED (tlisp-test's `min-files` floor
    ;; is the same idea), so a lint permanently reporting 0 cannot be used as
    ;; its own evidence — and "0 violations across 0 files" reads as a pass.
    "{ find . -path './_*' -prune -o -path './runtime-install-lint' -prune -o \\( -name 'action.yml' -o -name 'run.tlisp' \\) -print; find . -path './_*' -prune -o -path '*/.github/workflows/*' \\( -name '*.yml' -o -name '*.yaml' \\) -print; } | wc -l"))

(define files (string-trim (stdout-of files-r)))

(define baseline-lines
  (if (path-exists? baseline-path)
    (filter (lambda (l) (not (equal? l ""))) (string-split (read-file baseline-path) "\n"))
    (list)))

(define (list-contains? lst item)
  (cond
    ((null? lst) #f)
    ((equal? (car lst) item) #t)
    (else (list-contains? (cdr lst) item))))

;; tatara-script's `let` has no named-let form -- a top-level `define` is
;; the portable recursive-loop idiom used elsewhere in this repo (see
;; action-shell-lint/run.tlisp's own report-violations).
(define (report-violations lines new-n baseline-n)
  (cond
    ((null? lines)
      (append-output (string-append "violations=" (string-format "{}" new-n)))
      (append-output (string-append "baselined=" (string-format "{}" baseline-n)))
      (append-output (string-append "files-scanned=" files))
      (cond ((and (equal? fail-on "true") (> new-n 0)) (exit 1)) (else (exit 0))))
    ((equal? (car lines) "") (report-violations (cdr lines) new-n baseline-n))
    (else
      (let ((offending-file (car lines)))
        (cond
          ((list-contains? baseline-lines offending-file)
            (log-info (string-append "  (baseline, tracked debt) " offending-file))
            (report-violations
              (cdr lines)
              new-n
              (+ baseline-n 1)))
          (else
            (log-error
              (string-append
                "  NEW violation: "
                offending-file
                " -- convert to a Nix-hardened image + docker:// action, or add to baseline.txt as tracked debt with a reason"))
            (report-violations
              (cdr lines)
              (+ new-n 1)
              baseline-n)))))))

(cond
  ((equal? combined "")
    (log-info (string-append "0 runtime-install violations across " files " scanned files"))
    (append-output "violations=0")
    (append-output "baselined=0")
    (append-output (string-append "files-scanned=" files))
    (exit 0))
  (else
    (log-error "runtime tool installation found:")
    (report-violations
      (string-split combined "\n")
      0
      0)))
