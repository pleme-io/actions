;; tatara-script/output-contract.test.tlisp
;;
;; Runs the real gate as a subprocess against synthetic GITHUB_OUTPUT +
;; action.yml pairs and asserts its EXIT CODE, because the exit code is the
;; whole contract — a gate whose failure is indistinguishable from its success
;; verifies nothing, which is the exact property the thing under test exists to
;; restore.
;;
;;   tatara-script --test tatara-script/output-contract.test.tlisp

(define gate
  (let ((d (env-get "GATE_PATH" ""))) (if (equal? d "") "tatara-script/output-contract.tlisp" d)))

;; status-of / stdout-of live in the caixa + pleme stdlibs, which are NOT
;; inlined here — a test that pulled in a 56 KB stdlib to read one alist key
;; would couple this file to whatever else that stdlib defines.
(define (exit-code r) (alist-get r "status" -1))

;; deftest fails ONLY on a runtime error. Verified 2026-07-29: a body returning
;; #f PASSES, and so does (error "kind" "msg") — the two-to-three-arg form does
;; not raise. So an assertion written as (if cond #t (error ...)) is VACUOUS and
;; every such test reports green regardless of the subject.
;;
;; fail! logs the reason, then dereferences an empty list to raise a real error,
;; which is the only mechanism that actually reddens a case here.
(define (fail! msg)
  (log-error (string-append "ASSERTION FAILED: " msg))
  (car (list)))

(define (expect-rc want got label)
  (if (= want got)
    #t
    (fail!
      (string-append
        label
        ": expected rc "
        (string-format "{}" want)
        ", got "
        (string-format "{}" got)))))

;; Returns (dir out) — the manifest is always <dir>/action.yml, so the gate's
;; GITHUB_ACTION_PATH is just the dir and no path-dirname is needed.
(define (write-case out-body manifest-body)
  (let* ((dir (tmp-dir)) (out (path-join dir "gh_out")))
    (write-file out out-body)
    (write-file (path-join dir "action.yml") manifest-body)
    (list dir out)))

;; The gate reads its inputs from the environment, so each case sets them
;; immediately before invoking rather than relying on prior state.
(define (run-case c)
  (env-set "GITHUB_ACTION_PATH" (car c))
  (env-set "GITHUB_OUTPUT" (car (cdr c)))
  (exit-code (exec-capture "tatara-script" gate)))

(define declares-all
  "name: x\noutputs:\n  version:\n    value: a\n  repo-type:\n    value: b\n  manifest-path:\n    value: c\n  big:\n    value: d\nruns:\n  using: composite\n")

(define declares-some
  "name: x\noutputs:\n  version:\n    value: a\n  bumped:\n    value: b\nruns:\n  using: composite\n")

(deftest "passes when every written key is declared"
  (let* ((c (write-case "version=1.2.3\nrepo-type=caixa\n" declares-all)) (rc (run-case c)))
    (expect-rc
      0
      rc
      (string-append "expected 0, got " (string-format "{}" rc)))))

(deftest "FAILS when a written key is undeclared — the dispatcher bug"
  (let*
    ((c
       (write-case "version=1.2.3\nrepo-type=caixa\nmanifest-path=gha.caixa.lisp\n" declares-some))
      (rc (run-case c)))
    (expect-rc
      1
      rc
      (string-append "expected 1, got " (string-format "{}" rc)))))

(deftest "recognises the heredoc key form"
  (let* ((c (write-case "big<<EOF\nline one\nline two\nEOF\n" declares-some)) (rc (run-case c)))
    ;; `big` is undeclared in declares-some, so a gate that sees the heredoc key
    ;; must fail. A gate that missed it would pass, so this asserts detection.
    (expect-rc
      1
      rc
      "heredoc key not detected")))

(deftest "heredoc BODY lines are not mistaken for keys"
  (let*
    ((c (write-case "version<<EOF\nnot-a-key=value\nalso not a key\nEOF\n" declares-some))
      (rc (run-case c)))
    ;; version IS declared; the body contains a line that looks like `k=v`. If
    ;; the parser counted it, the gate would fail on a legitimate payload.
    (expect-rc
      0
      rc
      "a heredoc body line was counted as a key")))

(deftest "passes when the script wrote nothing at all"
  (let* ((c (write-case "" declares-some)) (rc (run-case c)))
    (expect-rc
      0
      rc
      "an empty output file must not be a violation")))

(deftest "skips rather than fails when GITHUB_OUTPUT is unset"
  (begin
    (env-set "GITHUB_OUTPUT" "")
    (env-set "GITHUB_ACTION_PATH" "")
    (let ((rc (exit-code (exec-capture "tatara-script" gate))))
      (expect-rc
        0
        rc
        "an unset environment must skip, not fail"))))

(deftest "nested keys under a declared output are not counted as declarations"
  ;; `value:` and `description:` sit deeper than two spaces; if the manifest
  ;; scanner counted them, an undeclared key named `value` would wrongly pass.
  (let* ((c (write-case "value=oops\n" declares-some)) (rc (run-case c)))
    (expect-rc
      1
      rc
      "a nested yaml key leaked into the declared set")))
