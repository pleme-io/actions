;; tatara-script/output-contract.tlisp — the output contract gate.
;;
;; A composite action exposes a step's GITHUB_OUTPUT keys to its caller ONLY
;; through its own `outputs:` block. A key the script writes but the action does
;; not declare is dropped at the boundary, silently, and every consumer reads an
;; empty string. Nothing fails. Nothing logs.
;;
;; That is what killed the polymorphic auto-release dispatcher org-wide:
;; detect-repo-type wrote `repo-type=caixa` correctly for months while every
;; caller saw '' and every arm's `if:` compared against nothing. Seven
;; hypotheses were eliminated by inspection before a bisect found it.
;;
;; This runs in the SAME step as the script — GITHUB_OUTPUT is per-step, so a
;; later step cannot see it — and turns that silent drop into a named failure.
;;
;; Reads   GITHUB_OUTPUT        the keys the script actually wrote
;;         GITHUB_ACTION_PATH   this action's own action.yml, for what it declares
;; Exits   0  every written key is declared (or nothing was written)
;;         1  at least one key would be dropped; names each one

(define out-file (env-get "GITHUB_OUTPUT" ""))

(define action-path (env-get "GITHUB_ACTION_PATH" ""))

;; A missing file is not a violation: plenty of scripts write no outputs, and a
;; contract gate that fails on absence would block them for no reason.
(define (skip why)
  (log-info (string-append "output-contract: skipped — " why))
  (exit 0))

;; TLISP_TEST gate — 46 of this repo's actions carry it; this file did not,
;; and that is why CI was red.
;;
;; The check compares the keys written to $GITHUB_OUTPUT against the keys
;; declared in the ENCLOSING action's action.yml. That is exactly right inside
;; a real action step, where the output file belongs to that one step.
;;
;; Under `tlisp-test`, it is wrong by construction: every discovered
;; *.test.tlisp runs in the SAME job, sharing ONE $GITHUB_OUTPUT, so this file
;; loaded and immediately audited a file full of keys written by other
;; actions' tests — and reported them as undeclared against tatara-script's
;; action.yml, which of course does not declare them. Reproduced locally by
;; seeding $GITHUB_OUTPUT with two foreign keys: it names both and fails.
;;
;; The check was not wrong about the keys. It was pointed at the wrong action.
;; Gating the main also lets this file's own deftests run at all — with the
;; main executing on load they never did.
(define tlisp-test-mode (equal? (env-get "TLISP_TEST" "") "1"))

(when tlisp-test-mode
  (log-info
    (string-append "output-contract: check skipped — TLISP_TEST=1 (the harness shares "
                   "one $GITHUB_OUTPUT across every action's tests). Definitions still "
                   "load so this file's own deftests can run.")))

(when (and (not tlisp-test-mode) (equal? out-file "")) (skip "GITHUB_OUTPUT is unset"))

(when (and (not tlisp-test-mode) (not (path-exists? out-file))) (skip "the script wrote no outputs"))

(when (and (not tlisp-test-mode) (equal? action-path "")) (skip "GITHUB_ACTION_PATH is unset"))

(define manifest (string-append action-path "/action.yml"))

(when (not (path-exists? manifest)) (skip (string-append "no action.yml at " action-path)))

;; ── keys the script wrote ────────────────────────────────────────────────
;;
;; Two shapes in GITHUB_OUTPUT: `key=value` and the heredoc form
;; `key<<DELIM`. Continuation lines of a heredoc body must NOT be mistaken for
;; keys, so a line only counts when its name part is a plain identifier — a
;; body line like "  foo bar" has a space and is rejected, and one containing
;; `=` inside prose is rejected by the same identifier test.

(define ident-chars "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")

(define (all-ident-chars? s)
  (cond
    ((equal? s "") #f)
    (else (null? (filter (fn (c) (not (string-contains? ident-chars c))) (string-split s ""))))))

;; A stateful walk, not a per-line map: inside a heredoc body every line is
;; opaque payload, and a body line such as `not-a-key=value` must NOT be read as
;; a key. Caught by the test suite once its assertions were made to actually
;; raise — the map-only version reported this file's own heredoc bodies as
;; undeclared keys.
(define (scan-written lines delim acc)
  (cond
    ((null? lines) acc)
    (else
      (let*
        ((line (car lines))
          (rest (cdr lines))
          (hd (string-split line "<<"))
          (eq (string-split line "=")))
        (cond
          ;; in a heredoc: only its closing delimiter is meaningful
          ((not (equal? delim "")) (scan-written rest (if (equal? line delim) "" delim) acc))
          ;; heredoc opener — record the key, remember the delimiter
          ((and (> (length hd) 1) (all-ident-chars? (car hd)))
            (scan-written
              rest
              (car (cdr hd))
              (cons (car hd) acc)))
          ;; plain key=value
          ((and (> (length eq) 1) (all-ident-chars? (car eq)))
            (scan-written
              rest
              ""
              (cons (car eq) acc)))
          (else (scan-written rest "" acc)))))))

(define written
  (if tlisp-test-mode (list) (scan-written (string-split (read-file out-file) "\n") "" (list))))

;; ── keys the action declares ─────────────────────────────────────────────
;;
;; The `outputs:` block, to the next top-level key. Declared entries are the
;; lines indented exactly two spaces and ending in `:` — nested `description:`
;; and `value:` sit deeper and are skipped by the indent test.

(define (top-level? line)
  (and
    (not (equal? line ""))
    (not (string-starts-with? line " "))
    (not (string-starts-with? line "#"))))

(define (declared-entry line)
  (cond
    ((not (string-starts-with? line "  ")) "")
    ((string-starts-with? line "   ") "")
    (else
      (let ((name (car (string-split (string-trim line) ":"))))
        (if (and (string-ends-with? (string-trim line) ":") (all-ident-chars? name))
          name
          "")))))

(define (scan-declared lines inside acc)
  (cond
    ((null? lines) acc)
    (else
      (let ((line (car lines)) (rest (cdr lines)))
        (cond
          ((string-starts-with? line "outputs:") (scan-declared rest #t acc))
          ((and inside (top-level? line)) acc)
          (inside
            (let ((e (declared-entry line)))
              (scan-declared
                rest
                #t
                (if (equal? e "")
                  acc
                  (cons e acc)))))
          (else (scan-declared rest inside acc)))))))

(define declared
  (if tlisp-test-mode (list) (scan-declared (string-split (read-file manifest) "\n") #f (list))))

;; ── the gate ─────────────────────────────────────────────────────────────

;; No elem?/member in this runtime — a length-0 filter is the membership test.
(define (declared? k) (> (length (filter (fn (d) (equal? d k)) declared)) 0))

(define dropped (filter (fn (k) (not (declared? k))) written))

(cond
  ;; Under the harness the verdict is not ours to give — `written` and
  ;; `declared` are both empty by construction above, so any verdict here
  ;; would be about nothing. Falling through without exiting is what lets
  ;; this file's deftests run.
  (tlisp-test-mode #t)
  ((null? dropped)
    (log-info
      (string-append
        "output-contract: ok — "
        (string-format "{}" (length written))
        " key(s) written, all declared"))
    (exit 0))
  (else
    (log-error
      (string-append
        "output-contract: the script wrote output key(s) this action does not "
        "declare, so they are DROPPED at the composite boundary and every "
        "consumer reads an empty string: "
        (string-join ", " dropped)))
    (log-error
      (string-append
        "add them to the `outputs:` block of "
        manifest
        " as `value: ${{ steps.exec.outputs.<key> }}`"))
    (exit 1)))
