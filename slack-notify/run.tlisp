;; slack-notify/run.tlisp — post a release event to a Slack webhook.
;;
;; Was jq-through-sh then curl-through-sh. Three defects, all structural:
;; the webhook URL (which IS the Slack credential) sat in argv where `ps` can
;; read it; curl had no `--fail`, so a 401 or 500 exited 0 and only a scraped
;; `%{http_code}` string decided the verdict; and the payload was reassembled
;; as shell text with hand-rolled requoting.
;;
;; A fourth, quieter one: the jq call read `"$TITLE"`/`"$BODY"`/`"$COLOR"`/
;; `"$FIELDS"` from the ENVIRONMENT rather than from the values bound above,
;; so every tlisp default was unreachable. An unset FIELDS became
;; `--argjson fields ""`, a jq parse error, and the action failed instead of
;; posting — the documented default "[]" could never apply.

(define webhook (env-required "WEBHOOK_URL"))

(define title (env-required "TITLE"))

(define body (env-get "BODY" ""))

(define color (env-get "COLOR" "good"))

(define fields-raw (env-get "FIELDS" "[]"))

;; FIELDS is JSON by contract (it was `--argjson`), so it is parsed rather
;; than embedded as a string. Malformed input fails loudly here instead of
;; becoming a jq syntax error two layers down.
(define fields
  (let ((r (erro:attempt (lambda () (json-parse fields-raw)))))
    (cond
      ((erro:err? r)
        (log-error
          (string-append "slack-notify: FIELDS is not valid JSON: " fields-raw))
        (append-output "delivered=false")
        (exit 1))
      (else (erro:value r)))))

(define payload
  (list
    (list "attachments"
      (list
        (list
          (list "color" color)
          (list "title" title)
          (list "text" body)
          (list "fields" fields)
          (list "mrkdwn_in" (list "text" "fields")))))))

(define r (webhook:post webhook (list) payload))

(cond
  ((erro:err? r)
    (log-error
      (string-append "slack-notify: delivery failed — " (erro:message (erro:value r))))
    (append-output "delivered=false")
    (exit 1))
  (else
    (log-info "delivered to Slack")
    (append-output "delivered=true")
    (exit 0)))
