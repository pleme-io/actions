;; detect-repo-type/run.tlisp — emit one of:
;;
;;   rust-workspace      — Cargo.toml with [workspace] section
;;   rust-single-crate   — Cargo.toml with [package] section (no [workspace])
;;   go                  — go.mod
;;   npm                 — package.json
;;   python              — pyproject.toml
;;   helm                — Chart.yaml
;;   ansible-collection  — galaxy.yml
;;   ruby-gem            — *.gemspec at root
;;   github-action       — action.yml at root
;;   caixa               — a *.caixa.lisp manifest and NO language manifest
;;   unknown             — none of the above
;;
;; Precedence (when multiple manifests coexist):
;;   rust > go > ansible > helm > python > npm > ruby > action > caixa > unknown
;;
;; Outputs (appended):
;;   repo-type       the typed identifier
;;   manifest-path   the file that drove the detection (for log lines)

(define gh-output (env-required "GITHUB_OUTPUT"))

(define (append-output line)
  (define prior (if (path-exists? gh-output) (read-file gh-output) ""))
  (write-file gh-output (string-append prior line "\n")))

;; `expect` — assert the detected type, inside the action.
;;
;; Empty (the default) keeps the historical detect-and-report behaviour
;; byte for byte, so every existing consumer is untouched.
;;
;; Non-empty turns this into a PRECONDITION. A reusable workflow that only
;; works on one repo shape can now state that shape as a value in its call
;; instead of trusting each consumer's shim to have picked the right
;; workflow — which is the failure this input exists for. Measured
;; 2026-08-14: seven repos ran cargo-auto-release.yml (single-crate) against
;; a [workspace] root, and every release died at
;;
;;     ERROR cargo-publish-crate: package.name not found in Cargo.toml
;;
;; A workspace root has no [package] BY DEFINITION, so that message is a true
;; statement about the manifest and tells the reader nothing about the actual
;; mistake. The routing rule was written down — cargo-auto-release.yml's own
;; header says "For workspace repos use rust-auto-release.yml instead" — and
;; a header cannot fail a build.
(define expect (string-trim (env-get "EXPECT" "")))

(define (emit type manifest)
  (log-info (string-append "detected: " type " (manifest: " manifest ")"))
  (append-output (string-append "repo-type=" type))
  (append-output (string-append "manifest-path=" manifest))
  (cond
    ((and (not (equal? expect "")) (not (equal? expect type)))
      (log-error
        (string-append
          "repo-type mismatch: this workflow expects a '"
          expect
          "' repo and "
          manifest
          " says this is '"
          type
          "'"))
      ;; The routing rule goes IN the message, not behind a link. The
      ;; operator reading this is looking at a CI log in a repo that is not
      ;; this one, and the fix is one line in a shim; making them go find a
      ;; table first is the whole difference between a diagnosis and a
      ;; complaint. (README.md is also `pleme-doc-gen` OUTPUT — "do not
      ;; hand-edit" — so a table added there would be erased by the next
      ;; regen, and the link would rot pointing at nothing.)
      (log-error "  the shim calling this workflow names the wrong one. Rust routing:")
      (log-error "    [package] root                        -> cargo-auto-release.yml")
      (log-error "    [workspace] + [workspace.package]     -> rust-auto-release.yml")
      (log-error
        (string-append
          "    [workspace] without it                -> "
          "cargo-publish-each-member-auto-release.yml"))
      (exit 1)))
  (exit 0))

;; -------------------------------------------------------------- ;;
;; Rust detection — workspace vs single-crate                      ;;
;; -------------------------------------------------------------- ;;

(define (cargo-has-section? section)
  (and (path-exists? "Cargo.toml") (string-contains? (read-file "Cargo.toml") section)))

;; -------------------------------------------------------------- ;;
;; Ruby gem — find any *.gemspec at root                           ;;
;; -------------------------------------------------------------- ;;

(define (find-gemspec)
  (let ((r (exec-capture "sh" "-c" "ls *.gemspec 2>/dev/null | head -1")))
    (string-trim (alist-get r "stdout" ""))))

;; -------------------------------------------------------------- ;;
;; caixa — a *.caixa.lisp manifest at root                         ;;
;;                                                                 ;;
;; DELIBERATELY LAST in the cond below, after every language        ;;
;; manifest. The vendored caixa-* crates carry BOTH a Cargo.toml    ;;
;; and a <crate>.caixa.lisp (verified 2026-07-29: caixa-serde,      ;;
;; caixa-clap), so matching on the manifest first would move ~200   ;;
;; working rust-single-crate repos onto this pipeline at once.      ;;
;; caixa is therefore the answer only when nothing else claims the  ;;
;; repo, which is exactly the pure-tlisp library case.              ;;
;; -------------------------------------------------------------- ;;

(define (find-caixa-manifest)
  (let ((r (exec-capture "sh" "-c" "ls *.caixa.lisp 2>/dev/null | head -1")))
    (string-trim (alist-get r "stdout" ""))))

;; -------------------------------------------------------------- ;;
;; Dispatch — first match wins (precedence per header comment)     ;;
;; -------------------------------------------------------------- ;;

(cond
  ;; Rust — workspace check first since [workspace] crowds out
  ;; [package] when both are present
  ((cargo-has-section? "[workspace]") (emit "rust-workspace" "Cargo.toml"))
  ((cargo-has-section? "[package]") (emit "rust-single-crate" "Cargo.toml"))

  ;; Go — go.mod (pull-model module: tag-only delivery, FSM-MODULE)
  ((path-exists? "go.mod") (emit "go" "go.mod"))

  ;; Ansible
  ((path-exists? "galaxy.yml") (emit "ansible-collection" "galaxy.yml"))

  ;; Helm
  ((path-exists? "Chart.yaml") (emit "helm" "Chart.yaml"))

  ;; Python — pyproject.toml is the modern manifest
  ((path-exists? "pyproject.toml") (emit "python" "pyproject.toml"))

  ;; npm
  ((path-exists? "package.json") (emit "npm" "package.json"))

  ;; Ruby gem
  ((not (equal? (find-gemspec) "")) (emit "ruby-gem" (find-gemspec)))

  ;; GitHub action
  ((path-exists? "action.yml") (emit "github-action" "action.yml"))
  ((path-exists? "action.yaml") (emit "github-action" "action.yaml"))

  ;; caixa — see the precedence note above: last, never first
  ((not (equal? (find-caixa-manifest) "")) (emit "caixa" (find-caixa-manifest)))

  ;; Nothing matched. A detector REPORTS its answer (including
  ;; "unknown") and succeeds — exiting non-zero here fails the detect
  ;; job, which in the polymorphic auto-release workflow cascades to
  ;; skip+red every dispatch job for a repo that simply has no
  ;; packageable artifact (and should no-op green per the AUTO-RELEASE
  ;; exemption). Callers branch on `repo-type=unknown` via job `if:`.
  (else
    (log-info "detect-repo-type: no recognized manifest at repo root (unknown)")
    (append-output "repo-type=unknown")
    (append-output "manifest-path=")
    (exit 0)))
