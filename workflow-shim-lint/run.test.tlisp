;; Tests for workflow-shim-lint's classification predicates.
;;
;; These pin the DISPOSITION — shim vs waived vs hand-authored — because that
;; is the layer a mistake actually hurts at. A wrong `shim?` silently excuses a
;; hand-authored workflow; a wrong `waived?` either excuses a bare marker or
;; refuses a legitimate waiver, and the first of those is how a waiver grammar
;; decays into a mute button.

(define shim-text
  "name: a\njobs:\n  x:\n    uses: pleme-io/substrate/.github/workflows/cargo-ci.yml@main\n")

(define bespoke-text
  "name: b\njobs:\n  x:\n    runs-on: ubuntu-latest\n    steps: [{ run: \"true\" }]\n")

(define waived-text
  "# skip-workflow-shim: vendored upstream CI, not ours to restandardize\nname: c\n")

(define bare-marker-text "# skip-workflow-shim:\nname: d\n")

(deftest
  "a workflow calling a substrate reusable is a shim"
  (assert (shim? shim-text) "a `uses: pleme-io/substrate/...` line makes it a shim")
  (assert (not (shim? bespoke-text)) "a hand-authored job is not a shim"))

(deftest
  "a waiver REQUIRES a typed reason — a bare marker does not waive"
  ;; The load-bearing one. A bare `# skip-workflow-shim:` is exactly the shape
  ;; a waiver takes when it is being used to silence rather than to explain,
  ;; so it must NOT count. Verified end-to-end too: in a 4-file probe repo the
  ;; bare-marker file is reported alongside the genuinely bespoke one.
  (assert (waived? waived-text) "a marker WITH a reason waives")
  (assert (not (waived? bare-marker-text)) "a marker with NO reason does not waive")
  (assert (not (waived? bespoke-text)) "no marker at all does not waive"))

(deftest
  "a shim is never treated as a waiver, and vice versa"
  ;; Guarding the class: the two escape hatches must stay distinct, or a repo
  ;; could appear compliant for the wrong reason and nobody would look again.
  (assert (not (waived? shim-text)) "a shim needs no waiver and does not carry one")
  (assert (not (shim? waived-text)) "a waived file is still not routed through substrate"))

(deftest
  "the reason is extracted, not merely detected"
  ;; If the reason were parsed wrongly a legitimate waiver could read as empty
  ;; and be refused — which trains people to delete the gate rather than use it.
  (assert
    (equal?
      (waiver-reason "# skip-workflow-shim: vendored upstream CI, not ours to restandardize")
      "vendored upstream CI, not ours to restandardize")
    "the text after the marker is the reason")
  (assert (equal? (waiver-reason "# skip-workflow-shim:") "") "an empty reason reads as empty")
  (assert (equal? (waiver-reason "name: unrelated") "") "a line with no marker has no reason"))

(deftest
  "both publishers count as a shim, not just substrate"
  ;; substrate is not the only publisher: pleme-actions ships two reusables
  ;; carrying 23 consumers each. Treating only substrate as canonical would
  ;; report 23 correctly-shimmed repos as violations — the gate accusing repos
  ;; of the exact thing they had already done.
  (assert
    (shim? "jobs:\n  x:\n    uses: pleme-io/substrate/.github/workflows/cargo-ci.yml@main\n")
    "a substrate reusable is a shim")
  (assert
    (shim?
      "jobs:\n  x:\n    uses: pleme-io/pleme-actions/.github/workflows/release-action.yml@main\n")
    "a pleme-actions reusable is equally a shim")
  (assert
    (not (shim? "jobs:\n  x:\n    runs-on: ubuntu-latest\n"))
    "a hand-authored job is still not a shim"))

;; ── the shell ratchet ────────────────────────────────────────────────────
;; The counter is pinned on the STEP form (`- run: |`) because that is the one
;; it got wrong: the first cut tested the trimmed line against "run: |", which
;; a list item never starts with, so a file that was nothing but shell counted
;; 0. For a ratchet that is the worst possible failure — it reports the number
;; falling while the shell is still there — so the dash case is a test, not a
;; comment.
(deftest shell-lines-counts-step-bodies
  (assert
    (= (shell-lines "jobs:\n  x:\n    steps:\n      - run: |\n          echo a\n          echo b\n") 2)
    "counts a two-line body behind the `- run: |` step form")
  (assert
    (= (shell-lines "jobs:\n  x:\n    steps:\n      - run: |\n          echo a\n      - uses: actions/checkout@v4\n") 1)
    "a following step at the same indent closes the block")
  (assert
    (= (shell-lines "jobs:\n  x:\n    uses: pleme-io/flows/.github/workflows/pleme-rust.yml@main\n") 0)
    "a pure shim carries no shell")
  (assert
    (= (shell-lines "jobs:\n  x:\n    steps:\n      - run: |\n          echo a\n\n          echo b\n") 2)
    "a blank line inside a body is not counted and does not close the block")
  (assert
    (= (shell-lines "jobs:\n  x:\n    steps:\n      - run: |\n          # why this is here\n          # and why it stays\n          echo a\n") 1)
    "a comment inside a body is prose, not shell — pricing it would make deleting the explanation the cheapest way to meet a budget"))

(deftest flows-is-a-publisher
  (assert
    (shim? "jobs:\n  x:\n    uses: pleme-io/flows/.github/workflows/pleme-rust.yml@main\n")
    "pleme-io/flows is a shim publisher alongside substrate"))

(deftest budget-uses-the-stdlib-parser
  ;; stdlib ALREADY had num:parse-int — decimal and hex, typed ok/err, and
  ;; documented as never guessing a fallback. A second parse-int was written
  ;; here before that was found, which is the differently-named
  ;; reimplementation tlisp-lint exists to catch. These pin the survivor.
  (assert (= (shim:budget-of "42") 42) "reads a decimal budget")
  (assert (= (shim:budget-of "  7 ") 7) "tolerates surrounding whitespace")
  (assert (= (shim:budget-of "0x10") 16) "hex comes free with the stdlib parser"))

