;; workflow-shim-lint — the CONSUMER side of CATALOG REFLECTION.
;;
;; substrate publishes 71 reusable workflows and catalogues them at
;; substrate/catalog/workflows.lisp, gated so one cannot land uncatalogued.
;; That closes the PRODUCER side. This closes the consumer side: it reports a
;; repo's workflow files that are hand-authored instead of thin shims over one
;; of those reusables.
;;
;; WHY IT IS NEEDED, measured 2026-08-04 across locally-cloned pleme-io repos:
;;
;;   1667 consumer workflow files
;;   1347 (80.8%) already shims over a substrate reusable
;;    320 hand-authored — of which 176 are VENDORED upstream forks (vector,
;;         the caixa-* crate mirrors) carrying their original CI, out of scope
;;    144 pleme-io-authored, spread across 99 repos
;;
;; 144 across 99 repos is the signature of drift with no gate: no single repo
;; is a bad actor, and the total grew anyway. A catalog alone would not have
;; stopped it — nothing was asking the question at merge time.
;;
;; WHAT COUNTS AS A SHIM: the file calls `uses: pleme-io/substrate/.github/
;; workflows/...`. That is deliberately the whole test. Judging "thin enough"
;; would need a heuristic on job/step counts, and a heuristic that is wrong on
;; a legitimate file teaches people to waive rather than convert.
;;
;; TWO WAIVER SCOPES, because the two legitimate cases have different shapes.
;;
;; PER-FILE — a comment line anywhere in the workflow:
;;
;;     # skip-workflow-shim: <typed reason>
;;
;; REPO-LEVEL — a `.github/workflow-shim-waiver` file whose contents are the
;; reason. This exists for VENDORED UPSTREAM FORKS, which are 176 of the
;; fleet's 257 remaining hand-authored workflows across 63 repos (vector, the
;; caixa-* crate mirrors). Restandardizing someone else's CI is not ours to
;; do, and editing 176 upstream files to say so would be worse than the
;; problem: it guarantees a conflict on every upstream merge, in exactly the
;; files we least want to touch. One file per repo states the fact once,
;; outside the vendored tree.
;;
;; A REASON IS REQUIRED in both scopes; a bare marker or an empty file does not
;; waive. Time pressure is never a typed reason.
;;
;; TIER: CI-caught, and only-mitigated while `fail-on-violation` defaults to
;; false during rollout. Say that, do not round it up. It becomes a real gate
;; when the default flips, which is the named end state — not this commit.

(define paths-glob (env-get "PATHS" ".github/workflows/*.yml"))
(define fail-on-violation? (equal? (env-get "FAIL_ON_VIOLATION" "false") "true"))

;; The budget gates SEPARATELY from the shim verdict, and it has to.
;;
;; The shim check is report-only fleet-wide and will stay that way for a while:
;; 144 hand-authored workflows across 99 repos would go red at once, which is a
;; backlog to burn down rather than a wall to hit. The BUDGET is the opposite --
;; every repo carrying shell has a committed budget set to what it measured
;; TODAY, so gating it can only fail a repo that ADDS shell. Nothing existing
;; goes red.
;;
;; One flag for both would have forced the choice: either the budget stays inert
;; while the backlog burns down, or the backlog fails the fleet today. Two flags
;; is the whole reason the ratchet is real rather than advisory.
(define fail-on-budget? (equal? (env-get "FAIL_ON_BUDGET" "true") "true"))

;; Both publishers count. substrate is not the only one — pleme-actions
;; publishes two reusables carrying 23 consumers each, and treating only
;; substrate as canonical would report 23 correctly-shimmed repos as
;; violations.
(define shim-markers
  (list "pleme-io/substrate/.github/workflows/"
        "pleme-io/flows/.github/workflows/"
        "pleme-io/pleme-actions/.github/workflows/"))

;; ── the shell ratchet ────────────────────────────────────────────────────
;; Absorption is measured in shell REMOVED, not in workflows that merely call
;; the catalog. A shim that calls auto-release and still carries 40 lines of
;; its own `run:` counts as absorbed by the shim test above and is not; this
;; counts what is actually left, so the number can be held down.
;;
;; Reported ALWAYS, enforced only when a budget is set — an empty budget is
;; off, which is what lets 171 existing consumers inherit the measurement
;; without a single one of them turning red on the day it ships.
;; Resolution order, matching runner-resolve's config-path idiom: an explicit
;; input wins, else the repo's own committed budget, else off. The committed
;; file is the point — a ratchet whose value lives in the caller's YAML is a
;; number nobody can see from inside the repo it constrains, and lowering it
;; becomes someone else's edit.
(define budget-config-path ".github/shell-budget")

(define shell-budget
  (let ((given (string-trim (env-get "SHELL_BUDGET" ""))))
    (cond
      ((not (equal? given "")) given)
      ((path-exists? budget-config-path) (string-trim (read-file budget-config-path)))
      (else ""))))

;; Indent by character count. `string-trim` strips both ends, so a line with
;; trailing whitespace reads as MORE indented and stays inside the block --
;; an over-count of at most those lines, never an under-count, which is the
;; right direction for a ratchet.
;; A budget that does not parse is a CONFIGURATION error, not a zero. Zero
;; would silently fail every repo with any shell at all, which reads as the
;; ratchet working; stdlib's num:parse-int refuses to guess for exactly this
;; reason, so the refusal is honoured here rather than defaulted away.
(define (shim:budget-of s)
  (let ((r (num:parse-int s)))
    (cond
      ((erro:ok? r) (erro:value r))
      (else
        (log-error (string-append "workflow-shim-lint: shell-budget '" s
                                  "' is not a number — refusing to guess a budget"))
        (exit 2)))))

(define (indent-of line)
  (- (length (string-chars line)) (length (string-chars (string-trim line)))))

(define (run-inline? line)
  (let* ((t0 (string-trim line))
         (t (if (string-starts-with? t0 "- ") (string-trim (string-replace t0 "- " "")) t0)))
    (and (string-starts-with? t "run:")
         (not (string-starts-with? t "run: |"))
         (not (string-starts-with? t "run: >"))
         (not (string-starts-with? t "run:|"))
         (not (string-starts-with? t "run:>"))
         (not (equal? (string-trim (string-replace t "run:" "")) "")))))

(define (run-opener? line)
  ;; A step is `- run: |`, so the list dash has to come off before the test.
  ;; Without this the counter reads 0 on a file that is nothing but shell,
  ;; which is the worst possible failure for a ratchet: it reports the number
  ;; going DOWN while the shell is still there.
  (let* ((t0 (string-trim line))
         (t (if (string-starts-with? t0 "- ") (string-trim (string-replace t0 "- " "")) t0)))
    (or (string-starts-with? t "run: |")
        (string-starts-with? t "run: >")
        (string-starts-with? t "run:|")
        (string-starts-with? t "run:>"))))

;; One pass, no regex: on a `run:` opener remember its indent; every later
;; non-blank line indented FURTHER is body. A line at or below that indent
;; closes the block.
(define (shell-lines text)
  (let ((lines (string-split text "\n")))
    (nth 0
      (reduce
        (fn (acc line)
          (let ((total (nth 0 acc)) (open (nth 1 acc)) (base (nth 2 acc)) (cont (nth 3 acc)))
            (cond
              ((run-opener? line) (list total 1 (indent-of line) 0))
              ;; An INLINE `run: cmd` is one statement of shell and was counted
              ;; as zero until 2026-08-19, because only a block scalar opened a
              ;; body. That made the ratchet gameable in the cheapest possible
              ;; way: move every block onto one line each and a repo reads clean
              ;; while carrying exactly as much shell. Counted, and it closes
              ;; the block rather than opening one.
              ((run-inline? line) (list (+ total 1) 0 base 0))
              ((equal? (string-trim line) "") (list total open base cont))
              ;; A comment inside a `run:` body is not shell. Counting it makes a
              ;; carefully-explained two-line block read as fifteen lines of debt
              ;; -- measured on hardened-images/image-release.yml, where 12 of 15
              ;; lines were a shellcheck-suppression rationale. A budget set from
              ;; that number would price prose, and the cheapest way to meet it
              ;; would be deleting the explanation.
              ((and (equal? open 1) (> (indent-of line) base)
                    (string-starts-with? (string-trim line) "#"))
                (list total 1 base cont))
              ;; A backslash-continued command is ONE statement, however many
              ;; lines it is wrapped across. Counting the wrap punishes exactly
              ;; the shape the directive asks for -- invoking a typed binary
              ;; with its flags one per line -- and rewards cramming it onto a
              ;; single unreadable line to make a budget.
              ((and (equal? open 1) (> (indent-of line) base) (equal? cont 1))
                (list total 1 base (if (string-ends-with? (string-trim line) "\\") 1 0)))
              ((and (equal? open 1) (> (indent-of line) base))
                (list (+ total 1) 1 base (if (string-ends-with? (string-trim line) "\\") 1 0)))
              (else (list total 0 base 0)))))
        (list 0 0 0 0)
        lines))))

(define repo-waiver-path ".github/workflow-shim-waiver")
(define waiver-marker "skip-workflow-shim:")

;; -------------------------------------------------------------- ;;
;; Predicates                                                      ;;
;; -------------------------------------------------------------- ;;

;; A shim calls a substrate reusable. Substring is the RIGHT test here, unlike
;; the catalog's `workflow_call:` check: `uses:` values are not a key that a
;; comment plausibly mentions, and a file that names a substrate reusable
;; anywhere is by construction routing through one.
(define (shim? text) (any? (lambda (m) (string-contains? text m)) shim-markers))

;; A repo-level waiver waives every workflow in the repo. Empty file = no
;; waiver, same rule as a bare per-file marker.
(define
  (repo-waived?)
  (and (path-exists? repo-waiver-path) (not (equal? (string-trim (read-file repo-waiver-path)) ""))))

;; A waiver needs a REASON after the marker, not just the marker. A bare
;; `# skip-workflow-shim:` is the shape a waiver decays into when it is used to
;; silence rather than to explain, so it does not count.
(define
  (waiver-reason line)
  (let ((parts (string-split line waiver-marker)))
    (if (> (length parts) 1) (string-trim (nth 1 parts)) "")))

;; The SHELL waiver is a second, independent marker, and deliberately not the
;; same one. A workflow can be a legitimate hand-authored non-shim (waived for
;; shape) while its shell is still live debt, and vice versa: tend's
;; docker-image.yml is a perfect shim question and a parked Dockerfile heredoc.
;; One marker for both would make each waiver silently grant the other.
;;
;; It exists because parked, documented debt would otherwise sit under the
;; ratchet forever and stop the number ever reaching zero -- and a target that
;; cannot be reached is a target people stop reading. Same grammar as every
;; other fleet waiver, same refusal of a bare marker.
(define shell-waiver-marker "skip-shell-budget:")

(define
  (shell-waiver-reason line)
  (let ((parts (string-split line shell-waiver-marker)))
    (if (> (length parts) 1) (string-trim (nth 1 parts)) "")))

(define
  (shell-waived? text)
  (any?
    (lambda (line)
      (and (string-contains? line shell-waiver-marker)
           (not (equal? (shell-waiver-reason line) ""))))
    (string-split text "\n")))

(define
  (waived? text)
  (any?
    (lambda (line)
      (and (string-contains? line waiver-marker) (not (equal? (waiver-reason line) ""))))
    (string-split text "\n")))

;; -------------------------------------------------------------- ;;
;; Scan                                                            ;;
;; -------------------------------------------------------------- ;;

(define
  (classify path)
  (let ((text (read-file path)))
    (cond
      ((shim? text) 'shim)
      ((waived? text) 'waived)
      ((repo-waived?) 'waived)
      (else 'hand-authored))))

(define
  (main)
  (let*
    ((files (glob paths-glob))
      (verdicts (map (lambda (f) (list f (classify f))) files))
      (offenders (map (lambda (v) (nth 0 v)) (filter (lambda (v) (equal? (nth 1 v) 'hand-authored)) verdicts)))
      (waived-n (length (filter (lambda (v) (equal? (nth 1 v) 'waived)) verdicts)))
      (live-files (filter (fn (f) (not (shell-waived? (read-file f)))) files))
      (shell-total (reduce (fn (a f) (+ a (shell-lines (read-file f)))) 0 live-files))
      (shell-waived-total
        (reduce (fn (a f) (+ a (shell-lines (read-file f)))) 0
                (filter (fn (f) (shell-waived? (read-file f))) files)))
      (over-budget?
        (and (not (equal? shell-budget ""))
             (> shell-total (shim:budget-of shell-budget)))))
    (append-output (string-append "shell-lines=" (string-format "{}" shell-total)))
    (append-output (string-append "shell-waived=" (string-format "{}" shell-waived-total)))
    (log-info
      (string-append "workflow-shim-lint: " (string-format "{}" shell-total)
                     " shell line(s) in `run:` bodies across "
                     (string-format "{}" (length live-files)) " unwaived workflow(s)"
                     (if (> shell-waived-total 0)
                         (string-append "; " (string-format "{}" shell-waived-total)
                                        " more waived with a typed reason")
                         "")
                     (if (equal? shell-budget "") " (budget unset — reported, not enforced)"
                         (string-append " (budget " shell-budget ")"))))
    (when over-budget?
      (log-error
        (string-append "workflow-shim-lint: shell budget EXCEEDED — "
                       (string-format "{}" shell-total) " > " shell-budget
                       ". A workflow is a call with values; move the logic into a "
                       "pleme-io/actions action and call it. The budget ratchets DOWN, "
                       "never up -- lower it when you remove shell, never raise it to "
                       "admit more.")))
    (append-output (string-append "files-scanned=" (string-format "{}" (length files))))
    (append-output (string-append "violations=" (string-format "{}" (length offenders))))
    (append-output (string-append "waived=" (string-format "{}" waived-n)))
    (cond
      ((and (null? offenders) over-budget?) (exit (if fail-on-budget? 1 0)))
      ((null? offenders)
        (log-info
          (string-append
            "workflow-shim-lint: ok — "
            (string-format "{}" (length files))
            " workflow(s), all shims or waived"))
        (exit 0))
      (else
        (log-info
          (string-append
            "workflow-shim-lint: "
            (string-format "{}" (length offenders))
            " hand-authored workflow(s) not routed through a substrate reusable: "
            (string-join ", " offenders)
            ". Either call a catalogued reusable "
            "(see substrate/catalog/workflows.lisp for the 71 available and "
            "what each takes), or waive it with a typed reason: "
            "`# skip-workflow-shim: <reason>`."))
        (cond
          ((and over-budget? fail-on-budget?) (exit 1))
          (fail-on-violation? (exit 1))
          (else (exit 0)))))))


;; TLISP_TEST=1 loads the definitions without running the scan, so the
;; `run.test.tlisp` harness can drive the predicates directly. Same convention
;; as every other action in this repo.
;; (This block was pasted TWICE until 2026-08-14. `main` exits on every path,
;; so the second copy was unreachable rather than a double scan — harmless,
;; and it read as deliberate, which is why it is removed rather than left.)
(if (equal? (env-get "TLISP_TEST" "") "")
  (main)
  (log-info "TLISP_TEST=1 — action loaded; main skipped (the test harness drives it)"))
