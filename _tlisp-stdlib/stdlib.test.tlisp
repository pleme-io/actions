;; _tlisp-stdlib/stdlib.test.tlisp — (deftest …) tests for the shared stdlib's
;; TOML helpers, run by the tlisp-test action via tatara-script --test. The
;; stdlib IS the unit-under-test; it is pure (no main), so no TLISP_TEST gate
;; is needed. These lock in the array-field-as-section + rust-version-substring
;; bugfix that now underpins rust-workspace-bump + rust-workspace-publish +
;; cargo-publish-each-member (all read versions through cargo-workspace-version
;; / toml-read-field).

(deftest "line-is-section-header?: a bracket with no '=' — array fields are NOT headers"
  (assert (line-is-section-header? "[workspace.package]") "real section header")
  (assert (line-is-section-header? "  [package]  ") "trimmed section header")
  (assert (not (line-is-section-header? "keywords = [\"a\", \"b\"]")) "array-valued field is NOT a header")
  (assert (not (line-is-section-header? "version = \"1.0\"")) "plain field is not a header")
  (assert (not (line-is-section-header? "# see [lib] below")) "bracketed COMMENT is NOT a header (kazari 2026-07-21)")
  (assert (not (line-is-section-header? "  # a [b] c")) "trimmed bracketed comment is NOT a header"))

(deftest "line-assigns-field?: exact field name, not a substring"
  (assert (line-assigns-field? "version = \"1.0\"" "version") "version assigns version")
  (assert (line-assigns-field? "  version=\"1.0\"" "version") "tight/trimmed still assigns version")
  (assert (not (line-assigns-field? "rust-version = \"1.89\"" "version")) "rust-version is NOT version"))

(deftest "line-is-named-section?: exact, not subsection or array value"
  (assert (line-is-named-section? "[package]" "[package]") "exact section matches")
  (assert (not (line-is-named-section? "[package.metadata.docs.rs]" "[package]")) "subsection is not [package]")
  (assert (not (line-is-named-section? "keywords = [\"package\"]" "[package]")) "array value is not a section"))

(deftest "extract-quoted-value: double + single quotes"
  (assert (equal? (extract-quoted-value "version = \"1.2.3\"") "1.2.3") "double-quoted value")
  (assert (equal? (extract-quoted-value "name = 'foo'") "foo") "single-quoted value"))

(deftest "toml-read-field reads version past an array field + a rust-version trap"
  (let ((p "/tmp/stdlib-test-cargo.toml"))
    (write-file p "[workspace.package]\nkeywords = [\"x\", \"y\"]\nversion = \"4.5.6\"\nrust-version = \"1.89.0\"\n")
    (assert (equal? (toml-read-field p "[workspace.package]" "version") "4.5.6")
            "reads 4.5.6 despite array field above + rust-version below")))

(deftest "toml-read-field stops at the next section (does not leak across)"
  (let ((p "/tmp/stdlib-test-cargo2.toml"))
    (write-file p "[package]\nname = \"a\"\n\n[dependencies]\nversion = \"9.9.9\"\n")
    (assert (equal? (toml-read-field p "[package]" "version") "")
            "no version in [package] — must not read [dependencies].version")))

(deftest "toml-read-field reads version past a bracketed [package] comment (kazari 2026-07-21)"
  ;; The recurring regression: a legal [package] comment that CONTAINS a bracket
  ;; (e.g. `# … (see [lib] below)`) was mis-read as a new section header, so the
  ;; walker left [package] before reaching `version` → cargo-bump reported
  ;; "package.version not found". The published-name-collision fix (renaming
  ;; kazari → pleme-io-kazari with an explanatory bracketed comment) tripped it.
  (let ((p "/tmp/stdlib-test-cargo3.toml"))
    (write-file p (string-append
                    "[package]\n"
                    "# the lib name stays `kazari` (see [lib] below)\n"
                    "name = \"pleme-io-kazari\"\n"
                    "version = \"0.1.3\"\n"
                    "\n"
                    "[lib]\n"
                    "name = \"kazari\"\n"))
    (assert (equal? (toml-read-field p "[package]" "version") "0.1.3")
            "a [package] comment containing a bracket must not end the section early")))

;; ── publishability preflight — the false-green seal ──────────────
;; A git dep (or a versionless path dep) in a SHIPPED dep table makes a crate
;; permanently unpublishable to crates.io; undetected it defers GREEN forever
;; (sui-spec froze at 0.1.118, 2026-07-21). These lock the DETECTION and, just
;; as load-bearing, the NO-FALSE-POSITIVE cases — a clean manifest MUST pass or
;; wiring the preflight into the publish action would red-fail real publishes.

(deftest "manifest-publish-blockers: detects a git dep in a shipped table (the sui-spec bug)"
  (assert (not (manifest-publishable?
                 "[package]\nname = \"sui-spec\"\n\n[dependencies]\nkazari = { git = \"https://github.com/pleme-io/kazari\", rev = \"abc\" }\nserde = \"1\"\n"))
          "a [dependencies] git dep is a blocker")
  (assert (= 1 (length (manifest-publish-blockers
                         "[package]\n[dependencies]\nkazari = { git = \"https://x\" }\n")))
          "exactly one blocker for one git dep"))

(deftest "manifest-publish-blockers: detects a versionless path dep in a shipped table"
  (assert (not (manifest-publishable?
                 "[package]\n[dependencies]\nfoo = { path = \"../foo\" }\n"))
          "a path dep with no version is a blocker")
  (assert (manifest-publishable?
            "[package]\n[dependencies]\nfoo = { path = \"../foo\", version = \"0.1\" }\n")
          "a path dep WITH a version is fine (a common publish pattern)"))

(deftest "manifest-publish-blockers: dev-dependencies are EXEMT (stripped on publish)"
  (assert (manifest-publishable?
            "[package]\nname = \"x\"\n\n[dependencies]\nserde = \"1\"\n\n[dev-dependencies]\nhelper = { git = \"https://x\" }\n")
          "a git dev-dependency does NOT block publish"))

(deftest "manifest-publish-blockers: NO false positives on a clean real-shaped manifest"
  ;; version deps, a workspace dep, repository= in [package], a bracketed
  ;; comment, a target table, a [lib] — all clean. MUST be publishable.
  (assert (manifest-publishable?
            (string-append
              "[package]\n"
              "name = \"pleme-io-kazari\"\n"
              "# the lib name stays `kazari` (see [lib] below)\n"
              "version = \"0.1.3\"\n"
              "repository = \"https://github.com/pleme-io/kazari\"\n"
              "\n"
              "[lib]\nname = \"kazari\"\n"
              "\n"
              "[dependencies]\n"
              "irodori = \"0.2\"\n"
              "serde = { version = \"1\", features = [\"derive\"] }\n"
              "sui-compat.workspace = true\n"
              "\n"
              "[target.'cfg(unix)'.dependencies]\n"
              "libc = \"0.2\"\n"
              "\n"
              "[dev-dependencies]\n"
              "tempfile = \"3\"\n"))
          "a clean manifest with version/workspace/target deps must NOT be flagged"))

(deftest "manifest-publish-blockers: target dep tables ship (a git dep there IS caught)"
  (assert (not (manifest-publishable?
                 "[package]\n[target.'cfg(unix)'.dependencies]\nfoo = { git = \"https://x\" }\n"))
          "a git dep in a [target.*.dependencies] table blocks")
  (assert (manifest-publishable?
            "[package]\n[target.'cfg(unix)'.dev-dependencies]\nfoo = { git = \"https://x\" }\n")
          "but a [target.*.dev-dependencies] git dep is exempt"))

(deftest "manifest-publish-blockers: a comment mentioning git is not a blocker"
  (assert (manifest-publishable?
            "[package]\n[dependencies]\n# clone via git = \"…\" during dev only\nserde = \"1\"\n")
          "a comment that mentions git= must not be read as a git dep"))

;; ── semver: numeric version algebra + the release-monotonicity invariant ──
;; These lock in the fix for the backward-release class (937-repo census,
;; 2026-07-27: 527 inverted tag pairs; engenho v0.53.0 -> v0.1.5 across 307
;; linear commits). Each test below is written so that REMOVING the fix makes
;; it fail — the ranking tests fail under any string comparison, and the
;; monotonicity tests fail under the old "is the exact tag free?" question.

(deftest "semver:parse — strict; only a bare X.Y.Z ranks"
  (assert (semver:valid? "0.1.0") "bare three-segment parses")
  (assert (semver:valid? "10.20.30") "multi-digit segments parse")
  (assert (not (semver:valid? "v1")) "a moving action ref does not rank")
  (assert (not (semver:valid? "0.2")) "a two-segment version does not rank")
  (assert (not (semver:valid? "0.8.18-pleme.1")) "a pre-release does not rank")
  (assert (not (semver:valid? "0.2-full-api")) "a labelled tag does not rank")
  (assert (not (semver:valid? "0.1.rc")) "a non-numeric segment does not rank")
  (assert (not (semver:valid? "")) "empty does not rank (read-string would raise)"))

(deftest "semver:gt? — NUMERIC, not lexical; 0.10.0 beats 0.9.0"
  ;; The load-bearing case. Every string comparison — and `sort` without
  ;; -V — gets this backwards, which is why the comparison is hand-written.
  (assert (semver:gt? "0.10.0" "0.9.0") "0.10.0 > 0.9.0 numerically")
  (assert (not (semver:gt? "0.9.0" "0.10.0")) "and 0.9.0 is NOT > 0.10.0")
  (assert (semver:gt? "1.0.0" "0.99.99") "major dominates")
  (assert (semver:gt? "0.3.0" "0.2.99") "minor dominates patch")
  (assert (semver:gt? "0.2.10" "0.2.9") "patch compares numerically too")
  (assert (not (semver:gt? "0.2.5" "0.2.5")) "equal is not greater")
  (assert (not (semver:gt? "junk" "0.1.0")) "an unrankable side is never greater")
  (assert (not (semver:gt? "0.1.0" "junk")) "…in either position (fail-closed)"))

(deftest "semver:max — highest, skipping everything unrankable"
  (assert (equal? (semver:max (list "0.2.5" "0.10.0" "0.9.0")) "0.10.0")
          "numeric max, not lexical")
  (assert (equal? (semver:max (list "v1" "0.2-full-api" "0.1.0")) "0.1.0")
          "unrankable entries are skipped, not coerced")
  (assert (equal? (semver:max (list "v1" "junk")) "")
          "no rankable entry means no max")
  (assert (equal? (semver:max '()) "") "empty list means no max"))

(deftest "string-prefix? / string-strip-prefix"
  (assert (string-prefix? "v0.3.1" "v") "v-prefixed tag")
  (assert (not (string-prefix? "guardrail-v1.2.3" "v"))
          "a component-scoped tag is NOT v-prefixed — it must not gate the root")
  (assert (not (string-prefix? "macos-universal-r24-abc" "v")) "nor an AUTOBUMP image tag")
  (assert (equal? (string-strip-prefix "v0.3.1" "v") "0.3.1") "strips the prefix")
  (assert (equal? (string-strip-prefix "vv1.0.0" "v") "v1.0.0")
          "strips ONE prefix only — a later occurrence survives")
  (assert (equal? (string-strip-prefix "0.3.1" "v") "0.3.1") "no prefix, unchanged"))

(deftest "git:max-released-version's filter over REAL fleet tag shapes"
  ;; The exact 264-of-2886 non-bare tag shapes measured across the 662
  ;; substrate-consuming repos. None of them may outrank a real release.
  (let ((tags (list "v0.2.5" "v0.3.0" "v0.3.1" "v1"
                    "macos-universal-r24-6ee9574a2add" "guardrail-v9.9.9"
                    "otel/v9.9.9" "v0.2-full-api" "v0.8.18-pleme.1")))
    (assert (equal? (semver:max
                      (map (lambda (t) (string-strip-prefix t "v"))
                           (filter (lambda (t) (string-prefix? t "v")) tags)))
                    "0.3.1")
            "only bare vX.Y.Z tags rank; guardrail-v9.9.9 must NOT win")))

(deftest "semver:release-monotone? — THE invariant (red under the old question)"
  ;; The engenho-shaped regression: 0.2.6 is a FREE tag, so the old
  ;; "is this exact tag taken?" check waved it through while v0.3.1 existed.
  (assert (not (semver:release-monotone? "0.2.6" "0.3.1"))
          "a free-but-BELOW-max version is refused — the whole point")
  (assert (semver:release-monotone? "0.3.2" "0.3.1") "above the max passes")
  (assert (not (semver:release-monotone? "0.3.1" "0.3.1")) "equal is not above")
  (assert (semver:release-monotone? "0.1.0" "")
          "first release: nothing to regress below, vacuous by definition")
  (assert (not (semver:release-monotone? "0.9.0" "0.10.0"))
          "and the numeric case — 0.9.0 after 0.10.0 is a regression")
  (assert (not (semver:release-monotone? "1.0.0-rc1" "0.1.0"))
          "an unrankable release is refused, never assumed fine"))

(deftest "semver:bump-seed — seed from the MAX, not the manifest alone"
  (assert (equal? (semver:bump-seed "0.2.5" "0.3.1") "0.3.1")
          "manifest lags the tags -> seed from the tags (the STEP-2 fix)")
  (assert (equal? (semver:bump-seed "0.4.0" "0.3.1") "0.4.0")
          "manifest ahead of the tags -> seed from the manifest")
  (assert (equal? (semver:bump-seed "0.2.5" "") "0.2.5")
          "no released version -> the manifest is all there is")
  (assert (equal? (semver:bump-seed "0.1.0" "0.1.0") "0.1.0") "in sync -> unchanged")
  (assert (equal? (semver:bump-seed "not-a-version" "0.3.1") "0.3.1")
          "an unreadable manifest version cannot outrank a real release"))

(deftest "semver:bump — LENIENT arithmetic, byte-identical to the shipped behavior"
  (assert (equal? (semver:bump "0.2.3" "patch") "0.2.4") "patch")
  (assert (equal? (semver:bump "0.2.9" "patch") "0.2.10") "patch crosses two digits")
  (assert (equal? (semver:bump "1.4.7" "minor") "1.5.0") "minor resets patch")
  (assert (equal? (semver:bump "1.4.7" "major") "2.0.0") "major resets both")
  (assert (equal? (semver:bump "0.2.3" "nonsense") "") "unknown type is an empty failure")
  (assert (equal? (semver:bump "1.2" "patch") "1.2.1")
          "a missing segment reads 0 — LENIENT on purpose, unlike semver:parse"))

(deftest "seed-then-bump composes into a monotone release (the STEP-1+STEP-2 tie)"
  ;; The end-to-end algebra: the skew fixture (manifest 0.2.5, tags to
  ;; v0.3.1) must produce 0.3.2, and that result must satisfy the gate.
  (let* ((seed (semver:bump-seed "0.2.5" "0.3.1"))
         (next (semver:bump seed "patch")))
    (assert (equal? next "0.3.2") "0.2.5 seeded to 0.3.1 patch-bumps to 0.3.2")
    (assert (semver:release-monotone? next "0.3.1")
            "and the seeded result passes the gate the old result failed")))
