;; shadow-gate.test.tlisp — no action may redefine a stdlib name it does not
;; own.
;;
;; WHY THIS EXISTS. action.yml files build their script as
;; `stdlib.tlisp` ++ `<action>/run.tlisp`, so a `define` in run.tlisp of a name
;; the stdlib already defines is evaluated SECOND and WINS. Every caller of that
;; name — including stdlib functions that call it internally — silently gets the
;; local version.
;;
;; This has now bitten twice, in the same file:
;;
;;   2026-07-17  cargo-publish-crate carried its own publish-failure predicates.
;;               The set had no 403/conflict arm, so a crates.io "you don't seem
;;               to be an owner" fell through to the catch-all and reported "no
;;               recognizable retry signature" — hiding the actual remedy.
;;               pleme-io/tear sat red for a week, hourly.
;;
;;   2026-07-30  the same file carried `line-is-section-header?` as
;;               `(string-contains? line "[")` — ANY line with a bracket. The
;;               stdlib's strict version had already been fixed for exactly this
;;               (num-traits; kazari 2026-07-21). The shadow broke BOTH the
;;               publish=false preflight (mado: `categories = [...]` above
;;               `publish`) and `read-field` itself (lava: `authors = [...]`
;;               above `name` -> "package.name not found in Cargo.toml"). Both
;;               repos red-failed their releases.
;;
;; Twice is a class, not an accident. The remedy each time was the same: delete
;; the local copy and let the stdlib's win. This gate makes the third occurrence
;; impossible to land silently.
;;
;; TIER: test failure, not a compile error — tlisp has no notion of a sealed
;; namespace, so this is the honest CI-caught floor, not unrepresentability.

;; ── the allowlist ────────────────────────────────────────────────────────
;;
;; A name here is a DELIBERATE local specialization. Each entry states why.
;; Adding a row is the decision point: if the local copy merely restates the
;; stdlib, delete it instead of allowlisting it.
;; TWO lists, deliberately. Collapsing them into one would let genuine
;; duplication hide behind the word "permitted".
(define
  intentional-shadows
  (list
    ;; gem-publish parses Ruby `VERSION = "0.1.0"` / `VERSION = '0.1.0'` /
    ;; frozen-string-literal forms. Genuinely a different grammar from the
    ;; TOML-oriented stdlib helper, not a restatement of it.
    (list "gem-publish" "extract-quoted-value")
    ;; Per-registry liveness probes. Each hits a different API and shares only
    ;; a naming shape with its siblings; there is no stdlib implementation
    ;; these could delegate to.
    (list "helm-publish" "helm-published?")
    (list "npm-publish" "npm-published?")
    (list "python-publish" "pypi-published?")
    ;; `append-output` MEASURABLY differs: the stdlib's no-ops when its own
    ;; `stdlib:gh-output` is empty, while these bind their own `gh-output` via
    ;; `env-required` so a missing GITHUB_OUTPUT fails loudly instead of
    ;; silently discarding every output. That is the better behaviour for an
    ;; action whose whole job is to emit outputs, so it stays.
    (list "ansible-collection-build" "append-output")
    (list "cargo-publish-crate" "append-output")
    (list "derive-version-from-tag" "append-output")
    (list "detect-repo-type" "append-output")
    (list "git-commit-tag" "append-output")
    (list "rust-workspace-bump" "append-output")
    (list "spec-watch" "append-output")
    (list "substrate-bump" "append-output")))

;; KNOWN DEBT, not approval. Each of these is byte-identical to the stdlib
;; form it shadows (verified 2026-07-30 by normalizing whitespace and comments
;; and comparing). An exact copy is harmless right up until one side is fixed
;; and the other is not — which is exactly how `line-is-section-header?`
;; became a live bug that red-failed mado and lava. They are baselined here so
;; the gate can block NEW shadows today rather than waiting on a sweep of
;; eight actions I have not exercised. The fix for every row is deletion.
;;
;; cargo-publish-crate's four were deleted rather than listed, since that file
;; was the one already being repaired.
(define
  baselined-duplicate-shadows
  (list
    (list "rust-workspace-bump" "status-of")
    (list "rust-workspace-bump" "stdout-of")
    (list "rust-workspace-bump" "last-tag")
    (list "substrate-bump" "extract-quoted-value")))

(define permitted-shadows (append intentional-shadows baselined-duplicate-shadows))

(define
  (shadow-permitted? action name)
  (any?
    (fn (row) (and (equal? (car row) action) (equal? (car (cdr row)) name)))
    permitted-shadows))

;; ── name extraction ──────────────────────────────────────────────────────
;;
;; Two shapes have to be handled, and a naive line scan gets both wrong:
;;
;;   (define (name args...)        ← same line
;;   (define\n  (name args...)     ← the DOMINANT form in this corpus
;;
;; and `(define` also appears inside comments, which must not count. So:
;; drop comment lines first, join what is left into one stream, split on
;; `(define`, and take each chunk's leading identifier.

(define
  (comment-line? line)
  (string-starts-with? (string-trim line) ";"))

(define
  (strip-comments text)
  (string-join " " (filter (fn (l) (not (comment-line? l))) (string-split text "\n"))))

(define
  (first-field s sep)
  (let* ((parts (string-split s sep))) (if (null? parts) s (car parts))))

(define
  (leading-token chunk)
  ;; The chunk begins immediately after `(define`. Its head is either
  ;; `  (name args…` or `  name`, so drop a leading `(` then cut at the first
  ;; delimiter.
  (let*
    ((t (string-trim chunk))
      (afterparen
        (if
          (string-starts-with? t "(")
          (let* ((ps (string-split t "("))) (if (< (length ps) 2) t (car (cdr ps))))
          t)))
    (first-field (first-field (first-field (string-trim afterparen) " ") ")") "(")))

(define
  (names-defined-in text)
  (let*
    ((chunks (string-split (strip-comments text) "(define")))
    (filter
      (fn (n) (not (equal? n "")))
      (map leading-token (if (null? chunks) chunks (cdr chunks))))))

(define
  (dedup lst)
  ;; No `sort`/`uniq-sorted` in this dialect; order does not matter here since
  ;; every consumer is a membership test or a joined message.
  (cond
    ((null? lst) lst)
    ((member? (car lst) (cdr lst)) (dedup (cdr lst)))
    (else (cons (car lst) (dedup (cdr lst))))))

;; ── the corpus ───────────────────────────────────────────────────────────

(define stdlib-text (read-file "_tlisp-stdlib/stdlib.tlisp"))

(define stdlib-names (dedup (names-defined-in stdlib-text)))

(define
  action-dirs
  (filter
    (fn (d)
      (and
        (is-dir? d)
        (not (string-starts-with? (path-basename d) "_"))
        (not (string-starts-with? (path-basename d) "."))
        (path-exists? (path-join d "run.tlisp"))))
    (ls ".")))

(define
  (shadows-in dir)
  ;; Every stdlib name this action redefines without an allowlist row.
  (let*
    ((action (path-basename dir))
      (locals (dedup (names-defined-in (read-file (path-join dir "run.tlisp"))))))
    (map
      (fn (n) (string-append action " :: " n))
      (filter
        (fn (n) (and (member? n stdlib-names) (not (shadow-permitted? action n))))
        locals))))
