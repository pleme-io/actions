(define (words s)
  (filter (lambda (w) (not (equal? w ""))) (string-split (string-replace (string-trim s) "\n" " ") " ")))

(define (resolve-mode mode open-pr)
  (let ((m (string-trim mode)))
    (cond
      ((equal? m "") (if (equal? (string-trim open-pr) "true") "pr" "none"))
      ((or (equal? m "push") (equal? m "pr") (equal? m "none")) m)
      (else ""))))

(define (update-argv inputs) (append (list "nix" "flake" "update") (words inputs)))

(define (verify-argv ref) (list "nix" "build" "--no-link" ref))

(define (first-failing-ref refs build)
  (cond
    ((null? refs) "")
    ((= (build (car refs)) 0) (first-failing-ref (cdr refs) build))
    (else (car refs))))

(define (commit-argv name email message)
  (append
    (list "git")
    (if (equal? name "") (list) (list "-c" (string-append "user.name=" name) "-c" (string-append "user.email=" email)))
    (list "commit" "-m" message)))

(define (push-argv branch) (list "git" "push" "origin" (string-append "HEAD:refs/heads/" branch)))

(define (pr-push-argv branch) (list "git" "push" "--force" "origin" (string-append "HEAD:refs/heads/" branch)))

(define (pr-create-argv repo base head message)
  (list "gh" "pr" "create"
    "--repo" repo
    "--base" base
    "--head" head
    "--title" message
    "--body" "nix flake update, verified before publishing by pleme-io/actions/nix-flake-update."))

(define (pr-view-argv repo head) (list "gh" "pr" "view" head "--repo" repo "--json" "url" "--jq" ".url"))

(define (verdict mode changed verified pushed sha pr reason code)
  (list mode changed verified pushed sha pr reason code))

(define (emit v)
  (append-output (string-append "mode=" (nth 0 v)))
  (append-output (string-append "changed=" (nth 1 v)))
  (append-output (string-append "verified=" (nth 2 v)))
  (append-output (string-append "pushed=" (nth 3 v)))
  (append-output (string-append "commit-sha=" (nth 4 v)))
  (append-output (string-append "pr-url=" (nth 5 v)))
  (append-output (string-append "reason=" (nth 6 v)))
  (nth 7 v))

(define (build-status ref)
  (log-info (string-append "==> nix " (string-join " " (cdr (verify-argv ref)))))
  (apply exec-check (verify-argv ref)))

(define (commit-lock name email message)
  (cond ((equal? name "") (configure-git-bot)) (else #f))
  (exec-or-die (list "git" "add" "flake.lock"))
  (exec-or-die (commit-argv name email message))
  (string-trim (stdout-of (exec-capture "git" "rev-parse" "HEAD"))))

(define (publish-push mode branch sha)
  (cond
    ((= (apply exec-check (push-argv branch)) 0)
      (log-info (string-append "pushed " sha " to " branch))
      (verdict mode "true" "true" "true" sha "" "published" 0))
    (else
      (log-error (string-append "push to " branch " was rejected; origin moved during the update, the next run retries"))
      (verdict mode "true" "true" "false" sha "" "push-rejected" 1))))

(define (publish-pr mode repo base head message sha)
  (exec-or-die (pr-push-argv head))
  (let ((created (apply exec-capture (pr-create-argv repo base head message))))
    (cond
      ((= (status-of created) 0)
        (verdict mode "true" "true" "true" sha (string-trim (stdout-of created)) "published" 0))
      (else
        (let ((existing (apply exec-capture (pr-view-argv repo head))))
          (cond
            ((= (status-of existing) 0)
              (verdict mode "true" "true" "true" sha (string-trim (stdout-of existing)) "published" 0))
            (else
              (log-error (string-append "gh pr create failed: " (string-trim (stderr-of created))))
              (verdict mode "true" "true" "true" sha "" "pr-failed" 1))))))))

(define (main)
  (let ((mode (resolve-mode (env-get "MODE" "") (env-get "OPEN_PR" "true"))))
    (cond
      ((equal? mode "")
        (log-error (string-append "mode must be push, pr or none, got: " (env-get "MODE" "")))
        (verdict "" "false" "" "false" "" "" "bad-mode" 2))
      ((not (path-exists? "flake.nix"))
        (log-error "no flake.nix at repo root")
        (verdict mode "false" "" "false" "" "" "update-failed" 1))
      (else
        (let ((r (apply exec-capture (update-argv (env-get "INPUTS_TO_UPDATE" "")))))
          (cond
            ((not (= (status-of r) 0))
              (log-error "nix flake update failed")
              (log-info (stderr-of r))
              (verdict mode "false" "" "false" "" "" "update-failed" (status-of r)))
            ((= (exec-check "git" "diff" "--quiet" "flake.lock") 0)
              (log-info "flake.lock unchanged")
              (verdict mode "false" "" "false" "" "" "unchanged" 0))
            (else
              (let ((failed (first-failing-ref (words (env-get "VERIFY" "")) build-status)))
                (cond
                  ((not (equal? failed ""))
                    (log-error (string-append "verify ref failed to build against the new lock, nothing published: " failed))
                    (verdict mode "true" "false" "false" "" "" "verify-failed" 1))
                  ((equal? mode "none")
                    (log-info "flake.lock changed and verified; mode none publishes nothing")
                    (verdict mode "true" "true" "false" "" "" "report-only" 0))
                  (else
                    (let ((sha (commit-lock (env-get "AUTHOR_NAME" "") (env-get "AUTHOR_EMAIL" "") (env-get "COMMIT_MESSAGE" "flake: nix flake update")))
                          (branch (env-get "TARGET_BRANCH" "main")))
                      (cond
                        ((equal? mode "push") (publish-push mode branch sha))
                        (else
                          (publish-pr mode (env-required "REPO") branch (env-get "PR_BRANCH" "chore/flake-lock-update") (env-get "COMMIT_MESSAGE" "flake: nix flake update") sha))))))))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1") (log-info "TLISP_TEST=1 — nix-flake-update helpers loaded; main skipped"))
  (else (exit (emit (main)))))
