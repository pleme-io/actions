;; cargo-bump/run.tlisp — bump a single-crate Rust repo's
;; package.version field.
;;
;; Uses pleme-io/actions/_tlisp-stdlib helpers (prepended by
;; action.yml's loader step):
;;   append-output, status-of, cargo-package-version,
;;   last-tag, has-changes-since?, config-resolve.
;;
;; All inputs resolve via 3-tier precedence:
;;   env-var (workflow input) > .pleme-io-release.toml [bump] > hardcoded default

(define bump-type (config-resolve "BUMP_TYPE" "bump" "default-type" "patch"))

(define skip-flag
  (config-resolve
    "SKIP_WHEN_NO_SOURCE_CHANGES"
    "bump"
    "skip-when-no-source-changes"
    "true"))

(define source-paths
  (config-resolve
    "SOURCE_PATHS"
    "bump"
    "source-paths"
    "src Cargo.toml Cargo.lock"))

(define regenerate-cargo-nix
  (config-resolve
    "REGENERATE_CARGO_NIX"
    "bump"
    "regenerate-cargo-nix"
    "true"))

(define (should-bump?)
  (cond ((not (equal? skip-flag "true")) #t) (else (has-changes-since? (last-tag) source-paths))))

;; ── Release monotonicity ──────────────────────────────────────────────
;;
;; `cargo set-version --bump <type>` seeds from the MANIFEST and knows
;; nothing about tags — strictly worse than rust-workspace-bump, which at
;; least probed for a collision. So when a manifest lags its tags, this
;; action bumps into territory the repo already passed and the published
;; version walks BACKWARD (937-repo census, 2026-07-27: 527 inverted tag
;; pairs on linear history; pleme-io's own bumpers produced 4).
;;
;; The fix keeps `--bump` on the healthy path and only takes over when the
;; manifest actually lags: `semver:bump-seed` returns the manifest version
;; unchanged whenever it is at or above the highest release, so a repo in
;; the normal state runs the exact command it ran before, byte for byte.
;; A lagging repo instead gets an EXPLICIT `cargo set-version <target>`
;; computed from the tags. Either way `cargo set-version` — not a hand
;; rewrite — does the writing, so its dependent-requirement updates are
;; preserved.
(define (bump-target old-v max-v type)
  (cond
    ((equal? (semver:bump-seed old-v max-v) old-v) "")
    ;; "" = use --bump
    (else (semver:bump (semver:bump-seed old-v max-v) type))))

;; Returns the WHOLE exec result, not `status-of` it.
;;
;; It returned only the exit code until 2026-08-14, and the cost was measured:
;; a fleet CI sweep found 74 repos red on `ERROR cargo set-version failed`
;; with cargo's own message nowhere in the log — captured by `exec-capture`
;; and dropped one line later. Every one of those runs was undiagnosable
;; without re-running the command by hand, which is the same defect class the
;; kotae doctrine names: a failure that says THAT it failed and not WHICH
;; thing failed.
(define (do-bump target)
  (cond
    ((equal? target "") (exec-capture "cargo" "set-version" "--bump" bump-type))
    (else
      (log-info
        (string-append
          "manifest lags the tags — setting the version explicitly to "
          target
          " instead of bumping from the manifest"))
      (exec-capture "cargo" "set-version" target))))

;; PINNED, not master: the regenerated Cargo.nix's embedded runtime template
;; must match what the fleet's builders consume. An unpinned regen silently
;; tracked crate2nix master past the 0.15.0 tag (new template + dev-dep
;; folding) and produced Cargo.nix files whose nix builds fail fleet-wide
;; with E0463 can't-find-crate while cargo/CI stayed green (mado v0.1.49,
;; 2026-07-02). This rev is the fleet flake pin; bumping it is a deliberate
;; PR that re-verifies `nix build` on a consumer, never an ambient drift.
(define crate2nix-pinned-rev "c994c83963b42b26f127e9cc50a8c86852db67d0")

;; Returns the FULL capture result (not just the status) so a non-zero
;; regen can surface its stdout+stderr. Discarding that output is what
;; made this failure class undiagnosable: 22 repos went red with
;; "crate2nix generate failed" and no reason attached, so the true
;; sub-split (isolated-resolve vs a private git dep vs a real break)
;; could not be read off the logs at all.
(define (do-regen)
  (exec-capture "nix"
    "run"
    (string-append "github:nix-community/crate2nix/" crate2nix-pinned-rev)
    "--" "generate"))

;; A repo only owes a Cargo.nix if it SHIPS one. Regenerating (and
;; failing on) an artifact the repo does not carry is a fabricated
;; requirement — the presence gate is the same shape stdlib's
;; `ensure-gen-lock-fresh` uses for Cargo.gen.lock (stdlib.tlisp:194).
(define (repo-ships-cargo-nix?) (path-exists? "Cargo.nix"))

(define (emit-skip msg old-v)
  (log-info msg)
  (append-output (string-append "old-version=" old-v))
  (append-output "bumped=false")
  (append-output "new-version="))

(define (emit-success old-v new-v)
  (log-info (string-append "bumped: " old-v " -> " new-v))
  (append-output (string-append "old-version=" old-v))
  (append-output "bumped=true")
  (append-output (string-append "new-version=" new-v)))

(define (emit-failure msg old-v)
  (log-error msg)
  (append-output (string-append "old-version=" old-v))
  (append-output "bumped=false")
  (append-output "new-version="))

(define (post-bump-checks old-v)
  (exec-capture "cargo" "update")
  ;; D2 gate (stdlib ensure-gen-lock-fresh): delta-only repos must leave
  ;; with Cargo.gen.lock sha-tied to the rewritten Cargo.lock, else every
  ;; consumer flake eval dies on the lockfile-delta STALE throw. FATAL
  ;; when regen can't restore the tie.
  (cond
    ((not (ensure-gen-lock-fresh))
      (emit-failure
        "Cargo.gen.lock stale after bump and `gen build` could not restore the D2 tie"
        old-v)
      1)
    (else
      (let ((new-v (cargo-package-version)))
        (cond
          ((equal? new-v old-v)
            (emit-failure (string-append "version unchanged after bump: " old-v) old-v)
            1)
          ;; POST-CONDITION. The seed above already makes a below-max
          ;; version unnameable, so this asserts rather than mechanises —
          ;; but `cargo set-version` is a foreign binary, and this is the
          ;; only place its ACTUAL output is checked against the invariant.
          ((not (semver:release-monotone? new-v (git:max-released-version "v")))
            (emit-failure
              (string-append
                "cargo set-version produced "
                new-v
                ", which is not above the highest released version v"
                (git:max-released-version "v")
                " — refusing to release backward (release-monotonicity)")
              old-v)
            1)
          (else (emit-success old-v new-v) 0))))))

(define (run-bump-pipeline old-v)
  (log-info (string-append "bumping " bump-type " from " old-v))
  (let* ((bump-result (do-bump (bump-target old-v (git:max-released-version "v") bump-type)))
         (bump-status (status-of bump-result)))
    (cond
      ((not (= bump-status 0))
        ;; Say WHICH failure this was. cargo writes its diagnosis to stderr
        ;; (and occasionally stdout); both are already in hand, and the run
        ;; is over — there is no cost to printing them and a measured cost to
        ;; not. Guarded so an empty capture does not print a bare label.
        (cond
          ((not (equal? (stderr-of bump-result) ""))
            (log-error (string-append "cargo set-version stderr: " (stderr-of bump-result)))))
        (cond
          ((not (equal? (stdout-of bump-result) ""))
            (log-error (string-append "cargo set-version stdout: " (stdout-of bump-result)))))
        ;; The exit code is NOT interpolated here: tatara-lisp has no
        ;; `number->string` (only the keyword/symbol/string conversions), so
        ;; the obvious spelling would have thrown at runtime — on the error
        ;; path, which is exactly where a test is least likely to reach it.
        ;; The code is already on the runner's own `##[error]Process completed
        ;; with exit code N` line; the stderr above is what was missing.
        (emit-failure "cargo set-version failed — see stderr above" old-v)
        bump-status)
      ((not (equal? regenerate-cargo-nix "true"))
        (log-info "regenerate-cargo-nix=false — skipping crate2nix step")
        (post-bump-checks old-v))
      ((not (repo-ships-cargo-nix?))
        ;; Presence gate: no Cargo.nix in the repo ⇒ nothing to regenerate.
        (log-info "no Cargo.nix in repo — skipping crate2nix step")
        (post-bump-checks old-v))
      (else
        (log-info "regenerating Cargo.nix")
        ;; Best-effort artifact regen — NON-FATAL, exactly as
        ;; `rust-workspace-bump/run.tlisp:182-190` already does for the
        ;; identical reason: a workspace with cross-repo path or
        ;; unpublished/private git deps cannot resolve on an isolated
        ;; runner, so its Cargo.nix is regenerated locally (siblings
        ;; present) and committed. Treating that as FATAL failed the
        ;; whole bump — and therefore the whole release — for 22 repos
        ;; whose only sin was not being isolated-resolvable.
        ;;
        ;; The D2 gate in `post-bump-checks` stays FATAL: a STALE
        ;; committed artifact is a real, verifiable defect, whereas an
        ;; un-regenerable one is an environment limit.
        (let ((regen (do-regen)))
          (if (= (status-of regen) 0)
            (log-info "Cargo.nix regenerated")
            (begin
              ;; Surface the reason — never swallow it. This is the one
              ;; place the true sub-split becomes readable.
              (log-info
                "Cargo.nix regen skipped (workspace not isolated-resolvable; regen + commit locally)")
              (log-info (string-append "crate2nix stdout: " (stdout-of regen)))
              (log-info (string-append "crate2nix stderr: " (stderr-of regen)))))
          (post-bump-checks old-v))))))

(define (main)
  (let ((old-version (cargo-package-version)))
    (cond
      ((not (path-exists? "Cargo.toml"))
        (emit-failure
          "cargo-bump: no Cargo.toml in the working directory — if this crate is not at the repo root, set the action's `crate-path` input (e.g. crate-path: cli)"
          "")
        (exit 1))
      ((equal? old-version "")
        (emit-failure
          "cargo-bump: package.version not found (workspace? use rust-workspace-bump)"
          "")
        (exit 1))
      ((not (should-bump?))
        (emit-skip
          (string-append
            "no changes since last tag — skipping (at "
            old-version
            ")")
          old-version)
        (exit 0))
      (else (exit (run-bump-pipeline old-version))))))

;; Gated on TLISP_TEST so the tlisp-test harness can load this unit and
;; drive bump-target with a mock tag set without running the real bump
;; (which needs a Cargo.toml, cargo-edit, and git tags). Same shape as
;; rust-workspace-bump.
(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — bump fns loaded; main skipped (the test harness drives them)"))
  (else (main)))
