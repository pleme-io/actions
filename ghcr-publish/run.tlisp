;; ghcr-publish/run.tlisp — push a nix OCI image tarball to a private
;; registry (ghcr.io/pleme-io/<svc>) under the ★ AUTOBUMP exact tag.
;;
;; AUTOBUMP (org directive ★★ AUTO-RELEASE → "never :latest"): every push
;; emits a SORTABLE, EXACT, IMMUTABLE tag `<arch>-r<run>-<sha>` — r<run> is
;; the numeric sort key a Flux ImagePolicy extracts (^<arch>-r(?P<n>\d+)-),
;; <sha> is the trace. A moving `<arch>-latest` MAY also be pushed as a HUMAN
;; pointer, but is NEVER a deploy source.
;;
;; Wrapper over skopeo (baked into the tatara-script base image). Auth is a
;; PRE-CONDITION: docker/login-action must have authenticated the target
;; registry first (skopeo reads ~/.docker/config.json).
;;
;; Tier-honest: the tag algebra + ref composition are pure + unit-tested (now);
;; a real PRIVATE-ghcr push needs registry creds supplied by the workflow
;; (LiveTODO on the credential wiring, not on this action's logic).
;;
;; Uses stdlib helpers: append-output, status-of.
;;
;; Inputs (env):
;;   REPO          full image base "ghcr.io/pleme-io/<svc>" (no tag)
;;                 (fallback: REGISTRY + IMAGE)
;;   REGISTRY      default "ghcr.io"      (used iff REPO empty)
;;   IMAGE         path "pleme-io/<svc>"  (used iff REPO empty)
;;   ARCH          default "amd64"
;;   RUN_NUMBER    github.run_number      (numeric sort key)
;;   SHA           github.sha             (trace)
;;   TARBALL       docker-archive path    (default "./result")
;;   MOVING_LATEST "true"|"false"         (default "true") — also push <arch>-latest
;;
;; Outputs:
;;   tag / ref / ref-amd64 / ref-arm64 / pushed / result

;; ── pure helpers (unit-tested via run.test.tlisp) ────────────────
(define (autobump-tag arch run sha) (string-append arch "-r" run "-" sha))

(define (moving-tag arch) (string-append arch "-latest"))

(define
  (image-base repo registry image)
  (cond ((not (equal? repo "")) repo) (else (string-append registry "/" image))))

(define (target-ref base tag) (string-append base ":" tag))

;; ── doca wrappers (replacing skopeo) ─────────────────────────────
;;
;; Reading a Nix-produced `docker-archive` tarball and pushing it IS doca's
;; primary job (oci-push's own module doc), so `push` replaces
;; `skopeo copy docker-archive: docker://` one-for-one rather than
;; approximating it.
;;
;; AUTH IS UNCHANGED for every caller: doca resolves credentials from the
;; ambient docker config (`docker_config_credentials`, which tries the bare
;; host, both schemed spellings, and docker-hub's legacy index key), exactly
;; as skopeo did. This action never took user/pass inputs and still doesn't --
;; the calling workflow's existing login step keeps working untouched.
;;
;; The one shape difference: skopeo took ONE composed `<registry>/<image>:<tag>`
;; ref; doca wants --registry/--image/--tag separately. `oci:split-registry` /
;; `oci:split-image` in the stdlib are the shared splitters (every branch of
;; oci:compose-base yields host[:port]/path..., so splitting on the FIRST "/"
;; is safe).
(define
  (doca-push-archive tarball base tag)
  (status-of
    (apply
      exec-capture
      (append
        (oci:doca-argv "push")
        (list
          "--tarball" tarball
          "--registry" (oci:split-registry base)
          "--image" (oci:split-image base)
          "--tag" tag)))))

;; Registry -> registry. doca's `transfer` takes whole refs (no docker:// scheme
;; prefix -- that was skopeo's transport syntax, not part of the reference).
(define
  (doca-transfer src-ref dst-ref)
  (status-of
    (apply
      exec-capture
      (append (oci:doca-argv "transfer") (list "--src" src-ref "--dest" dst-ref)))))

(define
  (main)
  (let*
    ((repo (env-get "REPO" ""))
      (registry (env-get "REGISTRY" "ghcr.io"))
      (image (env-get "IMAGE" ""))
      (arch (env-get "ARCH" "amd64"))
      (run (env-required "RUN_NUMBER"))
      (sha (env-required "SHA"))
      (tarball (env-get "TARBALL" "./result"))
      (moving (env-get "MOVING_LATEST" "true"))
      (base (image-base repo registry image)))
    (cond
      ((and (equal? repo "") (equal? image ""))
        (log-error "ghcr-publish: need REPO or REGISTRY+IMAGE")
        (append-output "pushed=false")
        1)
      (else
        (let*
          ((tag (autobump-tag arch run sha)) (ref (target-ref base tag)))
          (log-info (string-append "==> ghcr-publish " tarball " -> " ref))
          ;; Record WHICH doca the job resolved (baked vs job-time), so a run is
          ;; never ambiguous about which binary produced the artifact.
          (log-info (oci:doca-source-note))
          (let
            ((s (doca-push-archive tarball base tag)))
            (cond
              ((not (= s 0))
                (log-error
                  (string-append
                    "ghcr-publish: doca push failed (exit "
                    (string-format "{}" s)
                    ") for "
                    ref))
                (append-output "pushed=false")
                s)
              (else
                (append-output (string-append "tag=" tag))
                (append-output (string-append "ref=" ref))
                (append-output (string-append "ref-" arch "=" ref))
                (append-output (string-append "result=" ref))
                ;; moving human pointer — NEVER a deploy source
                (when
                  (equal? moving "true")
                  (let
                    ((ms (doca-transfer ref (target-ref base (moving-tag arch)))))
                    (when
                      (not (= ms 0))
                      (log-info
                        (string-append
                          "::warning::ghcr-publish: moving "
                          (moving-tag arch)
                          " pointer push failed (non-fatal)")))))
                (append-output "pushed=true")
                (log-info (string-append "pushed exact " ref))
                0))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — ghcr-publish helpers loaded; main skipped"))
  (else (exit (main))))
