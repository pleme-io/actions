;; output-contract-sync/run.tlisp — generate the output contract, then gate it.
;;
;; ── the class this closes ────────────────────────────────────────────────
;;
;; Every action here is a GitHub COMPOSITE action, and a composite exposes a
;; step's GITHUB_OUTPUT keys to its caller ONLY through its own `outputs:`
;; block. Nearly every action runs its .tlisp through the SHARED INNER RUNNER
;; tatara-script, so a value crosses TWO composite boundaries:
;;
;;     run.tlisp --writes--> tatara-script/action.yml --forwards--> <action>/action.yml --forwards--> caller
;;                           ^ the INNER boundary                   ^ the OUTER boundary
;;
;; A key undeclared at EITHER boundary is dropped, and the consumer reads an
;; empty string. detect-repo-type wrote `repo-type=caixa` correctly for months
;; while every caller read '' and every arm's `if:` compared against nothing.
;; tatara-script/output-contract.tlisp turned that silent drop into a hard
;; failure at RUNTIME — but a runtime gate only ever sees the ONE code path a
;; given run took, which is why 251 actions were broken while only a handful
;; had surfaced (container-boot-check's `healthy` took down the camelot
;; hardened-image pipeline: rabbitmq and vector BUILT and BOOTED GREEN and
;; failed the step anyway).
;;
;; This is the STATIC half. It derives the whole contract from the corpus,
;; covering every branch of every script, and it is the GENERATOR and the GATE
;; in one file so the two can never disagree about what the contract is.
;;
;; ── what is GENERATED vs PRESERVED ───────────────────────────────────────
;;
;; GENERATED: the KEY SET of tatara-script/action.yml's `outputs:` block, and
;; output-contract-catalog.tsv. Sorted, byte-stable, re-running produces
;; identical bytes.
;;
;; PRESERVED: each key's `description:` line, harvested VERBATIM from the
;; committed block. 107 of the original 110 carry hand-authored semantic
;; content ("nix-image amd64 tarball path", "a shared typed why-string key,
;; consumers disjoint") that no generator can derive — regenerating those from
;; a template would have destroyed real institutional memory to gain nothing.
;; So the invariant this seals is the KEY SET; prose stays human. A key with no
;; harvestable description gets the house template.
;;
;; The block is spliced between two literal marker lines. A missing marker is a
;; HARD FAILURE, never a silent no-op — the naive
;; `(write-file p (string-replace (read-file p) needle repl))` shape cannot
;; distinguish "patched" from "did nothing" and reports success either way.
;;
;; ── determinism, and how it is guaranteed ────────────────────────────────
;;
;; 1. Enumeration is `(ls ".")`, which sorts. `glob` does NOT — it is
;;    readdir-ordered, so a catalog generated with it is byte-stable on one
;;    filesystem and different on another. `glob` is never used here.
;; 2. Every emitted sequence goes through `uniq-sorted` = `(sort-by compare
;;    (distinct …))`. `distinct` alone preserves FIRST-SEEN order, so a dedup
;;    without a following sort yields an unstable byte stream the moment input
;;    order changes.
;; 3. No timestamps, no absolute paths, no run ids, no randomness. Every
;;    number in the output is a count derived from the corpus.
;; 4. Generation is a fixed point: it harvests the descriptions it wrote, so
;;    run N+1 over run N's output is byte-identical.
;;
;; ── the DYNAMIC-KEY hazard, and why a naive diff gate is DANGEROUS ───────
;;
;; Three sites build the output KEY by runtime concatenation, so no static
;; scan can see the resulting names:
;;
;;     ghcr-publish  (append-output (string-append "ref-"     arch "=" ref))
;;     zot-push      (append-output (string-append "ref-"     arch "=" ref))
;;     nix-image     (append-output (string-append "tarball-" arch "=" path))
;;
;; A purely static generate-then-byte-diff gate reports ref-amd64, ref-arm64,
;; tarball-amd64 and tarball-arm64 as declared-but-never-written, and a
;; reviewer reads the resulting deletion as a clean cleanup — silently breaking
;; all three actions. So the dynamic sites are TYPED DATA, not inference:
;; dynamic-keys.tsv declares each (action, prefix, domain) and the generator
;; expands the cross product. Reconciliation runs BOTH ways — an undeclared
;; site is a hard failure (a new dynamic site cannot land without its spec
;; entry) and a spec row matching no site is a hard failure (the spec cannot
;; rot). That is the CATALOG REFLECTION interlock: neither side can drift.
;;
;; ── the union is MONOTONIC ───────────────────────────────────────────────
;;
;; inner-union = static keys ∪ dynamic expansions ∪ CURRENTLY-DECLARED keys.
;; Generation therefore never DROPS a declaration. Over-declaration is inert at
;; runtime, and a dropped forward is not; retirement stays a deliberate human
;; edit (★★ MODULARIZE, DON'T DELETE). Keys declared with no discoverable
;; writer are REPORTED in the catalog as `stale?`, never deleted.
;;
;; ── layers ───────────────────────────────────────────────────────────────
;;
;;   L1  inner drift    generated inner outputs block != committed
;;   L2  catalog drift  generated catalog != committed
;;   L3  dynamic spec   declared sites <-> detected sites, both directions
;;   L4  outer boundary a key the script writes that the action's OWN
;;                      outputs block never forwards (the boundary
;;                      output-contract.tlisp is structurally blind to:
;;                      it reads GITHUB_ACTION_PATH/action.yml, which inside
;;                      the exec step is tatara-script's OWN manifest)
;;   L5  ghost step     an outputs value forwarding steps.<id>.outputs.<k>
;;                      where no step with that id exists
;;   L6  parser parity  the yaml-parse declared-set must equal the line
;;                      scanner output-contract.tlisp uses, on every manifest
;;   L7  non-vacuity    a run that examined nothing exits RED, never green
;;
;; Reads   MODE             write | check   (default check)
;;         FAIL_ON_DRIFT    "true" | "false"
;; Writes  drift wrapper-violations wrapper-baselined spec-violations
;;         ghost-steps parity-violations actions-scanned keys-checked reason
;; Exits   0  every layer clean (or drift written, in write mode)
;;         1  a layer failed; names every case

;; ── env ──────────────────────────────────────────────────────────────────

(define mode (env-get "MODE" "check"))

(define fail-on (env-get "FAIL_ON_DRIFT" "true"))

(define inner-manifest (env-get "INNER_MANIFEST" "tatara-script/action.yml"))

(define catalog-path (env-get "CATALOG" "output-contract-catalog.tsv"))

(define dyn-spec-path (env-get "DYNAMIC_KEYS" "output-contract-sync/dynamic-keys.tsv"))

(define wrapper-baseline-path (env-get "WRAPPER_BASELINE" "output-contract-sync/wrapper-baseline.txt"))

(define BEGIN-MARK "# BEGIN GENERATED OUTPUTS -- output-contract-sync; do not hand-edit below.")

(define END-MARK "# END GENERATED OUTPUTS -- output-contract-sync.")

(define INNER-STEP "exec")

;; ── list helpers ─────────────────────────────────────────────────────────

(define (uniq-sorted xs) (sort-by compare (distinct xs)))

(define (minus xs ys) (filter (fn (x) (not (member? x ys))) xs))

(define (flat lol) (foldl (fn (acc x) (append acc x)) (list) lol))

(define (nonempty xs) (filter (fn (x) (not (equal? x ""))) xs))

(define (lines-of s) (string-split s "\n"))

(define (num n) (string-format "{}" n))

(define
  (die msg)
  (log-error (string-append "output-contract-sync: " msg))
  (exit 1))

;; ── corpus enumeration (ls sorts; glob does not) ──────────────────────────

(define
  action-dirs
  (filter
    (fn (d)
      (and
        (is-dir? d)
        (not (string-starts-with? (path-basename d) "_"))
        (not (string-starts-with? (path-basename d) "."))
        (path-exists? (path-join d "action.yml"))))
    (ls ".")))

(define action-names (uniq-sorted (map path-basename action-dirs)))

;; ── scanners ─────────────────────────────────────────────────────────────
;;
;; Anchored on the `append-output` call, never on a bare `"key=` literal. An
;; UNanchored scan returns ~45 phantom keys harvested from CLI flags (--push,
;; --tls-verify) and env vars (GOFLAGS, KO_DOCKER_REPO) — over-declaration no
;; gate would ever catch, because it is inert at runtime and therefore
;; invisible. Both separators are matched: `key=` AND the heredoc opener
;; `key<<DELIM`, which has no `=` at all. Dropping the `<<` alternative loses
;; exactly the multi-line outputs — changelog-generate's `changelog` is one
;; today — i.e. the keys most likely to carry real payload.

(define
  STATIC-RE
  "append-output[ \t\n]*\\(?[ \t\n]*(\\(string-append[ \t\n]*)?\"([a-zA-Z0-9_-]+)(=|<<)")

(define
  DYN-RE
  "append-output[ \t\n]*\\(string-append[ \t\n]*\"([a-zA-Z0-9_-]*)\"[ \t\n]+([a-z][a-zA-Z0-9?!*-]*)")

(define REF-RE "steps\\.([a-zA-Z0-9_-]+)\\.outputs\\.([a-zA-Z0-9_-]+)")

;; Full-line comments are blanked before scanning, line count preserved so a
;; genuinely multi-line call still matches across the newline. Without this, a
;; documentation example inside a `;;` block becomes a phantom output key —
;; this file's own header documents the three dynamic sites verbatim and would
;; otherwise claim them as its own. Only lines whose first non-whitespace
;; character is `;` are blanked: a trailing comment after real code is left
;; alone, since the code before it IS a real write.
(define
  (strip-comments src)
  (string-join
    "\n"
    (map (fn (l) (if (string-starts-with? (string-trim l) ";") "" l)) (lines-of src))))

(define
  (scan-static src)
  (let
    ((s (strip-comments src)))
    (map (fn (m) (nth 2 (re-captures STATIC-RE m))) (re-find-all STATIC-RE s))))

(define
  (scan-dynamic src)
  (let
    ((s (strip-comments src)))
    (map (fn (m) (nth 1 (re-captures DYN-RE m))) (re-find-all DYN-RE s))))

;; ── manifest readers ─────────────────────────────────────────────────────

(define (declared-of yml-text) (uniq-sorted (map car (alist-get (yaml-parse yml-text) "outputs" (list)))))

;; The `outputs:` block as raw lines, so `steps.<id>.outputs.<key>` forwards
;; are read from the FORWARDS ONLY — a step's `if:` or `env:` may reference the
;; same expression, and counting those would mask a real outer-boundary gap.
(define
  (top-level? line)
  (and
    (not (equal? line ""))
    (not (string-starts-with? line " "))
    (not (string-starts-with? line "#"))))

(define
  (outputs-lines ls-in inside acc)
  (cond
    ((null? ls-in) acc)
    (else
      (let
        ((line (car ls-in)) (rest (cdr ls-in)))
        (cond
          ((string-starts-with? line "outputs:") (outputs-lines rest #t acc))
          ((and inside (top-level? line)) acc)
          (inside (outputs-lines rest #t (cons line acc)))
          (else (outputs-lines rest inside acc)))))))

(define (outputs-block-text yml-text) (string-join "\n" (outputs-lines (lines-of yml-text) #f (list))))

(define
  (forwards-of yml-text)
  (let
    ((blk (outputs-block-text yml-text)))
    (map (fn (m) (re-captures REF-RE m)) (re-find-all REF-RE blk))))

(define (step-ids-of yml-text) (uniq-sorted (map (fn (m) (nth 1 (re-captures "id: *([a-zA-Z0-9_-]+)" m))) (re-find-all "id: *([a-zA-Z0-9_-]+)" yml-text))))

;; Which .tlisp files an action cats into the runner. Line-oriented on purpose:
;; `${{ github.action_path }}` contains SPACES, so a `cat [^ ]*\.tlisp` match
;; silently finds NOTHING and the whole measurement reads zero and looks green.
(define
  (script-files-of yml-text)
  (uniq-sorted
    (flat
      (map
        (fn (l) (map (fn (m) (nth 1 (re-captures "([a-zA-Z0-9_-]+\\.tlisp)" m))) (re-find-all "([a-zA-Z0-9_-]+\\.tlisp)" l)))
        (filter (fn (l) (string-contains? l "cat ")) (lines-of yml-text))))))

(define (routes? yml-text) (string-contains? yml-text "actions/tatara-script@"))

;; ── parser-parity oracle ─────────────────────────────────────────────────
;;
;; A verbatim copy of tatara-script/output-contract.tlisp's declared-set line
;; scanner. This file reads manifests with `yaml-parse` (simpler, and it
;; handles `${{ }}` and folded blocks), so two parsers for "what does this
;; action.yml declare" now exist and could disagree — the runtime gate would
;; then enforce a different contract than the one generated here. L6 asserts
;; they agree on every manifest in the corpus, which is strictly stronger than
;; sharing one parser: a divergence reddens instead of going unnoticed.

(define ident-chars "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")

(define
  (all-ident-chars? s)
  (cond
    ((equal? s "") #f)
    (else (null? (filter (fn (c) (not (string-contains? ident-chars c))) (string-split s ""))))))

(define
  (declared-entry line)
  (cond
    ((not (string-starts-with? line "  ")) "")
    ((string-starts-with? line "   ") "")
    (else
      (let
        ((name (car (string-split (string-trim line) ":"))))
        (if (and (string-ends-with? (string-trim line) ":") (all-ident-chars? name)) name "")))))

(define
  (scan-declared ls-in inside acc)
  (cond
    ((null? ls-in) acc)
    (else
      (let
        ((line (car ls-in)) (rest (cdr ls-in)))
        (cond
          ((string-starts-with? line "outputs:") (scan-declared rest #t acc))
          ((and inside (top-level? line)) acc)
          (inside
            (let
              ((e (declared-entry line)))
              (scan-declared rest #t (if (equal? e "") acc (cons e acc)))))
          (else (scan-declared rest inside acc)))))))

(define (declared-oracle yml-text) (uniq-sorted (scan-declared (lines-of yml-text) #f (list))))

;; ── the dynamic-key spec ─────────────────────────────────────────────────

(define
  spec-rows
  (if
    (path-exists? dyn-spec-path)
    (map
      (fn (l) (string-split l "\t"))
      (filter (fn (l) (not (string-starts-with? l "#"))) (nonempty (lines-of (read-file dyn-spec-path)))))
    (list)))

(define (spec-action r) (nth 0 r))

(define (spec-prefix r) (nth 1 r))

(define (spec-domain r) (uniq-sorted (nonempty (string-split (nth 2 r) ","))))

(define (spec-key r) (string-append (spec-action r) "\t" (spec-prefix r)))

(define (spec-expand r) (map (fn (d) (string-append (spec-prefix r) d)) (spec-domain r)))

;; Every key a given action may emit: the literal ones a scan can see, plus the
;; cross product of its declared dynamic sites. Both boundaries are checked
;; against this union — a dynamic key that only the INNER contract declares is
;; still dropped at the wrapper, so covering only the static half would leave
;; exactly the arch variants nobody tested (tarball-x86_64) silently broken.
(define
  (all-keys-for r)
  (uniq-sorted
    (append
      (f-get r "static")
      (flat (map spec-expand (filter (fn (s) (equal? (spec-action s) (f-name r))) spec-rows))))))

;; ── per-action facts ─────────────────────────────────────────────────────
;;
;; Keyed per (action, script file) and never per file: _tlisp-stdlib/stdlib.tlisp
;; is prepended into 308 actions, so a file->keys map would attribute a single
;; stdlib key to all of them at once.

(define
  (facts-for a)
  (let*
    ((name (path-basename a))
      (yml (read-file (path-join a "action.yml")))
      (scripts (filter (fn (f) (path-exists? (path-join a f))) (script-files-of yml)))
      (srcs (map (fn (f) (read-file (path-join a f))) scripts))
      (statics (uniq-sorted (flat (map scan-static srcs))))
      (dyns (uniq-sorted (flat (map scan-dynamic srcs)))))
    (list
      (list "name" name)
      (list "routes" (routes? yml))
      (list "scripts" scripts)
      (list "declared" (declared-of yml))
      (list "oracle" (declared-oracle yml))
      (list "forwards" (forwards-of yml))
      (list "step-ids" (step-ids-of yml))
      (list "static" statics)
      (list "dynamic" dyns))))

(define facts (map facts-for action-dirs))

(define (f-get r k) (alist-get r k (list)))

(define (f-name r) (alist-get r "name" ""))

(define (f-routes? r) (alist-get r "routes" #f))

(define routing (filter f-routes? facts))

;; ── L3  dynamic-spec reconciliation, both directions ─────────────────────

(define
  detected-sites
  (uniq-sorted
    (flat (map (fn (r) (map (fn (p) (string-append (f-name r) "\t" p)) (f-get r "dynamic"))) facts))))

(define declared-sites (uniq-sorted (map spec-key spec-rows)))

(define undeclared-sites (minus detected-sites declared-sites))

(define stale-sites (minus declared-sites detected-sites))

(define spec-violations (+ (length undeclared-sites) (length stale-sites)))

;; ── the inner union (monotonic: a declaration is never dropped) ───────────

(define inner-yml (read-file inner-manifest))

(define inner-declared (declared-of inner-yml))

(define written-static (uniq-sorted (flat (map (fn (r) (f-get r "static")) routing))))

(define dynamic-expanded (uniq-sorted (flat (map spec-expand spec-rows))))

(define inner-union (uniq-sorted (append (append written-static dynamic-expanded) inner-declared)))

(define inner-missing (minus (uniq-sorted (append written-static dynamic-expanded)) inner-declared))

(define stale-declared (minus inner-declared (uniq-sorted (append written-static dynamic-expanded))))

;; ── the generated inner outputs block ────────────────────────────────────

(define
  (harvest ls-in acc)
  (cond
    ((null? ls-in) acc)
    ((null? (cdr ls-in)) acc)
    (else
      (let*
        ((line (car ls-in)) (nxt (car (cdr ls-in))) (e (declared-entry line)))
        (cond
          ((and (not (equal? e "")) (string-starts-with? nxt "    description:"))
            (harvest (cdr ls-in) (cons (list e nxt) acc)))
          (else (harvest (cdr ls-in) acc)))))))

(define descriptions (harvest (lines-of inner-yml) (list)))

(define
  (description-for k)
  (alist-get
    descriptions
    k
    (string-append "    description: \"Forwarded from the script's GITHUB_OUTPUT (key: " k ")\"")))

(define
  (entry-lines k)
  (list
    (string-append "  " k ":")
    (description-for k)
    (string-append "    value: ${{ steps." INNER-STEP ".outputs." k " }}")))

(define generated-block (append (list "outputs:") (flat (map entry-lines inner-union))))

;; ── splice ───────────────────────────────────────────────────────────────

(define inner-lines (lines-of inner-yml))

(define begin-ix (find-index (fn (l) (equal? l BEGIN-MARK)) inner-lines))

(define end-ix (find-index (fn (l) (equal? l END-MARK)) inner-lines))

(when
  (or (< begin-ix 0) (< end-ix 0))
  (die
    (string-append
      "the generated-region markers are absent from "
      inner-manifest
      " — refusing to guess where the block goes. A mutation that cannot tell "
      "'patched' from 'did nothing' reports success either way; that is the "
      "same silent-success class this tool exists to remove. Expected the "
      "lines:\n  "
      BEGIN-MARK
      "\n  "
      END-MARK)))

(when
  (>= begin-ix end-ix)
  (die "the END marker precedes the BEGIN marker in the inner manifest"))

(define
  spliced
  (append
    (append (take (+ begin-ix 1) inner-lines) generated-block)
    (drop end-ix inner-lines)))

(define rendered-inner (string-join "\n" spliced))

;; ── the catalog ──────────────────────────────────────────────────────────
;;
;; Line-oriented and sorted, not a single-line JSON blob: this artifact's whole
;; job is to be byte-diffed, and a one-line document rewrites entirely when one
;; key changes, so a reviewer cannot see what moved. Two sections — the
;; per-action routing summary, then one row per (action, key) carrying its
;; status at BOTH boundaries.

(define
  (outer-status r k)
  (let
    ((fwd (map (fn (c) (nth 2 c)) (f-get r "forwards"))))
    (if (member? k fwd) "forwarded" "MISSING")))

;; Tested against the GENERATED union, never against the currently-committed
;; declared set. Both artifacts are written in the SAME pass, so reporting
;; pre-write state here would make one write pass produce a catalog describing a
;; manifest that no longer exists — convergence would need a second pass, and a
;; human who ran write once and committed would land a red gate.
(define
  (inner-status r k)
  (cond ((not (f-routes? r)) "n/a") ((member? k inner-union) "declared") (else "MISSING")))

;; One definition of "the keys this action may emit", shared by the catalog and
;; by the outer-boundary gate, so the artifact and the check can never describe
;; different key sets.
(define
  (kind-of r k)
  (let
    ((hit (filter (fn (s) (and (equal? (spec-action s) (f-name r)) (member? k (spec-expand s)))) spec-rows)))
    (if (null? hit) "static" (string-append "dynamic:" (spec-prefix (car hit))))))

(define
  (key-rows r)
  (map
    (fn (k) (string-join "\t" (list (f-name r) k (kind-of r k) (inner-status r k) (outer-status r k))))
    (all-keys-for r)))

(define inner-dir (path-basename (path-dirname inner-manifest)))

;; The inner runner's own declared count is the one number in this catalog that
;; the SAME pass rewrites, so it is reported from the generated union rather
;; than from disk. Without this the catalog describes the manifest as it was
;; before the write, and convergence costs a second pass — which a human who
;; ran write once and committed would discover as a red gate.
(define
  (declared-count r)
  (if (equal? (f-name r) inner-dir) (length inner-union) (length (f-get r "declared"))))

(define
  (summary-row r)
  (string-join
    "\t"
    (list
      (f-name r)
      (if (f-routes? r) "tatara-script" "own-runner")
      (if (null? (f-get r "scripts")) "-" (string-join "," (f-get r "scripts")))
      (num (length (f-get r "static")))
      (num (declared-count r)))))

(define
  catalog-lines
  (append
    (append
      (list
        "# output-contract-catalog.tsv — GENERATED by output-contract-sync. Do not hand-edit."
        "#"
        "# The schema of the flows: for every action, whether it routes through the"
        "# shared inner runner, which .tlisp files it cats, and for every output key"
        "# its status at BOTH composite boundaries. Regenerate with:"
        "#     MODE=write <stdlib + output-contract-sync/run.tlisp>"
        "#"
        (string-append "# actions                " (num (length action-dirs)))
        (string-append "# routing tatara-script  " (num (length routing)))
        (string-append "# distinct keys written  " (num (length written-static)))
        (string-append "# dynamic key expansions " (num (length dynamic-expanded)))
        (string-append "# inner union (generated)" (num (length inner-union)))
        "#"
        "# The count of keys CURRENTLY declared, and any declared with no"
        "# discoverable writer, are deliberately absent: both are properties of"
        "# the manifest this pass rewrites, so embedding them would describe a"
        "# pre-write state and cost a second pass to converge. They are logged"
        "# on every run instead."
        "#"
        "# SECTION summary: action<TAB>runner<TAB>scripts<TAB>n-written<TAB>n-declared"
        "# SECTION keys:    action<TAB>key<TAB>kind<TAB>inner<TAB>outer"
        "#"
        "## summary")
      (uniq-sorted (map summary-row facts)))
    (append (list "## keys") (uniq-sorted (flat (map key-rows facts))))))

(define rendered-catalog (string-append (string-join "\n" catalog-lines) "\n"))

;; ── L4  outer boundary: written but never forwarded by the OWN manifest ───

(define
  wrapper-baseline
  (if (path-exists? wrapper-baseline-path) (nonempty (lines-of (read-file wrapper-baseline-path))) (list)))

(define
  (wrapper-gaps r)
  (let
    ((fwd (map (fn (c) (nth 2 c)) (f-get r "forwards"))))
    (map
      (fn (k) (string-append (f-name r) "\t" k))
      (filter (fn (k) (not (member? k fwd))) (all-keys-for r)))))

(define all-wrapper-gaps (uniq-sorted (flat (map wrapper-gaps routing))))

(define wrapper-new (minus all-wrapper-gaps wrapper-baseline))

(define wrapper-baselined (filter (fn (g) (member? g wrapper-baseline)) all-wrapper-gaps))

;; ── L5  ghost step: a forward from a step id that does not exist ──────────

(define
  (ghost-of r)
  (let
    ((ids (f-get r "step-ids")))
    (map
      (fn (c) (string-append (f-name r) "\t" (nth 1 c) "\t" (nth 2 c)))
      (filter (fn (c) (not (member? (nth 1 c) ids))) (f-get r "forwards")))))

(define ghosts (uniq-sorted (flat (map ghost-of facts))))

;; ── L6  parser parity ────────────────────────────────────────────────────

(define
  parity-bad
  (uniq-sorted
    (map
      f-name
      (filter (fn (r) (not (equal? (string-join "," (f-get r "declared")) (string-join "," (f-get r "oracle"))))) facts))))

;; ── L7  non-vacuity ──────────────────────────────────────────────────────
;;
;; Hard floors, deliberately not configurable. A gate whose scan silently
;; matched nothing must exit RED — a check that examined nothing reporting
;; green is the defect, not the feature. These sit far below today's corpus
;; (337 / 315 / 283) and far above zero.

(when
  (< (length action-dirs) 200)
  (die (string-append "vacuous scan: only " (num (length action-dirs)) " action dirs found (floor 200)")))

(when
  (< (length routing) 200)
  (die (string-append "vacuous scan: only " (num (length routing)) " routing actions found (floor 200)")))

(when
  (< (length written-static) 100)
  (die (string-append "vacuous scan: only " (num (length written-static)) " written keys found (floor 100)")))

(when
  (null? spec-rows)
  (die (string-append "vacuous scan: the dynamic-key spec at " dyn-spec-path " is empty or absent")))

;; ── verdict values (pure; computed even under the test harness) ───────────

(define (report-list label xs) (for-each (fn (x) (log-error (string-append "  " label " " x))) xs))

(define inner-drift (if (equal? rendered-inner inner-yml) 0 1))

(define
  catalog-drift
  (if
    (and (path-exists? catalog-path) (equal? rendered-catalog (read-file catalog-path)))
    0
    1))


(define drift (if (equal? mode "write") 0 (+ inner-drift catalog-drift)))

(define
  failures
  (+ (+ drift spec-violations) (+ (length wrapper-new) (+ (length ghosts) (length parity-bad)))))

(define
  reason
  (cond
    ((> drift 0) "drift")
    ((> spec-violations 0) "dynamic-spec-unreconciled")
    ((> (length wrapper-new) 0) "outer-boundary-gap")
    ((> (length ghosts) 0) "ghost-step")
    ((> (length parity-bad) 0) "parser-parity")
    ((equal? mode "write") "written")
    (else "ok")))

;; ── main (side-effecting; gated off under TLISP_TEST) ─────────────────────
;;
;; Everything above is a pure derivation of the corpus and runs under the test
;; harness too, so run.test.tlisp asserts against the REAL 338-action contract
;; rather than a fixture that could drift from it. Only the writes, the report
;; and the (exit …) live here — an (exit) at load time would terminate the
;; program before a single (deftest …) ran, which is how a test file ends up
;; reporting green while never having executed.

(define
  (report)
  (log-info
    (string-append
      "==> corpus: "
      (num (length action-dirs))
      " actions, "
      (num (length routing))
      " routing through tatara-script, "
      (num (length written-static))
      " distinct keys written statically, "
      (num (length dynamic-expanded))
      " dynamic expansions"))
  (log-info
    (string-append
      "==> inner contract: "
      (num (length inner-declared))
      " declared, "
      (num (length inner-union))
      " in the generated union, "
      (num (length inner-missing))
      " missing, "
      (num (length stale-declared))
      " declared with no discoverable writer"))
  (when
    (> inner-drift 0)
    (cond
      ((equal? mode "write") #t)
      (else
        (log-error
          (string-append
            inner-manifest
            " is out of date: the generated `outputs:` block differs from what is committed."))
        (report-list "inner MISSING" inner-missing)
        (log-error "regenerate with the sync action in write mode; do not hand-edit between the markers"))))
  (when
    (> catalog-drift 0)
    (cond
      ((equal? mode "write") #t)
      (else
        (log-error
          (string-append catalog-path " is out of date: regenerate it in the same commit as the change that moved it.")))))
  (when
    (> spec-violations 0)
    (log-error "dynamic-key spec is not reconciled with the corpus:")
    (report-list "site with NO spec row (add it to dynamic-keys.tsv)" undeclared-sites)
    (report-list "spec row matching NO site (stale; remove it)" stale-sites))
  (when
    (> (length wrapper-new) 0)
    (log-error
      (string-append
        "OUTER boundary: key(s) written by a script that the action's OWN outputs "
        "block never forwards — dropped before the caller ever sees them, and "
        "invisible to the runtime gate, which reads tatara-script's manifest:"))
    (report-list "outer MISSING" wrapper-new))
  (for-each (fn (g) (log-info (string-append "  outer MISSING (baselined, tracked debt) " g))) wrapper-baselined)
  (when
    (> (length ghosts) 0)
    (log-error "outputs value forwards from a step id that does not exist (the forward resolves to '' forever):")
    (report-list "ghost step" ghosts))
  (when
    (> (length parity-bad) 0)
    (log-error
      (string-append
        "parser parity: yaml-parse and output-contract.tlisp's line scanner "
        "disagree about the declared set, so the runtime gate would enforce a "
        "different contract than the one generated here:"))
    (report-list "parity" parity-bad))
  (when
    (> (length stale-declared) 0)
    (log-info
      (string-append
        "  note: "
        (num (length stale-declared))
        " inner key(s) declared with no discoverable writer — reported, never deleted "
        "(a dropped forward breaks a consumer; an extra one is inert): "
        (string-join ", " stale-declared)))))

(define
  (apply-writes)
  (when
    (> inner-drift 0)
    (write-file inner-manifest rendered-inner)
    (log-info (string-append "wrote " inner-manifest)))
  (when
    (> catalog-drift 0)
    (write-file catalog-path rendered-catalog)
    (log-info (string-append "wrote " catalog-path)))
  (when
    (and (equal? inner-drift 0) (equal? catalog-drift 0))
    (log-info "both artifacts already match the corpus — nothing to write")))

(define
  (emit-outputs)
  (append-output (string-append "drift=" (num drift)))
  (append-output (string-append "wrapper-violations=" (num (length wrapper-new))))
  (append-output (string-append "wrapper-baselined=" (num (length wrapper-baselined))))
  (append-output (string-append "spec-violations=" (num spec-violations)))
  (append-output (string-append "ghost-steps=" (num (length ghosts))))
  (append-output (string-append "parity-violations=" (num (length parity-bad))))
  (append-output (string-append "actions-scanned=" (num (length action-dirs))))
  (append-output (string-append "keys-checked=" (num (length inner-union))))
  (append-output (string-append "reason=" reason)))

(define
  (main)
  (report)
  (when (equal? mode "write") (apply-writes))
  (emit-outputs)
  (cond
    ((equal? failures 0) (log-info (string-append "output-contract-sync: ok — reason=" reason)) (exit 0))
    ((equal? fail-on "true")
      (log-error (string-append "output-contract-sync: FAILED — reason=" reason))
      (exit 1))
    (else
      (log-info (string-append "output-contract-sync: issues found, fail-on-drift=false — reason=" reason))
      (exit 0))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1")
    (log-info "TLISP_TEST=1 — contract computed; report/write/exit skipped (the harness drives the assertions)"))
  (else (main)))
