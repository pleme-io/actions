;; helm-publish/run.tlisp — package + push a Helm chart to an OCI registry.

(define registry (env-required "REGISTRY"))

(define dry-run (env-get "DRY_RUN" "false"))

(define max-retries 20)

(define (read-name)
  (let ((r (exec-capture "sh" "-c" "yq '.name' Chart.yaml 2>/dev/null")))
    (if (= (status-of r) 0)
      (string-trim (stdout-of r))
      "")))

(define (read-version)
  (let ((r (exec-capture "sh" "-c" "yq '.version' Chart.yaml 2>/dev/null")))
    (if (= (status-of r) 0)
      (string-trim (stdout-of r))
      "")))

;; OCI manifest existence probe — for ghcr.io we use the
;; registry v2 manifest endpoint. Returns 200 if the (name, version)
;; tag exists, 404 otherwise.
(define (helm-published? name version)
  (let*
    ((url
       (string-append
         "https://"
         (string-replace
           registry
           "ghcr.io"
           "ghcr.io/v2")
         "/"
         name
         "/manifests/"
         version)))
    (http-200? url)))

;; ── A CHART WITH DEPENDENCIES CANNOT BE PACKAGED FROM A CLEAN CHECKOUT ───
;;
;; `helm package` refuses a chart whose `dependencies:` are not present in its
;; `charts/` directory:
;;
;;   Error: found in Chart.yaml, but missing in charts/ directory: pleme-lib
;;
;; The subchart .tgz is a FETCHED artifact, never authored, and every pleme-io
;; chart repo gitignores it (`charts/*/charts/`, `*.tgz` — the convention
;; helmworks-akeyless set and ensaio copied). So it is present on the machine
;; of whoever last ran `helm dependency update` by hand, and absent in CI on
;; every single run. This action never resolved them, which means it could
;; only ever have published DEPENDENCY-FREE charts — a limit nothing stated
;; and nothing tested, because its one consumer had no dependencies.
;;
;; `update` rather than `build`: `build` requires a Chart.lock and fails when
;; the lock disagrees with Chart.yaml, which turns a routine dependency range
;; bump into a red publish. `update` re-resolves the range and writes the lock.
;; This mirrors what `forge helm release-all` already does for the monorepo
;; path (cli/src/commands/helm.rs::helm_dependency_update), so the two release
;; paths agree instead of each having their own answer.
;;
;; Skipped entirely for a chart that declares no dependencies, so a dependency-
;; free chart's publish is unchanged — no new network call, no new failure mode.
(define (dependency-count)
  (let ((r (exec-capture "sh" "-c" "yq '.dependencies | length' Chart.yaml 2>/dev/null")))
    (if (= (status-of r) 0) (string-trim (stdout-of r)) "0")))

(define (has-dependencies?)
  (let ((n (dependency-count)))
    (and (not (equal? n "0")) (not (equal? n "null")) (not (equal? n "")))))

(define (do-dependency-update)
  (log-info
    (string-append
      "chart declares "
      (dependency-count)
      " dependency/dependencies — resolving before package"))
  (checked-status "helm dependency update" (exec-capture "helm" "dependency" "update" ".")))

(define (do-package)
  (cond
    ((not (has-dependencies?)) (checked-status "helm package" (exec-capture "helm" "package" ".")))
    (else
      (let ((dep (do-dependency-update)))
        (cond
          ((not (= dep 0))
            (log-error
              (string-append
                "helm dependency update failed. The chart declares "
                (dependency-count)
                " dependency/dependencies and cannot be packaged without them; "
                "if the repository is an OCI registry, check that the login step "
                "before this one used a token with read access to it."))
            dep)
          (else (checked-status "helm package" (exec-capture "helm" "package" "."))))))))

(define (do-push name version)
  ;; The packaged chart lands at ./<name>-<version>.tgz.
  (let*
    ((pkg (string-append name "-" version ".tgz"))
      (target (string-append "oci://" registry))
      (r (exec-capture "helm" "push" pkg target)))
    r))

(define (rate-limit? log) (or (log-contains? log "429") (log-contains? log "Too Many Requests")))

(define (already-uploaded? log)
  (or (log-contains? log "already exists") (log-contains? log "BLOB_UPLOAD_INVALID")))

(define (try-push name version attempt)
  (cond
    ((>= attempt max-retries)
      (log-error "exceeded max retries")
      (append-output "shipped=false")
      (exit 1))
    (else
      (log-info (string-append "push attempt " (string-format "{}" attempt)))
      (let*
        ((r (do-push name version))
          (code (status-of r))
          (log (string-append (stdout-of r) "\n" (stderr-of r))))
        (cond
          ((= code 0)
            (log-info "pushed successfully")
            (append-output "shipped=true")
            (exit 0))
          ((already-uploaded? log)
            (log-info "already pushed — treating as success")
            (append-output "shipped=true")
            (exit 0))
          ((rate-limit? log)
            (log-info "registry rate limit — sleeping 600s")
            (exec-capture "sleep" "600")
            (try-push
              name
              version
              (+ attempt 1)))
          (else
            (log-error "push failed with no recognizable retry signature")
            (log-info log)
            (append-output "shipped=false")
            (exit code)))))))

(define name (read-name))

(define version (read-version))

(cond
  ((equal? name "")
    (log-error "helm-publish: .name not found in Chart.yaml")
    (append-output "shipped=false")
    (exit 1))
  ((equal? version "")
    (log-error "helm-publish: .version not found in Chart.yaml")
    (append-output "shipped=false")
    (exit 1))
  ((helm-published? name version)
    (log-info (string-append "skipping '" name ":" version "' — already on registry"))
    (append-output "shipped=true")
    (exit 0))
  (else
    (let ((pkg-status (do-package)))
      (cond
        ((not (= pkg-status 0))
          (log-error "helm package failed")
          (append-output "shipped=false")
          (exit pkg-status))
        ((equal? dry-run "true")
          (log-info "dry-run — packaged but not pushed")
          (append-output "shipped=true")
          (exit 0))
        (else (try-push name version 1))))))
